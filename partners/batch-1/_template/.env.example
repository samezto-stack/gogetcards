# Coverage Desk needs no environment variables to run.
#
# SITE_URL is optional and normally absent: server/seo.js falls back to
# Render's own RENDER_EXTERNAL_URL, which is the origin the service is
# actually served from, so canonical links, og:url and sitemap.xml follow
# the real host. Set this only once a custom domain is attached.
# SITE_URL=https://coveragedesk.com
