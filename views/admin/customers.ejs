<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { title: 'Customers' }) %>
</head>
<body class="admin-body">
  <%- include('_sidebar', { currentPath: '/admin/customers' }) %>

  <main class="admin-main">
    <header class="admin-header">
      <div>
        <h1 class="admin-header__title">Customers</h1>
        <p class="admin-header__sub"><%= activeSessions %> live session<%= activeSessions === 1 ? '' : 's' %></p>
      </div>
    </header>

    <div class="admin-content">
      <%
        const money = (c) => `$${(Number(c || 0) / 100).toFixed(2)}`;
        const day = (d) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
      %>

      <% if (deleted) { %>
        <div class="admin-alert admin-alert--success">
          <%= deleted === 'all'
            ? 'Account deleted, along with its test orders, sessions and sign-in links.'
            : 'Account deleted. Its orders were kept.' %>
        </div>
      <% } %>

      <div class="admin-stats-grid">
        <div class="admin-stat-card">
          <div class="admin-stat-card__num"><%= stats.customers %></div>
          <div class="admin-stat-card__label">Accounts</div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-card__num"><%= stats.withOrders %></div>
          <div class="admin-stat-card__label">Have ordered</div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-card__num"><%= stats.repeat %></div>
          <div class="admin-stat-card__label">Repeat buyers</div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-card__num"><%= money(stats.spend) %></div>
          <div class="admin-stat-card__label">Lifetime value</div>
        </div>
      </div>

      <form class="admin-filter-bar" method="GET" action="/admin/customers">
        <div class="admin-filter-bar__search">
          <input class="admin-search-input" type="search" name="q" value="<%= q %>"
                 placeholder="Search name, email or phone" autocomplete="off">
        </div>
        <button class="admin-btn" type="submit">Search</button>
        <% if (q) { %><a class="admin-btn admin-btn--ghost" href="/admin/customers">Clear</a><% } %>
        <%/* Counts on the cards cover the rows shown, which is the page you
             are looking at. Said out loud rather than left to be assumed
             once the list outgrows one page. */%>
        <% if (truncated) { %>
          <span class="small faint">Showing the <%= rows.length %> newest of <%= total %>. Search to narrow it down.</span>
        <% } %>
      </form>

      <% if (!rows.length) { %>
        <div class="admin-empty">
          <p><%= q ? 'No customer matches that.' : 'No customer accounts yet.' %></p>
          <p>Accounts are created automatically when a payment is confirmed on the thank-you page.</p>
        </div>
      <% } else { %>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Customer</th>
                <th>Email</th>
                <th class="num">Orders</th>
                <th class="num">Spend</th>
                <th>Last order</th>
                <th>Joined</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% rows.forEach(function (r) { %>
                <tr class="is-clickable" onclick="location.href='/admin/customers/<%= r.c._id %>'">
                  <td>
                    <a href="/admin/customers/<%= r.c._id %>" class="admin-cell-link">
                      <%= [r.c.firstName, r.c.lastName].filter(Boolean).join(' ') || '—' %>
                    </a>
                  </td>
                  <td class="mono">
                    <%= r.c.displayEmail || r.c.email %>
                    <%/* Derived from the address, which is the same thing
                         the checkout keys the bypass on — so an account
                         cannot be tagged here and untagged there. */%>
                    <% if (testOrder.isTestEmail(r.c.email)) { %><span class="admin-tag admin-tag--warn" style="margin-left:6px">Test</span><% } %>
                  </td>
                  <td class="num"><%= r.orders %></td>
                  <td class="num"><%= money(r.spend) %></td>
                  <td><%= day(r.last) %></td>
                  <td><%= day(r.c.createdAt) %></td>
                  <td>
                    <span class="status-pill status-pill--<%= r.c.status === 'closed' ? 'err' : 'ok' %>">
                      <span class="status-pill__dot"></span><%= r.c.status === 'closed' ? 'Closed' : 'Active' %>
                    </span>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>
