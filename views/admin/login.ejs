<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { title: 'Sign in' }) %>
</head>
<body class="admin-login-page">
  <aside class="login-brand" aria-hidden="true">
    <div class="login-brand__mark">
      <%- include('../partials/logomark', { size: 32 }) %>
      GoGetCards
    </div>
    <div class="login-brand__copy">
      <h2>The counter behind the shop.</h2>
      <p>Orders, stock, partner rotation, email and the catalogue, in one place. Sign in with the owner account.</p>
    </div>
    <div class="login-brand__foot">gogetcards.com &middot; admin</div>
  </aside>

  <main class="login-pane">
    <div class="login-card">
      <div class="login-logo">
        <%- include('../partials/logomark', { size: 28 }) %>
        GoGetCards
      </div>
      <h1>Sign in</h1>
      <p class="login-lead">Use the admin email and password.</p>
      <% if (error) { %>
        <div class="admin-alert admin-alert--error" role="alert"><%= error %></div>
      <% } %>
      <form method="POST" action="/admin/login">
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" name="email" id="email" required autocomplete="email" autofocus>
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" name="password" id="password" required autocomplete="current-password">
        </div>
        <button type="submit" class="admin-btn admin-btn--primary admin-btn--block">Sign in</button>
      </form>
    </div>
  </main>
</body>
</html>
