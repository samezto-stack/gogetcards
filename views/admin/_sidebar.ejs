<%
  const path = typeof currentPath !== 'undefined' ? currentPath : '/admin';
  const on = (p) => path === p ? 'nav-item on' : 'nav-item';
%>
<aside class="admin-sidebar">
  <div class="sb-brand">
    <a href="/admin" class="sb-logo">
      <svg width="22" height="22" viewBox="0 0 28 28" fill="none"><polygon points="14,2 26,8 26,20 14,26 2,20 2,8" fill="none" stroke="url(#slg)" stroke-width="2"/><circle cx="14" cy="14" r="3" fill="url(#slg)"/><defs><linearGradient id="slg" x1="2" y1="2" x2="26" y2="26"><stop offset="0%" stop-color="#D8B45F"/><stop offset="100%" stop-color="#C4485C"/></linearGradient></defs></svg>
      <span class="lg">GoGetCards<span class="tm">™</span></span>
    </a>
    <span class="env">Live</span>
  </div>

  <nav class="admin-nav">
    <div class="sb-group">
      <div class="gl">Overview</div>
      <a href="/admin" class="<%= on('/admin') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="5" rx="1"/><rect x="13" y="10" width="8" height="11" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/></svg>
        <span class="nav-label">Dashboard</span>
      </a>
    </div>

    <div class="sb-group">
      <div class="gl">Commerce</div>
      <a href="/admin/analytics" class="<%= on('/admin/analytics') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 5-7"/></svg>
        <span class="nav-label">Analytics</span>
      </a>
      <a href="/admin/orders" class="<%= on('/admin/orders') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 7h16l-1.5 12a2 2 0 01-2 1.7H7.5a2 2 0 01-2-1.7L4 4H2"/></svg>
        <span class="nav-label">Orders</span>
      </a>
      <a href="/admin/chats" class="<%= on('/admin/chats') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 5h14a1 1 0 011 1v9a1 1 0 01-1 1H9l-4 4V6a1 1 0 011-1z"/></svg>
        <span class="nav-label">Live Chat</span>
        <% if (typeof unreadChatCount !== 'undefined' && unreadChatCount > 0) { %>
          <span class="badge-n"><%= unreadChatCount %></span>
        <% } %>
      </a>
      <%/* Contact-form messages. Without somewhere to read them, adding a
           form to the public site would only have created a silent black
           hole, which is exactly the failure a Merchant Center reviewer
           finds by sending a test enquiry and getting no reply. */%>
      <a href="/admin/messages" class="<%= on('/admin/messages') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
        <span class="nav-label">Messages</span>
        <% if (typeof unreadMessageCount !== 'undefined' && unreadMessageCount > 0) { %>
          <span class="badge-n"><%= unreadMessageCount %></span>
        <% } %>
      </a>
      <%/* Customer accounts. Sits next to Orders because the two are the
           same conversation: an order the portal shows as "unfulfilled"
           forever is a support ticket, and the controls that stop that
           happening live on the customer page. */%>
      <a href="/admin/customers" class="<%= on('/admin/customers') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span class="nav-label">Customers</span>
      </a>
      <%/* Transactional email. Under Commerce because a confirmation
           that never arrived is a commercial problem before it is a
           technical one, and because this page is where you find out
           that the shop has been unable to send anything. */%>
      <%/* Replaces the Stealth Generator, which added stores to a rotator
           this shop no longer uses. Preorders are most of the money here
           and are taken months before anything ships; until this page
           there was no way to see how many people were waiting on a set
           without filtering the orders list by hand. */%>
      <a href="/admin/preorders" class="<%= on('/admin/preorders') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
        <span class="nav-label">Preorders</span>
      </a>
      <a href="/admin/emails" class="<%= on('/admin/emails') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 8.5l9 5.5 9-5.5"/></svg>
        <span class="nav-label">Email</span>
      </a>
      <a href="/admin/abandoned" class="<%= on('/admin/abandoned') %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <span>Abandoned</span>
      </a>
      <a href="/admin/products" class="<%= on('/admin/products') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 7l8-4 8 4v10l-8 4-8-4z"/><path d="M4 7l8 4 8-4M12 11v10"/></svg>
        <span class="nav-label">Products</span>
      </a>
      <%/* Everything that leaves this site for an external sales channel.
           Sits under Commerce rather than System because it publishes the
           catalogue, and because a feed that has silently stopped syncing
           is a commercial problem before it is a configuration one. */%>
      <a href="/admin/distribution" class="<%= on('/admin/distribution') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M6 15.5V8a2 2 0 012-2h7.5M8.2 17.2h7.3"/></svg>
        <span class="nav-label">Distribution</span>
      </a>
      <%/* The rotation's ledger. Lives beside Distribution because it is
           the same kind of question — where the catalogue went and what it
           was worth — and because burying it in Settings is what made it
           unreadable in the first place. */%>
      <a href="/admin/partner-log" class="<%= on('/admin/partner-log') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 5h16M4 12h16M4 19h10"/><circle cx="19" cy="19" r="2.2"/></svg>
        <span class="nav-label">Order log</span>
      </a>
      <a href="/admin/pages" class="<%= on('/admin/pages') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3h9l3 3v15a1 1 0 01-1 1H6a1 1 0 01-1-1V4a1 1 0 011-1z"/><path d="M14 3v4h4M8 12h8M8 16h5"/></svg>
        <span class="nav-label">Pages</span>
      </a>
    </div>

    <div class="sb-group">
      <div class="gl">Growth</div>
      <a href="/admin/leads" class="<%= on('/admin/leads') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 11l16-6-4 15-4-6-8-3z"/></svg>
        <span class="nav-label">Leads &amp; Marketing</span>
      </a>
      <%/* The store's side of Google Ads, per country — ad-attributed
           revenue and orders next to a spend box, so ROAS can be read
           without leaving the admin. Sits under Growth because it is a
           planning tool, not a report of what already happened. */%>
      <a href="/admin/analytics/ads" class="<%= on('/admin/analytics/ads') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 019 9h-9z"/><path d="M12 7v5l3 3"/></svg>
        <span class="nav-label">Ads Planner</span>
      </a>
    </div>

    <div class="sb-group">
      <div class="gl">System</div>
      <a href="/admin/settings" class="<%= on('/admin/settings') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/></svg>
        <span class="nav-label">Settings</span>
      </a>
      <a href="/" class="nav-item" target="_blank">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 2.5 15 0 18M12 3c-2.5 2.5-2.5 15 0 18"/></svg>
        <span class="nav-label">View Site</span>
      </a>
    </div>
  </nav>

  <a href="/admin/logout" class="sb-user">
    <span class="av"></span>
    <span class="sb-user__meta">
      <span class="un">GoGetCards Admin</span>
      <span class="ur">OWNER · SIGN OUT</span>
    </span>
    <svg class="sb-user__out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 4h3a1 1 0 011 1v14a1 1 0 01-1 1h-3M10 8l-4 4 4 4M6 12h11"/></svg>
  </a>
</aside>
