<%/* The admin shell: the navy top bar and the white navigation column.
     Included first inside <body class="admin-body"> by every admin page;
     the page's own <main class="admin-main"> follows it.

     Locals (all optional): `currentPath` marks the active item;
     `unreadChatCount` / `unreadMessageCount` put a count on the item. */%>
<%
  var _path = typeof currentPath !== 'undefined' ? currentPath : '/admin';
  var _on = function (p) { return _path === p ? 'nav-item on' : 'nav-item'; };
  var _chats = (typeof unreadChatCount !== 'undefined' && unreadChatCount > 0) ? unreadChatCount : 0;
  var _msgs = (typeof unreadMessageCount !== 'undefined' && unreadMessageCount > 0) ? unreadMessageCount : 0;
%>
<header class="admin-topbar">
  <button type="button" class="admin-topbar__menu" id="adminNavToggle" aria-label="Open navigation" aria-controls="adminNav" aria-expanded="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  </button>
  <a href="/admin" class="admin-brand">
    <span class="admin-brand__mark"><%- include('../partials/logomark', { size: 26 }) %></span>
    <span class="admin-brand__name">GoGetCards</span>
    <span class="admin-brand__tag">Admin</span>
  </a>
  <span class="admin-topbar__spacer"></span>
  <span class="admin-topbar__env">Live</span>
  <a href="/" class="admin-topbar__link" target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9M19 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V6a1 1 0 011-1h5"/></svg>
    <span>View store</span>
  </a>
  <a href="/admin/logout" class="admin-topbar__user" title="Sign out">
    <span>Sign out</span>
    <span class="admin-topbar__avatar" aria-hidden="true">GG</span>
  </a>
</header>

<div class="admin-nav-scrim" id="adminNavScrim"></div>
<nav class="admin-nav" id="adminNav" aria-label="Admin">
  <div class="admin-nav__group">
    <div class="admin-nav__label">Overview</div>
    <a href="/admin" class="<%= _on('/admin') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="5" rx="1.5"/><rect x="13" y="10" width="8" height="11" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/></svg>
      <span class="nav-label">Dashboard</span>
    </a>
    <a href="/admin/analytics" class="<%= _on('/admin/analytics') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 5-7"/></svg>
      <span class="nav-label">Analytics</span>
    </a>
  </div>

  <div class="admin-nav__group">
    <div class="admin-nav__label">Sales</div>
    <a href="/admin/orders" class="<%= _on('/admin/orders') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16l-1.5 12a2 2 0 01-2 1.7H7.5a2 2 0 01-2-1.7L4 4H2"/></svg>
      <span class="nav-label">Orders</span>
    </a>
    <%/* The rotation's ledger: where each order went and what it was
         worth. Beside Orders because it is the same question. */%>
    <a href="/admin/partner-log" class="<%= _on('/admin/partner-log') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 5h16M4 12h16M4 19h10"/><circle cx="19" cy="19" r="2.2"/></svg>
      <span class="nav-label">Order log</span>
    </a>
    <a href="/admin/preorders" class="<%= _on('/admin/preorders') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
      <span class="nav-label">Preorders</span>
    </a>
    <a href="/admin/abandoned" class="<%= _on('/admin/abandoned') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/></svg>
      <span class="nav-label">Abandoned checkouts</span>
    </a>
    <a href="/admin/customers" class="<%= _on('/admin/customers') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      <span class="nav-label">Customers</span>
    </a>
  </div>

  <div class="admin-nav__group">
    <div class="admin-nav__label">Catalogue</div>
    <a href="/admin/products" class="<%= _on('/admin/products') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M4 7l8-4 8 4v10l-8 4-8-4z"/><path d="M4 7l8 4 8-4M12 11v10"/></svg>
      <span class="nav-label">Products</span>
    </a>
    <%/* Everything that leaves this site for an external sales channel.
         A feed that has silently stopped syncing is a commercial problem
         before it is a configuration one, so it sits with the catalogue. */%>
    <a href="/admin/distribution" class="<%= _on('/admin/distribution') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M6 15.5V8a2 2 0 012-2h7.5M8.2 17.2h7.3"/></svg>
      <span class="nav-label">Distribution</span>
    </a>
    <a href="/admin/pages" class="<%= _on('/admin/pages') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M6 3h9l3 3v15a1 1 0 01-1 1H6a1 1 0 01-1-1V4a1 1 0 011-1z"/><path d="M14 3v4h4M8 12h8M8 16h5"/></svg>
      <span class="nav-label">Pages</span>
    </a>
  </div>

  <div class="admin-nav__group">
    <div class="admin-nav__label">Inbox</div>
    <a href="/admin/chats" class="<%= _on('/admin/chats') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M5 5h14a1 1 0 011 1v9a1 1 0 01-1 1H9l-4 4V6a1 1 0 011-1z"/></svg>
      <span class="nav-label">Live chat</span>
      <% if (_chats) { %><span class="badge-n"><%= _chats %></span><% } %>
    </a>
    <%/* Contact-form messages. Without somewhere to read them, the
         public form would be a silent black hole, which is exactly what a
         Merchant Center reviewer finds by sending a test enquiry. */%>
    <a href="/admin/messages" class="<%= _on('/admin/messages') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
      <span class="nav-label">Messages</span>
      <% if (_msgs) { %><span class="badge-n"><%= _msgs %></span><% } %>
    </a>
    <%/* Transactional email. A confirmation that never arrived is a
         commercial problem before it is a technical one, and this page is
         where you find out the shop has been unable to send anything. */%>
    <a href="/admin/emails" class="<%= _on('/admin/emails') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16v12H4z"/><path d="M4 8.5l8 5 8-5"/><path d="M4 18l6-6M20 18l-6-6"/></svg>
      <span class="nav-label">Email</span>
    </a>
  </div>

  <div class="admin-nav__group">
    <div class="admin-nav__label">Growth</div>
    <a href="/admin/leads" class="<%= _on('/admin/leads') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M3 11l16-6-4 15-4-6-8-3z"/></svg>
      <span class="nav-label">Leads &amp; marketing</span>
    </a>
    <%/* The store's side of Google Ads, per country: ad-attributed
         revenue beside a spend box, so ROAS reads without leaving the
         admin. A planning tool, not a report of what already happened. */%>
    <a href="/admin/analytics/ads" class="<%= _on('/admin/analytics/ads') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
      <span class="nav-label">Ads planner</span>
    </a>
  </div>

  <div class="admin-nav__group">
    <div class="admin-nav__label">System</div>
    <a href="/admin/settings" class="<%= _on('/admin/settings') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/></svg>
      <span class="nav-label">Settings</span>
    </a>
  </div>

</nav>

<script>
  /* Mobile navigation toggle. Static behaviour, no data involved. */
  (function () {
    var body = document.body, btn = document.getElementById('adminNavToggle'), scrim = document.getElementById('adminNavScrim');
    if (!btn) return;
    function set(open) { body.classList.toggle('nav-open', open); btn.setAttribute('aria-expanded', open ? 'true' : 'false'); }
    btn.addEventListener('click', function () { set(!body.classList.contains('nav-open')); });
    if (scrim) scrim.addEventListener('click', function () { set(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
  })();
</script>
