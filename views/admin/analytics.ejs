<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'><rect width='512' height='512' rx='96' fill='%230F2A4A'/><rect x='190' y='104' width='196' height='272' rx='22' fill='none' stroke='%23ffffff' stroke-width='30' transform='rotate(14 288 240)'/><rect x='126' y='136' width='196' height='272' rx='22' fill='%23ffffff'/></svg>">
  <meta name="theme-color" content="#0c0c12">
  <meta name="robots" content="noindex, nofollow">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Analytics | GoGetCards Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css?v=<%= assetVersion %>">
  <style>
    /* Dense on purpose. This page is read, not glanced at. */
    .an-bar { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
    .an-bar select, .an-bar input[type="date"] { background: var(--admin-surface); color: var(--admin-text);
      border: 1px solid var(--admin-border); border-radius: 6px; padding: 0.4rem 0.7rem; font: inherit; font-size: 0.82rem; }
    .an-bar__spacer { margin-left: auto; }
    .an-dl { font-size: 0.72rem; color: var(--admin-faint); text-decoration: none; border: 1px solid var(--admin-border);
      border-radius: 6px; padding: 0.35rem 0.7rem; }
    .an-dl:hover { color: var(--admin-text); border-color: var(--admin-accent); }

    .an-note { background: rgba(251,191,36,0.06); border: 1px solid rgba(251,191,36,0.3); color: #FCD34D;
      border-radius: 10px; padding: 0.8rem 1.1rem; font-size: 0.8rem; line-height: 1.55; margin-bottom: 1.25rem; }

    .an-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(165px, 1fr)); gap: 0.75rem; margin-bottom: 2rem; }
    .an-card { background: var(--admin-card); border: 1px solid var(--admin-border); border-radius: 10px; padding: 0.9rem 1rem; }
    .an-card .k { font-family: var(--admin-font-mono); font-size: 0.58rem; letter-spacing: 0.09em; text-transform: uppercase; color: var(--admin-faint); }
    .an-card .v { font-size: 1.35rem; font-weight: 700; margin-top: 0.3rem; font-variant-numeric: tabular-nums; }
    .an-card .d { font-size: 0.68rem; margin-top: 0.2rem; font-variant-numeric: tabular-nums; }
    .up { color: #4ADE80; } .down { color: #F87171; } .flat { color: var(--admin-faint); }

    .an-sec { background: var(--admin-card); border: 1px solid var(--admin-border); border-radius: 12px;
      padding: 1.2rem 1.4rem; margin-bottom: 1.5rem; }
    .an-sec > h2 { font-size: 0.95rem; font-weight: 700; margin: 0 0 0.3rem; }
    .an-sec > .sub { font-size: 0.76rem; color: var(--admin-faint); margin: 0 0 1rem; line-height: 1.55; max-width: 78ch; }

    /* Funnel: the bar length is the share of the top of the funnel, so the
       collapse between stages is visible without reading the numbers. */
    .fn-row { display: grid; grid-template-columns: 150px 1fr 210px; gap: 0.8rem; align-items: center; padding: 0.45rem 0; }
    .fn-name { font-size: 0.8rem; }
    .fn-track { background: rgba(255,255,255,0.05); border-radius: 4px; height: 22px; overflow: hidden; }
    .fn-fill { height: 100%; background: linear-gradient(90deg, var(--admin-primary), var(--admin-bordeaux)); }
    .fn-meta { font-size: 0.72rem; color: var(--admin-muted); text-align: right; font-variant-numeric: tabular-nums; }
    .fn-drop { color: #F87171; }

    .an-table { width: 100%; border-collapse: collapse; font-size: 0.78rem; }
    .an-table th { text-align: left; font-family: var(--admin-font-mono); font-size: 0.58rem; letter-spacing: 0.09em;
      text-transform: uppercase; color: var(--admin-faint); font-weight: 500; padding: 0.55rem 0.5rem;
      border-bottom: 1px solid var(--admin-border); white-space: nowrap; }
    .an-table td { padding: 0.55rem 0.5rem; border-bottom: 1px solid rgba(255,255,255,0.04); }
    .an-table td.n { text-align: right; font-variant-numeric: tabular-nums; font-family: var(--admin-font-mono); }
    .an-table td.rev { color: var(--admin-accent); font-weight: 700; }
    .an-table tr:hover td { background: rgba(255,255,255,0.02); }
    .an-table tfoot td { border-top: 1px solid var(--admin-border); border-bottom: 0; padding-top: 0.7rem; }
    .an-slug { display: block; font-size: 0.66rem; color: var(--admin-faint); font-family: var(--admin-font-mono); }
    .an-why { background: rgba(255,255,255,0.02); border: 1px solid var(--admin-border);
      border-radius: 8px; padding: 0.7rem 1rem; margin-top: 1rem; font-size: 0.78rem; }
    .an-why summary { cursor: pointer; color: var(--admin-primary-soft); font-weight: 600; }
    .an-why p { color: var(--admin-muted); line-height: 1.6; margin: 0.7rem 0 0; max-width: 82ch; }
    .an-empty { padding: 1.5rem 0.5rem; text-align: center; color: var(--admin-faint); font-size: 0.8rem; }
    .an-two { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    @media (max-width: 900px) { .an-two { grid-template-columns: 1fr; } .fn-row { grid-template-columns: 110px 1fr; } .fn-meta { grid-column: 1 / -1; text-align: left; } }

    /* A bar drawn in the cell, so a table reads as a chart without one. */
    .mini { position: relative; }
    .mini::before { content: ''; position: absolute; inset: 0 auto 0 0; width: var(--w, 0%);
      background: rgba(124,58,237,0.16); border-radius: 3px; }
    .mini > span { position: relative; }
  </style>
</head>
<body class="admin-body">
  <%- include('_sidebar', { currentPath: '/admin/analytics' }) %>

  <main class="admin-main">
    <%
      const money = (c) => '$' + (Number(c || 0) / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const num = (n) => Number(n || 0).toLocaleString('en-US');
      const pc = (n) => (n === null || n === undefined) ? '—' : Number(n).toFixed(1) + '%';
      const dl = (d) => {
        if (d === null || d === undefined) return '<span class="d flat">no prior data</span>';
        const cls = d > 0.05 ? 'up' : d < -0.05 ? 'down' : 'flat';
        const sign = d > 0 ? '↑ +' : d < 0 ? '↓ ' : '';
        return `<span class="d ${cls}">${sign}${d.toFixed(1)}% vs previous</span>`;
      };
      const qs = new URLSearchParams(Object.entries(query || {}).filter(([k]) => k !== 'range')).toString();
    %>

    <header class="admin-header">
      <div>
        <h1 class="admin-header__title">Analytics</h1>
        <p class="admin-header__sub">
          <%= win.startDate.toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) %>
          &rarr;
          <%= new Date(win.endDate.getTime() - 1).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) %>
          &middot; compared with the previous equal period
        </p>
      </div>
    </header>

    <form method="GET" action="/admin/analytics" class="an-bar">
      <select name="range" onchange="this.form.submit()">
        <% ranges.forEach(function (r) { %>
          <option value="<%= r.key %>" <%= range === r.key ? 'selected' : '' %>><%= r.label %></option>
        <% }); %>
      </select>
      <% if (range === 'custom') { %>
        <input type="date" name="start" value="<%= query.start || '' %>">
        <input type="date" name="end" value="<%= query.end || '' %>">
        <button type="submit" class="admin-btn admin-btn--sm">Apply</button>
      <% } %>
      <select name="bucket" onchange="this.form.submit()">
        <% ['hour','day','week','month'].forEach(function (b) { %>
          <option value="<%= b %>" <%= bucket === b ? 'selected' : '' %>><%= b.charAt(0).toUpperCase() + b.slice(1) %>ly</option>
        <% }); %>
      </select>
      <span class="an-bar__spacer"></span>
      <% ['products','countries','sources','campaigns','checkouts-by-product','checkouts-by-country','channel-grid','timeseries'].forEach(function (w) { %>
        <a class="an-dl" href="/admin/analytics/export/<%= w %>.csv?<%= qs %>&range=<%= range %>&bucket=<%= bucket %>">
          <%= w %>.csv
        </a>
      <% }); %>
    </form>

    <%/* Two limits the numbers cannot express on their own. Stated where
         they apply rather than in documentation nobody opens. */%>
    <% if (win.partialEvents) { %>
      <div class="an-note">
        <strong>This window reaches past the event retention of <%= win.retentionDays %> days.</strong>
        Orders and revenue are complete for the whole range, but visitors, product views and every
        funnel stage only exist for the most recent <%= win.retentionDays %> days — so the rates
        below understate conversion for the earlier part of this window.
      </div>
    <% } %>

    <%/* ── Overview ── */%>
    <section class="an-cards">
      <div class="an-card"><div class="k">Visitors</div><div class="v"><%= num(overview.visitors) %></div><%- dl(deltas.visitors) %></div>
      <div class="an-card"><div class="k">Page views</div><div class="v"><%= num(overview.totalPageViews) %></div></div>
      <div class="an-card"><div class="k">Product views</div><div class="v"><%= num(overview.productViews) %></div></div>
      <div class="an-card"><div class="k">Unique viewers</div><div class="v"><%= num(overview.uniqueProductViewers) %></div></div>
      <div class="an-card"><div class="k">Checkouts started</div><div class="v"><%= num(overview.started) %></div><%- dl(deltas.started) %></div>
      <div class="an-card"><div class="k">Reached step 1</div><div class="v"><%= num(overview.step1) %></div></div>
      <div class="an-card"><div class="k">Reached step 2</div><div class="v"><%= num(overview.step2) %></div></div>
      <div class="an-card"><div class="k">Orders</div><div class="v"><%= num(overview.orders) %></div><%- dl(deltas.orders) %></div>
      <div class="an-card"><div class="k">Revenue</div><div class="v" style="color:var(--admin-accent)"><%= money(overview.revenue) %></div><%- dl(deltas.revenue) %></div>
      <div class="an-card"><div class="k">Avg order value</div><div class="v"><%= money(overview.aov) %></div><%- dl(deltas.aov) %></div>
      <div class="an-card"><div class="k">Conversion rate</div><div class="v"><%= pc(overview.conversionRate) %></div><%- dl(deltas.conversionRate) %></div>
      <div class="an-card"><div class="k">Checkout conv.</div><div class="v"><%= pc(overview.checkoutConversionRate) %></div></div>
      <div class="an-card"><div class="k">Abandonment</div><div class="v"><%= pc(overview.checkoutAbandonmentRate) %></div></div>
      <div class="an-card"><div class="k">View &rarr; checkout</div><div class="v"><%= pc(overview.productToCheckoutRate) %></div></div>
      <div class="an-card"><div class="k">Revenue / visitor</div><div class="v"><%= money(overview.revenuePerVisitor) %></div></div>
      <div class="an-card"><div class="k">Units sold</div><div class="v"><%= num(overview.units) %></div></div>
    </section>

    <%/* ── Funnel ── */%>
    <section class="an-sec">
      <h2>Checkout funnel</h2>
      <p class="sub">
        Each stage counted by distinct session or distinct checkout, never by raw events — one person
        clicking Buy three times is one checkout. <strong>% of prev</strong> is the one that identifies
        a broken step; <strong>% of visitors</strong> is the business number.
      </p>
      <% funnel.forEach(function (s) { %>
        <div class="fn-row">
          <div class="fn-name"><%= s.label %></div>
          <div class="fn-track"><div class="fn-fill" style="width:<%= Math.max(0.5, s.ofTotal).toFixed(2) %>%"></div></div>
          <div class="fn-meta">
            <strong><%= num(s.users) %></strong> &middot; <%= pc(s.ofTotal) %> of visitors
            <% if (s.fromPrev !== null) { %>
              &middot; <%= pc(s.fromPrev) %> of prev
              &middot; <span class="fn-drop">&minus;<%= num(s.dropCount) %></span>
            <% } %>
          </div>
        </div>
      <% }); %>
      <%/* The gap that looks wrong until you know where each event is
           raised. Stated on the page because it is asked every time. */%>
      <details class="an-why">
        <summary>Why is "Checkout started" so much larger than "Step 1"?</summary>
        <p>
          They are recorded in different places, and only one of them can fail.
          <strong>Checkout started</strong> is written by this server the moment the Buy
          request arrives &mdash; nothing can stop it. <strong>Step 1</strong> is a beacon
          fired by the checkout page in the customer's browser after it loads on the
          payment host.
        </p>
        <p>
          So the gap is everyone who asked to check out and never got a working page: the
          hop to the payment host failed, the tab was closed mid-redirect, the page loaded
          but its JavaScript did not, or an ad blocker or privacy extension ate the beacon.
          That last one means <em>some of this gap is measurement, not lost customers</em> &mdash;
          they arrived and we never heard about it.
        </p>
        <p>
          <strong>The one number in that gap that is definitely real</strong> is the
          server-side token failure below: the payment host itself refused the handoff.
          Those are genuinely lost, and they are the ones worth chasing.
        </p>
      </details>
      <% if (funnel.length && (funnel[0].tokenFailed || funnel[0].paymentFailed)) { %>
        <p class="sub" style="margin-top:1rem">
          Of those, <strong><%= num(funnel[0].tokenFailed) %></strong> never reached the checkout page at all
          (server-side token failure — a technical loss, not a customer decision), and
          <strong><%= num(funnel[0].paymentFailed) %></strong> had the payment form fail to load.
        </p>
      <% } %>
    </section>

    <%/* ── Products ── */%>
    <section class="an-sec">
      <h2>Product performance</h2>
      <p class="sub">Ranked by revenue. A high view count beside a low order count is the signal worth acting on.</p>
      <div class="admin-table-wrap">
        <table class="an-table">
          <thead><tr>
            <th>Product</th><th style="text-align:right">Views</th><th style="text-align:right">Viewers</th>
            <th style="text-align:right">Checkouts</th><th style="text-align:right">Step 2</th>
            <th style="text-align:right">Orders</th><th style="text-align:right">Units</th>
            <th style="text-align:right">Revenue</th><th style="text-align:right">View&rarr;CO</th>
            <th style="text-align:right">CO&rarr;Buy</th><th style="text-align:right">Refunds</th>
          </tr></thead>
          <tbody>
            <% if (!products.length) { %>
              <tr><td colspan="11" class="an-empty">No product activity in this range.</td></tr>
            <% } %>
            <% const maxViews = Math.max(1, ...products.map(p => p.views)); %>
            <% products.slice(0, 40).forEach(function (p) { %>
              <tr>
                <td><%= p.name || p.slug %><% if (p.name) { %><span class="an-slug"><%= p.slug %></span><% } %></td>
                <td class="n mini" style="--w:<%= (p.views / maxViews * 100).toFixed(1) %>%"><span><%= num(p.views) %></span></td>
                <td class="n"><%= num(p.viewers) %></td>
                <td class="n"><%= num(p.checkouts) %></td>
                <td class="n"><%= num(p.step2) %></td>
                <td class="n"><%= num(p.orders) %></td>
                <td class="n"><%= num(p.units) %></td>
                <td class="n rev"><%= money(p.revenue) %></td>
                <td class="n"><%= pc(p.viewToCheckout) %></td>
                <td class="n"><%= pc(p.checkoutToPurchase) %></td>
                <td class="n"><%= p.refunds ? num(p.refunds) + ' / ' + money(p.refundAmount) : '—' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </section>

    <%/* ── Checkout starts by product and country ── */%>
    <div class="an-two">
      <section class="an-sec">
        <h2>Checkouts started, by product</h2>
        <p class="sub">
          What people actually try to buy, and how far each one gets. The product is
          recorded on the server at the moment of the Buy click; the later stages inherit it
          by sharing that checkout's id.
        </p>
        <div class="admin-table-wrap">
          <table class="an-table">
            <thead><tr><th>Product</th><th style="text-align:right">Started</th><th style="text-align:right">Step 1</th><th style="text-align:right">Step 2</th><th style="text-align:right">&rarr;1</th><th style="text-align:right">&rarr;2</th><th style="text-align:right">Refused</th></tr></thead>
            <tbody>
              <% if (!coProduct.length) { %><tr><td colspan="7" class="an-empty">No checkouts started in this range.</td></tr><% } %>
              <% coProduct.slice(0, 30).forEach(function (r) { %>
                <tr>
                  <td>
                    <% if (r.slug) { %><%= r.name || r.slug %><% if (r.name) { %><span class="an-slug"><%= r.slug %></span><% } %>
                    <% } else { %><em>Not recorded</em><span class="an-slug">started before the product was captured</span><% } %>
                  </td>
                  <td class="n"><%= num(r.starts) %></td>
                  <td class="n"><%= num(r.step1) %></td>
                  <td class="n"><%= num(r.step2) %></td>
                  <td class="n"><%= pc(r.step1Rate) %></td>
                  <td class="n"><%= pc(r.step2Rate) %></td>
                  <td class="n"><%= r.tokenFailed ? num(r.tokenFailed) : '—' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="an-sec">
        <h2>Checkouts started, by country</h2>
        <p class="sub">
          Geolocated at the Buy click, so it follows the same checkout through every stage
          rather than being re-derived per beacon. <strong>Refused</strong> is the payment
          host rejecting the handoff &mdash; a technical loss, not a decision.
        </p>
        <div class="admin-table-wrap">
          <table class="an-table">
            <thead><tr><th>Country</th><th style="text-align:right">Started</th><th style="text-align:right">Step 1</th><th style="text-align:right">Step 2</th><th style="text-align:right">&rarr;1</th><th style="text-align:right">&rarr;2</th><th style="text-align:right">Refused</th></tr></thead>
            <tbody>
              <% if (!coCountry.length) { %><tr><td colspan="7" class="an-empty">No checkouts started in this range.</td></tr><% } %>
              <% coCountry.slice(0, 30).forEach(function (r) { %>
                <tr>
                  <td><%= r.country || '<em>Not recorded</em>' %></td>
                  <td class="n"><%= num(r.starts) %></td>
                  <td class="n"><%= num(r.step1) %></td>
                  <td class="n"><%= num(r.step2) %></td>
                  <td class="n"><%= pc(r.step1Rate) %></td>
                  <td class="n"><%= pc(r.step2Rate) %></td>
                  <td class="n"><%= r.tokenFailed ? num(r.tokenFailed) : '—' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <div class="an-two">
      <%/* ── Countries ── */%>
      <section class="an-sec">
        <h2>Countries</h2>
        <p class="sub">Traffic is matched on the visitor's country code; orders on the country on the order.</p>
        <div class="admin-table-wrap">
          <table class="an-table">
            <thead><tr><th>Country</th><th style="text-align:right">Visitors</th><th style="text-align:right">Checkouts</th><th style="text-align:right">Orders</th><th style="text-align:right">Revenue</th><th style="text-align:right">Conv.</th></tr></thead>
            <tbody>
              <% if (!countries.length) { %><tr><td colspan="6" class="an-empty">No country data in this range.</td></tr><% } %>
              <% countries.slice(0, 25).forEach(function (c) { %>
                <tr>
                  <td><%= c.key %></td>
                  <td class="n"><%= num(c.visitors) %></td>
                  <td class="n"><%= num(c.starts) %></td>
                  <td class="n"><%= num(c.orders) %></td>
                  <td class="n rev"><%= money(c.revenue) %></td>
                  <td class="n"><%= pc(c.conversionRate) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>

      <%/* ── Sources ── */%>
      <section class="an-sec">
        <h2>Traffic sources</h2>
        <p class="sub">Which channel sends people, and which one actually makes money.</p>
        <div class="admin-table-wrap">
          <table class="an-table">
            <thead><tr><th>Source</th><th style="text-align:right">Visitors</th><th style="text-align:right">Checkouts</th><th style="text-align:right">Orders</th><th style="text-align:right">Revenue</th><th style="text-align:right">Rev/visitor</th></tr></thead>
            <tbody>
              <% if (!sources.length) { %><tr><td colspan="6" class="an-empty">No source data in this range.</td></tr><% } %>
              <% sources.slice(0, 25).forEach(function (s) { %>
                <tr>
                  <td><%= s.key %></td>
                  <td class="n"><%= num(s.visitors) %></td>
                  <td class="n"><%= num(s.starts) %></td>
                  <td class="n"><%= num(s.orders) %></td>
                  <td class="n rev"><%= money(s.revenue) %></td>
                  <td class="n"><%= money(s.revenuePerVisitor) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <div class="an-two">
      <%/* ── Devices ── */%>
      <section class="an-sec">
        <h2>Devices</h2>
        <p class="sub">
          Classified from the User-Agent already stored on every event, so the whole history is
          covered. Orders carry no user agent, so this reports reach and drop-off by device rather
          than revenue it cannot attribute.
        </p>
        <div class="admin-table-wrap">
          <table class="an-table">
            <thead><tr><th>Device</th><th style="text-align:right">Visitors</th><th style="text-align:right">Checkouts</th><th style="text-align:right">Step 2</th><th style="text-align:right">Drop after start</th></tr></thead>
            <tbody>
              <% if (!devices.rows.length) { %><tr><td colspan="5" class="an-empty">No device data in this range.</td></tr><% } %>
              <% devices.rows.forEach(function (d) { %>
                <tr>
                  <td><%= d.key %></td>
                  <td class="n"><%= num(d.visitors) %></td>
                  <td class="n"><%= num(d.starts) %></td>
                  <td class="n"><%= num(d.step2) %></td>
                  <td class="n"><%= pc(d.dropAfterStart) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>

      <%/* ── Browser / OS ── */%>
      <section class="an-sec">
        <h2>Browser &amp; OS</h2>
        <p class="sub">Visitors by browser family and operating system.</p>
        <div class="an-two" style="gap:1rem">
          <table class="an-table">
            <thead><tr><th>Browser</th><th style="text-align:right">Visitors</th></tr></thead>
            <tbody>
              <% technical.browsers.slice(0, 8).forEach(function (b) { %>
                <tr><td><%= b.key %></td><td class="n"><%= num(b.visitors) %></td></tr>
              <% }); %>
            </tbody>
          </table>
          <table class="an-table">
            <thead><tr><th>OS</th><th style="text-align:right">Visitors</th></tr></thead>
            <tbody>
              <% technical.oses.slice(0, 8).forEach(function (o) { %>
                <tr><td><%= o.key %></td><td class="n"><%= num(o.visitors) %></td></tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <%/* ── Campaigns ── */%>
    <section class="an-sec">
      <h2>Campaigns (UTM)</h2>
      <% if (!campaigns.length) { %>
        <p class="sub">
          <strong>Nothing yet, and that is expected.</strong> Campaign tags were not recorded before
          this feature shipped, and nothing backfills them. Rows appear here once tagged traffic
          arrives — add <code>?utm_source=…&amp;utm_medium=…&amp;utm_campaign=…</code> to your ad links.
        </p>
      <% } else { %>
        <p class="sub">Tags exactly as they arrived. Traffic Sources above stays the authority on channel — a
          mistagged campaign shows here as mistagged rather than rewriting the channel.</p>
        <div class="admin-table-wrap">
          <table class="an-table">
            <thead><tr><th>Source</th><th>Medium</th><th>Campaign</th><th style="text-align:right">Visitors</th></tr></thead>
            <tbody>
              <% campaigns.slice(0, 30).forEach(function (c) { %>
                <tr><td><%= c.source %></td><td><%= c.medium || '—' %></td><td><%= c.campaign || '—' %></td><td class="n"><%= num(c.visitors) %></td></tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <%/* ── Source x product ── */%>
    <section class="an-sec">
      <h2>Which channel sells which product</h2>
      <p class="sub">
        Orders per product, split by the channel that acquired the buyer. One row per
        product so a product's whole channel mix reads across a single line &mdash; the
        pair-per-row version said the same thing in ten times the space.
        Channels are the top <%= sourceProduct.columns.filter(c => c !== 'Other').length %> by revenue;
        anything smaller is summed into <strong>Other</strong>, so the row totals still reconcile.
      </p>
      <div class="admin-table-wrap">
        <table class="an-table">
          <thead>
            <tr>
              <th>Product</th>
              <% sourceProduct.columns.forEach(function (c) { %>
                <th style="text-align:right"><%= c %></th>
              <% }); %>
              <th style="text-align:right">Total</th>
              <th style="text-align:right">Revenue</th>
            </tr>
          </thead>
          <tbody>
            <% if (!sourceProduct.rows.length) { %>
              <tr><td colspan="<%= sourceProduct.columns.length + 3 %>" class="an-empty">No orders in this range.</td></tr>
            <% } %>
            <% sourceProduct.rows.slice(0, 30).forEach(function (r) { %>
              <tr>
                <td><%= r.name || r.slug %><% if (r.name) { %><span class="an-slug"><%= r.slug %></span><% } %></td>
                <% sourceProduct.columns.forEach(function (c) {
                     const cell = r.cells[c];
                     /* A channel that sold none of THIS product is a dash, not a
                        zero: a grid of zeroes is unreadable, and the eye needs the
                        cells that carry a number to stand out. */ %>
                  <td class="n" <% if (cell) { %>title="<%= money(cell.revenue) %>"<% } %>>
                    <%= cell ? num(cell.orders) : '·' %>
                  </td>
                <% }); %>
                <td class="n"><strong><%= num(r.orders) %></strong></td>
                <td class="n rev"><%= money(r.revenue) %></td>
              </tr>
            <% }); %>
          </tbody>
          <% if (sourceProduct.rows.length) { %>
            <tfoot>
              <tr>
                <td><strong>All products</strong></td>
                <% sourceProduct.columns.forEach(function (c) { %>
                  <td class="n"><strong><%= sourceProduct.totals[c] ? num(sourceProduct.totals[c]) : '·' %></strong></td>
                <% }); %>
                <td class="n"><strong><%= num(sourceProduct.grandOrders) %></strong></td>
                <td class="n rev"><%= money(sourceProduct.grandRevenue) %></td>
              </tr>
            </tfoot>
          <% } %>
        </table>
      </div>
    </section>

    <div class="an-two">
      <%/* ── Abandonment ── */%>
      <section class="an-sec">
        <h2>Abandoned checkouts</h2>
        <p class="sub">From the recovery collection, by the state each sequence ended in.</p>
        <table class="an-table">
          <thead><tr><th>Status</th><th style="text-align:right">Count</th><th style="text-align:right">Value</th></tr></thead>
          <tbody>
            <% if (!abandonment.length) { %><tr><td colspan="3" class="an-empty">Nothing recorded in this range.</td></tr><% } %>
            <% abandonment.forEach(function (a) { %>
              <tr><td><%= a.status %></td><td class="n"><%= num(a.count) %></td><td class="n"><%= money(a.value) %></td></tr>
            <% }); %>
          </tbody>
        </table>
      </section>

      <%/* ── Customers ── */%>
      <section class="an-sec">
        <h2>Customers</h2>
        <p class="sub">Grouped by email within this window. A "repeat" customer is one with more than one order <em>in this range</em>.</p>
        <div class="an-cards" style="grid-template-columns:repeat(2,1fr);margin-bottom:1rem">
          <div class="an-card"><div class="k">Customers</div><div class="v"><%= num(customers.customers) %></div></div>
          <div class="an-card"><div class="k">Repeat rate</div><div class="v"><%= pc(customers.repeatRate) %></div></div>
          <div class="an-card"><div class="k">Avg orders each</div><div class="v"><%= customers.avgOrdersPerCustomer.toFixed(2) %></div></div>
          <div class="an-card"><div class="k">Avg value</div><div class="v"><%= money(customers.avgCustomerValue) %></div></div>
        </div>
      </section>
    </div>

    <%/* ── Over time ── */%>
    <section class="an-sec">
      <h2>Over time</h2>
      <p class="sub">Bucketed <%= bucket %>ly, in <%= win.retentionDays %>-day event retention.</p>
      <div class="admin-table-wrap">
        <table class="an-table">
          <thead><tr><th>Period</th><th style="text-align:right">Visitors</th><th style="text-align:right">Checkouts</th><th style="text-align:right">Orders</th><th style="text-align:right">Revenue</th></tr></thead>
          <tbody>
            <% if (!series.length) { %><tr><td colspan="5" class="an-empty">No activity in this range.</td></tr><% } %>
            <% const maxV = Math.max(1, ...series.map(s => s.visitors)); %>
            <% series.slice(-60).forEach(function (s) { %>
              <tr>
                <td><%= s.bucket %></td>
                <td class="n mini" style="--w:<%= (s.visitors / maxV * 100).toFixed(1) %>%"><span><%= num(s.visitors) %></span></td>
                <td class="n"><%= num(s.starts) %></td>
                <td class="n"><%= num(s.orders) %></td>
                <td class="n rev"><%= money(s.revenue) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</body>
</html>
