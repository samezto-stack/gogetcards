<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { title: 'Messages' }) %>
  <style>
    /* One card per message: who, what, the replies so far, and the box. */
    .msg { background: var(--admin-card); border: 1px solid var(--admin-border); border-radius: var(--admin-r); margin-bottom: 12px; }
    .msg--new { border-left: 3px solid var(--admin-primary); }
    .msg__head { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; align-items: baseline; padding: 14px 18px 0; }
    .msg__who { font-weight: 600; font-size: 14px; }
    .msg__mail { margin-left: 8px; font-size: 13px; }
    .msg__meta { display: flex; gap: 10px; align-items: center; font-size: 12px; color: var(--admin-faint); }
    .msg__body { padding: 10px 18px 16px; }
    .msg__text { font-size: 13.5px; line-height: 1.7; white-space: pre-wrap; }
    .msg__order { font-size: 12.5px; color: var(--admin-muted); margin: 4px 0 0; }
    .msg__reply { margin-top: 12px; padding: 10px 14px; border-left: 2px solid var(--admin-ok-line); background: var(--admin-ok-tint); border-radius: 0 var(--admin-r-sm) var(--admin-r-sm) 0; }
    .msg__reply-when { font-size: 11.5px; color: var(--admin-muted); margin-bottom: 4px; }
    .msg__reply p { font-size: 13px; line-height: 1.65; white-space: pre-wrap; margin: 0; }
    .msg__form { border-top: 1px solid var(--admin-border); padding: 14px 18px; background: var(--admin-panel-2); border-radius: 0 0 var(--admin-r) var(--admin-r); }
    .msg__form label { display: block; font-size: 12.5px; font-weight: 600; margin-bottom: 6px; }
    .msg__form textarea { width: 100%; min-height: 72px; }
    .msg__acts { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-top: 10px; }
  </style>
</head>
<body class="admin-body">
  <%- include('_sidebar', { currentPath: '/admin/messages', unreadMessageCount: newCount }) %>

  <main class="admin-main">
    <header class="admin-header">
      <div>
        <h1 class="admin-header__title">Messages</h1>
        <p class="admin-header__sub"><%= newCount %> unread of <%= messages.length %></p>
      </div>
    </header>

    <div class="admin-content admin-content--narrow">
      <%/* Everything sent through the public contact form lands here. The
           form promises a reply within the window stated in
           config/company.js, so an unanswered message is a broken promise
           on a page a Merchant Center reviewer reads. */%>

      <% if (typeof sent !== 'undefined' && sent) { %>
        <div class="admin-alert admin-alert--success">
          <span>Reply sent to <strong><%= sent %></strong>. It is in <a href="/admin/emails">the email log</a> with its delivery status.</span>
        </div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="admin-alert admin-alert--error"><%= error %></div>
      <% } %>

      <% if (!messages.length) { %>
        <div class="admin-empty">
          <p>No messages yet.</p>
          <p>Anything sent through <a href="/contact" target="_blank" rel="noopener">the contact form</a> appears here.</p>
        </div>
      <% } else { %>
        <% messages.forEach(function (m) { %>
          <article id="m-<%= m._id %>" class="msg <%= m.status === 'new' ? 'msg--new' : '' %>">
            <div class="msg__head">
              <div>
                <span class="msg__who"><%= m.name %></span>
                <a class="msg__mail" href="mailto:<%= m.email %>?subject=<%= encodeURIComponent('Re: your message to GoGetCards') %>"><%= m.email %></a>
              </div>
              <div class="msg__meta">
                <span class="admin-tag"><%= m.topic %></span>
                <% if (m.status === 'new') { %><span class="admin-tag admin-tag--navy">New</span><% } %>
                <% if (m.status === 'answered') { %><span class="admin-tag admin-tag--ok">Answered</span><% } %>
                <time datetime="<%= new Date(m.createdAt).toISOString() %>"><%= new Date(m.createdAt).toLocaleString('en-US') %></time>
              </div>
            </div>

            <div class="msg__body">
              <% if (m.orderNumber) { %>
                <p class="msg__order">Order <span class="admin-code"><%= m.orderNumber %></span></p>
              <% } %>

              <%/* white-space:pre-wrap, and escaped output. The message is
                   untrusted text typed by a stranger; rendering it as HTML
                   would put a stored-XSS hole straight into the admin. */%>
              <p class="msg__text"><%= m.message %></p>

              <%/* Replies already sent, oldest first. Shown before the box
                   because the point of them is to be read BEFORE writing the
                   next one. Escaped and pre-wrap, same as the customer's own
                   text. */%>
              <% (m.replies || []).forEach(function (r) { %>
                <div class="msg__reply">
                  <div class="msg__reply-when">You replied &middot; <%= new Date(r.sentAt).toLocaleString('en-US') %></div>
                  <p><%= r.body %></p>
                </div>
              <% }); %>
            </div>

            <%/* The reply box. Sends through services/mail, logs in
                 /admin/emails, records itself above and marks the message
                 answered — but only if the send actually succeeded. */%>
            <div class="msg__form">
              <form method="POST" action="/admin/messages/<%= m._id %>/reply">
                <label for="reply-<%= m._id %>"><%= (m.replies || []).length ? 'Reply again' : 'Reply' %> to <%= m.email %></label>
                <textarea id="reply-<%= m._id %>" name="reply" rows="3" maxlength="5000" required class="admin-input"
                  placeholder="Write your answer. It is sent from <%= supportEmail %> and quotes their original message underneath."></textarea>
                <div class="msg__acts">
                  <button class="admin-btn admin-btn--primary admin-btn--sm">Send reply</button>
                  <span class="tiny faint">Sending marks this answered.</span>
                </div>
              </form>
              <div class="msg__acts">
                <% if (m.status !== 'answered') { %>
                  <form method="POST" action="/admin/messages/<%= m._id %>/status">
                    <input type="hidden" name="status" value="answered">
                    <button class="admin-btn admin-btn--sm">Mark answered</button>
                  </form>
                <% } %>
                <% if (m.status === 'new') { %>
                  <form method="POST" action="/admin/messages/<%= m._id %>/status">
                    <input type="hidden" name="status" value="read">
                    <button class="admin-btn admin-btn--sm admin-btn--ghost">Mark read</button>
                  </form>
                <% } %>
              </div>
            </div>
          </article>
        <% }); %>
      <% } %>
    </div>
  </main>
</body>
</html>
