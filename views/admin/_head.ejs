<%/* Shared <head> for every admin page.

     Locals: `title` — the page's own name; the suffix is added here.
     A page that needs its own <style> or a script puts it after this
     include, inside its <head>. Nothing in here is user data. */%>
<%
  var _title = (typeof title !== 'undefined' && title) ? title : 'Admin';
  var _fonts = 'https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap';
%>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#0F2A4A">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'><rect width='512' height='512' rx='96' fill='%230F2A4A'/><rect x='190' y='104' width='196' height='272' rx='22' fill='none' stroke='%23ffffff' stroke-width='30' transform='rotate(14 288 240)'/><rect x='126' y='136' width='196' height='272' rx='22' fill='%23ffffff'/></svg>">
<title><%= _title %> · GoGetCards Admin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="<%= _fonts %>">
<link rel="stylesheet" href="/css/admin.css?v=<%= assetVersion %>">
