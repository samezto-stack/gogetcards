<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { title: 'Leads & marketing' }) %>
  <style>
    .capi { display: flex; gap: 10px; align-items: flex-end; flex-wrap: wrap; }
    .capi .form-group { flex: 0 1 220px; }
    .capi__status { font-size: 12.5px; color: var(--admin-muted); margin-top: 10px; }
  </style>
</head>
<body class="admin-body">
  <%- include('_sidebar', { currentPath: '/admin/leads' }) %>

  <main class="admin-main">
    <header class="admin-header">
      <div>
        <h1 class="admin-header__title">Leads &amp; marketing</h1>
        <p class="admin-header__sub">Email addresses captured by the newsletter box and the abandoned-cart prompt.</p>
      </div>
      <div class="admin-header__actions">
        <button class="admin-btn" onclick="copyAllEmails()">Copy all emails</button>
      </div>
    </header>

    <div class="admin-content">
      <div class="admin-stats-grid">
        <div class="admin-stat-card">
          <div class="admin-stat-card__num"><%= leads.filter(l => l.source === 'cart_abandonment').length %></div>
          <div class="admin-stat-card__label">Abandoned carts</div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-card__num"><%= leads.filter(l => l.source === 'newsletter').length %></div>
          <div class="admin-stat-card__label">Newsletter sign-ups</div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-card__num"><%= leads.length %></div>
          <div class="admin-stat-card__label">Total leads</div>
        </div>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Email address</th>
              <th>Source</th>
              <th>Captured</th>
            </tr>
          </thead>
          <tbody>
            <% if (leads.length === 0) { %>
              <tr><td colspan="3" class="admin-table__empty">No leads captured yet.</td></tr>
            <% } else { %>
              <% leads.forEach(lead => { %>
                <tr>
                  <td class="mono"><%= lead.email %></td>
                  <td>
                    <% if (lead.source === 'cart_abandonment') { %>
                      <span class="admin-tag admin-tag--warn">Abandoned cart</span>
                    <% } else { %>
                      <span class="admin-tag admin-tag--ok">Newsletter</span>
                    <% } %>
                  </td>
                  <td class="muted"><%= new Date(lead.createdAt).toLocaleString() %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

      <%/* Moved off the Dashboard. It is a marketing tool, not a metric,
           and it sat in the busiest spot on the busiest page where a
           mis-click fires a real Purchase event at Meta. It belongs with
           the other marketing controls, below the data it does not touch. */%>
      <div class="admin-panel">
        <div class="admin-panel__head">
          <div>
            <h2 class="admin-panel__title">Manual purchase event (Meta CAPI)</h2>
            <p class="admin-panel__sub">Sends one server-side Purchase event to Meta. Use it for a sale that happened off-site. Nothing here is recorded in the shop.</p>
          </div>
        </div>
        <div class="admin-panel__body">
          <div class="capi">
            <div class="form-group">
              <label for="manualCapiValue">Order value</label>
              <input type="number" id="manualCapiValue" placeholder="139.99" class="admin-input">
            </div>
            <div class="form-group">
              <label for="manualCapiEmail">Customer email</label>
              <input type="email" id="manualCapiEmail" placeholder="name@example.com" class="admin-input">
            </div>
            <div class="form-group">
              <label for="manualCapiDate">Date (optional, up to 7 days ago)</label>
              <input type="datetime-local" id="manualCapiDate" class="admin-input">
            </div>
            <button onclick="fireManualCAPI()" class="admin-btn admin-btn--primary">Fire purchase event</button>
          </div>
          <div id="manualCapiStatus" class="capi__status">Server-side only. The event carries the value, the email hash and the time.</div>
        </div>
      </div>
    </div>
  </main>

  <script>
    // ── Manual CAPI Trigger ──
    window.fireManualCAPI = async function fireManualCAPI() {
      const valueInput = document.getElementById('manualCapiValue');
      const emailInput = document.getElementById('manualCapiEmail');
      const dateInput = document.getElementById('manualCapiDate');
      const statusSpan = document.getElementById('manualCapiStatus');

      const value = valueInput.value.trim();
      const email = emailInput.value.trim();
      const dateVal = dateInput ? dateInput.value : '';
      const idle = 'Server-side only. The event carries the value, the email hash and the time.';

      if (!value) {
        statusSpan.style.color = 'var(--admin-crit)';
        statusSpan.textContent = 'Enter an order value first.';
        return;
      }

      statusSpan.style.color = 'var(--admin-warn)';
      statusSpan.textContent = 'Sending the event to Meta…';

      try {
        const res = await fetch('/admin/api/manual-capi', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ value, email, date: dateVal })
        });

        const data = await res.json();
        if (data.success) {
          statusSpan.style.color = 'var(--admin-ok)';
          statusSpan.textContent = 'Sent. A purchase event for $' + value + ' went to Meta CAPI.';
          valueInput.value = '';
          emailInput.value = '';

          setTimeout(() => {
            statusSpan.style.color = 'var(--admin-muted)';
            statusSpan.textContent = idle;
          }, 5000);
        } else {
          statusSpan.style.color = 'var(--admin-crit)';
          statusSpan.textContent = 'Error: ' + data.error;
        }
      } catch (e) {
        statusSpan.style.color = 'var(--admin-crit)';
        statusSpan.textContent = 'Network error. Nothing was sent.';
      }
    };

    function copyAllEmails() {
      const emails = <%- jsonForScript(leads.map(l => l.email)) %>;
      navigator.clipboard.writeText(emails.join(', ')).then(() => {
        alert('Copied ' + emails.length + ' emails to clipboard.');
      });
    }
  </script>
</body>
</html>
