<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { title: pageTitle }) %>
  <style>
    /* Customer detail. Each order is one table row followed by its own
       tools row, so the fulfilment and refund forms stay beside the order
       they act on without the table turning into a stack of cards. */
    .cu-scroll { overflow-x: auto; }
    .admin-table tbody tr.cu-tools, .admin-table tbody tr.cu-tools:hover { background: var(--admin-panel-2); }
    .cu-tools td { padding: 12px 14px 14px; }
    .cu-tools form { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .cu-tools form + form { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--admin-border); }
    .cu-tools__label { font-size: 12px; font-weight: 600; color: var(--admin-muted); min-width: 72px; }
    .cu-w-sm { width: 150px; } .cu-w-md { width: 180px; } .cu-w-lg { width: 220px; }
    .cu-line { flex-basis: 100%; }
    .cu-ua { max-width: 280px; }
  </style>
</head>
<body class="admin-body">
  <%- include('_sidebar', { currentPath: '/admin/customers' }) %>

  <main class="admin-main">
    <%
      /* Server-side helper from routes/admin.js — one prefix map, not a
         copy per template. A EUR order used to read "$69.99 EUR". */
      const money = (c, cur) => locals.money(c, cur);
      const day = (d) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
      const stamp = (d) => d ? day(d) + ', ' + new Date(d).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) : '—';
      const name = [customer.firstName, customer.lastName].filter(Boolean).join(' ');
      const a = customer.address || {};
      const addr = [a.line1, a.line2, [a.city, a.region, a.postalCode].filter(Boolean).join(', '), a.country].filter(Boolean);
      const savedMsg = {
        status: 'Account status updated.',
        sessions: 'Every session for this customer was ended.',
        fulfilment: 'Fulfilment updated. The customer sees this in their account immediately.',
        refund: 'Refund status updated.',
      };
      const failedMsg = {
        real_orders: 'Nothing was deleted. This account has orders that did not come from the test-purchase flow, and this button will not delete a real sale.',
      };
      const tone = { good: 'ok', accent: 'ok', warn: 'warn', neutral: 'neutral' };
    %>

    <header class="admin-header">
      <div>
        <h1 class="admin-header__title">
          <%= name || (customer.displayEmail || customer.email) %>
          <% if (customer.status === 'closed') { %><span class="admin-tag admin-tag--crit">Closed</span><% } %>
        </h1>
        <p class="admin-header__sub">Customer since <%= day(customer.createdAt) %> &middot; <span class="mono"><%= customer.displayEmail || customer.email %></span></p>
      </div>
      <div class="admin-header__actions">
        <a class="admin-btn admin-btn--ghost" href="/admin/customers">All customers</a>
      </div>
    </header>

    <div class="admin-content">
      <% if (saved && savedMsg[saved]) { %>
        <div class="admin-alert admin-alert--success"><%= savedMsg[saved] %></div>
      <% } %>
      <% if (failed && failedMsg[failed]) { %>
        <div class="admin-alert admin-alert--error"><%= failedMsg[failed] %></div>
      <% } %>

      <% if (customer.status === 'closed') { %>
        <div class="admin-alert admin-alert--error">
          This account is closed. Sign-in links are refused and every session has been ended.
        </div>
      <% } %>

      <div class="admin-stats-grid">
        <div class="admin-stat-card">
          <div class="admin-stat-card__num"><%= counts.all %></div>
          <div class="admin-stat-card__label">Orders</div>
        </div>
        <div class="admin-stat-card admin-stat-card--accent">
          <div class="admin-stat-card__num"><%= money(totalSpend) %></div>
          <div class="admin-stat-card__label">Lifetime value</div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-card__num"><%= counts.preorders %></div>
          <div class="admin-stat-card__label">Active preorders</div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-card__num"><%= sessions.length %></div>
          <div class="admin-stat-card__label">Live sessions</div>
        </div>
      </div>

      <%/* ── Identity ────────────────────────────────────────────── */%>
      <section class="admin-panel">
        <div class="admin-panel__head"><h2 class="admin-panel__title">Profile</h2></div>
        <div class="admin-panel__body">
          <div class="admin-kv">
            <div>
              <div class="admin-kv__k">Email</div>
              <div class="admin-kv__v mono"><%= customer.displayEmail || customer.email %></div>
            </div>
            <div>
              <div class="admin-kv__k">Phone</div>
              <div class="admin-kv__v"><%= customer.phone || '—' %></div>
            </div>
            <div>
              <div class="admin-kv__k">Default address</div>
              <div class="admin-kv__v">
                <% if (addr.length) { addr.forEach(function (l) { %><%= l %><br><% }); } else { %>—<% } %>
              </div>
            </div>
            <div>
              <div class="admin-kv__k">Account</div>
              <div class="admin-kv__v">
                Created <%= day(customer.createdAt) %> via <%= customer.createdVia || 'purchase' %><br>
                Marketing: <%= customer.marketingOptIn ? 'opted in' : 'not opted in' %>
              </div>
            </div>
          </div>
        </div>
      </section>

      <%/* ── Orders ──────────────────────────────────────────────── */%>
      <section class="admin-panel">
        <div class="admin-panel__head">
          <h2 class="admin-panel__title">Orders <span class="admin-header__count"><%= orders.length %></span></h2>
        </div>

        <% if (!orders.length) { %>
          <div class="admin-panel__body">
            <div class="admin-empty admin-empty--inset"><p>No orders on this account.</p></div>
          </div>
        <% } else { %>
          <div class="admin-panel__body admin-panel__body--flush">
            <div class="cu-scroll">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Reference</th>
                    <th>Status</th>
                    <th>Items</th>
                    <th>Placed</th>
                    <th class="num">Total</th>
                  </tr>
                </thead>
                <tbody>
                  <% orders.forEach(function (d) { const o = d.order; %>
                    <tr>
                      <td class="mono nowrap"><%= d.reference %></td>
                      <td>
                        <span class="status-pill status-pill--<%= tone[d.status.tone] || 'neutral' %>">
                          <span class="status-pill__dot"></span><%= d.status.label %>
                        </span>
                      </td>
                      <td>
                        <%= (d.product && d.product.title) || (o.products || [])[0] || 'Order' %>
                        <% if (d.moreItems) { %> and <%= d.moreItems %> more<% } else if ((Number(o.quantity) || 1) > 1) { %> &times;<%= o.quantity %><% } %>
                        <% if (d.isPreorder) { %>
                          <span class="admin-cell-sub">Preorder<% if (d.release && d.release.hasDate) { %>, releases <%= d.release.display %><% } %></span>
                        <% } %>
                      </td>
                      <td class="nowrap">
                        <%= stamp(o.purchaseDate || o.createdAt) %>
                        <span class="admin-cell-sub">
                          <%= o.source || o.paymentProvider || 'direct' %>
                          <% if (o.cancelledAt) { %> &middot; Cancelled <%= day(o.cancelledAt) %> by <%= o.cancelledBy || 'unknown' %><% } %>
                          <% if (o.cancellationReason) { %> &middot; &ldquo;<%= o.cancellationReason %>&rdquo;<% } %>
                        </span>
                      </td>
                      <td class="num mono"><%= money(o.totalPrice, o.currency) %></td>
                    </tr>
                    <tr class="cu-tools">
                      <td colspan="5">
                        <%/* ── Fulfilment ─────────────────────────────────────
                             The customer's account reads these fields directly, so
                             what is typed here is what they see within seconds. */%>
                        <form method="POST" action="/admin/customers/<%= customer._id %>/orders/<%= o._id %>/fulfilment">
                          <span class="cu-tools__label">Fulfilment</span>
                          <select name="fulfillmentStatus" class="admin-select">
                            <% ['unfulfilled', 'preparing', 'shipped', 'delivered'].forEach(function (s) { %>
                              <option value="<%= s %>" <%= o.fulfillmentStatus === s ? 'selected' : '' %>><%= s %></option>
                            <% }); %>
                          </select>
                          <input class="admin-input cu-w-sm" name="trackingCarrier" value="<%= o.trackingCarrier || '' %>" placeholder="Carrier">
                          <input class="admin-input cu-w-md" name="trackingNumber" value="<%= o.trackingNumber || '' %>" placeholder="Tracking number">
                          <input class="admin-input cu-w-lg" name="trackingUrl" value="<%= o.trackingUrl || '' %>" placeholder="https://tracking-url">
                          <button class="admin-btn admin-btn--sm admin-btn--primary" type="submit">Save fulfilment</button>
                        </form>

                        <%/* ── Cancellation & refund ──────────────────────────
                             NOTHING HERE MOVES MONEY. "Mark refunded" records that a
                             refund already sent by hand in the payment provider has
                             been sent; the customer's account then says so. Pressing
                             it before actually refunding makes the portal lie. */%>
                        <form method="POST" action="/admin/customers/<%= customer._id %>/orders/<%= o._id %>/refund">
                          <span class="cu-tools__label">Refund</span>
                          <span class="small muted">
                            <strong><%= o.refundStatus %></strong>
                            <% if (o.refundAmount) { %> (<%= money(o.refundAmount, o.currency) %>)<% } %>
                          </span>
                          <%/* The customer has been asked whether they want the order
                               back, and the email promised the refund goes out AFTER
                               the deadline. Marking it refunded before then breaks
                               that promise. See docs/release-day.md. */%>
                          <% if (o.cancelledAt && o.refundStatus === 'processing' && o.reinstateDeadline && new Date(o.reinstateDeadline) > new Date()) { %>
                            <span class="cu-line small warn">
                              Keep-or-refund offer open until
                              <%= new Date(o.reinstateDeadline).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'America/Los_Angeles' }) %>
                              &mdash; do not issue this refund before then.
                            </span>
                          <% } %>
                          <% if (o.reinstatedAt && !o.cancelledAt) { %>
                            <span class="cu-line small ok">Reinstated by the customer on <%= day(o.reinstatedAt) %> &mdash; no refund owed.</span>
                          <% } %>
                          <% if (!o.cancelledAt) { %>
                            <button class="admin-btn admin-btn--sm admin-btn--danger" name="action" value="cancel" type="submit"
                                    onclick="return confirm('Cancel this order and queue a refund? This does not contact the payment provider.')">Cancel &amp; owe refund</button>
                          <% } %>
                          <% if (o.refundStatus === 'none') { %>
                            <button class="admin-btn admin-btn--sm" name="action" value="processing" type="submit">Mark refund owed</button>
                          <% } %>
                          <% if (o.refundStatus !== 'refunded') { %>
                            <button class="admin-btn admin-btn--sm" name="action" value="refunded" type="submit"
                                    onclick="return confirm('Only press this AFTER issuing the refund in the payment provider. The customer will be told their money has been sent.')">Mark refunded</button>
                          <% } else { %>
                            <span class="small faint">Refunded <%= day(o.refundedAt) %></span>
                          <% } %>
                          <% if (o.refundStatus !== 'none') { %>
                            <button class="admin-btn admin-btn--sm" name="action" value="clear" type="submit">Clear refund flag</button>
                          <% } %>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        <% } %>
      </section>

      <%/* ── Sessions ────────────────────────────────────────────── */%>
      <section class="admin-panel">
        <div class="admin-panel__head">
          <h2 class="admin-panel__title">Sessions <span class="admin-header__count"><%= sessions.length %></span></h2>
        </div>
        <% if (!sessions.length) { %>
          <div class="admin-panel__body">
            <div class="admin-empty admin-empty--inset"><p>No live sessions.</p></div>
          </div>
        <% } else { %>
          <div class="admin-panel__body admin-panel__body--flush">
            <div class="cu-scroll">
              <table class="admin-table">
                <thead><tr><th>Device</th><th>Network</th><th>Started via</th><th>Last used</th><th>Expires</th></tr></thead>
                <tbody>
                  <% sessions.forEach(function (s) { %>
                    <tr>
                      <td class="truncate small cu-ua" title="<%= s.userAgent || '' %>"><%= s.userAgent || '—' %></td>
                      <td class="mono"><%= s.ipPrefix || '—' %></td>
                      <td><%= s.origin || '—' %></td>
                      <td class="nowrap"><%= stamp(s.lastUsedAt || s.createdAt) %></td>
                      <td class="nowrap"><%= day(s.expiresAt) %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        <% } %>
        <div class="admin-panel__foot">
          <form method="POST" action="/admin/customers/<%= customer._id %>/sessions/revoke">
            <button class="admin-btn admin-btn--sm admin-btn--danger" type="submit"
                    onclick="return confirm('Sign this customer out of every device?')">Sign out everywhere</button>
          </form>
        </div>
      </section>

      <%/* ── Account state ───────────────────────────────────────── */%>
      <section class="admin-panel">
        <div class="admin-panel__head">
          <h2 class="admin-panel__title">Account status</h2>
          <span class="status-pill status-pill--<%= customer.status === 'closed' ? 'err' : 'ok' %>">
            <span class="status-pill__dot"></span><%= customer.status === 'closed' ? 'Closed' : 'Active' %>
          </span>
        </div>
        <div class="admin-panel__body stack">
          <p class="small muted">
            Closing an account refuses new sign-in links and ends every live session. Order records are
            kept &mdash; we are required to hold them for tax and consumer-protection reasons, and the
            customer's orders remain visible here. This is reversible.
          </p>
          <form method="POST" action="/admin/customers/<%= customer._id %>/status">
            <input type="hidden" name="status" value="<%= customer.status === 'closed' ? 'active' : 'closed' %>">
            <button class="admin-btn admin-btn--sm <%= customer.status === 'closed' ? '' : 'admin-btn--danger' %>" type="submit"
                    onclick="return confirm('<%= customer.status === 'closed' ? 'Reopen this account?' : 'Close this account and end every session?' %>')">
              <%= customer.status === 'closed' ? 'Reopen account' : 'Close account' %>
            </button>
          </form>
        </div>
      </section>

      <%/* ── Permanent deletion ──────────────────────────────────────
           Kept apart from Close, and last on the page, because the two
           are not degrees of the same thing: one is reversible and one
           is not. Which buttons appear is decided by what the orders
           ARE, not by a checkbox — the destructive variant is only
           rendered when every order on the account came from the
           test-purchase flow, and the route re-checks that against the
           database before deleting anything. */%>
      <section class="admin-panel admin-panel--crit">
        <div class="admin-panel__head"><h2 class="admin-panel__title">Delete permanently</h2></div>
        <div class="admin-panel__body stack">

          <% if (testOnly) { %>
            <p class="small muted">
              <% if (testOrderCount) { %>
                Every order on this account (<%= testOrderCount %>) came from the test-purchase flow, so
                the whole thing can go: the account, its sessions, its sign-in links and those orders.
              <% } else { %>
                This account has no orders, so there is nothing to keep.
              <% } %>
              This cannot be undone.
            </p>
            <div class="admin-btn-row">
              <% if (testOrderCount) { %>
                <form method="POST" action="/admin/customers/<%= customer._id %>/delete">
                  <input type="hidden" name="orders" value="test">
                  <button class="admin-btn admin-btn--sm admin-btn--danger" type="submit"
                          onclick="return confirm('Permanently delete this account AND its <%= testOrderCount %> test order(s)? This cannot be undone.')">
                    Delete account and <%= testOrderCount %> test order<%= testOrderCount === 1 ? '' : 's' %>
                  </button>
                </form>
              <% } %>
              <form method="POST" action="/admin/customers/<%= customer._id %>/delete">
                <input type="hidden" name="orders" value="keep">
                <button class="admin-btn admin-btn--sm" type="submit"
                        onclick="return confirm('Permanently delete this account? Orders are kept.')">
                  Delete account only
                </button>
              </form>
            </div>

          <% } else { %>
            <p class="small muted">
              This account has <strong><%= realOrderCount %></strong> real
              order<%= realOrderCount === 1 ? '' : 's' %>, so its orders cannot be deleted from here.
              Deleting the account itself removes the profile, its sessions and its sign-in links, and
              leaves every order intact.
            </p>
            <p class="tiny faint">
              Orders are matched to an account by email address, so if this customer signs in again with
              the same address the account is rebuilt around the orders that are still here. To stop them
              signing in, close the account above instead.
            </p>
            <form method="POST" action="/admin/customers/<%= customer._id %>/delete">
              <input type="hidden" name="orders" value="keep">
              <button class="admin-btn admin-btn--sm admin-btn--danger" type="submit"
                      onclick="return confirm('Permanently delete this account? Their <%= realOrderCount %> order(s) are kept.')">
                Delete account only
              </button>
            </form>
          <% } %>
        </div>
      </section>
    </div>
  </main>
</body>
</html>
