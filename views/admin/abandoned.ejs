<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { title: pageTitle }) %>
  <style>
    .ab-list { min-width: 1120px; }
    .ab-list td:nth-child(4) { min-width: 260px; }
    /* Metric notes sit under the figure as a sentence, which the shared
       delta line (bold, short) is not built for. */
    .ab-metric__note { font-size: 12px; line-height: 1.45; color: var(--admin-faint); margin-top: 4px; }

    .ab-nodata { color: var(--admin-faint); font-style: italic; }

    /* ── Sending cap ── */
    .ab-cap__form { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .ab-cap__form label { font-size: 13px; font-weight: 600; }

    /* ── Row actions ──
       Out of the way until the row is pointed at: delete is the one
       irreversible control on the page and it should not compete with the
       data for attention. Hidden with opacity, NOT display:none, so it
       stays in the tab order — a keyboard user gets it on focus, which is
       the whole reason not to reach for a hover-only rule. */
    .ab-actions { width: 1%; white-space: nowrap; text-align: right; }
    .ab-del { width: 28px; padding: 0; opacity: 0; transition: opacity 0.12s, color 0.12s, background 0.12s, border-color 0.12s; }
    .admin-table tbody tr:hover .ab-del,
    .ab-del:focus-visible { opacity: 1; }
    /* Touch devices have no hover state, so it would otherwise be both
       invisible and unreachable on a phone. */
    @media (hover: none) { .ab-del { opacity: 0.55; } }

    /* The convert control. Deliberately understated and gated behind typing
       a payment id — it creates an order and mails a customer, so it should
       not be a thing the hand reaches for while scrolling. */
    .ab-convert { display: inline-flex; gap: 6px; align-items: center; margin-right: 8px; vertical-align: middle; }
    .ab-convert input {
      width: 150px; height: 28px; padding: 0 8px; font-size: 12px;
      font-family: var(--admin-font-mono);
      background: var(--admin-card); color: var(--admin-text);
      border: 1px solid var(--admin-border-2); border-radius: var(--admin-r-sm); outline: none;
      transition: border-color 0.12s, box-shadow 0.12s;
    }
    .ab-convert input:focus { border-color: var(--admin-primary-soft); box-shadow: var(--admin-focus); }

    .ab-pager { margin-top: 16px; }
  </style>
</head>
<body class="admin-body">
  <%- include('_sidebar', { currentPath: '/admin/abandoned' }) %>

  <main class="admin-main">
    <header class="admin-header">
      <div>
        <h1 class="admin-header__title"><%= pageTitle %> <span class="admin-header__count"><%= stats.total %></span></h1>
        <p class="admin-header__sub">Checkouts that reached the partner and did not come back, and what the reminders recovered.</p>
      </div>
    </header>

    <%
      /* .admin-main has no padding of its own — every other admin page puts
         its body inside .admin-content, which supplies it. This page did
         not, so everything on it sat flush against the sidebar and the top
         bar with no breathing room anywhere. */
    %>
    <div class="admin-content">

    <%
      /* Every figure on this page belongs to a market. Printing them all
         with a dollar sign showed a £179.97 UK checkout as "$179.97" — the
         right number wearing the wrong currency, on the screen used to
         decide whether a recovery is worth chasing. The prefixes mirror
         config/markets.js CURRENCIES; a template cannot require it. */
      const MONEY_PREFIX = { USD: 'US$', CAD: 'CA$', GBP: '£', EUR: '€' };
      const money = (c, cur) => {
        const code = String(cur || 'USD').toUpperCase();
        return (MONEY_PREFIX[code] || code + ' ')
          + (Number(c || 0) / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      };
      const pct = (r) => r === null ? null : (r * 100).toFixed(1) + '%';
      const when = (d) => d ? new Date(d).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) : '—';
      /* Status to tag tone. Purchased is paid, but not by the sequence —
         deliberately not the success colour: reading the list, these are
         not wins the emails can claim. */
      const pillTone = {
        active: 'admin-tag--info', abandoned: 'admin-tag--warn', recovered: 'admin-tag--ok',
        purchased: '', expired: '', cancelled: '', suppressed: 'admin-tag--crit',
      };
    %>

    <%/* ── Sending cap ────────────────────────────────────────────────
         The cap is the highest step allowed out. Steps above it are HELD,
         not skipped: the row waits with its due time intact and continues
         when the cap goes back up, its remaining wait preserved. See
         services/abandonedCheckout/pause.js. */%>
    <%/* A held sequence must not look like a running one: the panel
         takes the warn tint while any step is held. */%>
    <section class="admin-panel ab-cap <%= pauseState.restricted ? 'admin-panel--warn ab-cap--on' : '' %>">
      <div class="admin-panel__head ab-cap__head">
        <div>
          <h2 class="admin-panel__title ab-cap__title">Sending cap</h2>
          <p class="admin-panel__sub ab-cap__sub">
            Holds the later reminders without cancelling them. A held sequence keeps its
            place &mdash; when the cap goes back up, each one continues from where it
            stopped with its remaining wait intact, rather than all firing at once.
            <% if (pauseState.restricted && pauseState.cappedAt) { %>
              <br><strong>Held since <%= when(pauseState.cappedAt) %><%= pauseState.cappedBy ? ' by ' + pauseState.cappedBy : '' %>.</strong>
            <% } %>
          </p>
        </div>
        <span class="status-pill status-pill--<%= pauseState.restricted ? 'warn' : 'ok' %> ab-cap__state">
          <span class="status-pill__dot"></span>
          <% if (pauseState.paused) { %>
            All reminders held
          <% } else if (pauseState.restricted) { %>
            Steps 1&ndash;<%= pauseState.maxStep %> sending &middot; <%= pauseState.maxStep + 1 %>&ndash;<%= pauseState.fullMaxStep %> held
          <% } else { %>
            Full sequence running
          <% } %>
        </span>
      </div>

      <div class="admin-panel__body">
        <% if (typeof query !== 'undefined' && query.cap === 'down') { %>
          <div class="admin-alert admin-alert--success ab-flash ab-flash--ok">
            <span><strong>Cap set to step <%= query.step %>.</strong>
            <%= query.held %> sequence<%= query.held === '1' ? '' : 's' %> now holding. Nothing was cancelled.</span>
          </div>
        <% } %>
        <% if (typeof query !== 'undefined' && query.cap === 'up') { %>
          <div class="admin-alert admin-alert--success ab-flash ab-flash--ok">
            <span><strong>Cap raised to step <%= query.step %>.</strong>
            <%= query.shifted %> sequence<%= query.shifted === '1' ? '' : 's' %> moved forward by
            <%= query.hours %> h so each resumes where it stopped instead of firing at once.</span>
          </div>
        <% } %>
        <% if (typeof query !== 'undefined' && query.failed === 'cap') { %>
          <div class="admin-alert admin-alert--error ab-flash ab-flash--err"><span><strong>Could not change the cap.</strong> Nothing was altered.</span></div>
        <% } %>

        <form method="POST" action="/admin/abandoned/cap" class="ab-cap__form">
          <label for="ab-cap-step">Highest reminder allowed to send</label>
          <select name="maxStep" id="ab-cap-step" class="admin-select">
            <option value="0" <%= pauseState.maxStep === 0 ? 'selected' : '' %>>0 &mdash; hold everything</option>
            <% schedule.forEach(function (s) { %>
              <option value="<%= s.step %>" <%= pauseState.maxStep === s.step ? 'selected' : '' %>>
                <%= s.step %> &mdash; up to the <%= s.afterMinutes < 60 ? s.afterMinutes + ' min' : (s.afterMinutes / 60) + ' h' %> reminder<%= s.step === maxStep ? ' (full sequence)' : '' %>
              </option>
            <% }); %>
          </select>
          <button type="submit" class="admin-btn admin-btn--primary ab-cap__go">Apply</button>
        </form>
      </div>
    </section>

    <section class="admin-stats-grid ab-metrics">
      <div class="admin-stat-card ab-metric">
        <div class="admin-stat-card__num"><%= money(stats.abandonedValue) %></div>
        <div class="admin-stat-card__label">Abandoned value</div>
        <div class="ab-metric__note">Left behind and not recovered</div>
      </div>
      <%/* The headline figure: what the reminders actually brought back. */%>
      <div class="admin-stat-card admin-stat-card--accent ab-metric">
        <div class="admin-stat-card__num"><%= money(stats.recoveredValue) %></div>
        <div class="admin-stat-card__label">Recovered value</div>
        <div class="ab-metric__note"><%= stats.byStatus.recovered || 0 %> checkouts · came back via a reminder</div>
      </div>
      <%/* Kept beside it rather than folded into it. These customers paid
           without the sequence, and showing the two together is the only
           way the recovered figure means anything. */%>
      <div class="admin-stat-card ab-metric">
        <div class="admin-stat-card__num"><%= money(stats.purchasedValue) %></div>
        <div class="admin-stat-card__label">Paid without a reminder</div>
        <div class="ab-metric__note"><%= stats.byStatus.purchased || 0 %> checkouts · finished on their own</div>
      </div>
      <div class="admin-stat-card ab-metric">
        <div class="admin-stat-card__num"><%= stats.recoveryRate === null ? 'No data' : pct(stats.recoveryRate) %></div>
        <div class="admin-stat-card__label">Recovery rate</div>
        <div class="ab-metric__note">Of checkouts that were left behind</div>
      </div>
      <div class="admin-stat-card ab-metric">
        <div class="admin-stat-card__num"><%= stats.clickRate === null ? 'No data' : pct(stats.clickRate) %></div>
        <div class="admin-stat-card__label">Reminder click-through</div>
        <div class="ab-metric__note"><%= stats.emailsClicked %> of the checkouts emailed had their link used</div>
      </div>
      <div class="admin-stat-card ab-metric">
        <div class="admin-stat-card__num"><%= stats.emailsSent.toLocaleString('en-US') %></div>
        <div class="admin-stat-card__label">Reminders sent</div>
        <div class="ab-metric__note">Across <%= stats.total.toLocaleString('en-US') %> checkouts</div>
      </div>
      <div class="admin-stat-card ab-metric">
        <div class="admin-stat-card__num"><%= suppressedCount.toLocaleString('en-US') %></div>
        <div class="admin-stat-card__label">Unsubscribed</div>
        <div class="ab-metric__note">Addresses that will never be emailed</div>
      </div>
    </section>

    <section class="admin-section ab-section">
    <h2 class="admin-section__title">Recovery by sequence step</h2>
    <p class="admin-section__sub">
      A recovery is credited to the last reminder that actually went out before the customer
      paid. That is an attribution convention, not a measurement: somebody who came back after
      the third email may well have been prompted by the first. Steps with nothing sent yet show
      no data rather than 0%.
    </p>

    <div class="admin-table-wrap">
    <table class="admin-table ab-steps">
      <thead>
        <tr><th>Step</th><th>Sent after</th><th class="num">Emails sent</th><th class="num">Recovered</th><th class="num">Rate</th></tr>
      </thead>
      <tbody>
        <% stats.stepRates.forEach(function (s) { %>
          <tr>
            <td><strong><%= String(s.step).padStart(2, '0') %></strong></td>
            <td><%= s.label %></td>
            <td class="num"><%= s.sent %></td>
            <td class="num"><%= s.recovered %></td>
            <td class="num"><% if (s.rate === null) { %><span class="ab-nodata">no data</span><% } else { %><%= pct(s.rate) %><% } %></td>
          </tr>
        <% }); %>
        <tr>
          <td colspan="3" class="faint">Recovered before any reminder was sent</td>
          <td class="num"><%= stats.recoveredAfterStep[0] %></td>
          <td class="num">—</td>
        </tr>
      </tbody>
    </table>
    </div>

    <div class="admin-alert admin-alert--info">
      <span>
        Opens and clicks are not shown. They need delivery webhooks from the mail provider, which
        are not wired up &mdash; and an open rate guessed from send counts would be a made-up number in
        a place people make decisions. Recovery-link clicks below are counted directly, because
        those hit this server.
      </span>
    </div>
    </section>

    <section class="admin-section ab-section">
    <h2 class="admin-section__title">Checkouts</h2>
    <p class="admin-section__sub">
      Deleting a row removes its recovery bookkeeping and nothing else: the scheduler sweeps this
      collection alone, so a row that is gone can never be picked up by a later reminder. Use it
      to clear what a test checkout left behind. It does not touch the order behind a recovered
      row, and it cannot be undone.
    </p>

    <nav class="admin-tabs ab-tabs" aria-label="Checkout status">
      <a class="admin-tab ab-tab <%= status === 'all' ? 'is-on' : '' %>" href="/admin/abandoned?status=all">All <span class="admin-tab__n"><%= stats.total %></span></a>
      <% statuses.forEach(function (s) { %>
        <a class="admin-tab ab-tab <%= status === s ? 'is-on' : '' %>" href="/admin/abandoned?status=<%= s %>">
          <%= s.charAt(0).toUpperCase() + s.slice(1) %> <span class="admin-tab__n"><%= stats.byStatus[s] || 0 %></span>
        </a>
      <% }); %>
    </nav>

    <% if (typeof query !== 'undefined' && query.converted) { %>
      <div class="admin-alert admin-alert--success ab-flash ab-flash--ok">
        <span><strong>Order <%= query.converted %> created.</strong>
        <% if (query.convertedNew === '1') { %>
          The confirmation email has gone out, the customer can see it at /account, and this checkout is closed.
        <% } else { %>
          That order already existed, so nothing was re-sent.
        <% } %></span>
      </div>
    <% } %>
    <% if (typeof query !== 'undefined' && query.convertError) { %>
      <div class="admin-alert admin-alert--error ab-flash ab-flash--err"><span><strong>No order created.</strong> <%= query.convertError %></span></div>
    <% } %>

    <div class="admin-table-wrap">
      <table class="admin-table ab-list">
        <thead>
          <tr>
            <th>Customer</th><th>Source</th><th>Country</th><th>Product</th><th class="num">Total</th>
            <th>Status</th><th>Step</th><th>Last email</th><th>Next email</th><th>Last activity</th>
            <%/* The column header carries a name for screen readers without
                 printing one, since the column is visually just controls. */%>
            <th class="ab-actions"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% if (!rows.length) { %>
            <tr><td colspan="11" class="admin-table__empty">No checkouts with this status.</td></tr>
          <% } %>
          <% rows.forEach(function (r) { %>
            <tr>
              <td>
                <div class="admin-cell-title"><%= [r.firstName, r.lastName].filter(Boolean).join(' ') || '—' %></div>
                <span class="admin-cell-sub mono"><%= r.email %></span>
                <% if (r.recoveryLinkClicks) { %>
                  <span class="admin-cell-sub"><%= r.recoveryLinkClicks %> link click<%= r.recoveryLinkClicks === 1 ? '' : 's' %></span>
                <% } %>
              </td>
              <%/* Source and country, side by side and early in the row.

                   These are the two questions asked of every abandoned
                   checkout — where did they come from, and where are they —
                   and until now both required opening the record. Placed
                   before the product because a list is scanned left to
                   right, and a column nobody reaches is a column that does
                   not exist.

                   Source is blank on rows captured before it was recorded,
                   and on any checkout that reached the partner without a
                   click Event. An em dash rather than a guess. */%>
              <%/* Quieter than the status tag on purpose: status is the
                   thing being acted on, these are the things being scanned
                   for a pattern, and two loud tags per row would compete
                   with it. */%>
              <td>
                <% if (r.trafficSource) { %>
                  <span class="admin-tag admin-tag--mono ab-tag ab-tag-src"><%= r.trafficSource %></span>
                <% } else { %><span class="ab-nodata">—</span><% } %>
              </td>
              <td>
                <% if (r.country) { %>
                  <span class="admin-tag ab-tag"><%= String(r.country).toUpperCase() %></span>
                  <% if (r.shipping && r.shipping.city) { %><span class="admin-cell-sub"><%= r.shipping.city %></span><% } %>
                <% } else { %><span class="ab-nodata">—</span><% } %>
              </td>
              <td>
                <div><%= r.productName || r.productSlug || '—' %></div>
                <span class="admin-cell-sub">Qty <%= r.quantity || 1 %><%= r.partnerStore ? ' · ' + r.partnerStore : '' %></span>
              </td>
              <td class="num mono"><%= r.total ? money(Math.round(parseFloat(r.total) * 100), r.currency) : '—' %></td>
              <td>
                <span class="admin-tag <%= pillTone[r.status] || '' %> ab-pill"><%= r.status %></span>
                <% if (r.stoppedReason) { %><span class="admin-cell-sub"><%= r.stoppedReason %></span><% } %>
                <% if (r.orderId) { %><span class="admin-cell-sub">Order <%= r.orderId %></span><% } %>
              </td>
              <td class="num"><%= r.recoveryStep || 0 %> / <%= maxStep %></td>
              <td class="small faint"><%= when(r.lastEmailAt) %></td>
              <td class="small faint"><%= r.status === 'abandoned' ? when(r.nextEmailAt) : '—' %></td>
              <td class="small faint"><%= when(r.lastActivityAt) %></td>
              <td class="ab-actions">
                <%
                  /* A POST, because it changes state — a link here would be
                     followed by any prefetcher and delete rows nobody asked
                     it to. The confirm names the customer, so a mis-aimed
                     click is caught by reading rather than by luck. */
                  const who = [r.firstName, r.lastName].filter(Boolean).join(' ') || r.email || 'this checkout';
                %>
                <%/* Offered only while the row is still open. A recovered or
                     already-converted checkout has its order, and a second
                     one would be a charge the customer never made. */%>
                <% if (!r.orderId && ['active', 'abandoned', 'suppressed'].includes(r.status)) { %>
                  <form method="POST" class="ab-convert"
                        action="/admin/abandoned/<%= r._id %>/create-order?status=<%= encodeURIComponent(status) %>&page=<%= page %>"
                        onsubmit="return confirm('Create a real order for <%= who.replace(/'/g, "\\'") %>?\n\nOnly do this once you have seen the payment succeed in Whop. It sends their confirmation email and makes the order visible in their account.');">
                    <input type="text" name="paymentId" required placeholder="Whop payment id"
                           title="From the Whop receipt. Written onto the order so the two can be reconciled later."
                           autocomplete="off" spellcheck="false">
                    <button class="admin-btn admin-btn--sm admin-btn--primary ab-convert-go" type="submit" title="Create the order for this checkout">Make order</button>
                  </form>
                <% } %>
                <form method="POST"
                      action="/admin/abandoned/<%= r._id %>/delete?status=<%= encodeURIComponent(status) %>&page=<%= page %>"
                      onsubmit="return confirm('Delete the abandoned-checkout record for <%= who.replace(/'/g, "\\'") %>?\n\nNo further recovery emails will be sent for it. This cannot be undone.');">
                  <button class="admin-btn admin-btn--sm admin-btn--danger ab-del" type="submit" title="Delete this record" aria-label="Delete the abandoned-checkout record for <%= who %>">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (pages > 1) { %>
      <nav class="admin-pager ab-pager" aria-label="Pages">
        <% if (page > 1) { %><a class="admin-page" href="/admin/abandoned?status=<%= status %>&page=<%= page - 1 %>">Previous</a><% } %>
        <span class="admin-page-gap">Page <%= page %> of <%= pages %> · <%= totalRows %> rows</span>
        <% if (page < pages) { %><a class="admin-page" href="/admin/abandoned?status=<%= status %>&page=<%= page + 1 %>">Next</a><% } %>
      </nav>
    <% } %>
    </section>

    <div class="admin-alert admin-alert--info">
      <span>
        Previews of all six reminders live on the
        <a href="/admin/emails">Email</a> page, alongside every
        other template. Previews render to the screen and send nothing.
      </span>
    </div>

    </div>
  </main>
</body>
</html>
