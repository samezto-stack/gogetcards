<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'><rect width='512' height='512' rx='96' fill='%230F2A4A'/><rect x='190' y='104' width='196' height='272' rx='22' fill='none' stroke='%23ffffff' stroke-width='30' transform='rotate(14 288 240)'/><rect x='126' y='136' width='196' height='272' rx='22' fill='%23ffffff'/></svg>">
  <meta name="theme-color" content="#161009">
  <meta name="robots" content="noindex, nofollow">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | GoGetCards Admin</title>
  <%/* No Outfit/Inter link. admin.css already imports the three fonts this
       admin is actually built from — Fraunces, Hanken Grotesk, IBM Plex Mono
       — and this page was loading two more it had no business using, then
       hardcoding them over the tokens. One less request, one typeface set. */%>
  <link rel="stylesheet" href="/css/admin.css?v=<%= assetVersion %>">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js" defer></script>
  <script src="https://unpkg.com/globe.gl@2.27.3/dist/globe.gl.min.js" defer></script>
  <style>
    /* ── One surface, stated once ──────────────────────────────────────
       Every box on this page — stat card, globe, chart, table panel — is
       the same object at the same depth, so they get the same background,
       the same border and the same radius. They had drifted into three
       backgrounds and two radii, which read as a hierarchy that does not
       exist and was the main reason the page looked busy. */
    :root {
      --dash-surface: rgba(255,255,255,0.025);
      --dash-line: rgba(255,255,255,0.06);
      --dash-radius: 14px;
    }

    .analytics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
    .analytics-card { background: var(--dash-surface); border: 1px solid var(--dash-line); border-radius: var(--dash-radius); padding: 1.25rem 1.5rem; transition: border-color 0.2s ease; position: relative; overflow: hidden; }
    /* Border only. The cards used to lift and lighten on hover, which moved
       numbers under the cursor while they were being read. */
    .analytics-card:hover { border-color: rgba(198,154,69,0.28); }
    .analytics-card__value { font-family: var(--admin-font-display, 'Fraunces', serif); font-size: 2rem; font-weight: 400; letter-spacing: -0.02em; color: var(--admin-text); line-height: 1; margin-bottom: 0.35rem; font-variant-numeric: tabular-nums; }
    .analytics-card__label { font-family: var(--admin-font-mono, monospace); font-size: 0.62rem; color: var(--admin-faint); font-weight: 500; text-transform: uppercase; letter-spacing: 0.12em; }
    /* Revenue is the one figure worth finding first, so it keeps an accent —
       but as a single flat tint, not the two-hue diagonal gradient it had. */
    .analytics-card--accent { border-color: rgba(198,154,69,0.28); background: rgba(198,154,69,0.06); }
    .analytics-card--accent .analytics-card__value { color: var(--admin-primary-soft); }

    /* Globe container */
    .globe-section { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem; }
    /* The one deliberate exception to the shared surface: the globe canvas
       is transparent, so it needs a darker ground behind it to read at all.
       Border and radius still match everything else. */
    .globe-wrap { background: rgba(0,0,0,0.28); border: 1px solid var(--dash-line); border-radius: var(--dash-radius); overflow: hidden; position: relative; height: 380px; display: flex; align-items: center; justify-content: center; }
    .globe-wrap canvas { border-radius: var(--dash-radius); }
    .globe-label { position: absolute; top: 1rem; left: 1.5rem; z-index: 10; }
    .globe-label h3 { font-family: var(--admin-font-display, 'Fraunces', serif); color: var(--admin-text); margin: 0 0 0.25rem 0; font-size: 1.05rem; font-weight: 400; letter-spacing: -0.01em; }
    .globe-label span { font-size: 0.78rem; color: var(--admin-muted); }

    /* Chart card. Was on a 7px radius while its neighbours were on 14 and
       16 — three radii in one row of boxes. */
    .chart-card { background: var(--dash-surface); border: 1px solid var(--dash-line); border-radius: var(--dash-radius); padding: 1.5rem; }
    .chart-card h3 { font-family: var(--admin-font-display, 'Fraunces', serif); color: var(--admin-text); margin: 0 0 1rem 0; font-size: 1.05rem; font-weight: 400; letter-spacing: -0.01em; }

    /* Traffic sources */
    .source-list { display: flex; flex-direction: column; gap: 0.6rem; }
    .source-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem 0; }
    .source-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: 700; flex-shrink: 0; }
    .source-info { flex: 1; min-width: 0; }
    .source-name { font-family: var(--admin-font-ui); font-size: 0.88rem; color: var(--admin-text); font-weight: 500; }
    .source-bar-wrap { height: 6px; background: rgba(255,255,255,0.06); border-radius: 4px; margin-top: 4px; overflow: hidden; }
    .source-bar { height: 100%; border-radius: 4px; transition: width 0.6s ease; }
    .source-stats { text-align: right; flex-shrink: 0; }
    .source-count { font-family: var(--admin-font-display); font-size: 1rem; font-weight: 500; color: var(--admin-text); font-variant-numeric: tabular-nums; }
    .source-pct { font-size: 0.72rem; color: var(--admin-muted); font-family: var(--admin-font-mono); }

    /* Panel subtitles. Every list panel opens the same way now — serif
       title, one quiet line of explanation — where they had each been
       doing their own spacing, which is most of why five panels built the
       same way did not look like a set.

       Left as normal flow rather than flexing the h3: that heading also
       carries the Live Visitors pulse dot, an empty 8px span that a
       baseline-aligned flex row drops below the text. */
    .source-note { font-size: 0.74rem; color: var(--admin-faint); line-height: 1.55; margin: -0.4rem 0 1.1rem; }

    /* ── Folded lists ─────────────────────────────────────────────────
       Long panels show their first five and keep the rest one click away.
       A dashboard is read by scanning, and a fifteen-row table pushes the
       next panel off the screen to say things nobody scans for.

       The rows are RENDERED and hidden, not dropped: the toggle is instant
       and needs no second request, and "show all" is the truth rather than
       a link to somewhere else. */
    .is-folded { display: none !important; }
    .fold-btn {
      display: block; width: 100%; margin-top: 0.9rem; padding: 0.55rem;
      background: transparent; border: 1px solid var(--dash-line); border-radius: 8px;
      color: var(--admin-muted); font-family: var(--admin-font-mono);
      font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase;
      cursor: pointer; transition: border-color 0.2s ease, color 0.2s ease;
    }
    .fold-btn:hover { border-color: rgba(198,154,69,0.35); color: var(--admin-primary-soft); }

    /* Bottom grid */
    .bottom-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 2rem; }
    @media (max-width: 900px) {
      .globe-section, .bottom-grid { grid-template-columns: 1fr; }
    }

    /* Live dot */
    .live-pulse { width: 8px; height: 8px; background: var(--admin-ok, #6FA07A); border-radius: 50%; display: inline-block; margin-right: 6px; animation: livePulse 1.5s infinite; }
    @keyframes livePulse { 0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(111,160,122,0.6); } 50% { opacity: 0.7; box-shadow: 0 0 0 6px rgba(111,160,122,0); } }
  </style>
</head>
<body class="admin-body">
  <%- include('_sidebar') %>

  <main class="admin-main">
    <header class="admin-header" style="justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
      <div style="display:flex; flex-direction:column; gap:0.5rem">
        <div style="display:flex;align-items:center;gap:1rem">
          <h1 class="admin-header__title"><%= pageTitle %></h1>
          <span style="font-size:0.78rem;color:var(--admin-muted)">Last updated: <%= new Date().toLocaleTimeString() %></span>
        </div>
        <div style="display:flex; gap: 0.5rem; align-items: center;">
          <form action="/admin" method="GET" id="rangeForm" style="margin: 0; display: flex; gap: 0.5rem;">
            <select name="range" class="admin-input" onchange="if(this.value !== 'custom') this.form.submit(); else document.getElementById('customDates').style.display='flex';" style="padding: 0.4rem 0.8rem; background: var(--admin-surface); color: var(--admin-text); border: 1px solid var(--admin-border); border-radius: 6px; font-size: 0.85rem;">
              <option value="today" <%= range === 'today' ? 'selected' : '' %>>Today</option>
              <option value="yesterday" <%= range === 'yesterday' ? 'selected' : '' %>>Yesterday</option>
              <option value="week" <%= range === 'week' ? 'selected' : '' %>>This Week</option>
              <option value="month" <%= range === 'month' ? 'selected' : '' %>>This Month</option>
              <option value="year" <%= range === 'year' ? 'selected' : '' %>>This Year</option>
              <option value="all" <%= range === 'all' ? 'selected' : '' %>>All Time</option>
              <option value="custom" <%= range === 'custom' ? 'selected' : '' %>>Custom Range</option>
            </select>
            
            <div id="customDates" style="display: <%= range === 'custom' ? 'flex' : 'none' %>; gap: 0.5rem; align-items: center;">
              <input type="date" name="start" value="<%= typeof startDate !== 'undefined' ? startDate : '' %>" class="admin-input" style="padding: 0.3rem; border-radius: 4px; border: 1px solid var(--admin-border); background: var(--admin-surface); color: white; font-size: 0.8rem;">
              <span style="color: var(--admin-muted)">to</span>
              <input type="date" name="end" value="<%= typeof endDate !== 'undefined' ? endDate : '' %>" class="admin-input" style="padding: 0.3rem; border-radius: 4px; border: 1px solid var(--admin-border); background: var(--admin-surface); color: white; font-size: 0.8rem;">
              <button type="submit" class="admin-btn admin-btn--primary" style="padding: 0.3rem 0.6rem; font-size: 0.8rem;">Apply</button>
            </div>
          </form>
        </div>
      </div>
      
    </header>
    <div class="admin-content">

    <%
      /* Period-over-period delta. Returns nothing at all when there is no
         comparable previous window (all-time range) or when the previous
         value was zero — "+100%" against a zero baseline reads as growth
         when it really means "the first one". Direction is stated in words
         for screen readers, not only by colour. */
      function delta(current, prev) {
        if (!previous || prev === undefined || prev === null) return null;
        if (prev === 0) return current > 0 ? { text: 'new', up: true, neutral: true } : null;
        const pct = ((current - prev) / prev) * 100;
        if (Math.abs(pct) < 0.5) return { text: 'no change', up: null, neutral: true };
        return { text: (pct > 0 ? '+' : '') + pct.toFixed(0) + '%', up: pct > 0, neutral: false };
      }
      function deltaHtml(current, prev, higherIsBetter) {
        const d = delta(current, prev);
        if (!d) return '';
        var cls = d.neutral ? 'is-neutral' : ((d.up === (higherIsBetter !== false)) ? 'is-good' : 'is-bad');
        var arrow = d.up === null ? '' : (d.up ? '\u2191' : '\u2193');
        return '<div class="analytics-card__delta ' + cls + '">' + arrow + ' ' + d.text +
               ' <span class="delta-vs">vs previous</span></div>';
      }
    %>
    <%/* Money a partner host confirmed with Whop where the customer's
         browser never reached our /thank-you, so no order exists. It lives
         in full on the Orders page; this is the pointer, because it is the
         one figure that means "possibly taken and not recorded" and it
         should not need a second page load to notice. Deliberately not
         scoped to the date range: an unresolved payment is a problem
         whichever window is selected. */%>
    <% if ((typeof unconfirmedPaymentCount !== 'undefined') && unconfirmedPaymentCount > 0) { %>
      <a href="/admin/orders" class="unconfirmed-alert" role="alert">
        <span class="unconfirmed-alert__dot" aria-hidden="true"></span>
        <strong><%= unconfirmedPaymentCount %></strong>
        payment<%= unconfirmedPaymentCount === 1 ? '' : 's' %> taken but never confirmed
        <span class="unconfirmed-alert__cta">Review on Orders &rarr;</span>
      </a>
    <% } %>

    <!-- Stats Grid -->
    <div class="analytics-grid">
      <div class="analytics-card">
        <div class="analytics-card__value"><%= stats.views || 0 %></div>
        <div class="analytics-card__label">Unique Visitors</div>
        <%- deltaHtml(stats.views || 0, previous && previous.views, true) %>
      </div>
      <div class="analytics-card">
        <div class="analytics-card__value"><%= stats.checkouts || 0 %></div>
        <div class="analytics-card__label">Checkouts</div>
        <%- deltaHtml(stats.checkouts || 0, previous && previous.checkouts, true) %>
      </div>
      <%/* Confirmed Arrivals used to sit here and reported the same number
           as Checkouts in practice, so it told you nothing. This is a real
           later step: the payment iframe actually rendered for these
           people. Buyers are included, so it is not styled as a warning. */%>
      <div class="analytics-card" title="Filled the checkout form and got as far as Whop's payment step. Includes the ones who went on to pay.">
        <div class="analytics-card__value"><%= stats.reachedCheckout || 0 %></div>
        <div class="analytics-card__label">Reached Checkout</div>
      </div>
      <div class="analytics-card">
        <div class="analytics-card__value"><%= stats.orders || 0 %></div>
        <div class="analytics-card__label">Orders</div>
        <%- deltaHtml(stats.orders || 0, previous && previous.orders, true) %>
      </div>
      <%/* totalPrice is stored in cents, so formatPrice does the divide and
           the thousands separator in one place rather than each view
           inventing its own. */%>
      <div class="analytics-card analytics-card--accent">
        <div class="analytics-card__value">$<%= formatPrice(stats.revenue || 0) %></div>
        <div class="analytics-card__label">Revenue</div>
        <%- deltaHtml(stats.revenue || 0, previous && previous.revenue, true) %>
      </div>
      <div class="analytics-card">
        <% const conversionRate = stats.views > 0 ? ((stats.orders / stats.views) * 100).toFixed(1) : 0; %>
        <div class="analytics-card__value"><%= conversionRate %>%</div>
        <div class="analytics-card__label">Conversion Rate</div>
      </div>
    </div>

    <!-- Globe + Hourly Chart Row -->
    <div class="globe-section">
      <!-- 3D Globe -->
      <div class="globe-wrap">
        <%/* The live count used to be a seventh stat card, sitting beside
             figures for the selected date range even though it only ever
             describes right now. It belongs on the globe, which is the
             thing actually plotting those visitors. */%>
        <div class="globe-label">
          <h3>Live Traffic Globe</h3>
          <span class="globe-live"><span class="live-pulse"></span><span id="live-count"><%= liveVisitors.length %></span> live now</span>
        </div>
        <div id="globeViz" style="width:100%;height:100%;"></div>
      </div>

      <!-- Hourly Unique Visitors Chart -->
      <div class="chart-card" style="display:flex;flex-direction:column;">
        <h3>Hourly Unique Visitors</h3>
        <div style="position:relative;height:300px;width:100%;flex:1;min-height:0;">
          <canvas id="hourlyChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Traffic Sources + Live Visitors -->
    <div class="bottom-grid">
      <!-- Traffic Sources -->
      <div class="chart-card">
        <h3>Traffic Sources</h3>
        <p class="source-note">Unique visitors, each credited to the channel that first brought them.</p>
        <div class="source-list" id="sourceList" data-collapse="5"></div>

        <%
          /* What is left in Direct after in-app browsers are recovered,
             broken down by the page each visitor landed on. Landing on "/"
             suggests a typed address or a bookmark; landing straight on a
             product URL means a link from somewhere that stripped the
             referrer (messaging app, email, QR code, privacy setting). */
          var dl = (typeof directLandings !== 'undefined' && directLandings) || [];
          var dlTotal = dl.reduce(function (n, r) { return n + r.count; }, 0);
        %>
        <% if (dlTotal > 0) { %>
          <details class="direct-breakdown">
            <summary>What Direct is made of <span class="direct-count"><%= dlTotal %></span></summary>
            <p class="source-note" style="margin:0.6rem 0 0.75rem">
              These arrived with no referrer and no in-app browser signature. The page they
              landed on is the best remaining clue: the homepage suggests a typed address or a
              bookmark, a deep product URL means a link from somewhere that strips referrers.
            </p>
            <ul class="direct-list">
              <% dl.forEach(function (r) { %>
                <li>
                  <span class="direct-page"><%= r._id %></span>
                  <span class="direct-n"><%= r.count %></span>
                </li>
              <% }); %>
            </ul>
          </details>
        <% } %>
      </div>

      <!-- Live Visitors -->
      <div class="chart-card">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
          <h3 style="margin:0"><span class="live-pulse"></span> Live Visitors</h3>
          <span style="font-size:0.72rem;color:rgba(240,232,216,0.55)">Auto-refreshes every 10s</span>
        </div>
        <div id="live-visitors-container" style="max-height:300px;overflow-y:auto">
          <% if (liveVisitors.length === 0) { %>
            <p style="color:rgba(240,232,216,0.55);font-size:0.85rem;padding:1rem 0">No active visitors right now.</p>
          <% } else { %>
            <div class="admin-table-wrap">
              <table class="admin-table">
                <thead><tr><th>Page</th><th>IP</th><th>Country</th><th>Last Seen</th></tr></thead>
                <tbody>
                  <% liveVisitors.forEach(function(v) { %>
                    <tr>
                      <td><code style="font-size:0.78rem;color:var(--admin-primary)"><%= v.page %></code></td>
                      <td style="font-size:0.78rem"><%= v.ip %></td>
                      <td>
                        <% if (v.countryCode) { %>
                          <img src="https://flagcdn.com/w20/<%= v.countryCode.toLowerCase() %>.png" width="16" height="12" style="vertical-align:middle;margin-right:4px" alt="<%= v.country %>">
                        <% } %>
                        <%= v.country || 'Unknown' %>
                      </td>
                      <td style="font-size:0.75rem;color:var(--admin-muted)"><%= new Date(v.lastSeen).toLocaleTimeString() %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Revenue by Channel + Top Products by Revenue -->
    <div class="bottom-grid" style="margin-top:1.5rem">
      <%/* Traffic Sources counts VISITORS per channel, which answers who
           shows up but not who pays, and the two routinely disagree by an
           order of magnitude. This is the panel that decides where ad
           money goes. */%>
      <% if ((typeof revenueBySource !== 'undefined') && revenueBySource.length) { %>
        <div class="chart-card">
          <h3>Revenue by Channel</h3>
          <p class="source-note">Where the money actually came from, by each buyer's first-touch channel.</p>
          <div class="source-list" data-collapse="5">
            <% revenueBySource.forEach(function (r) {
                 var pct = ((r.revenue / revenueBySourceTotal) * 100); %>
              <div class="rev-row">
                <div class="rev-row__top">
                  <span class="rev-row__name"><%= r.name %></span>
                  <span class="rev-row__amount">$<%= formatPrice(r.revenue) %></span>
                </div>
                <div class="rev-row__bar"><div class="rev-row__fill" style="width:<%= pct.toFixed(1) %>%"></div></div>
                <div class="rev-row__meta">
                  <%= pct.toFixed(1) %>% of revenue
                  &middot;
                  <%/* The order count opens what is behind it. Which channel
                       earns is only half the question; which PRODUCTS it
                       earns from is the half that decides where ad money
                       goes. A real <button> so it is keyboard-reachable and
                       announced as clickable rather than looking like text
                       that happens to respond. */%>
                  <button type="button" class="rev-drill" data-source="<%= r.name %>"
                          title="Show the products sold through <%= r.name %>">
                    <%= r.orders %> order<%= r.orders === 1 ? '' : 's' %>
                  </button>
                  &middot; $<%= formatPrice(Math.round(r.revenue / r.orders)) %> avg
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>

      <%/* Ranked by revenue, not views. The views panel below puts a cheap
           item that gets browsed a lot above an expensive one that
           actually sells, which is backwards for restocking decisions. */%>
      <% if ((typeof topProductsByRevenue !== 'undefined') && topProductsByRevenue.length) { %>
        <div class="chart-card">
          <h3>Top Products by Revenue</h3>
          <p class="source-note">What sold, ranked by money rather than by page views.</p>
          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead><tr><th>#</th><th>Product</th><th>Units</th><th>Revenue</th></tr></thead>
              <tbody data-collapse="5">
                <% topProductsByRevenue.forEach(function (tp, i) { %>
                  <tr>
                    <td><%= i + 1 %></td>
                    <td><%= tp._id %></td>
                    <td><%= tp.units %></td>
                    <td style="font-weight:700;color:var(--admin-accent)">$<%= formatPrice(tp.revenue) %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Top Products + Top Countries -->
    <div class="bottom-grid" style="margin-top:1.5rem">
      <!-- Top Products -->
      <% if (topProducts && topProducts.length > 0) { %>
        <div class="chart-card">
          <h3>Most Viewed Products</h3>
          <p class="source-note">Interest, not sales. Compare with Revenue above to spot what gets looked at but not bought.</p>
          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead><tr><th>#</th><th>Product</th><th>Views</th></tr></thead>
              <tbody data-collapse="5">
                <% topProducts.forEach(function(tp, idx) { %>
                  <tr><td><%= idx + 1 %></td><td><%= tp._id %></td><td><%= tp.views %></td></tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>

      <!-- Top Countries -->
      <% if (typeof topCountries !== 'undefined' && topCountries && topCountries.length > 0) { %>
        <div class="chart-card">
          <h3>Top Countries</h3>
          <%/* Was a 350px scroll box, which hides its own length: you cannot
               tell from the outside whether there are six countries or sixty,
               and a nested scrollbar inside a page that already scrolls is a
               trap for a trackpad. Folded like the rest. */%>
          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead><tr><th>#</th><th>Country</th><th>Visitors</th><th style="width:40%">Share</th></tr></thead>
              <tbody data-collapse="5">
                <% 
                  const totalCountryViews = topCountries.reduce((s, c) => s + c.views, 0);
                  topCountries.forEach(function(c, idx) { 
                    const pct = totalCountryViews > 0 ? ((c.views / totalCountryViews) * 100).toFixed(1) : 0;
                %>
                  <tr>
                    <td><%= idx + 1 %></td>
                    <td>
                      <% if (c._id) { %>
                        <img src="https://flagcdn.com/w20/<%= c._id.toLowerCase() %>.png" width="16" height="12" style="vertical-align:middle;margin-right:6px" alt="<%= c._id %>" onerror="this.style.display='none'">
                        <%= c._id %>
                      <% } else { %>
                        Unknown
                      <% } %>
                    </td>
                    <td><%= c.views %></td>
                    <td>
                      <div style="display:flex;align-items:center;gap:8px">
                        <div style="flex:1;background:rgba(255,255,255,0.06);border-radius:4px;height:8px;overflow:hidden">
                          <div style="width:<%= pct %>%;height:100%;background:linear-gradient(90deg,var(--admin-primary),var(--admin-bordeaux));border-radius:4px;transition:width 0.3s"></div>
                        </div>
                        <span style="font-size:0.75rem;color:var(--admin-muted);min-width:40px;text-align:right"><%= pct %>%</span>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>

    </div>


    </div>
  </main>

  <script>
   // Chart.js & globe.gl load with `defer`, so run everything that touches
   // them after DOMContentLoaded (deferred scripts finish before that fires).
   document.addEventListener('DOMContentLoaded', function () {
    // ── Data from server ──
    const hourlyData = <%- hourlyChart %>;
    const trafficSources = <%- trafficSources %>;
    const globePins = <%- globePins %>;

    // ── Hourly Unique Visitors Chart ──
    const hourLabels = Array.from({length: 24}, (_, i) => {
      const h = i % 12 || 12;
      return h + (i < 12 ? 'AM' : 'PM');
    });

    new Chart(document.getElementById('hourlyChart'), {
      type: 'bar',
      data: {
        labels: hourLabels,
        datasets: [{
          label: 'Unique Visitors',
          data: hourlyData,
          /* One flat colour, no outline.
             These were a brass-to-bordeaux gradient with a lit border, so
             every bar carried a vertical colour ramp and a bright edge that
             said nothing about its value — two bars differed by height AND
             by how much red had crept in, which is a second encoding of
             nothing. A single tone lets height do the whole job. */
          backgroundColor: 'rgba(198, 154, 69, 0.55)',
          hoverBackgroundColor: 'rgba(216, 180, 95, 0.85)',
          borderWidth: 0,
          borderRadius: 3,
          borderSkipped: false,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: 'rgba(22, 16, 9, 0.95)',
            titleColor: '#D8B45F',
            bodyColor: '#F0E8D8',
            borderColor: 'rgba(198,154,69,0.3)',
            borderWidth: 1,
            cornerRadius: 8,
            padding: 10,
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: { color: 'rgba(240,232,216,0.42)', font: { size: 10 }, maxRotation: 0 }
          },
          y: {
            beginAtZero: true,
            grid: { color: 'rgba(255,255,255,0.04)' },
            ticks: { color: 'rgba(240,232,216,0.42)', font: { size: 11 }, precision: 0 }
          }
        }
      }
    });

    // ── Traffic Sources ──
    // Warm brass-family palette so the whole panel stays on-theme.
    // Icons keep their brand glyph; bars are tinted brass/bordeaux/sage/slate.
    const BAR = { brass: '#C69A45', brassSoft: '#D8B45F', bordeaux: '#C4485C', sage: '#6FA07A', slate: '#7E93A8', muted: '#9A8F7C' };
    const chip = () => 'rgba(240,232,216,0.06)';

    /* ── Source marks ──────────────────────────────────────────────────
     *
     * Emoji before this, which was the wrong tool twice over: a 📢 and a
     * 🔵 are not what Google Ads and Bing look like to anyone, and every
     * platform draws them differently, so the column never lined up and
     * never looked like software.
     *
     * Drawn as monochrome glyphs taking `currentColor`, tinted to the same
     * bar colour as the row. Monochrome on purpose — an approximated
     * four-colour Google mark is a worse, and more misleading, thing to
     * ship than the brand's own geometry in one ink, and it would fight
     * the brass palette the rest of the panel is built from.
     *
     * viewBox is 24x24 for every one of them so they optically match at
     * 18px without per-icon nudging. */
    const I = (body) => '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">' + body + '</svg>';
    const ILINE = (body) => '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + body + '</svg>';

    const MARK = {
      // The Google G, in one ink.
      google: I('<path d="M12.2 10.4v3.1h4.4c-.2 1.1-1.4 3.3-4.4 3.3a5 5 0 110-10c1.5 0 2.6.6 3.2 1.2l2.2-2.1A8.2 8.2 0 1012.2 20c4.7 0 7.9-3.3 7.9-8 0-.5 0-.9-.1-1.3z"/>'),
      // Google Ads: the two angled bars and the dot.
      /* Stroked rather than two rotated rects: at 18px the rects overlapped
         into a single sliver, and this is the row that carries most of the
         traffic — it has to be the most legible mark in the column. */
      googleAds: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="4.3" stroke-linecap="round" aria-hidden="true"><path d="M12 4.4l5.8 12.4"/><path d="M12 4.4L7.6 13.8" opacity=".5"/><circle cx="6.7" cy="17.9" r="2.9" fill="currentColor" stroke="none"/></svg>',
      // Bing's swoosh.
      bing: I('<path d="M6 2.6l3.9 1.4v11.2l4.3-2.5-2.1-1-1.3-3.3 7.2 2.6v3.6L9.9 21.4 6 19.2z"/>'),
      // Yahoo's letterform.
      yahoo: I('<path d="M3 6.2h3.5l2.9 5 2.9-5H16l-5 8.3v4.3H8.2v-4.3z"/><circle cx="18.4" cy="16.9" r="1.9"/><path d="M17.2 5.2h2.6l-.6 8h-1.4z"/>'),
      // DuckDuckGo's duck, reduced to head and bill in its circle.
      duckduckgo: ILINE('<circle cx="12" cy="12" r="9.2"/><path d="M13.9 8.3a2.4 2.4 0 10-3.3 2.2c-.5 2.3-.7 4.2-.5 5.8 1.9.7 3.7.7 5.4 0l-1.4-4.2"/><path d="M14.6 7.6l2.6.5-2.3 1.2"/>'),
      // OpenAI's knot, simplified to its hexagonal weave.
      chatgpt: '<svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.4l7.4 4.3v8.6L12 19.6l-7.4-4.3V6.7z"/><path d="M12 2.4v8.6l7.4 4.3M12 11L4.6 15.3M12 11v8.6"/></svg>',
      // Facebook's f.
      facebook: I('<path d="M22 12a10 10 0 10-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0022 12z"/>'),
      // Trustpilot is a star.
      trustpilot: I('<path d="M12 2.6l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.5 6.1 20.6l1.2-6.5-4.8-4.6 6.6-.9z"/>'),
      reddit: I('<path d="M22 11.8a2.2 2.2 0 00-3.7-1.6c-1.5-1-3.5-1.6-5.7-1.7l1-4.5 3.1.7a1.8 1.8 0 101.8-1.9 1.8 1.8 0 00-1.6 1L13 3a.7.7 0 00-.8.5l-1.1 5.1c-2.2 0-4.3.7-5.8 1.7A2.2 2.2 0 002 11.8c0 .9.5 1.6 1.2 2v.7c0 3.4 3.9 6.1 8.8 6.1s8.8-2.7 8.8-6.1v-.7c.7-.4 1.2-1.1 1.2-2zM7 13.4a1.6 1.6 0 113.2 0 1.6 1.6 0 01-3.2 0zm8.9 4.2c-1 1-3 1.1-3.9 1.1s-2.9 0-3.9-1.1a.4.4 0 010-.6.4.4 0 01.6 0c.7.7 2.1.9 3.3.9s2.6-.2 3.3-.9a.4.4 0 01.6.6zm-.5-2.6a1.6 1.6 0 110-3.2 1.6 1.6 0 010 3.2z"/>'),
      tiktok: I('<path d="M17 3.2c.5 2 1.9 3.5 3.9 3.8v3c-1.5.1-2.9-.3-4.2-1.2v6.1c0 4.3-3.7 7-7.3 5.6-2.4-1-3.6-3.6-3-6.1.6-2.4 2.9-4 5.4-3.8v3.1c-.4-.1-.8-.1-1.2 0-1.2.2-2 1.3-1.8 2.5.2 1.1 1.2 1.9 2.3 1.8 1.3-.1 2.2-1.1 2.2-2.5V3.2z"/>'),
      twitter: I('<path d="M17.5 3h3.1l-6.8 7.8L21.8 21h-6.3l-4.9-6.4L4.9 21H1.8l7.3-8.3L2.2 3h6.5l4.4 5.8zm-1.1 16.1h1.7L7.7 4.8H5.9z"/>'),
      youtube: I('<path d="M21.6 7.2a2.5 2.5 0 00-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 00-1.8 1.8A26 26 0 002 12a26 26 0 00.4 4.8 2.5 2.5 0 001.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 001.8-1.8A26 26 0 0022 12a26 26 0 00-.4-4.8zM10 15.1V8.9l5.2 3.1z"/>'),
      snapchat: I('<path d="M12 2.6c2.7 0 4.6 2 4.6 4.7 0 .9-.1 1.7-.1 2.3.4.2.9.2 1.4 0 .5-.1 1 .2 1.1.6.1.5-.2 1-.9 1.3-.7.3-1.6.5-1.6 1 0 .8 2 2.7 3.6 3.2.4.1.6.5.5.9-.2.6-1.3.9-2.4 1.1-.2.4-.2.9-.4 1.1-.2.2-.6.2-1.1.1-.6-.1-1.4-.2-2.2 0-.8.2-1.5 1.1-2.5 1.1s-1.7-.9-2.5-1.1c-.8-.2-1.6-.1-2.2 0-.5.1-.9.1-1.1-.1-.2-.2-.2-.7-.4-1.1-1.1-.2-2.2-.5-2.4-1.1-.1-.4.1-.8.5-.9 1.6-.5 3.6-2.4 3.6-3.2 0-.5-.9-.7-1.6-1-.7-.3-1-.8-.9-1.3.1-.4.6-.7 1.1-.6.5.2 1 .2 1.4 0 0-.6-.1-1.4-.1-2.3C7.4 4.6 9.3 2.6 12 2.6z"/>'),
      pinterest: I('<path d="M12 2a10 10 0 00-3.6 19.3c-.1-.8-.2-2 0-2.9l1.2-5.1s-.3-.6-.3-1.5c0-1.4.8-2.5 1.9-2.5.9 0 1.3.7 1.3 1.5 0 .9-.6 2.2-.9 3.5-.2 1 .5 1.9 1.6 1.9 1.9 0 3.3-2 3.3-4.9 0-2.6-1.8-4.4-4.4-4.4-3 0-4.8 2.2-4.8 4.6 0 .9.3 1.9.8 2.4.1.1.1.2.1.3l-.3 1.1c0 .2-.2.2-.4.1-1.4-.7-2.3-2.7-2.3-4.4 0-3.6 2.6-6.9 7.5-6.9 3.9 0 7 2.8 7 6.5 0 3.9-2.5 7.1-5.9 7.1-1.2 0-2.3-.6-2.6-1.3l-.7 2.7c-.3 1-1 2.3-1.5 3.1A10 10 0 1012 2z"/>'),
      // Not brands: a direct arrival, and everything unrecognised.
      direct: ILINE('<path d="M12 20V6"/><path d="M6.5 11.5L12 6l5.5 5.5"/><path d="M4 3.5h16"/>'),
      other: ILINE('<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 010 18 14 14 0 010-18z"/>'),
    };

    const sourceColors = {
      'Facebook':    { bg: chip(), bar: BAR.slate,     icon: MARK.facebook },
      'Google':      { bg: chip(), bar: BAR.bordeaux,  icon: MARK.google },
      'Google Ads':  { bg: chip(), bar: BAR.brassSoft, icon: MARK.googleAds },
      'Bing':        { bg: chip(), bar: BAR.slate,     icon: MARK.bing },
      'Bing Ads':    { bg: chip(), bar: BAR.slate,     icon: MARK.bing },
      'Yahoo':       { bg: chip(), bar: BAR.muted,     icon: MARK.yahoo },
      'DuckDuckGo':  { bg: chip(), bar: BAR.sage,      icon: MARK.duckduckgo },
      'ChatGPT':     { bg: chip(), bar: BAR.sage,      icon: MARK.chatgpt },
      'Trustpilot':  { bg: chip(), bar: BAR.sage,      icon: MARK.trustpilot },
      'Reddit':      { bg: chip(), bar: BAR.bordeaux,  icon: MARK.reddit },
      'TikTok':      { bg: chip(), bar: BAR.muted,     icon: MARK.tiktok },
      'Twitter/X':   { bg: chip(), bar: BAR.slate,     icon: MARK.twitter },
      'YouTube':     { bg: chip(), bar: BAR.bordeaux,  icon: MARK.youtube },
      'Snapchat':    { bg: chip(), bar: BAR.brassSoft, icon: MARK.snapchat },
      'Pinterest':   { bg: chip(), bar: BAR.bordeaux,  icon: MARK.pinterest },
      'Direct':      { bg: chip(), bar: BAR.brass,     icon: MARK.direct },
      'Other':       { bg: chip(), bar: BAR.muted,     icon: MARK.other },
    };

    /* An unrecognised utm_source is passed through raw by
       middleware/tracking, so the list carries values like "chatgpt.com"
       and "trustpilot" that no exact key will ever match — they were all
       landing on the globe. Matching on a normalised key (lowercased, www
       and TLD removed) is what puts a mark on them, and anything genuinely
       unknown still falls through to Other. */
    const ALIAS = {
      'chatgpt': 'ChatGPT', 'openai': 'ChatGPT', 'chat.openai': 'ChatGPT',
      'trustpilot': 'Trustpilot', 'duckduckgo': 'DuckDuckGo', 'ddg': 'DuckDuckGo',
      'google': 'Google', 'googleads': 'Google Ads', 'adwords': 'Google Ads',
      'bing': 'Bing', 'yahoo': 'Yahoo', 'facebook': 'Facebook', 'instagram': 'Facebook',
      'reddit': 'Reddit', 'tiktok': 'TikTok', 'youtube': 'YouTube',
      'twitter': 'Twitter/X', 'x': 'Twitter/X', 'pinterest': 'Pinterest',
      'snapchat': 'Snapchat', 'perplexity': 'ChatGPT', 'gemini': 'Google',
    };
    function styleFor(name) {
      if (sourceColors[name]) return sourceColors[name];
      const key = String(name || '').toLowerCase()
        .replace(/^www\./, '')
        .replace(/\.(com|org|net|io|ai|co\.[a-z]{2}|[a-z]{2})$/, '')
        .replace(/[^a-z.]/g, '');
      const hit = ALIAS[key];
      return (hit && sourceColors[hit]) || sourceColors['Other'];
    }

    const sourceList = document.getElementById('sourceList');
    if (trafficSources.length === 0) {
      sourceList.innerHTML = '<p style="color:rgba(240,232,216,0.55);font-size:0.85rem;padding:1rem 0">No traffic data yet for this period.</p>';
    } else {
      /* s.name is an un-trusted traffic-source label (an unknown utm_source is
         stored raw), so it is HTML-escaped before it goes anywhere near
         innerHTML — otherwise a crafted utm_source value lands as live markup
         in this admin page (stored XSS). The counts are coerced to numbers so
         nothing but a number is ever interpolated. (The data itself is also
         embedded safely by the server; this is defence in depth.) */
      const escHtml = (v) => String(v == null ? '' : v).replace(/[&<>"'`]/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;', '`': '&#96;'
      })[c]);
      trafficSources.forEach(s => {
        const colors = styleFor(s.name);
        const name = escHtml(s.name);
        const count = Number(s.count) || 0;
        const percent = Math.max(0, Math.min(100, Number(s.percent) || 0));
        const item = document.createElement('div');
        item.className = 'source-item';
        item.innerHTML = `
          <div class="source-icon" style="background:${colors.bg};color:${colors.bar}">${colors.icon}</div>
          <div class="source-info">
            <div class="source-name">${name}</div>
            <div class="source-bar-wrap"><div class="source-bar" style="width:${percent}%;background:${colors.bar}"></div></div>
          </div>
          <div class="source-stats">
            <div class="source-count">${count}</div>
            <div class="source-pct">${percent}%</div>
          </div>
        `;
        sourceList.appendChild(item);
      });
    }

    /* ── Fold long panels to their first five ──────────────────────────
     *
     * One mechanism for all five, driven by data-collapse on whatever
     * element holds the rows — a <tbody> for the tables, a .source-list
     * div for the two bar lists. Marking the container rather than writing
     * a slice into each panel means a new panel only has to add the
     * attribute, and the server keeps sending the whole list.
     *
     * The rows are rendered and HIDDEN, not dropped: the toggle is instant,
     * needs no second request, and the count on the button is the real
     * total rather than a guess.
     *
     * Runs after the traffic-source list is built, because that one is
     * populated by the script above and has no children before then. */
    function foldPanels(root) {
      (root || document).querySelectorAll('[data-collapse]').forEach(function (box) {
        if (box.dataset.folded) return;
        var limit = parseInt(box.dataset.collapse, 10) || 5;
        var rows = [].filter.call(box.children, function (el) { return el.nodeType === 1; });
        if (rows.length <= limit) return;      // nothing to fold, no button
        box.dataset.folded = '1';

        var open = false;
        var fold = function () {
          rows.forEach(function (r, i) { r.classList.toggle('is-folded', !open && i >= limit); });
          btn.textContent = open ? 'Show top ' + limit : 'Show all ' + rows.length;
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        };
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'fold-btn';
        btn.addEventListener('click', function () { open = !open; fold(); });
        fold();

        /* Appended to the panel, not the container: a <button> is not
           valid inside a <tbody>, and inside the scrollable table wrap it
           would scroll away from the rows it controls. */
        (box.closest('.chart-card') || box.parentNode).appendChild(btn);
      });
    }
    foldPanels();

    // ── 3D Globe ──
    (function initGlobe() {
      const container = document.getElementById('globeViz');
      if (!container) return;
      
      try {
        const myGlobe = Globe()(container)
          .globeImageUrl('//unpkg.com/three-globe/example/img/earth-night.jpg')
          .backgroundColor('rgba(0,0,0,0)')
          .atmosphereColor('rgba(198,154,69,0.3)')
          .atmosphereAltitude(0.2)
          .pointsData(globePins)
          .pointLat('lat')
          .pointLng('lng')
          .pointColor(() => '#D8B45F')
          .pointAltitude(d => Math.min(d.count * 0.02, 0.3))
          .pointRadius(0.4)
          .pointsMerge(true)
          .ringsData(globePins.slice(0, 20))
          .ringLat('lat')
          .ringLng('lng')
          .ringColor(() => t => `rgba(216,180,95,${1 - t})`)
          .ringMaxRadius(3)
          .ringPropagationSpeed(2)
          .ringRepeatPeriod(2000);

        // Auto-rotate
        myGlobe.controls().autoRotate = true;
        myGlobe.controls().autoRotateSpeed = 0.8;
        myGlobe.controls().enableZoom = false;

        // Size to container
        const w = container.clientWidth;
        const h = container.clientHeight;
        myGlobe.width(w).height(h);
      } catch(e) {
        container.innerHTML = '<p style="color:rgba(240,232,216,0.55);text-align:center;padding:2rem">Globe requires WebGL. Your browser may not support it.</p>';
      }
    })();

    // ── Auto-refresh live visitors ──
    setInterval(async () => {
      try {
        const res = await fetch('/admin/api/live-visitors');
        const data = await res.json();
        document.getElementById('live-count').textContent = data.count;
      } catch(e) {}
    }, 10000);
   }); // end DOMContentLoaded
  </script>
<style>
  .source-note { font-size: 0.78rem; color: var(--admin-muted); margin: -0.35rem 0 1rem; }
  .direct-breakdown { margin-top: 1.25rem; border-top: 1px solid var(--admin-border); padding-top: 0.9rem; }
  .direct-breakdown summary { cursor: pointer; font-size: 0.82rem; font-weight: 600; color: var(--admin-muted); display: flex; align-items: center; gap: 0.5rem; list-style: none; }
  .direct-breakdown summary::-webkit-details-marker { display: none; }
  .direct-breakdown summary::before { content: '+'; color: var(--admin-primary); font-size: 1rem; }
  .direct-breakdown[open] summary::before { content: '\2212'; }
  .direct-breakdown summary:hover { color: #fff; }
  .direct-count { margin-left: auto; font-family: var(--admin-font-mono); color: var(--admin-primary); }
  .direct-list { list-style: none; margin: 0; padding: 0; }
  .direct-list li { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.4rem 0; border-top: 1px solid rgba(255,255,255,0.04); font-size: 0.8rem; }
  .direct-page { color: var(--admin-muted); font-family: var(--admin-font-mono); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .direct-n { color: #fff; font-weight: 600; flex-shrink: 0; }
</style>
<style>
  .globe-live { display: inline-flex; align-items: center; gap: 0.4rem; color: #4ade80; font-weight: 600; font-variant-numeric: tabular-nums; }
</style>
<style>
  /* Period-over-period deltas */
  .analytics-card__delta { margin-top: 0.35rem; font-size: 0.72rem; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: 0.02em; }
  .analytics-card__delta.is-good { color: #4ade80; }
  .analytics-card__delta.is-bad { color: #f87171; }
  .analytics-card__delta.is-neutral { color: var(--admin-muted); }
  .delta-vs { color: var(--admin-muted); font-weight: 500; }

  /* Unconfirmed-payment alert */
  .unconfirmed-alert { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1.5rem; padding: 0.9rem 1.25rem; border: 1px solid rgba(239,68,68,0.35); background: rgba(239,68,68,0.07); border-radius: 10px; color: #FCA5A5; font-size: 0.88rem; text-decoration: none; transition: background 0.2s; }
  .unconfirmed-alert:hover { background: rgba(239,68,68,0.12); }
  .unconfirmed-alert strong { color: #fff; font-size: 1.05rem; }
  .unconfirmed-alert__dot { width: 8px; height: 8px; border-radius: 50%; background: #ef4444; flex-shrink: 0; animation: livePulse 1.5s infinite; }
  .unconfirmed-alert__cta { margin-left: auto; font-weight: 600; color: #fff; }

  /* Revenue by channel */
  .rev-row { padding: 0.6rem 0; border-top: 1px solid rgba(255,255,255,0.05); }
  .rev-row:first-child { border-top: none; }
  .rev-row__top { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .rev-row__name { font-weight: 600; color: #fff; font-size: 0.9rem; }
  .rev-row__amount { font-family: var(--admin-font-mono); font-weight: 700; color: var(--admin-accent); font-variant-numeric: tabular-nums; }
  .rev-row__bar { height: 6px; background: rgba(255,255,255,0.06); border-radius: 3px; overflow: hidden; margin: 0.4rem 0 0.3rem; }
  .rev-row__fill { height: 100%; background: linear-gradient(90deg, var(--admin-primary), var(--admin-bordeaux)); border-radius: 3px; }
  .rev-row__meta { font-size: 0.72rem; color: var(--admin-muted); font-variant-numeric: tabular-nums; }

  /* ── Channel drill-down ── */
  .rev-drill { background: none; border: 0; padding: 0; font: inherit; color: var(--admin-accent);
               cursor: pointer; text-decoration: underline; text-underline-offset: 2px;
               font-variant-numeric: tabular-nums; }
  .rev-drill:hover { filter: brightness(1.25); }
  .rev-drill:focus-visible { outline: 2px solid var(--admin-accent); outline-offset: 2px; border-radius: 3px; }

  .cd-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.65); backdrop-filter: blur(2px);
                 display: flex; align-items: center; justify-content: center; padding: 1.5rem; z-index: 200; }
  .cd-backdrop[hidden] { display: none; }
  .cd-modal { background: var(--admin-card, #15151d); border: 1px solid var(--admin-border);
              border-radius: 14px; width: min(720px, 100%); max-height: 82vh; display: flex; flex-direction: column;
              box-shadow: 0 40px 80px -20px rgba(0,0,0,0.7); }
  .cd-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;
             padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--admin-border); }
  .cd-title { margin: 0; font-size: 1rem; font-weight: 700; color: #fff; }
  .cd-sub { margin: 0.25rem 0 0; font-size: 0.75rem; color: var(--admin-muted); }
  .cd-close { background: none; border: 0; color: var(--admin-muted); font-size: 1.5rem; line-height: 1;
              cursor: pointer; padding: 0 0.25rem; }
  .cd-close:hover { color: #fff; }
  .cd-body { overflow-y: auto; padding: 0.5rem 1.5rem 1.5rem; }
  .cd-table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
  .cd-table th { text-align: left; font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase;
                 color: var(--admin-faint); font-weight: 500; padding: 0.7rem 0.5rem; border-bottom: 1px solid var(--admin-border); }
  .cd-table td { padding: 0.7rem 0.5rem; border-bottom: 1px solid rgba(255,255,255,0.05); color: var(--admin-text); }
  .cd-table td.num { text-align: right; font-variant-numeric: tabular-nums; font-family: var(--admin-font-mono); }
  .cd-table td.rev { color: var(--admin-accent); font-weight: 700; }
  .cd-slug { display: block; font-size: 0.68rem; color: var(--admin-faint); font-family: var(--admin-font-mono); }
  .cd-state { padding: 2rem 0.5rem; text-align: center; color: var(--admin-muted); font-size: 0.85rem; }
</style>

<%/* Channel drill-down. One dialog reused for every row — the content is
     fetched on open rather than rendered for all channels up front, which
     would mean querying every channel's products on every dashboard load
     to populate popups that mostly never get opened. */%>
<div class="cd-backdrop" id="cdBackdrop" hidden role="dialog" aria-modal="true" aria-labelledby="cdTitle">
  <div class="cd-modal">
    <div class="cd-head">
      <div>
        <h3 class="cd-title" id="cdTitle">Products sold</h3>
        <p class="cd-sub" id="cdSub"></p>
      </div>
      <button type="button" class="cd-close" id="cdClose" aria-label="Close">&times;</button>
    </div>
    <div class="cd-body" id="cdBody"></div>
  </div>
</div>

<script>
(function () {
  var backdrop = document.getElementById('cdBackdrop');
  if (!backdrop) return;
  var titleEl = document.getElementById('cdTitle');
  var subEl   = document.getElementById('cdSub');
  var bodyEl  = document.getElementById('cdBody');
  var lastFocus = null;

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  /* Prices are stored in cents everywhere on this site. */
  function money(cents) {
    return '$' + (Number(cents || 0) / 100).toLocaleString('en-US',
      { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function open(source) {
    lastFocus = document.activeElement;
    titleEl.textContent = 'Products sold via ' + source;
    subEl.textContent = 'Same date range as the dashboard.';
    bodyEl.innerHTML = '<div class="cd-state">Loading…</div>';
    backdrop.hidden = false;
    document.getElementById('cdClose').focus();

    /* THE PAGE'S OWN QUERY STRING IS FORWARDED VERBATIM, rather than the
       range being read out and rebuilt here. It already carries range and,
       for a custom range, start and end — so the popup is guaranteed to be
       asking about the same window that produced the number clicked. */
    var qs = new URLSearchParams(window.location.search);
    qs.set('source', source);

    fetch('/admin/analytics/channel-orders?' + qs.toString(), { credentials: 'same-origin' })
      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
      .then(function (data) {
        if (!data.rows || !data.rows.length) {
          bodyEl.innerHTML = '<div class="cd-state">No products recorded for this channel in this range.</div>';
          return;
        }
        subEl.textContent = data.totals.orders + ' order' + (data.totals.orders === 1 ? '' : 's')
          + ' · ' + data.totals.units + ' unit' + (data.totals.units === 1 ? '' : 's')
          + ' · ' + money(data.totals.revenue) + ' total';

        var html = '<table class="cd-table"><thead><tr>'
          + '<th>Product</th><th style="text-align:right">Orders</th>'
          + '<th style="text-align:right">Units</th><th style="text-align:right">Revenue</th>'
          + '</tr></thead><tbody>';
        data.rows.forEach(function (r) {
          /* An order whose productSlug never got set still represents real
             money, so it is shown as unattributed rather than dropped. */
          var label = r.name ? esc(r.name) : (r.slug ? esc(r.slug) : '<em>No product recorded</em>');
          var slugLine = (r.name && r.slug) ? '<span class="cd-slug">' + esc(r.slug) + '</span>' : '';
          html += '<tr><td>' + label + slugLine + '</td>'
            + '<td class="num">' + r.orders + '</td>'
            + '<td class="num">' + r.units + '</td>'
            + '<td class="num rev">' + money(r.revenue) + '</td></tr>';
        });
        html += '</tbody></table>';
        bodyEl.innerHTML = html;
      })
      .catch(function (err) {
        bodyEl.innerHTML = '<div class="cd-state">Could not load this channel (' + esc(err.message) + ').</div>';
      });
  }

  function close() {
    backdrop.hidden = true;
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }

  document.addEventListener('click', function (e) {
    var btn = e.target.closest ? e.target.closest('.rev-drill') : null;
    if (btn) { open(btn.getAttribute('data-source') || ''); return; }
    if (e.target === backdrop) close();          // click outside the panel
    if (e.target.id === 'cdClose') close();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !backdrop.hidden) close();
  });
})();
</script>
</body>
</html>
