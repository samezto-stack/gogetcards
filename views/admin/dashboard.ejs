<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { title: pageTitle }) %>
  <%/* No Outfit/Inter link. _head.ejs carries the one typeface this admin
       is actually built from, and this page was loading two more it had no
       business using, then hardcoding them over the tokens. One less
       request, one typeface set. */%>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js" defer></script>
  <script src="https://unpkg.com/globe.gl@2.27.3/dist/globe.gl.min.js" defer></script>
  <style>
    /* ── Dashboard-only layout ─────────────────────────────────────────
       Everything that is a panel, stat card, table, button, alert or
       modal uses the shared admin.css class. What is left here is the
       globe, the chart box, the two bar lists and the drill-down table's
       own cells — layout that is genuinely this page's. */

    /* Range picker, in the header's action slot. The custom-dates group
       is shown and hidden by the select's own onchange (inline display),
       so this only sets how it lays out once it is visible. */
    .dash-range { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin: 0; }
    .dash-range__custom { gap: 8px; align-items: center; }
    .dash-range__custom .admin-input { width: auto; }

    /* Unconfirmed-payment alert: the whole bar is the link. */
    .dash-unconfirmed { align-items: center; text-decoration: none; }
    .dash-unconfirmed:hover { text-decoration: none; }
    .dash-unconfirmed:hover .dash-unconfirmed__cta { text-decoration: underline; text-underline-offset: 2px; }
    .dash-unconfirmed__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--admin-crit); flex: none; animation: livePulse 1.5s infinite; }
    .dash-unconfirmed__cta { margin-left: auto; font-weight: 600; white-space: nowrap; }

    /* Period-over-period deltas: colour comes from is-good/is-bad/is-neutral
       in admin.css; the "vs previous" tail is quieter than the figure. */
    .delta-vs { color: var(--admin-faint); font-weight: 500; }

    /* A row of two panels. The panel's own bottom margin is dropped
       inside the grid so the gap is the only spacing. */
    .dash-row { margin-bottom: 20px; }
    .dash-row > .admin-panel { margin-bottom: 0; min-width: 0; }

    /* The one deliberate exception to the white surface: the globe canvas
       is transparent, so it needs a dark ground behind it to read at all.
       Navy, so it is the same dark the top bar uses. */
    .dash-globe { height: 380px; background: var(--admin-primary); border-radius: 0 0 var(--admin-r) var(--admin-r); overflow: hidden; }
    .dash-globe__viz { width: 100%; height: 100%; }
    .dash-globe canvas { display: block; }
    .dash-globe__fallback { padding: 32px 24px; text-align: center; color: var(--admin-primary-ink); font-size: 13px; opacity: 0.8; }

    /* Chart.js needs a positioned box with a fixed height to size into. */
    .dash-chart { position: relative; height: 300px; width: 100%; }

    /* Tables that live inside a flush panel body: the panel already draws
       the border and the radius, so the wrap draws nothing. */
    .admin-panel__body--flush .admin-table-wrap { border: 0; border-radius: 0; margin: 0; }
    .dash-scroll { max-height: 300px; overflow-y: auto; }
    .dash-empty { margin: 0; padding: 18px; font-size: 13px; color: var(--admin-faint); }
    .dash-flag { display: inline-block; vertical-align: middle; margin-right: 6px; }
    .dash-share-col { width: 40%; }
    .dash-share { display: flex; align-items: center; gap: 8px; }
    .dash-share .admin-bar { flex: 1; }
    .dash-share__pct { min-width: 40px; text-align: right; font-size: 12px; color: var(--admin-muted); }

    /* Traffic sources: one row per channel, divided by hairlines. */
    .source-list { display: flex; flex-direction: column; }
    .source-item { display: flex; align-items: center; gap: 12px; padding: 9px 0; border-top: 1px solid var(--admin-border); }
    .source-item:first-child { border-top: 0; padding-top: 0; }
    .source-icon { width: 32px; height: 32px; border-radius: var(--admin-r-sm); display: flex; align-items: center; justify-content: center; flex: none; }
    .source-info { flex: 1; min-width: 0; }
    .source-name { font-size: 13.5px; font-weight: 500; color: var(--admin-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .source-bar-wrap { height: 6px; background: var(--admin-panel-3); border-radius: 3px; margin-top: 5px; overflow: hidden; }
    .source-bar { height: 100%; border-radius: 3px; background: var(--admin-primary); transition: width 0.6s ease; }
    .source-stats { text-align: right; flex: none; }
    .source-count { font-size: 14px; font-weight: 600; color: var(--admin-text); font-variant-numeric: tabular-nums; }
    .source-pct { font-size: 12px; color: var(--admin-faint); font-variant-numeric: tabular-nums; }
    .source-note { font-size: 12.5px; color: var(--admin-muted); line-height: 1.5; margin: 0; }
    .source-note--inset { margin: 8px 0 10px; }

    /* What Direct is made of: a fold under the source list. */
    .direct-breakdown { margin-top: 16px; border-top: 1px solid var(--admin-border); padding-top: 12px; }
    .direct-breakdown summary { cursor: pointer; font-size: 13px; font-weight: 600; color: var(--admin-muted); display: flex; align-items: center; gap: 8px; list-style: none; }
    .direct-breakdown summary::-webkit-details-marker { display: none; }
    .direct-breakdown summary::before { content: '+'; color: var(--admin-primary); font-size: 15px; line-height: 1; }
    .direct-breakdown[open] summary::before { content: '\2212'; }
    .direct-breakdown summary:hover { color: var(--admin-text); }
    .direct-count { margin-left: auto; font-family: var(--admin-font-mono); font-size: 12px; color: var(--admin-primary); }
    .direct-list { list-style: none; margin: 0; padding: 0; }
    .direct-list li { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 6px 0; border-top: 1px solid var(--admin-border); font-size: 12.5px; }
    .direct-page { color: var(--admin-muted); font-family: var(--admin-font-mono); font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .direct-n { color: var(--admin-text); font-weight: 600; flex: none; font-variant-numeric: tabular-nums; }

    /* ── Folded lists ─────────────────────────────────────────────────
       Long panels show their first five and keep the rest one click away.
       A dashboard is read by scanning, and a fifteen-row table pushes the
       next panel off the screen to say things nobody scans for.

       The rows are RENDERED and hidden, not dropped: the toggle is instant
       and needs no second request, and "show all" is the truth rather than
       a link to somewhere else. */
    .is-folded { display: none !important; }
    .dash-fold-btn { margin-top: 12px; }

    /* Revenue by channel */
    .rev-row { padding: 10px 0; border-top: 1px solid var(--admin-border); }
    .rev-row:first-child { border-top: 0; padding-top: 0; }
    .rev-row__top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
    .rev-row__name { font-weight: 500; font-size: 13.5px; color: var(--admin-text); }
    .rev-row__amount { font-weight: 600; color: var(--admin-text); font-variant-numeric: tabular-nums; }
    .rev-row__bar { margin: 6px 0 5px; }
    .rev-row__meta { font-size: 12px; color: var(--admin-muted); font-variant-numeric: tabular-nums; }

    /* ── Channel drill-down ── */
    .rev-drill { background: none; border: 0; padding: 0; font: inherit; color: var(--admin-primary-soft);
                 cursor: pointer; text-decoration: underline; text-underline-offset: 2px;
                 font-variant-numeric: tabular-nums; }
    .rev-drill:hover { color: var(--admin-primary); }
    .cd-table td.rev { font-weight: 600; }
    .cd-slug { display: block; font-size: 11.5px; color: var(--admin-faint); font-family: var(--admin-font-mono); }
    .cd-state { padding: 28px 8px; text-align: center; color: var(--admin-muted); font-size: 13px; }
  </style>
</head>
<body class="admin-body">
  <%- include('_sidebar', { currentPath: '/admin' }) %>

  <main class="admin-main">
    <header class="admin-header">
      <div>
        <h1 class="admin-header__title"><%= pageTitle %></h1>
        <p class="admin-header__sub">Last updated: <%= new Date().toLocaleTimeString() %></p>
      </div>
      <div class="admin-header__actions">
        <form action="/admin" method="GET" id="rangeForm" class="dash-range">
          <select name="range" class="admin-select" onchange="if(this.value !== 'custom') this.form.submit(); else document.getElementById('customDates').style.display='flex';">
            <option value="today" <%= range === 'today' ? 'selected' : '' %>>Today</option>
            <option value="yesterday" <%= range === 'yesterday' ? 'selected' : '' %>>Yesterday</option>
            <option value="week" <%= range === 'week' ? 'selected' : '' %>>This week</option>
            <option value="month" <%= range === 'month' ? 'selected' : '' %>>This month</option>
            <option value="year" <%= range === 'year' ? 'selected' : '' %>>This year</option>
            <option value="all" <%= range === 'all' ? 'selected' : '' %>>All time</option>
            <option value="custom" <%= range === 'custom' ? 'selected' : '' %>>Custom range</option>
          </select>
          <%/* display is inline on purpose: the select's onchange above
               flips it, so it has to be the inline property it writes. */%>
          <div id="customDates" class="dash-range__custom" style="display: <%= range === 'custom' ? 'flex' : 'none' %>">
            <input type="date" name="start" value="<%= typeof startDate !== 'undefined' ? startDate : '' %>" class="admin-input">
            <span class="small faint">to</span>
            <input type="date" name="end" value="<%= typeof endDate !== 'undefined' ? endDate : '' %>" class="admin-input">
            <button type="submit" class="admin-btn admin-btn--primary admin-btn--sm">Apply</button>
          </div>
        </form>
      </div>
    </header>
    <div class="admin-content">

    <%
      /* Period-over-period delta. Returns nothing at all when there is no
         comparable previous window (all-time range) or when the previous
         value was zero — "+100%" against a zero baseline reads as growth
         when it really means "the first one". Direction is stated in words
         for screen readers, not only by colour.

         deltaHtml is printed with the raw tag: every character it emits is
         its own literal markup or a number it computed; nothing from a
         request or a record goes through it. */
      function delta(current, prev) {
        if (!previous || prev === undefined || prev === null) return null;
        if (prev === 0) return current > 0 ? { text: 'new', up: true, neutral: true } : null;
        const pct = ((current - prev) / prev) * 100;
        if (Math.abs(pct) < 0.5) return { text: 'no change', up: null, neutral: true };
        return { text: (pct > 0 ? '+' : '') + pct.toFixed(0) + '%', up: pct > 0, neutral: false };
      }
      function deltaHtml(current, prev, higherIsBetter) {
        const d = delta(current, prev);
        if (!d) return '';
        var cls = d.neutral ? 'is-neutral' : ((d.up === (higherIsBetter !== false)) ? 'is-good' : 'is-bad');
        var arrow = d.up === null ? '' : (d.up ? '↑' : '↓');
        return '<div class="admin-stat-card__delta ' + cls + '">' + arrow + ' ' + d.text +
               ' <span class="delta-vs">vs previous</span></div>';
      }
    %>
    <%/* Money a partner host confirmed with Whop where the customer's
         browser never reached our /thank-you, so no order exists. It lives
         in full on the Orders page; this is the pointer, because it is the
         one figure that means "possibly taken and not recorded" and it
         should not need a second page load to notice. Deliberately not
         scoped to the date range: an unresolved payment is a problem
         whichever window is selected. */%>
    <% if ((typeof unconfirmedPaymentCount !== 'undefined') && unconfirmedPaymentCount > 0) { %>
      <a href="/admin/orders" class="admin-alert admin-alert--error dash-unconfirmed" role="alert">
        <span class="dash-unconfirmed__dot" aria-hidden="true"></span>
        <strong><%= unconfirmedPaymentCount %></strong>
        payment<%= unconfirmedPaymentCount === 1 ? '' : 's' %> taken but never confirmed
        <span class="dash-unconfirmed__cta">Review on Orders &rarr;</span>
      </a>
    <% } %>

    <!-- Stats -->
    <div class="admin-stats-grid">
      <div class="admin-stat-card">
        <div class="admin-stat-card__num"><%= stats.views || 0 %></div>
        <div class="admin-stat-card__label">Unique visitors</div>
        <%- deltaHtml(stats.views || 0, previous && previous.views, true) %>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-card__num"><%= stats.checkouts || 0 %></div>
        <div class="admin-stat-card__label">Checkouts</div>
        <%- deltaHtml(stats.checkouts || 0, previous && previous.checkouts, true) %>
      </div>
      <%/* Confirmed Arrivals used to sit here and reported the same number
           as Checkouts in practice, so it told you nothing. This is a real
           later step: the payment iframe actually rendered for these
           people. Buyers are included, so it is not styled as a warning. */%>
      <div class="admin-stat-card" title="Filled the checkout form and got as far as Whop's payment step. Includes the ones who went on to pay.">
        <div class="admin-stat-card__num"><%= stats.reachedCheckout || 0 %></div>
        <div class="admin-stat-card__label">Reached checkout</div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-card__num"><%= stats.orders || 0 %></div>
        <div class="admin-stat-card__label">Orders</div>
        <%- deltaHtml(stats.orders || 0, previous && previous.orders, true) %>
      </div>
      <%/* totalPrice is stored in cents, so formatPrice does the divide and
           the thousands separator in one place rather than each view
           inventing its own. Revenue is the one figure worth finding
           first, so it is the page's accent card. */%>
      <div class="admin-stat-card admin-stat-card--accent">
        <div class="admin-stat-card__num">$<%= formatPrice(stats.revenue || 0) %></div>
        <div class="admin-stat-card__label">Revenue</div>
        <%- deltaHtml(stats.revenue || 0, previous && previous.revenue, true) %>
      </div>
      <div class="admin-stat-card">
        <% const conversionRate = stats.views > 0 ? ((stats.orders / stats.views) * 100).toFixed(1) : 0; %>
        <div class="admin-stat-card__num"><%= conversionRate %>%</div>
        <div class="admin-stat-card__label">Conversion rate</div>
      </div>
    </div>

    <!-- Globe + hourly chart -->
    <div class="grid-2 dash-row">
      <div class="admin-panel">
        <div class="admin-panel__head">
          <h2 class="admin-panel__title">Live traffic globe</h2>
          <%/* The live count used to be a seventh stat card, sitting beside
               figures for the selected date range even though it only ever
               describes right now. It belongs on the globe, which is the
               thing actually plotting those visitors. */%>
          <span class="admin-live-count"><span class="live-dot"></span><span id="live-count"><%= liveVisitors.length %></span> live now</span>
        </div>
        <div class="admin-panel__body admin-panel__body--flush">
          <div class="dash-globe">
            <div id="globeViz" class="dash-globe__viz"></div>
          </div>
        </div>
      </div>

      <div class="admin-panel">
        <div class="admin-panel__head">
          <h2 class="admin-panel__title">Hourly unique visitors</h2>
        </div>
        <div class="admin-panel__body">
          <div class="dash-chart">
            <canvas id="hourlyChart"></canvas>
          </div>
        </div>
      </div>
    </div>

    <%/* `chart-card` on a panel body is a hook, not a style: the fold
         script below appends its "Show all" button to the nearest
         .chart-card so the button lands after the list rather than inside
         a <table>. */%>
    <!-- Traffic sources + live visitors -->
    <div class="grid-2 dash-row">
      <div class="admin-panel">
        <div class="admin-panel__head">
          <div>
            <h2 class="admin-panel__title">Traffic sources</h2>
            <p class="admin-panel__sub">Unique visitors, each credited to the channel that first brought them.</p>
          </div>
        </div>
        <div class="admin-panel__body chart-card">
          <div class="source-list" id="sourceList" data-collapse="5"></div>

          <%
            /* What is left in Direct after in-app browsers are recovered,
               broken down by the page each visitor landed on. Landing on "/"
               suggests a typed address or a bookmark; landing straight on a
               product URL means a link from somewhere that stripped the
               referrer (messaging app, email, QR code, privacy setting). */
            var dl = (typeof directLandings !== 'undefined' && directLandings) || [];
            var dlTotal = dl.reduce(function (n, r) { return n + r.count; }, 0);
          %>
          <% if (dlTotal > 0) { %>
            <details class="direct-breakdown">
              <summary>What Direct is made of <span class="direct-count"><%= dlTotal %></span></summary>
              <p class="source-note source-note--inset">
                These arrived with no referrer and no in-app browser signature. The page they
                landed on is the best remaining clue: the homepage suggests a typed address or a
                bookmark, a deep product URL means a link from somewhere that strips referrers.
              </p>
              <ul class="direct-list">
                <% dl.forEach(function (r) { %>
                  <li>
                    <span class="direct-page"><%= r._id %></span>
                    <span class="direct-n"><%= r.count %></span>
                  </li>
                <% }); %>
              </ul>
            </details>
          <% } %>
        </div>
      </div>

      <div class="admin-panel">
        <div class="admin-panel__head">
          <h2 class="admin-panel__title"><span class="live-dot"></span> Live visitors</h2>
          <span class="tiny faint">Auto-refreshes every 10s</span>
        </div>
        <div class="admin-panel__body admin-panel__body--flush">
          <div id="live-visitors-container" class="dash-scroll">
            <% if (liveVisitors.length === 0) { %>
              <p class="dash-empty">No active visitors right now.</p>
            <% } else { %>
              <div class="admin-table-wrap">
                <table class="admin-table">
                  <thead><tr><th>Page</th><th>IP</th><th>Country</th><th>Last seen</th></tr></thead>
                  <tbody>
                    <% liveVisitors.forEach(function(v) { %>
                      <tr>
                        <td><code><%= v.page %></code></td>
                        <td class="mono"><%= v.ip %></td>
                        <td>
                          <% if (v.countryCode) { %>
                            <img src="https://flagcdn.com/w20/<%= v.countryCode.toLowerCase() %>.png" width="16" height="12" class="dash-flag" alt="<%= v.country %>">
                          <% } %>
                          <%= v.country || 'Unknown' %>
                        </td>
                        <td class="muted nowrap"><%= new Date(v.lastSeen).toLocaleTimeString() %></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Revenue by channel + top products by revenue -->
    <div class="grid-2 dash-row">
      <%/* Traffic Sources counts VISITORS per channel, which answers who
           shows up but not who pays, and the two routinely disagree by an
           order of magnitude. This is the panel that decides where ad
           money goes. */%>
      <% if ((typeof revenueBySource !== 'undefined') && revenueBySource.length) { %>
        <div class="admin-panel">
          <div class="admin-panel__head">
            <div>
              <h2 class="admin-panel__title">Revenue by channel</h2>
              <p class="admin-panel__sub">Where the money actually came from, by each buyer's first-touch channel.</p>
            </div>
          </div>
          <div class="admin-panel__body chart-card">
            <div class="source-list" data-collapse="5">
              <% revenueBySource.forEach(function (r) {
                   var pct = ((r.revenue / revenueBySourceTotal) * 100); %>
                <div class="rev-row">
                  <div class="rev-row__top">
                    <span class="rev-row__name"><%= r.name %></span>
                    <span class="rev-row__amount">$<%= formatPrice(r.revenue) %></span>
                  </div>
                  <div class="admin-bar rev-row__bar"><div class="admin-bar__fill rev-row__fill" style="width:<%= pct.toFixed(1) %>%"></div></div>
                  <div class="rev-row__meta">
                    <%= pct.toFixed(1) %>% of revenue
                    &middot;
                    <%/* The order count opens what is behind it. Which channel
                         earns is only half the question; which PRODUCTS it
                         earns from is the half that decides where ad money
                         goes. A real <button> so it is keyboard-reachable and
                         announced as clickable rather than looking like text
                         that happens to respond. */%>
                    <button type="button" class="rev-drill" data-source="<%= r.name %>"
                            title="Show the products sold through <%= r.name %>">
                      <%= r.orders %> order<%= r.orders === 1 ? '' : 's' %>
                    </button>
                    &middot; $<%= formatPrice(Math.round(r.revenue / r.orders)) %> avg
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        </div>
      <% } %>

      <%/* Ranked by revenue, not views. The views panel below puts a cheap
           item that gets browsed a lot above an expensive one that
           actually sells, which is backwards for restocking decisions. */%>
      <% if ((typeof topProductsByRevenue !== 'undefined') && topProductsByRevenue.length) { %>
        <div class="admin-panel">
          <div class="admin-panel__head">
            <div>
              <h2 class="admin-panel__title">Top products by revenue</h2>
              <p class="admin-panel__sub">What sold, ranked by money rather than by page views.</p>
            </div>
          </div>
          <div class="admin-panel__body admin-panel__body--flush chart-card">
            <div class="admin-table-wrap">
              <table class="admin-table">
                <thead><tr><th class="num">#</th><th>Product</th><th class="num">Units</th><th class="num">Revenue</th></tr></thead>
                <tbody data-collapse="5">
                  <% topProductsByRevenue.forEach(function (tp, i) { %>
                    <tr>
                      <td class="num faint"><%= i + 1 %></td>
                      <td><%= tp._id %></td>
                      <td class="num"><%= tp.units %></td>
                      <td class="num"><strong>$<%= formatPrice(tp.revenue) %></strong></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Most viewed products + top countries -->
    <div class="grid-2 dash-row">
      <% if (topProducts && topProducts.length > 0) { %>
        <div class="admin-panel">
          <div class="admin-panel__head">
            <div>
              <h2 class="admin-panel__title">Most viewed products</h2>
              <p class="admin-panel__sub">Interest, not sales. Compare with Revenue above to spot what gets looked at but not bought.</p>
            </div>
          </div>
          <div class="admin-panel__body admin-panel__body--flush chart-card">
            <div class="admin-table-wrap">
              <table class="admin-table">
                <thead><tr><th class="num">#</th><th>Product</th><th class="num">Views</th></tr></thead>
                <tbody data-collapse="5">
                  <% topProducts.forEach(function(tp, idx) { %>
                    <tr><td class="num faint"><%= idx + 1 %></td><td><%= tp._id %></td><td class="num"><%= tp.views %></td></tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% } %>

      <% if (typeof topCountries !== 'undefined' && topCountries && topCountries.length > 0) { %>
        <div class="admin-panel">
          <div class="admin-panel__head">
            <h2 class="admin-panel__title">Top countries</h2>
          </div>
          <%/* Was a 350px scroll box, which hides its own length: you cannot
               tell from the outside whether there are six countries or sixty,
               and a nested scrollbar inside a page that already scrolls is a
               trap for a trackpad. Folded like the rest. */%>
          <div class="admin-panel__body admin-panel__body--flush chart-card">
            <div class="admin-table-wrap">
              <table class="admin-table">
                <thead><tr><th class="num">#</th><th>Country</th><th class="num">Visitors</th><th class="dash-share-col">Share</th></tr></thead>
                <tbody data-collapse="5">
                  <%
                    const totalCountryViews = topCountries.reduce((s, c) => s + c.views, 0);
                    topCountries.forEach(function(c, idx) {
                      const pct = totalCountryViews > 0 ? ((c.views / totalCountryViews) * 100).toFixed(1) : 0;
                  %>
                    <tr>
                      <td class="num faint"><%= idx + 1 %></td>
                      <td>
                        <% if (c._id) { %>
                          <img src="https://flagcdn.com/w20/<%= c._id.toLowerCase() %>.png" width="16" height="12" class="dash-flag" alt="<%= c._id %>" onerror="this.style.display='none'">
                          <%= c._id %>
                        <% } else { %>
                          Unknown
                        <% } %>
                      </td>
                      <td class="num"><%= c.views %></td>
                      <td>
                        <div class="dash-share">
                          <div class="admin-bar"><div class="admin-bar__fill" style="width:<%= pct %>%"></div></div>
                          <span class="dash-share__pct"><%= pct %>%</span>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% } %>
    </div>

    </div>
  </main>

  <script>
   // Chart.js & globe.gl load with `defer`, so run everything that touches
   // them after DOMContentLoaded (deferred scripts finish before that fires).
   document.addEventListener('DOMContentLoaded', function () {
    // ── Data from server ──
    const hourlyData = <%- hourlyChart %>;
    const trafficSources = <%- trafficSources %>;
    const globePins = <%- globePins %>;

    // ── Hourly Unique Visitors Chart ──
    const hourLabels = Array.from({length: 24}, (_, i) => {
      const h = i % 12 || 12;
      return h + (i < 12 ? 'AM' : 'PM');
    });

    new Chart(document.getElementById('hourlyChart'), {
      type: 'bar',
      data: {
        labels: hourLabels,
        datasets: [{
          label: 'Unique Visitors',
          data: hourlyData,
          /* One flat colour, no outline.
             These were a brass-to-bordeaux gradient with a lit border, so
             every bar carried a vertical colour ramp and a bright edge that
             said nothing about its value — two bars differed by height AND
             by how much red had crept in, which is a second encoding of
             nothing. A single tone lets height do the whole job.
             Navy at 60%, full navy under the cursor: the admin's own ink. */
          backgroundColor: 'rgba(15, 42, 74, 0.6)',
          hoverBackgroundColor: '#0F2A4A',
          borderWidth: 0,
          borderRadius: 3,
          borderSkipped: false,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#F7F8FA',
            titleColor: '#111827',
            bodyColor: '#4B5563',
            borderColor: '#C9D0DA',
            borderWidth: 1,
            cornerRadius: 6,
            padding: 10,
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: { color: '#6B7280', font: { size: 10 }, maxRotation: 0 }
          },
          y: {
            beginAtZero: true,
            grid: { color: '#E3E6EC' },
            ticks: { color: '#6B7280', font: { size: 11 }, precision: 0 }
          }
        }
      }
    });

    // ── Traffic Sources ──
    // Navy-family palette so the whole panel stays on the admin's palette.
    // Icons keep their brand glyph; bars are tinted navy/blue/slate.
    const BAR = { navy: '#0F2A4A', blue: '#1D4FB8', steel: '#5B7FB5', green: '#15803D', slate: '#6B7280', muted: '#9AA3B2' };
    const chip = () => 'var(--admin-primary-tint)';

    /* ── Source marks ──────────────────────────────────────────────────
     *
     * Emoji before this, which was the wrong tool twice over: a 📢 and a
     * 🔵 are not what Google Ads and Bing look like to anyone, and every
     * platform draws them differently, so the column never lined up and
     * never looked like software.
     *
     * Drawn as monochrome glyphs taking `currentColor`, tinted to the same
     * bar colour as the row. Monochrome on purpose — an approximated
     * four-colour Google mark is a worse, and more misleading, thing to
     * ship than the brand's own geometry in one ink, and it would fight
     * the navy palette the rest of the panel is built from.
     *
     * viewBox is 24x24 for every one of them so they optically match at
     * 18px without per-icon nudging. */
    const I = (body) => '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">' + body + '</svg>';
    const ILINE = (body) => '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + body + '</svg>';

    const MARK = {
      // The Google G, in one ink.
      google: I('<path d="M12.2 10.4v3.1h4.4c-.2 1.1-1.4 3.3-4.4 3.3a5 5 0 110-10c1.5 0 2.6.6 3.2 1.2l2.2-2.1A8.2 8.2 0 1012.2 20c4.7 0 7.9-3.3 7.9-8 0-.5 0-.9-.1-1.3z"/>'),
      // Google Ads: the two angled bars and the dot.
      /* Stroked rather than two rotated rects: at 18px the rects overlapped
         into a single sliver, and this is the row that carries most of the
         traffic — it has to be the most legible mark in the column. */
      googleAds: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="4.3" stroke-linecap="round" aria-hidden="true"><path d="M12 4.4l5.8 12.4"/><path d="M12 4.4L7.6 13.8" opacity=".5"/><circle cx="6.7" cy="17.9" r="2.9" fill="currentColor" stroke="none"/></svg>',
      // Bing's swoosh.
      bing: I('<path d="M6 2.6l3.9 1.4v11.2l4.3-2.5-2.1-1-1.3-3.3 7.2 2.6v3.6L9.9 21.4 6 19.2z"/>'),
      // Yahoo's letterform.
      yahoo: I('<path d="M3 6.2h3.5l2.9 5 2.9-5H16l-5 8.3v4.3H8.2v-4.3z"/><circle cx="18.4" cy="16.9" r="1.9"/><path d="M17.2 5.2h2.6l-.6 8h-1.4z"/>'),
      // DuckDuckGo's duck, reduced to head and bill in its circle.
      duckduckgo: ILINE('<circle cx="12" cy="12" r="9.2"/><path d="M13.9 8.3a2.4 2.4 0 10-3.3 2.2c-.5 2.3-.7 4.2-.5 5.8 1.9.7 3.7.7 5.4 0l-1.4-4.2"/><path d="M14.6 7.6l2.6.5-2.3 1.2"/>'),
      // OpenAI's knot, simplified to its hexagonal weave.
      chatgpt: '<svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.4l7.4 4.3v8.6L12 19.6l-7.4-4.3V6.7z"/><path d="M12 2.4v8.6l7.4 4.3M12 11L4.6 15.3M12 11v8.6"/></svg>',
      // Facebook's f.
      facebook: I('<path d="M22 12a10 10 0 10-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0022 12z"/>'),
      // Trustpilot is a star.
      trustpilot: I('<path d="M12 2.6l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.5 6.1 20.6l1.2-6.5-4.8-4.6 6.6-.9z"/>'),
      reddit: I('<path d="M22 11.8a2.2 2.2 0 00-3.7-1.6c-1.5-1-3.5-1.6-5.7-1.7l1-4.5 3.1.7a1.8 1.8 0 101.8-1.9 1.8 1.8 0 00-1.6 1L13 3a.7.7 0 00-.8.5l-1.1 5.1c-2.2 0-4.3.7-5.8 1.7A2.2 2.2 0 002 11.8c0 .9.5 1.6 1.2 2v.7c0 3.4 3.9 6.1 8.8 6.1s8.8-2.7 8.8-6.1v-.7c.7-.4 1.2-1.1 1.2-2zM7 13.4a1.6 1.6 0 113.2 0 1.6 1.6 0 01-3.2 0zm8.9 4.2c-1 1-3 1.1-3.9 1.1s-2.9 0-3.9-1.1a.4.4 0 010-.6.4.4 0 01.6 0c.7.7 2.1.9 3.3.9s2.6-.2 3.3-.9a.4.4 0 01.6.6zm-.5-2.6a1.6 1.6 0 110-3.2 1.6 1.6 0 010 3.2z"/>'),
      tiktok: I('<path d="M17 3.2c.5 2 1.9 3.5 3.9 3.8v3c-1.5.1-2.9-.3-4.2-1.2v6.1c0 4.3-3.7 7-7.3 5.6-2.4-1-3.6-3.6-3-6.1.6-2.4 2.9-4 5.4-3.8v3.1c-.4-.1-.8-.1-1.2 0-1.2.2-2 1.3-1.8 2.5.2 1.1 1.2 1.9 2.3 1.8 1.3-.1 2.2-1.1 2.2-2.5V3.2z"/>'),
      twitter: I('<path d="M17.5 3h3.1l-6.8 7.8L21.8 21h-6.3l-4.9-6.4L4.9 21H1.8l7.3-8.3L2.2 3h6.5l4.4 5.8zm-1.1 16.1h1.7L7.7 4.8H5.9z"/>'),
      youtube: I('<path d="M21.6 7.2a2.5 2.5 0 00-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 00-1.8 1.8A26 26 0 002 12a26 26 0 00.4 4.8 2.5 2.5 0 001.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 001.8-1.8A26 26 0 0022 12a26 26 0 00-.4-4.8zM10 15.1V8.9l5.2 3.1z"/>'),
      snapchat: I('<path d="M12 2.6c2.7 0 4.6 2 4.6 4.7 0 .9-.1 1.7-.1 2.3.4.2.9.2 1.4 0 .5-.1 1 .2 1.1.6.1.5-.2 1-.9 1.3-.7.3-1.6.5-1.6 1 0 .8 2 2.7 3.6 3.2.4.1.6.5.5.9-.2.6-1.3.9-2.4 1.1-.2.4-.2.9-.4 1.1-.2.2-.6.2-1.1.1-.6-.1-1.4-.2-2.2 0-.8.2-1.5 1.1-2.5 1.1s-1.7-.9-2.5-1.1c-.8-.2-1.6-.1-2.2 0-.5.1-.9.1-1.1-.1-.2-.2-.2-.7-.4-1.1-1.1-.2-2.2-.5-2.4-1.1-.1-.4.1-.8.5-.9 1.6-.5 3.6-2.4 3.6-3.2 0-.5-.9-.7-1.6-1-.7-.3-1-.8-.9-1.3.1-.4.6-.7 1.1-.6.5.2 1 .2 1.4 0 0-.6-.1-1.4-.1-2.3C7.4 4.6 9.3 2.6 12 2.6z"/>'),
      pinterest: I('<path d="M12 2a10 10 0 00-3.6 19.3c-.1-.8-.2-2 0-2.9l1.2-5.1s-.3-.6-.3-1.5c0-1.4.8-2.5 1.9-2.5.9 0 1.3.7 1.3 1.5 0 .9-.6 2.2-.9 3.5-.2 1 .5 1.9 1.6 1.9 1.9 0 3.3-2 3.3-4.9 0-2.6-1.8-4.4-4.4-4.4-3 0-4.8 2.2-4.8 4.6 0 .9.3 1.9.8 2.4.1.1.1.2.1.3l-.3 1.1c0 .2-.2.2-.4.1-1.4-.7-2.3-2.7-2.3-4.4 0-3.6 2.6-6.9 7.5-6.9 3.9 0 7 2.8 7 6.5 0 3.9-2.5 7.1-5.9 7.1-1.2 0-2.3-.6-2.6-1.3l-.7 2.7c-.3 1-1 2.3-1.5 3.1A10 10 0 1012 2z"/>'),
      // Not brands: a direct arrival, and everything unrecognised.
      direct: ILINE('<path d="M12 20V6"/><path d="M6.5 11.5L12 6l5.5 5.5"/><path d="M4 3.5h16"/>'),
      other: ILINE('<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 010 18 14 14 0 010-18z"/>'),
    };

    const sourceColors = {
      'Facebook':    { bg: chip(), bar: BAR.steel,  icon: MARK.facebook },
      'Google':      { bg: chip(), bar: BAR.blue,   icon: MARK.google },
      'Google Ads':  { bg: chip(), bar: BAR.navy,   icon: MARK.googleAds },
      'Bing':        { bg: chip(), bar: BAR.blue,   icon: MARK.bing },
      'Bing Ads':    { bg: chip(), bar: BAR.navy,   icon: MARK.bing },
      'Yahoo':       { bg: chip(), bar: BAR.slate,  icon: MARK.yahoo },
      'DuckDuckGo':  { bg: chip(), bar: BAR.green,  icon: MARK.duckduckgo },
      'ChatGPT':     { bg: chip(), bar: BAR.green,  icon: MARK.chatgpt },
      'Trustpilot':  { bg: chip(), bar: BAR.green,  icon: MARK.trustpilot },
      'Reddit':      { bg: chip(), bar: BAR.steel,  icon: MARK.reddit },
      'TikTok':      { bg: chip(), bar: BAR.slate,  icon: MARK.tiktok },
      'Twitter/X':   { bg: chip(), bar: BAR.steel,  icon: MARK.twitter },
      'YouTube':     { bg: chip(), bar: BAR.steel,  icon: MARK.youtube },
      'Snapchat':    { bg: chip(), bar: BAR.slate,  icon: MARK.snapchat },
      'Pinterest':   { bg: chip(), bar: BAR.steel,  icon: MARK.pinterest },
      'Direct':      { bg: chip(), bar: BAR.navy,   icon: MARK.direct },
      'Other':       { bg: chip(), bar: BAR.muted,  icon: MARK.other },
    };

    /* An unrecognised utm_source is passed through raw by
       middleware/tracking, so the list carries values like "chatgpt.com"
       and "trustpilot" that no exact key will ever match — they were all
       landing on the globe. Matching on a normalised key (lowercased, www
       and TLD removed) is what puts a mark on them, and anything genuinely
       unknown still falls through to Other. */
    const ALIAS = {
      'chatgpt': 'ChatGPT', 'openai': 'ChatGPT', 'chat.openai': 'ChatGPT',
      'trustpilot': 'Trustpilot', 'duckduckgo': 'DuckDuckGo', 'ddg': 'DuckDuckGo',
      'google': 'Google', 'googleads': 'Google Ads', 'adwords': 'Google Ads',
      'bing': 'Bing', 'yahoo': 'Yahoo', 'facebook': 'Facebook', 'instagram': 'Facebook',
      'reddit': 'Reddit', 'tiktok': 'TikTok', 'youtube': 'YouTube',
      'twitter': 'Twitter/X', 'x': 'Twitter/X', 'pinterest': 'Pinterest',
      'snapchat': 'Snapchat', 'perplexity': 'ChatGPT', 'gemini': 'Google',
    };
    function styleFor(name) {
      if (sourceColors[name]) return sourceColors[name];
      const key = String(name || '').toLowerCase()
        .replace(/^www\./, '')
        .replace(/\.(com|org|net|io|ai|co\.[a-z]{2}|[a-z]{2})$/, '')
        .replace(/[^a-z.]/g, '');
      const hit = ALIAS[key];
      return (hit && sourceColors[hit]) || sourceColors['Other'];
    }

    const sourceList = document.getElementById('sourceList');
    if (trafficSources.length === 0) {
      sourceList.innerHTML = '<p class="dash-empty">No traffic data yet for this period.</p>';
    } else {
      /* s.name is an un-trusted traffic-source label (an unknown utm_source is
         stored raw), so it is HTML-escaped before it goes anywhere near
         innerHTML — otherwise a crafted utm_source value lands as live markup
         in this admin page (stored XSS). The counts are coerced to numbers so
         nothing but a number is ever interpolated. (The data itself is also
         embedded safely by the server; this is defence in depth.) */
      const escHtml = (v) => String(v == null ? '' : v).replace(/[&<>"'`]/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;', '`': '&#96;'
      })[c]);
      trafficSources.forEach(s => {
        const colors = styleFor(s.name);
        const name = escHtml(s.name);
        const count = Number(s.count) || 0;
        const percent = Math.max(0, Math.min(100, Number(s.percent) || 0));
        const item = document.createElement('div');
        item.className = 'source-item';
        item.innerHTML = `
          <div class="source-icon" style="background:${colors.bg};color:${colors.bar}">${colors.icon}</div>
          <div class="source-info">
            <div class="source-name">${name}</div>
            <div class="source-bar-wrap"><div class="source-bar" style="width:${percent}%;background:${colors.bar}"></div></div>
          </div>
          <div class="source-stats">
            <div class="source-count">${count}</div>
            <div class="source-pct">${percent}%</div>
          </div>
        `;
        sourceList.appendChild(item);
      });
    }

    /* ── Fold long panels to their first five ──────────────────────────
     *
     * One mechanism for all five, driven by data-collapse on whatever
     * element holds the rows — a <tbody> for the tables, a .source-list
     * div for the two bar lists. Marking the container rather than writing
     * a slice into each panel means a new panel only has to add the
     * attribute, and the server keeps sending the whole list.
     *
     * The rows are rendered and HIDDEN, not dropped: the toggle is instant,
     * needs no second request, and the count on the button is the real
     * total rather than a guess.
     *
     * Runs after the traffic-source list is built, because that one is
     * populated by the script above and has no children before then. */
    function foldPanels(root) {
      (root || document).querySelectorAll('[data-collapse]').forEach(function (box) {
        if (box.dataset.folded) return;
        var limit = parseInt(box.dataset.collapse, 10) || 5;
        var rows = [].filter.call(box.children, function (el) { return el.nodeType === 1; });
        if (rows.length <= limit) return;      // nothing to fold, no button
        box.dataset.folded = '1';

        var open = false;
        var fold = function () {
          rows.forEach(function (r, i) { r.classList.toggle('is-folded', !open && i >= limit); });
          btn.textContent = open ? 'Show top ' + limit : 'Show all ' + rows.length;
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        };
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'admin-btn admin-btn--ghost admin-btn--sm admin-btn--block dash-fold-btn';
        btn.addEventListener('click', function () { open = !open; fold(); });
        fold();

        /* Appended to the panel, not the container: a <button> is not
           valid inside a <tbody>, and inside the scrollable table wrap it
           would scroll away from the rows it controls. */
        (box.closest('.chart-card') || box.parentNode).appendChild(btn);
      });
    }
    foldPanels();

    // ── 3D Globe ──
    (function initGlobe() {
      const container = document.getElementById('globeViz');
      if (!container) return;

      try {
        /* The canvas is cleared to a fully transparent navy so the panel's
           own ground shows through; points, rings and atmosphere are the
           admin's link blue so they read on it. */
        const myGlobe = Globe()(container)
          .globeImageUrl('//unpkg.com/three-globe/example/img/earth-night.jpg')
          .backgroundColor('rgba(15,42,74,0)')
          .atmosphereColor('rgba(91,141,239,0.45)')
          .atmosphereAltitude(0.2)
          .pointsData(globePins)
          .pointLat('lat')
          .pointLng('lng')
          .pointColor(() => '#7FB0FF')
          .pointAltitude(d => Math.min(d.count * 0.02, 0.3))
          .pointRadius(0.4)
          .pointsMerge(true)
          .ringsData(globePins.slice(0, 20))
          .ringLat('lat')
          .ringLng('lng')
          .ringColor(() => t => `rgba(127,176,255,${1 - t})`)
          .ringMaxRadius(3)
          .ringPropagationSpeed(2)
          .ringRepeatPeriod(2000);

        // Auto-rotate
        myGlobe.controls().autoRotate = true;
        myGlobe.controls().autoRotateSpeed = 0.8;
        myGlobe.controls().enableZoom = false;

        // Size to container
        const w = container.clientWidth;
        const h = container.clientHeight;
        myGlobe.width(w).height(h);
      } catch(e) {
        container.innerHTML = '<p class="dash-globe__fallback">Globe requires WebGL. Your browser may not support it.</p>';
      }
    })();

    // ── Auto-refresh live visitors ──
    setInterval(async () => {
      try {
        const res = await fetch('/admin/api/live-visitors');
        const data = await res.json();
        document.getElementById('live-count').textContent = data.count;
      } catch(e) {}
    }, 10000);
   }); // end DOMContentLoaded
  </script>

<%/* Channel drill-down. One dialog reused for every row — the content is
     fetched on open rather than rendered for all channels up front, which
     would mean querying every channel's products on every dashboard load
     to populate popups that mostly never get opened. The cd-* classes stay
     beside the shared modal classes because the script below writes
     cd-state, cd-slug and cd-table into the body. */%>
<div class="admin-modal-backdrop cd-backdrop" id="cdBackdrop" hidden role="dialog" aria-modal="true" aria-labelledby="cdTitle">
  <div class="admin-modal cd-modal">
    <div class="admin-modal__head cd-head">
      <div>
        <h3 class="admin-modal__title cd-title" id="cdTitle">Products sold</h3>
        <p class="admin-modal__sub cd-sub" id="cdSub"></p>
      </div>
      <button type="button" class="admin-modal__close cd-close" id="cdClose" aria-label="Close">&times;</button>
    </div>
    <div class="admin-modal__body cd-body" id="cdBody"></div>
  </div>
</div>

<script>
(function () {
  var backdrop = document.getElementById('cdBackdrop');
  if (!backdrop) return;
  var titleEl = document.getElementById('cdTitle');
  var subEl   = document.getElementById('cdSub');
  var bodyEl  = document.getElementById('cdBody');
  var lastFocus = null;

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  /* Prices are stored in cents everywhere on this site. */
  function money(cents) {
    return '$' + (Number(cents || 0) / 100).toLocaleString('en-US',
      { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function open(source) {
    lastFocus = document.activeElement;
    titleEl.textContent = 'Products sold via ' + source;
    subEl.textContent = 'Same date range as the dashboard.';
    bodyEl.innerHTML = '<div class="cd-state">Loading…</div>';
    backdrop.hidden = false;
    document.getElementById('cdClose').focus();

    /* THE PAGE'S OWN QUERY STRING IS FORWARDED VERBATIM, rather than the
       range being read out and rebuilt here. It already carries range and,
       for a custom range, start and end — so the popup is guaranteed to be
       asking about the same window that produced the number clicked. */
    var qs = new URLSearchParams(window.location.search);
    qs.set('source', source);

    fetch('/admin/analytics/channel-orders?' + qs.toString(), { credentials: 'same-origin' })
      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
      .then(function (data) {
        if (!data.rows || !data.rows.length) {
          bodyEl.innerHTML = '<div class="cd-state">No products recorded for this channel in this range.</div>';
          return;
        }
        subEl.textContent = data.totals.orders + ' order' + (data.totals.orders === 1 ? '' : 's')
          + ' · ' + data.totals.units + ' unit' + (data.totals.units === 1 ? '' : 's')
          + ' · ' + money(data.totals.revenue) + ' total';

        var html = '<table class="admin-table cd-table"><thead><tr>'
          + '<th>Product</th><th class="num">Orders</th>'
          + '<th class="num">Units</th><th class="num">Revenue</th>'
          + '</tr></thead><tbody>';
        data.rows.forEach(function (r) {
          /* An order whose productSlug never got set still represents real
             money, so it is shown as unattributed rather than dropped. */
          var label = r.name ? esc(r.name) : (r.slug ? esc(r.slug) : '<em>No product recorded</em>');
          var slugLine = (r.name && r.slug) ? '<span class="cd-slug">' + esc(r.slug) + '</span>' : '';
          html += '<tr><td>' + label + slugLine + '</td>'
            + '<td class="num">' + r.orders + '</td>'
            + '<td class="num">' + r.units + '</td>'
            + '<td class="num rev">' + money(r.revenue) + '</td></tr>';
        });
        html += '</tbody></table>';
        bodyEl.innerHTML = html;
      })
      .catch(function (err) {
        bodyEl.innerHTML = '<div class="cd-state">Could not load this channel (' + esc(err.message) + ').</div>';
      });
  }

  function close() {
    backdrop.hidden = true;
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }

  document.addEventListener('click', function (e) {
    var btn = e.target.closest ? e.target.closest('.rev-drill') : null;
    if (btn) { open(btn.getAttribute('data-source') || ''); return; }
    if (e.target === backdrop) close();          // click outside the panel
    if (e.target.id === 'cdClose') close();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !backdrop.hidden) close();
  });
})();
</script>
</body>
</html>
