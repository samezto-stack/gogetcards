<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { title: pageTitle }) %>
  <style>
    /* Live chat: a two-column workbench. Session list on the left, the
       open thread on the right, both panels fixed to the viewport so the
       thread scrolls inside its own box and the reply bar stays put. */
    .ch-layout { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 20px; height: calc(100vh - var(--admin-topbar-h) - 64px - 48px); min-height: 460px; }
    .ch-layout > .admin-panel { margin: 0; display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
    .ch-list { flex: 1; min-height: 0; overflow-y: auto; }
    .ch-item { display: block; padding: 10px 16px; border-bottom: 1px solid var(--admin-border); color: var(--admin-text); text-decoration: none; }
    .ch-item:hover { background: var(--admin-panel-2); text-decoration: none; }
    .ch-item.is-active { background: var(--admin-primary-tint); box-shadow: inset 3px 0 0 var(--admin-primary); }
    .ch-item__top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 2px; }
    .ch-item__id { font-family: var(--admin-font-mono); font-size: 12px; color: var(--admin-faint); }
    .ch-item__time { font-size: 11.5px; color: var(--admin-faint); white-space: nowrap; }
    .ch-item__msg { display: flex; align-items: center; gap: 6px; font-size: 13px; min-width: 0; }
    .ch-item__text { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ch-item__you { color: var(--admin-muted); flex: none; }
    .ch-thread { flex: 1; min-height: 0; overflow-y: auto; padding: 18px; display: flex; flex-direction: column; gap: 12px; }
    .ch-msg { display: flex; flex-direction: column; max-width: 72%; }
    .ch-msg--user { align-self: flex-start; align-items: flex-start; }
    .ch-msg--admin { align-self: flex-end; align-items: flex-end; }
    .ch-bubble { padding: 9px 12px; border-radius: var(--admin-r-lg); font-size: 13.5px; line-height: 1.45; white-space: pre-wrap; overflow-wrap: anywhere; }
    .ch-msg--user .ch-bubble { background: var(--admin-panel-3); color: var(--admin-text); border-bottom-left-radius: 4px; }
    .ch-msg--admin .ch-bubble { background: var(--admin-primary); color: var(--admin-primary-ink); border-bottom-right-radius: 4px; }
    .ch-when { font-size: 11.5px; color: var(--admin-faint); margin-top: 3px; }
    .ch-reply { display: flex; gap: 8px; padding: 12px 14px; border-top: 1px solid var(--admin-border); background: var(--admin-panel-2); }
    .ch-reply .admin-input { flex: 1; }
    .ch-empty { flex: 1; display: flex; align-items: center; justify-content: center; text-align: center; padding: 24px; color: var(--admin-faint); font-size: 13.5px; }
    @media (max-width: 1023px) {
      .ch-layout { grid-template-columns: 1fr; height: auto; }
      .ch-list { max-height: 280px; }
      .ch-thread { min-height: 320px; max-height: 60vh; }
    }
  </style>
</head>
<body class="admin-body">
  <%- include('_sidebar', { currentPath: '/admin/chats' }) %>

  <main class="admin-main">
    <header class="admin-header">
      <div>
        <h1 class="admin-header__title">Live chat <span class="admin-header__count"><%= chatStats.length %></span></h1>
        <p class="admin-header__sub">Auto-refreshes every 10 seconds, except while you are typing a reply.</p>
      </div>
    </header>

    <div class="admin-content">
      <div class="ch-layout">

        <!-- Sessions -->
        <section class="admin-panel">
          <div class="admin-panel__head"><h2 class="admin-panel__title">Sessions</h2></div>
          <div class="ch-list">
            <% if (chatStats.length === 0) { %>
              <div class="ch-empty">No active chats.</div>
            <% } else { %>
              <% chatStats.forEach(stat => { %>
                <a href="/admin/chats?session=<%= stat._id %>" class="ch-item <%= activeSessionId === stat._id ? 'is-active' : '' %>">
                  <span class="ch-item__top">
                    <span class="ch-item__id"><%= stat._id.substring(0, 8) %>…</span>
                    <span class="ch-item__time"><%= new Date(stat.lastDate).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></span>
                  </span>
                  <span class="ch-item__msg">
                    <% if (stat.lastSender === 'admin') { %><span class="ch-item__you">You:</span><% } %>
                    <span class="ch-item__text"><%= stat.lastMessage %></span>
                    <% if (stat.unreadCount > 0) { %>
                      <span class="admin-tag admin-tag--navy"><%= stat.unreadCount %></span>
                    <% } %>
                  </span>
                </a>
              <% }) %>
            <% } %>
          </div>
        </section>

        <!-- Thread -->
        <section class="admin-panel">
          <% if (!activeSessionId) { %>
            <div class="ch-empty">Select a session on the left to read the conversation.</div>
          <% } else { %>
            <div class="admin-panel__head">
              <div>
                <h2 class="admin-panel__title">Conversation</h2>
                <p class="admin-panel__sub mono">Session <%= activeSessionId %></p>
              </div>
            </div>

            <div class="ch-thread" id="chat-thread">
              <% if (activeMessages.length === 0) { %>
                <div class="ch-empty">No messages in this session.</div>
              <% } else { %>
                <% activeMessages.forEach(msg => { %>
                  <div class="ch-msg <%= msg.sender === 'user' ? 'ch-msg--user' : 'ch-msg--admin' %>">
                    <div class="ch-bubble"><%= msg.message %></div>
                    <span class="ch-when">
                      <%= msg.sender === 'user' ? 'Customer' : 'Admin' %> &middot;
                      <%= new Date(msg.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                    </span>
                  </div>
                <% }) %>
              <% } %>
            </div>

            <form class="ch-reply" id="admin-chat-form">
              <input type="text" id="admin-chat-input" class="admin-input" placeholder="Type a reply to the customer..." autocomplete="off" required>
              <button type="submit" class="admin-btn admin-btn--primary">Send</button>
            </form>
          <% } %>
        </section>

      </div>
    </div>
  </main>

  <script>
    // Scroll thread to bottom
    const thread = document.getElementById('chat-thread');
    if (thread) {
      thread.scrollTop = thread.scrollHeight;
    }

    // Auto-refresh the page every 10 seconds to pull new messages
    // (A full SPA with websockets is better, but this works fine for a simple dashboard)
    setInterval(() => {
      // Don't refresh if the admin is actively typing
      const input = document.getElementById('admin-chat-input');
      if (!input || input.value.trim() === '') {
        window.location.reload();
      }
    }, 10000);

    // Handle Admin Reply
    const form = document.getElementById('admin-chat-form');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const input = document.getElementById('admin-chat-input');
        const text = input.value.trim();
        if (!text) return;

        try {
          const res = await fetch(`/admin/api/chats/<%= activeSessionId %>/reply`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: text })
          });
          if (res.ok) {
            window.location.reload();
          } else {
            alert('Failed to send message');
          }
        } catch (err) {
          console.error(err);
        }
      });
    }
  </script>
</body>
</html>
