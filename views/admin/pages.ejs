<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { title: pageTitle }) %>
</head>
<body class="admin-body">
  <%- include('_sidebar', { currentPath: '/admin/pages' }) %>
  <main class="admin-main">
    <header class="admin-header">
      <div>
        <h1 class="admin-header__title"><%= pageTitle %> <span class="admin-header__count"><%= pages.length %></span></h1>
        <p class="admin-header__sub">Policy and information pages served at /page/&lt;slug&gt;.</p>
      </div>
      <div class="admin-header__actions">
        <a href="/admin/pages/new" class="admin-btn admin-btn--primary">Add page</a>
      </div>
    </header>
    <div class="admin-content">
      <% if (success) { %>
        <div class="admin-alert admin-alert--success"><%= success %></div>
      <% } %>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead><tr><th>Title</th><th>Address</th><th>Category</th><th class="num"><span class="sr-only">Actions</span></th></tr></thead>
          <tbody>
            <% if (!pages.length) { %>
              <tr><td colspan="4" class="admin-table__empty">No pages yet.</td></tr>
            <% } %>
            <% pages.forEach(function(p) { %>
              <tr>
                <td><a href="/admin/pages/<%= p._id %>/edit" class="admin-cell-link"><%= p.title %></a></td>
                <td><a href="/page/<%= p.slug %>" target="_blank" rel="noopener" class="admin-code">/page/<%= p.slug %></a></td>
                <td><span class="admin-tag"><%= p.category %></span></td>
                <td class="num nowrap">
                  <a href="/admin/pages/<%= p._id %>/edit" class="admin-btn admin-btn--sm">Edit</a>
                  <form method="POST" action="/admin/pages/<%= p._id %>/delete" style="display:inline" onsubmit="return confirm('Delete this page?')">
                    <button class="admin-btn admin-btn--sm admin-btn--danger">Delete</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
