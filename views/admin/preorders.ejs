<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { title: pageTitle }) %>
  <style>
    /* One panel per set: title and release state in the head, the
       numbers in the body. */
    .po-card { margin-bottom: 12px; }
    /* The one state this page exists to surface: released, but people
       are still waiting. Given a colour rather than a number to work out. */
    .po-card.is-overdue { border-color: var(--admin-crit-line); }
    .po-card.is-overdue .admin-panel__head { background: var(--admin-crit-tint); }
    .po-card.is-imminent { border-color: var(--admin-warn-line); }
    .po-top { align-items: baseline; }
    .po-title { font-size: 14.5px; font-weight: 600; color: var(--admin-text); flex: 1; min-width: 240px; }
    .po-title:hover { color: var(--admin-primary-soft); text-decoration: none; }
    .po-when { font-size: 12.5px; color: var(--admin-muted); white-space: nowrap; }
    .po-when strong { color: var(--admin-text); font-weight: 500; }
    .po-nums { display: flex; flex-wrap: wrap; gap: 14px 28px; align-items: flex-end; padding: 14px 18px; }
    .po-num { min-width: 78px; }
    .po-num__v { font-size: 18px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; font-variant-numeric: tabular-nums; }
    .po-num__v--text { font-size: 13.5px; font-weight: 500; padding-top: 4px; }
    .po-acts { margin-left: auto; }
  </style>
</head>
<body class="admin-body">
  <%- include('_sidebar', { currentPath: '/admin/preorders' }) %>

  <main class="admin-main">
    <%
      const money = (c) => `$${(Number(c || 0) / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      const day = (d) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
    %>

    <header class="admin-header">
      <div>
        <h1 class="admin-header__title">Preorders <span class="admin-header__count"><%= rows.length %></span></h1>
      </div>
      <div class="admin-header__actions">
        <a class="admin-btn" href="/admin/orders?range=all&status=unfulfilled">Orders needing packing</a>
      </div>
    </header>

    <div class="admin-content">

      <% if (sent && sent.startsWith('release_')) { const p = sent.split('_'); %>
        <div class="admin-alert admin-alert--success">
          <span>
            Release update queued for <%= p[1] %> customer<%= p[1] === '1' ? '' : 's' %> holding <%= p[2] %> open
            preorder<%= p[2] === '1' ? '' : 's' %>. It goes out one message at a time; open the set below to watch it drain.
          </span>
        </div>
      <% } %>
      <% if (failed) { %>
        <div class="admin-alert admin-alert--error">
          Nothing was sent. Pick a product and try again.
        </div>
      <% } %>

      <% if (overdueCount) { %>
        <div class="admin-alert admin-alert--error">
          <span>
            <strong><%= overdueCount %></strong>
            <%= overdueCount === 1 ? 'set has' : 'sets have' %> passed their release date with orders still
            waiting. Every day of that is a customer wondering whether they have been forgotten. Ship them,
            or send a release update so they know where they stand.
          </span>
        </div>
      <% } %>

      <div class="admin-stats-grid">
        <div class="admin-stat-card">
          <div class="admin-stat-card__num"><%= totals.units %></div>
          <div class="admin-stat-card__label">Units committed</div>
        </div>
        <div class="admin-stat-card admin-stat-card--accent">
          <div class="admin-stat-card__num"><%= money(totals.revenue) %></div>
          <div class="admin-stat-card__label">Taken in advance</div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-card__num"><%= totals.awaiting %></div>
          <div class="admin-stat-card__label">Orders still waiting</div>
        </div>
        <div class="admin-stat-card">
          <div class="admin-stat-card__num"><%= rows.length %></div>
          <div class="admin-stat-card__label">Sets on preorder</div>
        </div>
      </div>

      <% if (!rows.length) { %>
        <div class="admin-empty">
          <p>Nothing is on preorder.</p>
          <p>
            Mark a product as a preorder and give it a release date on
            <a href="/admin/products">the products page</a>,
            and it appears here with everyone waiting on it.
          </p>
        </div>
      <% } %>

      <% rows.forEach(function (r) { %>
        <article class="admin-panel po-card <%= r.overdue ? 'is-overdue' : (r.imminent ? 'is-imminent' : '') %>">
          <div class="admin-panel__head po-top">
            <a class="po-title" href="/admin/preorders/<%= r.product.slug %>"><%= r.product.title %></a>

            <% if (r.release.hasDate) { %>
              <span class="po-when">Releases <strong><%= r.release.display %></strong></span>
              <% if (r.overdue) { %>
                <span class="admin-tag admin-tag--crit po-flag po-flag--late"><%= Math.abs(r.daysAway) %> day<%= Math.abs(r.daysAway) === 1 ? '' : 's' %> overdue</span>
              <% } else if (r.daysAway === 0) { %>
                <span class="admin-tag admin-tag--info po-flag po-flag--soon">Releases today</span>
              <% } else if (r.daysAway > 0) { %>
                <span class="admin-tag po-flag <%= r.imminent ? 'po-flag--soon admin-tag--info' : 'po-flag--tbc' %>">in <%= r.daysAway %> days</span>
              <% } %>
            <% } else if (r.release.window) { %>
              <span class="po-when">Expected <strong><%= r.release.window %></strong></span>
              <span class="admin-tag po-flag po-flag--tbc">no confirmed date</span>
            <% } else { %>
              <span class="po-when">No release date set</span>
              <span class="admin-tag po-flag po-flag--tbc">unannounced</span>
            <% } %>

            <% if (!r.product.available) { %><span class="admin-tag po-flag po-flag--tbc">listing closed</span><% } %>
          </div>

          <div class="admin-panel__body po-nums">
            <div class="po-num"><div class="po-num__v"><%= r.units %></div><div class="admin-kv__k">Units</div></div>
            <div class="po-num"><div class="po-num__v"><%= r.orders %></div><div class="admin-kv__k">Orders</div></div>
            <div class="po-num"><div class="po-num__v"><%= r.customers %></div><div class="admin-kv__k">Customers</div></div>
            <div class="po-num"><div class="po-num__v"><%= money(r.revenue) %></div><div class="admin-kv__k">Taken</div></div>
            <div class="po-num"><div class="po-num__v"><%= r.awaiting %></div><div class="admin-kv__k">Still waiting</div></div>
            <div class="po-num"><div class="po-num__v po-num__v--text"><%= day(r.lastOrder) %></div><div class="admin-kv__k">Last order</div></div>
            <div class="admin-btn-row po-acts">
              <a class="admin-btn admin-btn--sm" href="/admin/preorders/<%= r.product.slug %>">Who is waiting</a>
              <a class="admin-btn admin-btn--sm" href="/admin/products">Edit date</a>
            </div>
          </div>
        </article>
      <% }); %>

      <%/* ── Release date broadcast ──────────────────────────────────
           Moved here from the email page. It belongs where you can see
           who it is about: the number of people it will reach is on the
           card directly above it. */%>
      <% if (rows.length) { %>
      <section class="admin-panel">
        <div class="admin-panel__head">
          <div>
            <h2 class="admin-panel__title">Tell everyone a date has moved</h2>
            <p class="admin-panel__sub">
              Emails everyone holding an open preorder for a set. Cancelled, refunded and already-shipped
              orders are skipped. <strong>Update the release date on the
              product first</strong> &mdash; the email reads the new date from there, so sending before you
              change it tells everybody the old date again.
            </p>
          </div>
        </div>
        <div class="admin-panel__body">
          <form method="POST" action="/admin/emails/release-update" class="admin-form">
            <div class="admin-form__row">
              <div class="form-group">
                <label>Set</label>
                <select name="slug" class="admin-select" required>
                  <option value="">Choose a set&hellip;</option>
                  <% rows.filter(function (r) { return r.awaiting > 0; }).forEach(function (r) { %>
                    <option value="<%= r.product.slug %>">
                      <%= r.product.title %> &mdash; <%= r.awaiting %> waiting<%= r.release.hasDate ? ', now ' + r.release.display : '' %>
                    </option>
                  <% }); %>
                </select>
              </div>
              <div class="form-group">
                <label>Previous date</label>
                <input class="admin-input" name="previousRelease" placeholder="Previous date (optional)">
              </div>
            </div>
            <div class="form-group">
              <label>Message</label>
              <textarea name="message" class="admin-input" rows="3"
                placeholder="Optional: what changed and why, in your own words. Left blank, the email explains that the allocation and price are unchanged and that they can cancel for a full refund."></textarea>
            </div>
            <div class="admin-form__actions">
              <button class="admin-btn admin-btn--sm admin-btn--danger" type="submit"
                      onclick="return confirm('Email every open preorder holder for this set? This cannot be unsent.')">
                Send release update
              </button>
            </div>
          </form>
        </div>
      </section>
      <% } %>

    </div>
  </main>
</body>
</html>
