<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { title: pageTitle }) %>
  <style>
    /* A per-account total can carry one sum per currency, so it wraps
       instead of clipping like a single figure would. */
    .pl-sum { font-size: 18px; white-space: normal; overflow: visible; }
    .pl-slug { word-break: break-all; }
  </style>
</head>
<body class="admin-body">
  <%- include('_sidebar', { currentPath: '/admin/partner-log' }) %>

  <main class="admin-main">
    <header class="admin-header">
      <div>
        <h1 class="admin-header__title"><%= pageTitle %></h1>
        <p class="admin-header__sub">Where each order went in the rotation, and what it was worth.</p>
      </div>
      <div class="admin-header__actions">
        <a class="admin-btn" href="/admin/settings">Checkout settings</a>
      </div>
    </header>

    <div class="admin-content">

      <% if (!rows.length) { %>
        <div class="admin-empty">
          <p>No brokered orders yet.</p>
          <p>Every order handed to a partner site appears here, with the amount it was charged.</p>
        </div>
      <% } else { %>

        <%/* LIFETIME FIRST, because it is the question people actually
             arrive with: what has each account earned. The block below it
             covers only the orders still in the log, which is a dozen —
             useful for "is the split even right now", misleading if read
             as a total. */%>
        <% if (typeof lifetime !== 'undefined' && lifetime.length) { %>
          <section class="admin-section">
            <h2 class="admin-section__title">Lifetime, per account</h2>
            <div class="admin-stats-grid mb-0">
              <% lifetime.forEach(function (t) { %>
                <div class="admin-stat-card">
                  <div class="admin-stat-card__num pl-sum"><%= t.sums.length ? t.sums.join(' · ') : '—' %></div>
                  <div class="admin-stat-card__label"><strong><%= t.name %></strong> &middot; <%= t.orders %> <%= t.orders === 1 ? 'order' : 'orders' %></div>
                </div>
              <% }); %>
            </div>
          </section>
        <% } %>

        <%/* Per-site totals for the orders still in the log. The log answers
             "what happened"; this answers "is the split even", which is the
             question the rotation exists to make true and the one nobody can
             eyeball from rows. */%>
        <section class="admin-section">
          <h2 class="admin-section__title">Recent, across the last <%= rows.length %> order<%= rows.length === 1 ? '' : 's' %></h2>
          <% const missing = siteTotals.filter(function (t) { return t.unknown; }); %>
          <% if (missing.length) { %>
            <div class="admin-alert admin-alert--warn">
              <span>
                Some entries in the log have no order in the database and are not counted below:
                <% missing.forEach(function (t, i) { %><%= i ? ', ' : '' %><strong><%= t.name %></strong> <%= t.unknown %> with no matching order<% }); %>.
              </span>
            </div>
          <% } %>
          <div class="admin-stats-grid mb-0">
            <% siteTotals.forEach(function (t) { %>
              <div class="admin-stat-card">
                <div class="admin-stat-card__num pl-sum"><%= t.sums.length ? t.sums.join(' · ') : '—' %></div>
                <div class="admin-stat-card__label"><strong><%= t.name %></strong> &middot; <%= t.orders %> <%= t.orders === 1 ? 'order' : 'orders' %></div>
              </div>
            <% }); %>
          </div>
        </section>

        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>When</th>
                <th>Site</th>
                <th>Product</th>
                <th>Order</th>
                <th class="num">Amount</th>
              </tr>
            </thead>
            <tbody>
              <% rows.forEach(function (r) { %>
                <tr>
                  <td class="nowrap muted"><%= r.at ? new Date(r.at).toLocaleString() : '—' %></td>
                  <td><%= r.siteName %></td>
                  <td class="pl-slug"><%= r.productSlug %></td>
                  <td class="mono">
                    <% if (r.orderId) { %>
                      <a href="/admin/orders?q=<%= encodeURIComponent(r.orderId) %>" class="admin-cell-link"><%= r.orderId %></a>
                    <% } else { %>—<% } %>
                  </td>
                  <%/* A row whose order is not in the database says so rather
                       than printing a zero, which would read as a free order
                       and hide the fact that something did not land. */%>
                  <td class="num mono nowrap">
                    <% if (r.amount == null) { %>
                      <span class="warn">not found</span>
                    <% } else { %>
                      <%= money(r.amount, r.currency) %>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <p class="small faint">
          The log keeps the most recent entries only. Amounts are read from the order itself, so a
          corrected or refunded order shows its current value rather than what it was worth when it
          was brokered.
        </p>
      <% } %>

    </div>
  </main>
</body>
</html>
