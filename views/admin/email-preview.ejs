<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { title: 'Email templates' }) %>
  <style>
    /* Template list on the left, the message on the right. */
    .ep { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 20px; align-items: start; }
    .ep__list { margin-bottom: 0; }
    .ep__t { padding: 10px 10px 12px; border-bottom: 1px solid var(--admin-border); }
    .ep__t:last-child { border-bottom: 0; }
    .ep__t h3 { font-size: 13px; font-weight: 600; padding: 0 8px; margin-bottom: 4px; }
    .ep__s { display: flex; align-items: center; height: 28px; padding: 0 8px; border-radius: var(--admin-r-sm);
             font-size: 13px; color: var(--admin-muted); text-decoration: none; }
    .ep__s:hover { background: var(--admin-panel-2); color: var(--admin-text); text-decoration: none; }
    .ep__s--none { color: var(--admin-crit); }
    .ep__frame { margin-bottom: 0; }
    .ep__bar { align-items: center; }
    .ep__bar .admin-panel__title { min-width: 0; }
    .ep__bar .admin-btn-row { margin-left: auto; }
    /* The stage is a quieter inset so the white message reads as a sheet
       sitting on it, framed by a hairline. */
    .ep__stage { display: flex; justify-content: center; padding: 16px;
                 background: var(--admin-panel-2); border-radius: 0 0 var(--admin-r) var(--admin-r); }
    .ep__w { border: 1px solid var(--admin-border); width: 100%; max-width: 100%; height: 78vh;
             background: var(--admin-card); display: block; }
    @media (max-width: 1000px) { .ep { grid-template-columns: 1fr; } }
  </style>
</head>
<body class="admin-body">
  <%- include('_sidebar', { currentPath: '/admin/emails' }) %>

  <main class="admin-main">
    <header class="admin-header">
      <div>
        <h1 class="admin-header__title">Email templates</h1>
        <p class="admin-header__sub">Every template, in every state that changes what it says. Nothing on this page sends anything.</p>
      </div>
      <div class="admin-header__actions">
        <a class="admin-btn" href="/admin/emails">Back to email</a>
      </div>
    </header>

    <div class="admin-content">
      <div class="admin-alert admin-alert--info">
        <span>
          These render against the same fixtures <span class="admin-code">scripts/audit/check-email.js</span>
          asserts on, so what you look at here and what the audit checks cannot drift apart.
        </span>
      </div>

      <div class="ep">
        <div class="admin-panel ep__list">
          <% types.forEach(function (t) { %>
            <div class="ep__t">
              <h3><%= labels[t] %></h3>
              <% (cases[t] || []).forEach(function (state) { %>
                <a class="ep__s" href="#" onclick="return show('<%= t %>','<%= state.replace(/'/g, "\\'") %>')">
                  <%= state %>
                </a>
              <% }); %>
              <% if (!(cases[t] || []).length) { %>
                <span class="ep__s ep__s--none">no sample data</span>
              <% } %>
            </div>
          <% }); %>
        </div>

        <div class="admin-panel ep__frame">
          <div class="admin-panel__head ep__bar">
            <div>
              <h2 class="admin-panel__title" id="epTitle">Pick a template</h2>
              <p class="admin-panel__sub" id="epSubject"></p>
            </div>
            <div class="admin-btn-row">
              <button class="admin-btn admin-btn--sm" onclick="setWidth(600)">Desktop</button>
              <button class="admin-btn admin-btn--sm" onclick="setWidth(375)">Phone</button>
              <a class="admin-btn admin-btn--sm" id="epText" href="#" target="_blank" rel="noopener">Plain text</a>
              <a class="admin-btn admin-btn--sm" id="epRaw" href="#" target="_blank" rel="noopener">Open</a>
            </div>
          </div>
          <%/* An iframe at an exact pixel width is the only truthful way
               to check a 600px email against a 375px phone. Resizing the
               browser tests the admin page, not the message. */%>
          <div class="admin-panel__body admin-panel__body--flush ep__stage">
            <iframe class="ep__w" id="epFrame" style="width:600px" title="Email preview"></iframe>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    var current = null;
    function show(type, state) {
      current = { type: type, state: state };
      var url = '/admin/emails/preview/' + type + '?state=' + encodeURIComponent(state);
      document.getElementById('epFrame').src = url;
      document.getElementById('epTitle').textContent = type;
      document.getElementById('epRaw').href = url;
      document.getElementById('epText').href = url + '&as=text';
      fetch(url + '&as=subject')
        .then(function (r) { return r.text(); })
        .then(function (s) { document.getElementById('epSubject').textContent = 'Subject: ' + s; })
        .catch(function () {});
      return false;
    }
    function setWidth(px) { document.getElementById('epFrame').style.width = px + 'px'; }
  </script>
</body>
</html>
