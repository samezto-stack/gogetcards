<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { title: pageTitle }) %>
</head>
<body class="admin-body">
  <%- include('_sidebar', { currentPath: '/admin/pages' }) %>
  <main class="admin-main">
    <header class="admin-header">
      <div>
        <h1 class="admin-header__title"><%= pageTitle %></h1>
        <% if (page && page.slug) { %><p class="admin-header__sub">/page/<%= page.slug %></p><% } %>
      </div>
      <div class="admin-header__actions">
        <a href="/admin/pages" class="admin-btn admin-btn--ghost">Back to pages</a>
      </div>
    </header>
    <div class="admin-content admin-content--narrow">
      <% if (error) { %><div class="admin-alert admin-alert--error"><%= error %></div><% } %>
      <form method="POST" action="<%= page && page._id ? '/admin/pages/' + page._id : '/admin/pages' %>" class="admin-form">
        <div class="admin-panel">
          <div class="admin-panel__head"><h2 class="admin-panel__title">Page</h2></div>
          <div class="admin-panel__body stack">
            <div class="admin-form__row">
              <div class="form-group"><label for="pg-title">Title</label><input id="pg-title" type="text" name="title" value="<%= page ? page.title : '' %>" required></div>
              <div class="form-group"><label for="pg-slug">Slug</label><input id="pg-slug" type="text" name="slug" value="<%= page ? page.slug : '' %>" required></div>
            </div>
            <div class="form-group">
              <label for="pg-cat">Category</label>
              <select id="pg-cat" name="category">
                <option value="legal" <%= page && page.category === 'legal' ? 'selected' : '' %>>Legal</option>
                <option value="information" <%= page && page.category === 'information' ? 'selected' : '' %>>Information</option>
              </select>
            </div>
            <div class="form-group">
              <label for="pg-meta">Meta description</label>
              <textarea id="pg-meta" name="metaDescription" rows="2" maxlength="300" placeholder="One sentence describing this page, as it should read in Google results. Leave blank to derive it from the content."><%= page ? (page.metaDescription || '') : '' %></textarea>
              <span class="field-hint">Aim for 120 to 158 characters. Left blank, the first sentences of the content are used.</span>
            </div>
          </div>
        </div>
        <div class="admin-panel">
          <div class="admin-panel__head"><h2 class="admin-panel__title">Content</h2><span class="small muted">HTML</span></div>
          <div class="admin-panel__body">
            <div class="form-group"><label for="pg-content" class="sr-only">Content (HTML)</label><textarea id="pg-content" name="content" rows="16" class="mono"><%= page ? page.content : '' %></textarea></div>
          </div>
        </div>
        <div class="admin-form__actions">
          <button type="submit" class="admin-btn admin-btn--primary"><%= page && page._id ? 'Save page' : 'Create page' %></button>
          <a href="/admin/pages" class="admin-btn admin-btn--ghost">Cancel</a>
        </div>
      </form>
    </div>
  </main>
</body>
</html>
