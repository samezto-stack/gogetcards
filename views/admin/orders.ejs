<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { title: pageTitle }) %>
  <style>
    /* ── Orders table ────────────────────────────────────────────
       Eight columns, sized so the two that carry long free text — the
       product name and the shipping address — get real width instead of
       being squeezed to nothing by a row of badges. The old version had
       ten columns and a 1500px min-width, which meant horizontal
       scrolling on every screen; this fits a laptop. */
    /* FIXED LAYOUT WITH DECLARED WIDTHS. With `auto`, the browser sizes
       columns from content, so one 90-character product name starved the
       address column down to about sixty pixels and every row in the
       table grew to eight lines tall to match. Declaring the widths makes
       every row the same height and puts the space where the long text
       actually is. */
    .ot-table { min-width: 980px; table-layout: fixed; }
    .ot-table th, .ot-table td { vertical-align: top; }
    /* A test purchase sits in the list but is tinted so it cannot be
       mistaken for money. */
    .ot-table tbody tr.is-test, .ot-table tbody tr.is-test:hover { background: var(--admin-warn-tint); }

    /* In-table toolbar: title and count on the left, the filters that
       act on this table on the right. */
    .ot-title { font-size: 14.5px; font-weight: 600; }
    .ot-count { font-size: 12.5px; color: var(--admin-faint); margin-left: 8px; }
    .ot-tools { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-left: auto; }
    .ot-search { width: 300px; max-width: 100%; }
    .ot-notice { margin: 12px 14px; }
    .ot-empty { padding: 36px 16px; text-align: center; color: var(--admin-faint); font-size: 13.5px; }
    .ot-rowbtns { display: flex; gap: 8px; justify-content: flex-end; }
    .ot-rowacts { display: flex; flex-direction: column; gap: 5px; align-items: flex-start; margin-top: 7px; }

    /* The reference the customer quotes, first. The provider's own id is
       kept underneath because it is what you paste into Whop, but it is
       no longer the thing your eye lands on. */
    .ot-ref { font-family: var(--admin-font-mono); font-size: 13px; color: var(--admin-primary); font-weight: 600; letter-spacing: 0.02em; }
    .ot-rawid { font-family: var(--admin-font-mono); font-size: 11px; color: var(--admin-faint); margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ot-chip { margin-top: 5px; }

    /* Destructive, and therefore quiet until you go looking for it.
       Revealed on row hover so it cannot be hit while scanning. */
    .ot-del { margin: 6px 0 0; }
    .ot-del-btn { opacity: 0; transition: opacity 0.15s, color 0.15s, border-color 0.15s, background 0.12s; }
    tr:hover .ot-del-btn, .ot-del-btn:focus-visible { opacity: 1; }

    .ot-cust { display: block; text-decoration: none; }
    .ot-cust:hover { text-decoration: none; }
    .ot-cust-name { display: block; font-weight: 500; color: var(--admin-text); font-size: 13px; }
    .ot-cust:hover .ot-cust-name { color: var(--admin-primary-soft); }
    .ot-cust:hover .ot-sub { color: var(--admin-muted); }
    .ot-sub { display: block; font-size: 12px; color: var(--admin-faint); margin-top: 2px; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; }
    .ot-cust .ot-sub, .ot-cust-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    /* Two lines, then an ellipsis, with the whole title on hover. A
       product name here is for recognition, not for reading — the full
       one is on the order page a click away. */
    .ot-product { font-size: 13px; color: var(--admin-text); line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .ot-pre { color: var(--admin-info); font-weight: 500; }
    .ot-total { font-family: var(--admin-font-mono); font-size: 13px; font-weight: 600; white-space: nowrap; font-variant-numeric: tabular-nums; }

    /* One line. Packing needs the address on the CLIPBOARD, not on the
       screen — the Copy button carries the full thing, and the visible
       line is only there to tell one order from another at a glance. */
    .ot-ship { font-size: 12.5px; color: var(--admin-muted); line-height: 1.4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .copy-addr-btn { margin-top: 5px; }
    .copy-addr-btn.copied { color: var(--admin-ok); border-color: var(--admin-ok-line); background: var(--admin-ok-tint); }
  </style>
</head>
<body class="admin-body">
  <%- include('_sidebar', { currentPath: '/admin/orders' }) %>

  <main class="admin-main">
    <header class="admin-header">
      <div>
        <h1 class="admin-header__title"><%= pageTitle %> <span class="admin-header__count"><%= total %></span></h1>
      </div>
      <div class="admin-header__actions">
        <nav class="admin-seg" aria-label="Date range">
          <% [['daily','Today'],['weekly','This week'],['monthly','This month'],['all','All time']].forEach(function (r) { %>
            <a href="/admin/orders?range=<%= r[0] %>&status=<%= statusFilter %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"
               class="admin-seg__item <%= range === r[0] ? 'is-on' : '' %>"><%= r[1] %></a>
          <% }); %>
        </nav>
      </div>
    </header>

    <div class="admin-content">

    <!-- Analytics Cards -->
    <div class="admin-stats-grid">
      <div class="admin-stat-card admin-stat-card--accent">
        <div class="admin-stat-card__num">$<%= (stats.totalRevenue / 100).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></div>
        <div class="admin-stat-card__label">Total revenue</div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-card__num"><%= stats.totalOrders %></div>
        <div class="admin-stat-card__label">Total orders</div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-card__num">$<%= (stats.aov / 100).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></div>
        <div class="admin-stat-card__label">Average order value</div>
      </div>
    </div>

    <!-- Orders Table -->
    <% if (typeof query !== 'undefined' && query.recovered) { %>
      <div class="admin-alert admin-alert--success">
        <span>
          <strong>Order <%= query.recovered %> created.</strong>
          <% if (query.recoveredNew === '1') { %>
            The confirmation email has been sent, the customer can now see it at /account, and it appears in the orders below.
          <% } else { %>
            That order already existed, so nothing was re-sent.
          <% } %>
        </span>
      </div>
    <% } %>
    <% if (typeof query !== 'undefined' && query.recoverError) { %>
      <div class="admin-alert admin-alert--error"><span><strong>Could not create the order.</strong> <%= query.recoverError %></span></div>
    <% } %>

    <%/* Payments confirmed by Whop on a partner host whose customer never
         reached our /thank-you, so no order was created. Money that exists
         but is not in the table below, which is exactly why it needs to be
         loud rather than a subtle row. */%>
    <% if ((typeof unconfirmedPayments !== 'undefined') && unconfirmedPayments.length) { %>
      <section class="admin-panel admin-panel--crit">
        <div class="admin-panel__head">
          <div>
            <h2 class="admin-panel__title">Paid, but never confirmed <span class="admin-tag admin-tag--crit"><%= unconfirmedPayments.length %></span></h2>
            <p class="admin-panel__sub">
              A partner site took payment through Whop and told us server-to-server, but the customer's browser
              never reached the confirmation page, so no order was created. The money is real. Check Whop for the
              payment id, then either create the order manually or dismiss the notice.
            </p>
          </div>
        </div>
        <div class="admin-panel__body admin-panel__body--flush">
          <table class="admin-table">
            <thead>
              <tr>
                <th>When</th><th>Order ID</th><th>Site</th><th>Customer</th>
                <th>Product</th><th class="num">Amount</th><th>Payment ID</th><th class="num"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              <% unconfirmedPayments.forEach(function (p) { %>
                <tr>
                  <td class="nowrap muted"><%= new Date(p.createdAt).toLocaleString() %></td>
                  <td><span class="admin-code"><%= p.orderId %></span></td>
                  <td><%= p.store || '&mdash;' %></td>
                  <td>
                    <div><%= p.customerName || 'Guest' %></div>
                    <span class="admin-cell-sub"><%= p.customerEmail || '' %></span>
                  </td>
                  <td><%= p.productName || '&mdash;' %><% if (p.quantity && p.quantity !== '1') { %> <span class="muted">&times;<%= p.quantity %></span><% } %></td>
                  <td class="num"><strong><%= p.currency || 'USD' %> <%= p.price || '?' %></strong></td>
                  <td class="mono muted"><%= p.paymentId || '&mdash;' %></td>
                  <td class="num">
                    <%/* The recover action is the affirmative one in that row — it creates an
                         order and mails a customer — so it reads as a button and "Dismiss"
                         stays a plain control beside it. */%>
                    <div class="ot-rowbtns">
                      <form action="/admin/orders/pending/<%= encodeURIComponent(p.orderId) %>/create-order" method="POST"
                            onsubmit="return confirm('Create the order for <%= p.customerEmail || 'this customer' %>?\n\nThis sends their confirmation email and makes the order visible in their account. Only do this once you have checked the payment really succeeded in Whop.')">
                        <button type="submit" class="admin-btn admin-btn--sm admin-btn--primary">Create the order</button>
                      </form>
                      <form action="/admin/orders/pending/<%= encodeURIComponent(p.orderId) %>/acknowledge" method="POST"
                            onsubmit="return confirm('Dismiss this notice? It does NOT create an order.')">
                        <button type="submit" class="admin-btn admin-btn--sm">Dismiss</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>
    <% } %>

    <div class="admin-table-wrap">
      <div class="admin-table-head">
        <div>
          <h2 class="ot-title">Orders
            <span class="ot-count">
              <% if (total) { %><%= from %>&ndash;<%= to %> of <%= total %><% } else { %>None in range<% } %>
            </span>
          </h2>
        </div>

        <%/* Search and status live WITH the table rather than floating
             above the metric cards, because they filter the table and
             nothing else. The date range at the top still governs both. */%>
        <form class="ot-tools" method="GET" action="/admin/orders">
          <input type="hidden" name="range" value="<%= range %>">
          <input class="admin-search-input ot-search" type="search" name="q" value="<%= q %>"
                 placeholder="ZTCG-46571, email, name, product or tracking" autocomplete="off">
          <select name="status" class="admin-select">
            <% [['all','Any status'],['unfulfilled','Needs packing'],['preparing','Preparing'],
                ['shipped','Shipped'],['delivered','Delivered'],['cancelled','Cancelled'],
                ['refunded','Refund open']].forEach(function (o) { %>
              <option value="<%= o[0] %>" <%= statusFilter === o[0] ? 'selected' : '' %>><%= o[1] %></option>
            <% }); %>
          </select>
          <button class="admin-btn admin-btn--primary" type="submit">Search</button>
          <% if (q || statusFilter !== 'all') { %>
            <a class="admin-btn admin-btn--ghost" href="/admin/orders?range=<%= range %>">Clear</a>
          <% } %>
        </form>
      </div>

      <% if (typeof notice !== 'undefined' && notice) { %>
        <%
          const noticeText = {
            cancelled: ['success', 'Order cancelled. The refund is queued for you to issue by hand, and the customer has been emailed to say it is being processed.'],
            cancel_already_cancelled: ['success', 'That order was already cancelled. Nothing changed and no second email was sent.'],
            cancel_already_shipped: ['error', 'That order has already shipped, so it cannot be cancelled. Contact the customer about a return instead.'],
            cancel_no_order: ['error', 'That order no longer exists.'],
          }[notice];
        %>
        <% if (noticeText) { %>
          <div class="admin-alert admin-alert--<%= noticeText[0] %> ot-notice"><%= noticeText[1] %></div>
        <% } %>
      <% } %>

      <% if (rows && rows.length > 0) { %>
        <table class="admin-table ot-table">
          <%/* Widths declared once, here, rather than guessed by the
               browser from whatever the longest product name happens to
               be on this page. */%>
          <%/* Proportions, not pixels. Declared widths in px plus cell
               padding overflowed the content area and pushed the last
               column off the right edge on a laptop; percentages let the
               table fill exactly what it is given and keep every column
               visible. The min-width on .ot-table is the floor below
               which it scrolls instead of crushing. */%>
          <colgroup>
            <col style="width:13%"><col style="width:8%"><col style="width:16%">
            <col style="width:19%"><col style="width:8%"><col style="width:14%">
            <col style="width:14%"><col style="width:8%">
          </colgroup>
          <thead>
            <tr>
              <th>Order</th>
              <th>Placed</th>
              <th>Customer</th>
              <th>Product</th>
              <th class="num">Total</th>
              <th>Status</th>
              <th>Ship to</th>
              <th>Channel</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(function (r) { const order = r.order; %>
              <%/* A test purchase is listed like any other order — seeing
                   one is the whole point of making it — but tinted and
                   tagged, and left out of the money above. Detected from
                   the order itself rather than from a flag this view
                   sets, so the table cannot disagree with the totals. */%>
              <% const isTest = testOrder.isTestOrder(order); %>
              <tr class="<%= isTest ? 'is-test' : '' %>">

                <td>
                  <%/* The ZTCG reference first, because it is the only
                       identifier the customer has and the thing they
                       quote. The provider's own id is kept underneath —
                       it is what you paste into Whop — but it is no
                       longer the headline. */%>
                  <div class="ot-ref"><%= r.reference %></div>
                  <div class="ot-rawid" title="<%= order.orderId %>"><%= order.orderId %></div>
                  <% if (isTest) { %><span class="admin-tag admin-tag--warn ot-chip">TEST &middot; not counted</span><% } %>

                  <%/* Delete moved up here from the old Actions column.
                       Pixel and email buttons are gone: both now happen
                       automatically, and a manual button that re-fires a
                       Purchase event is a way to double-count a sale. */%>
                  <form action="/admin/orders/<%= order._id %>/delete" method="POST" class="ot-del"
                        onsubmit="return confirm('Remove <%= r.reference %> permanently? This cannot be undone and does not refund anything.');">
                    <button type="submit" class="admin-btn admin-btn--xs admin-btn--danger ot-del-btn" title="Remove this order" aria-label="Remove <%= r.reference %>">Remove</button>
                  </form>
                </td>

                <td class="nowrap">
                  <div><%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></div>
                  <div class="ot-sub"><%= new Date(order.createdAt).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }) %></div>
                </td>

                <td>
                  <%/* One click to the profile — every order, refund and
                       session for this person on one page. Falls back to
                       plain text when no account exists yet, rather than
                       rendering a link that 404s. */%>
                  <% if (r.customerId) { %>
                    <a class="ot-cust" href="/admin/customers/<%= r.customerId %>">
                      <span class="ot-cust-name"><%= order.customerName || 'Guest' %></span>
                      <span class="ot-sub"><%= order.customerEmail %></span>
                    </a>
                  <% } else { %>
                    <div class="ot-cust-name"><%= order.customerName || 'Guest' %></div>
                    <div class="ot-sub"><%= order.customerEmail || '&mdash;' %></div>
                  <% } %>
                </td>

                <td>
                  <div class="ot-product" title="<%= r.title %>"><%= r.title || '&mdash;' %></div>
                  <div class="ot-sub">
                    <% if ((Number(order.quantity) || 1) > 1) { %>Qty <%= order.quantity %><% } %>
                    <% if (r.isPreorder) { %>
                      <span class="ot-pre">Preorder<% if (r.release && r.release.hasDate) { %> &middot; <%= r.release.display %><% } %></span>
                    <% } %>
                  </div>
                </td>

                <td class="num ot-total"><%= money(order.totalPrice, order.currency) %></td>

                <td>
                  <%/* The status a CUSTOMER would be shown, derived by
                       services/customerOrders — the same function the
                       account portal uses. The old badge only knew
                       "completed" or "pending", so a shipped order and a
                       refunded one looked identical here. */%>
                  <span class="status-pill status-pill--<%= ({ good: 'ok', accent: 'ok', warn: 'warn', neutral: 'neutral' })[r.status.tone] || 'neutral' %>">
                    <span class="status-pill__dot"></span><%= r.status.label %>
                  </span>
                  <% if (order.trackingNumber) { %>
                    <div class="ot-sub mono" title="<%= order.trackingNumber %>"><%= order.trackingNumber %></div>
                  <% } %>
                  <%/* A cancelled order the customer has been asked to
                       keep. Its refund is promised for AFTER the deadline
                       and the email said so; issuing it early breaks that
                       promise and can refund an order that is about to be
                       reinstated. */%>
                  <% if (order.cancelledAt && order.refundStatus === 'processing' && order.reinstateDeadline && new Date(order.reinstateDeadline) > new Date()) { %>
                    <div class="ot-sub warn">Keep-or-refund offer open — do not refund before
                      <%= new Date(order.reinstateDeadline).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'America/Los_Angeles' }) %></div>
                  <% } %>
                  <% if (order.reinstatedAt && !order.cancelledAt) { %>
                    <div class="ot-sub ok">Reinstated by the customer — no refund owed</div>
                  <% } %>
                  <%/* Actions on the STATE live with the state. A customer
                       who emailed asking to cancel, or who cannot sign in
                       to do it themselves, is cancelled from here — the
                       same service the customer page uses, so both queue
                       the refund and both send the same email.

                       Offered only while it is actually possible: a
                       shipped parcel cannot be un-sent, and a button that
                       silently does nothing is worse than no button. */%>
                  <div class="ot-rowacts">
                    <% if (order.status !== 'completed' && !order.cancelledAt) { %>
                      <form action="/admin/orders/<%= order._id %>/complete" method="POST">
                        <button type="submit" class="admin-btn admin-btn--xs">Mark completed</button>
                      </form>
                    <% } %>
                    <% if (!order.cancelledAt && order.fulfillmentStatus !== 'shipped' && order.fulfillmentStatus !== 'delivered') { %>
                      <form action="/admin/orders/<%= order._id %>/cancel" method="POST"
                            onsubmit="return confirm('Cancel <%= r.reference %> for <%= (order.customerName || 'this customer').replace(/'/g, "\\'") %>?\n\nThis stops the order, queues a refund of <%= money(order.totalPrice, order.currency) %> for you to issue by hand, and emails the customer to say so. It does not move any money.');">
                        <button type="submit" class="admin-btn admin-btn--xs admin-btn--danger">Cancel order</button>
                      </form>
                    <% } %>
                  </div>
                </td>

                <td>
                  <% if (order.shippingAddress) { %>
                    <%/* COUNTRY FIRST, city under it. Truncating the raw
                         string from the left leaves "2321 Rosecrans Ave
                         Ste…", which is the part that never tells you
                         anything. The two facts you scan a shipping
                         column for are "is this going abroad" and
                         "roughly where" — both fit without truncation.
                         The Copy button still carries the whole address,
                         which is what packing actually needs. */%>
                    <% const parts = order.shippingAddress.split(',').map(function (x) { return x.trim(); }).filter(Boolean); %>
                    <% const country = parts.length > 2 ? parts[parts.length - 1] : ''; %>
                    <% const locality = parts.length > 2 ? parts[1] : ''; %>
                    <% if (country) { %>
                      <div class="ot-ship" title="<%= order.shippingAddress %>"><%= country %></div>
                      <% if (locality) { %><span class="ot-sub"><%= locality %></span><% } %>
                    <% } else { %>
                      <div class="ot-ship" title="<%= order.shippingAddress %>"><%= order.shippingAddress %></div>
                    <% } %>
                    <button class="admin-btn admin-btn--xs copy-addr-btn" onclick="copyAddr(this, '<%= order.shippingAddress.replace(/'/g, "&apos;") %>')">Copy</button>
                  <% } else { %>
                    <span class="ot-sub">&mdash;</span>
                  <% } %>
                </td>

                <td>
                  <% const ts = order.trafficSource || 'Unknown'; const tsClass = ts.replace(/[^A-Za-z0-9]+/g, '-'); %>
                  <span class="admin-tag traffic-badge traffic-badge--<%= tsClass %>"><%= ts %></span>
                </td>

              </tr>
            <% }); %>
          </tbody>
        </table>

        <%/* ── Pagination ──────────────────────────────────────────
             Numbered, with a window around the current page and the
             first and last always reachable, so "jump to the end" does
             not mean clicking Next forty times. Every link carries the
             range, status and search so paging never silently drops the
             filter you are paging through. */%>
        <% if (pages > 1) { %>
          <%
            const qs = (n) => `/admin/orders?range=${encodeURIComponent(range)}`
              + `&status=${encodeURIComponent(statusFilter)}`
              + (q ? `&q=${encodeURIComponent(q)}` : '')
              + `&page=${n}`;
            const window_ = 2;
            const nums = [];
            for (let n = 1; n <= pages; n++) {
              if (n === 1 || n === pages || Math.abs(n - page) <= window_) nums.push(n);
              else if (nums[nums.length - 1] !== '…') nums.push('…');
            }
          %>
          <div class="admin-table-foot">
            <nav class="admin-pager" aria-label="Order pages">
              <a class="admin-page <%= page === 1 ? 'is-off' : '' %>"
                 href="<%= page === 1 ? '#' : qs(page - 1) %>" <%- page === 1 ? 'aria-disabled="true"' : '' %>>Previous</a>
              <% nums.forEach(function (n) { %>
                <% if (n === '…') { %><span class="admin-page-gap">…</span>
                <% } else { %>
                  <a class="admin-page <%= n === page ? 'is-on' : '' %>" href="<%= qs(n) %>"
                     <%- n === page ? 'aria-current="page"' : '' %>><%= n %></a>
                <% } %>
              <% }); %>
              <a class="admin-page <%= page === pages ? 'is-off' : '' %>"
                 href="<%= page === pages ? '#' : qs(page + 1) %>" <%- page === pages ? 'aria-disabled="true"' : '' %>>Next</a>
            </nav>
          </div>
        <% } %>
      <% } else { %>
        <div class="ot-empty">
          <% if (q || statusFilter !== 'all') { %>
            Nothing matches that. <a href="/admin/orders?range=<%= range %>">Clear the filters</a>
            or widen the date range above.
          <% } else { %>
            No orders in this date range.
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
  </main>
<script>
function copyAddr(btn, address) {
  navigator.clipboard.writeText(address).then(() => {
    btn.textContent = '✅ Copied!';
    btn.classList.add('copied');
    setTimeout(() => {
      btn.textContent = '📋 Copy';
      btn.classList.remove('copied');
    }, 2000);
  });
}

/* The pixel and email helpers that used to live here are gone.
   Confirmations are sent automatically by services/mail the moment a
   payment is verified, and the Meta Purchase event is pushed by the
   pipeline for Facebook-attributed orders. A manual button that fires
   either again is a way to double-count a sale or to send a customer a
   second copy of a receipt they already have.

   The email builder in particular was guessing: it inferred the product
   from the order TOTAL by dividing by hardcoded prices, and carried
   hardcoded release dates that have since moved. Deleting it removes a
   source of confidently wrong information. */
</script>
</body>
</html>
