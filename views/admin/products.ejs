<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { title: pageTitle }) %>
</head>
<body class="admin-body">
  <%- include('_sidebar', { currentPath: '/admin/products' }) %>
  <main class="admin-main">
    <header class="admin-header">
      <div>
        <h1 class="admin-header__title"><%= pageTitle %> <span class="admin-header__count"><%= products.length %></span></h1>
      </div>
      <div class="admin-header__actions">
        <a href="/admin/products/new" class="admin-btn admin-btn--primary">Add product</a>
      </div>
    </header>
    <div class="admin-content">

      <% if (success) { %>
        <div class="admin-alert admin-alert--success"><%= success %></div>
      <% } %>

      <form method="GET" action="/admin/products" class="admin-filter-bar">
        <div class="admin-filter-bar__search">
          <input type="search" name="q" value="<%= q %>" placeholder="Search products" class="admin-search-input" autocomplete="off">
        </div>
        <select name="collection" class="admin-select">
          <option value="all" <%= collection === 'all' ? 'selected' : '' %>>All collections</option>
          <% collections.forEach(function(c) { %>
            <option value="<%= c.handle %>" <%= collection === c.handle ? 'selected' : '' %>><%= c.name %></option>
          <% }); %>
        </select>
        <select name="sort" class="admin-select">
          <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest first</option>
          <option value="title" <%= sort === 'title' ? 'selected' : '' %>>Title A to Z</option>
          <option value="price-asc" <%= sort === 'price-asc' ? 'selected' : '' %>>Price, low to high</option>
          <option value="price-desc" <%= sort === 'price-desc' ? 'selected' : '' %>>Price, high to low</option>
          <option value="stock" <%= sort === 'stock' ? 'selected' : '' %>>Stock, low to high</option>
        </select>
        <button type="submit" class="admin-btn">Filter</button>
        <% if (q || collection !== 'all') { %>
          <a href="/admin/products" class="admin-btn admin-btn--ghost">Clear</a>
        <% } %>
      </form>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Product</th>
              <th class="num">Price</th>
              <th class="num">Stock</th>
              <th>Status</th>
              <th>Badge</th>
              <th class="num"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% if (products.length === 0) { %>
              <tr><td colspan="6" class="admin-table__empty">No products match.</td></tr>
            <% } %>
            <% products.forEach(function(p) { %>
              <tr id="product-row-<%= p._id %>">
                <td>
                  <a href="/admin/products/<%= p._id %>/edit" class="admin-cell-link admin-product-title"><%= p.title %></a>
                  <%/* The version, beside the title rather than folded into
                       it. Two boxes of one product share a base title, so
                       without this the list shows the same row twice.
                       Inline quick-edit writes `title`, so the composed
                       title must not be what that field displays. */%>
                  <% if (p.variantName) { %>
                    <span class="admin-tag" style="margin-left:6px"><%= p.variantName %></span>
                  <% } %>
                  <span class="admin-cell-sub"><%= p.vendor %> &middot; <%= p.productType %></span>
                </td>
                <td class="num">
                  <span class="admin-editable" data-product-id="<%= p._id %>" data-field="price" data-current="<%= (p.price / 100).toFixed(2) %>" title="Double-click to edit">
                    $<%= formatPrice(p.price) %>
                  </span>
                </td>
                <td class="num">
                  <span class="admin-editable <%= p.stock <= 3 ? 'crit' : p.stock <= 10 ? 'warn' : '' %>" data-product-id="<%= p._id %>" data-field="stock" data-current="<%= p.stock %>" title="Double-click to edit">
                    <%= p.stock %>
                  </span>
                </td>
                <td>
                  <% if (p.available) { %>
                    <span class="admin-tag admin-tag--ok">Available</span>
                  <% } else { %>
                    <span class="admin-tag">Hidden</span>
                  <% } %>
                  <% if (p.preorder) { %> <span class="admin-tag admin-tag--info">Preorder</span><% } %>
                </td>
                <td><%= p.badge || '' %></td>
                <td class="num nowrap">
                  <a href="/admin/products/<%= p._id %>/edit" class="admin-btn admin-btn--sm">Edit</a>
                  <form method="POST" action="/admin/products/<%= p._id %>/delete" style="display:inline" onsubmit="return confirm('Delete this product?')">
                    <button type="submit" class="admin-btn admin-btn--sm admin-btn--danger">Delete</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <p class="tiny faint">Double-click a price or a stock figure to change it in place.</p>
    </div>
  </main>

  <script>
    // Quick inline edit
    document.querySelectorAll('.admin-editable').forEach(el => {
      el.style.cursor = 'pointer';
      el.addEventListener('dblclick', function() {
        const field = this.dataset.field;
        const current = this.dataset.current;
        const productId = this.dataset.productId;
        const input = document.createElement('input');
        input.type = field === 'stock' ? 'number' : 'text';
        input.value = current;
        input.className = 'admin-inline-input';
        input.style.width = '80px';
        this.textContent = '';
        this.appendChild(input);
        input.focus();
        input.select();

        const save = async () => {
          const val = input.value;
          try {
            const res = await fetch('/admin/products/' + productId + '/quick-update', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ field, value: val })
            });
            const data = await res.json();
            if (data.success) {
              el.dataset.current = val;
              if (field === 'price') el.textContent = '$' + parseFloat(val).toLocaleString('en-US', { minimumFractionDigits: 2 });
              else el.textContent = val;
            } else {
              el.textContent = field === 'price' ? '$' + current : current;
            }
          } catch(e) {
            el.textContent = field === 'price' ? '$' + current : current;
          }
        };

        input.addEventListener('blur', save);
        input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); input.blur(); } if (e.key === 'Escape') { el.textContent = field === 'price' ? '$' + current : current; } });
      });
    });
  </script>
</body>
</html>
