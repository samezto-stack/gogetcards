<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { title: 'Ads planner' }) %>
  <style>
    .ap-range { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .ap-range .admin-input[type="date"] { width: 150px; }

    /* The table sits flush in its panel; the body scrolls sideways. */
    .ap-scroll { overflow-x: auto; }
    .ap-table td.rev { color: var(--admin-accent); font-weight: 600; }
    .ap-table tfoot td { border-top: 1px solid var(--admin-border-2); border-bottom: 0; background: var(--admin-panel-2); font-weight: 600; }
    .ap-mkt { font-weight: 600; white-space: nowrap; }
    .ap-approx { display: block; font-size: 11.5px; font-weight: 400; color: var(--admin-faint); }
    .ap-top { font-size: 12px; color: var(--admin-muted); line-height: 1.5; max-width: 26ch; }
    .ap-spend { width: 96px; height: 30px; text-align: right; font-variant-numeric: tabular-nums; }
    .ap-roas { font-weight: 600; }
    .ap-roas.good { color: var(--admin-ok); } .ap-roas.mid { color: var(--admin-warn); } .ap-roas.bad { color: var(--admin-crit); }
    .ap-roas.none { color: var(--admin-faint); font-weight: 400; }

    /* Copy block: the foot holds the button, the confirmation and the
       textarea it copies from. */
    .ap-copied { color: var(--admin-ok); font-size: 12.5px; font-weight: 600; opacity: 0; transition: opacity .2s; }
    .ap-copied.show { opacity: 1; }
    .ap-note { margin-left: auto; }
    .ap-out {
      flex: 1 0 100%; width: 100%; min-height: 220px; padding: 10px 12px;
      background: var(--admin-panel-2); color: var(--admin-text); border: 1px solid var(--admin-border); border-radius: var(--admin-r-sm);
      font-family: var(--admin-font-mono); font-size: 12px; line-height: 1.55; white-space: pre; overflow: auto; resize: vertical;
    }
    .ap-out:focus { outline: none; border-color: var(--admin-primary-soft); box-shadow: var(--admin-focus); }

    /* Below tablet width the rows stack into cards, each cell labelled by its data-l. */
    @media (max-width: 820px) {
      .ap-table, .ap-table thead, .ap-table tbody, .ap-table tfoot, .ap-table tr, .ap-table td, .ap-table th { display: block; }
      .ap-table thead { display: none; }
      .ap-table tr { border-bottom: 1px solid var(--admin-border); padding: 6px 0; }
      .ap-table tr:last-child { border-bottom: 0; }
      .ap-table td { display: flex; justify-content: space-between; align-items: center; gap: 16px; border-bottom: 0; padding: 6px 14px; }
      .ap-table td::before { content: attr(data-l); color: var(--admin-faint); font-size: 12px; font-weight: 600; }
      .ap-table td.num { text-align: right; }
      .ap-table tfoot td { border-top: 0; }
      .ap-top { max-width: none; text-align: right; }
    }
  </style>
</head>
<body class="admin-body">
  <%- include('_sidebar', { currentPath: '/admin/analytics/ads' }) %>

  <main class="admin-main">
    <%
      const num = (n) => Number(n || 0).toLocaleString('en-US');
      const pc = (n) => (n === null || n === undefined) ? '—' : Number(n).toFixed(2) + '%';
      const fmtLocal = (cents, cur) => { try { return new Intl.NumberFormat('en-US', { style:'currency', currency: cur }).format((cents||0)/100); } catch (e) { return ((cents||0)/100).toFixed(2) + ' ' + cur; } };
      const usd = (cents) => '$' + (Number(cents || 0)/100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const rangeLabel = (ranges.find(r => r.key === range) || {}).label || range;
      const winStart = win.startDate.toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' });
      const winEnd = new Date(win.endDate.getTime() - 1).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' });
      // Compact per-row payload the browser uses to compute ROAS and build the copy block.
      const jsRows = report.rows.map(r => ({
        id: r.id, name: r.name, flag: r.flag, currency: r.currency,
        sessions: r.sessions, orders: r.orders,
        revLocal: r.revenueCents/100, revUsd: r.revenueUsdCents/100, aovLocal: r.aovCents/100,
        cr: r.conversionRate, top: r.topProducts.map(p => `${p.name} (${p.n})`),
      }));
    %>

    <header class="admin-header">
      <div>
        <h1 class="admin-header__title">Ads planner</h1>
        <p class="admin-header__sub">Google&nbsp;Ads · <%= winStart %> &rarr; <%= winEnd %> · the store's side of the numbers, ready to plan against</p>
      </div>
      <div class="admin-header__actions">
        <form method="GET" action="/admin/analytics/ads" class="ap-range">
          <select name="range" class="admin-select" onchange="this.form.submit()">
            <% ranges.forEach(function (r) { %>
              <option value="<%= r.key %>" <%= range === r.key ? 'selected' : '' %>><%= r.label %></option>
            <% }); %>
          </select>
          <% if (range === 'custom') { %>
            <input type="date" name="start" class="admin-input" value="<%= query.start || '' %>">
            <input type="date" name="end" class="admin-input" value="<%= query.end || '' %>">
            <button type="submit" class="admin-btn">Apply</button>
          <% } %>
          <a class="admin-btn admin-btn--ghost admin-btn--xs" href="/admin/analytics/ads.csv?range=<%= range %><%= range==='custom' ? ('&start='+(query.start||'')+'&end='+(query.end||'')) : '' %>">ads-planner.csv</a>
          <a class="admin-btn admin-btn--ghost admin-btn--xs" href="/admin/analytics">← Full analytics</a>
        </form>
      </div>
    </header>

    <div class="admin-content">
      <div class="admin-alert admin-alert--info">
        <div>
          <strong>What this is:</strong> orders and revenue attributed to <strong>Google&nbsp;Ads clicks</strong> (a visit that arrived with a <code>gclid</code>), split by the countries you advertise in. Each country's revenue is in <strong>its own currency</strong>; the USD column and totals use the live courtesy rate. Type your <strong>spend (in USD)</strong> from Google&nbsp;Ads into each row and ROAS / cost-per-order compute instantly — then hit <strong>Copy for Claude</strong>.
        </div>
      </div>

      <% if (report.empty) { %>
        <div class="admin-empty mb-md">
          <p>No Google&nbsp;Ads-attributed sessions or orders in this window.</p>
          <p>Either ads weren't running, or clicks arrived without a <code>gclid</code> (check that auto-tagging is on in Google&nbsp;Ads). Try a wider range.</p>
        </div>
      <% } %>

      <div class="admin-panel">
        <div class="admin-panel__head">
          <div>
            <h2 class="admin-panel__title">Per-country performance</h2>
            <p class="admin-panel__sub">Sessions are ad clicks by visitor country; orders and revenue are ad-attributed sales by storefront. Enter spend to see ROAS (revenue ÷ spend), cost per order, and cost per click.</p>
          </div>
        </div>
        <div class="admin-panel__body admin-panel__body--flush ap-scroll">
          <table class="admin-table ap-table">
            <thead>
              <tr>
                <th>Country</th>
                <th class="num">Ad sessions</th>
                <th class="num">Ad orders</th>
                <th class="num">Conv. rate</th>
                <th class="num">Revenue</th>
                <th class="num">AOV</th>
                <th class="num">Spend (USD)</th>
                <th class="num">ROAS</th>
                <th class="num">Cost / order</th>
                <th class="num">Cost / click</th>
                <th>Top products</th>
              </tr>
            </thead>
            <tbody>
              <% report.rows.forEach(function (r) { %>
                <tr data-market="<%= r.id %>">
                  <td data-l="Country"><span class="ap-mkt"><%= r.flag %> <%= r.name %><small class="admin-cell-sub mono"><%= r.currency %></small></span></td>
                  <td class="num" data-l="Sessions"><%= num(r.sessions) %></td>
                  <td class="num" data-l="Orders"><%= num(r.orders) %></td>
                  <td class="num" data-l="Conv."><%= pc(r.conversionRate) %></td>
                  <td class="num rev" data-l="Revenue"><%= fmtLocal(r.revenueCents, r.currency) %><% if (r.currency !== 'USD') { %><small class="ap-approx">≈ <%= usd(r.revenueUsdCents) %></small><% } %></td>
                  <td class="num" data-l="AOV"><%= fmtLocal(r.aovCents, r.currency) %></td>
                  <td class="num" data-l="Spend"><input class="admin-input ap-spend" type="number" min="0" step="0.01" inputmode="decimal" data-market="<%= r.id %>" placeholder="0.00"></td>
                  <td class="num" data-l="ROAS"><span class="ap-roas none" data-cell="roas">—</span></td>
                  <td class="num" data-l="Cost/order"><span data-cell="cpa">—</span></td>
                  <td class="num" data-l="Cost/click"><span data-cell="cpc">—</span></td>
                  <td class="ap-top" data-l="Top"><%= r.topProducts.length ? r.topProducts.map(p => `${p.name} (${p.n})`).join(', ') : '—' %></td>
                </tr>
              <% }); %>
            </tbody>
            <tfoot>
              <tr>
                <td data-l="Total">Total (USD)</td>
                <td class="num" data-l="Sessions"><%= num(report.total.sessions) %></td>
                <td class="num" data-l="Orders"><%= num(report.total.orders) %></td>
                <td class="num" data-l="Conv."><%= pc(report.total.conversionRate) %></td>
                <td class="num rev" data-l="Revenue"><%= usd(report.total.revenueUsdCents) %></td>
                <td class="num" data-l="AOV"><%= usd(report.total.aovUsdCents) %></td>
                <td class="num" data-l="Spend"><span data-cell="total-spend">—</span></td>
                <td class="num" data-l="ROAS"><span class="ap-roas none" data-cell="total-roas">—</span></td>
                <td class="num" data-l="Cost/order"><span data-cell="total-cpa">—</span></td>
                <td class="num"></td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>

        <div class="admin-panel__foot">
          <button type="button" class="admin-btn admin-btn--primary admin-btn--xs" id="apCopy">Copy for Claude</button>
          <span class="ap-copied" id="apCopied">Copied ✓</span>
          <span class="tiny faint ap-note">Spend is remembered on this device until you change the range.</span>
          <textarea class="ap-out" id="apOut" readonly aria-label="Summary to copy"></textarea>
        </div>
      </div>
    </div>
  </main>

  <script>
    (function () {
      var ROWS = <%- jsonForScript(jsRows) %>;
      var META = { range: <%- jsonForScript(rangeLabel) %>, start: <%- jsonForScript(winStart) %>, end: <%- jsonForScript(winEnd) %> };
      var STORE_KEY = 'ztcg_ads_spend_' + <%- jsonForScript(range) %>;
      var spend = {}; // market -> USD number

      function loadSpend() {
        try { spend = JSON.parse(localStorage.getItem(STORE_KEY) || '{}') || {}; } catch (e) { spend = {}; }
      }
      function saveSpend() {
        try { localStorage.setItem(STORE_KEY, JSON.stringify(spend)); } catch (e) {}
      }
      var fmtUsd = function (n) { return '$' + (Number(n) || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); };
      var roasClass = function (x) { return x >= 3 ? 'good' : x >= 1.5 ? 'mid' : 'bad'; };

      function recalc() {
        var totalSpend = 0, haveAnySpend = false;
        var totalRevUsd = ROWS.reduce(function (s, r) { return s + r.revUsd; }, 0);
        var totalOrders = ROWS.reduce(function (s, r) { return s + r.orders; }, 0);

        ROWS.forEach(function (r) {
          var tr = document.querySelector('tr[data-market="' + r.id + '"]');
          if (!tr) return;
          var s = Number(spend[r.id]);
          var roasEl = tr.querySelector('[data-cell="roas"]');
          var cpaEl = tr.querySelector('[data-cell="cpa"]');
          var cpcEl = tr.querySelector('[data-cell="cpc"]');
          if (s > 0) {
            haveAnySpend = true; totalSpend += s;
            // Revenue in USD vs spend in USD — same currency, honest ROAS.
            var roas = r.revUsd / s;
            roasEl.textContent = roas.toFixed(2) + '×';
            roasEl.className = 'ap-roas ' + roasClass(roas);
            cpaEl.textContent = r.orders > 0 ? fmtUsd(s / r.orders) : '—';
            cpcEl.textContent = r.sessions > 0 ? fmtUsd(s / r.sessions) : '—';
          } else {
            roasEl.textContent = '—'; roasEl.className = 'ap-roas none';
            cpaEl.textContent = '—'; cpcEl.textContent = '—';
          }
        });

        var tsEl = document.querySelector('[data-cell="total-spend"]');
        var trEl = document.querySelector('[data-cell="total-roas"]');
        var tcEl = document.querySelector('[data-cell="total-cpa"]');
        if (haveAnySpend) {
          tsEl.textContent = fmtUsd(totalSpend);
          var bR = totalSpend > 0 ? totalRevUsd / totalSpend : 0;
          trEl.textContent = bR.toFixed(2) + '×'; trEl.className = 'ap-roas ' + roasClass(bR);
          tcEl.textContent = totalOrders > 0 ? fmtUsd(totalSpend / totalOrders) : '—';
        } else {
          tsEl.textContent = '—'; trEl.textContent = '—'; trEl.className = 'ap-roas none'; tcEl.textContent = '—';
        }
        buildOut(haveAnySpend, totalSpend, totalRevUsd, totalOrders);
      }

      function buildOut(haveSpend, totalSpend, totalRevUsd, totalOrders) {
        var L = [];
        L.push('GoGetCards — Google Ads planning data');
        L.push('Window: ' + META.range + ' (' + META.start + ' → ' + META.end + ')');
        L.push('Revenue is in each country\'s currency; USD figures use live FX. Spend entered in USD.');
        L.push('');
        ROWS.forEach(function (r) {
          var s = Number(spend[r.id]) || 0;
          L.push(r.name + ' (' + r.currency + ')');
          L.push('  Ad sessions: ' + r.sessions.toLocaleString('en-US'));
          L.push('  Ad orders: ' + r.orders.toLocaleString('en-US'));
          L.push('  Conversion rate: ' + (r.cr == null ? 'n/a (no sessions)' : r.cr.toFixed(2) + '%'));
          L.push('  Ad revenue: ' + r.revLocal.toLocaleString('en-US', { style: 'currency', currency: r.currency }) + (r.currency !== 'USD' ? ' (≈ ' + fmtUsd(r.revUsd) + ')' : ''));
          L.push('  AOV: ' + r.aovLocal.toLocaleString('en-US', { style: 'currency', currency: r.currency }));
          if (s > 0) {
            L.push('  Spend (USD): ' + fmtUsd(s) + '  |  ROAS: ' + (r.revUsd / s).toFixed(2) + '×  |  Cost/order: ' + (r.orders ? fmtUsd(s / r.orders) : 'n/a') + '  |  Cost/click: ' + (r.sessions ? fmtUsd(s / r.sessions) : 'n/a'));
          } else {
            L.push('  Spend (USD): (not entered)');
          }
          L.push('  Top products: ' + (r.top.length ? r.top.join(', ') : '—'));
          L.push('');
        });
        L.push('TOTALS (USD): revenue ' + fmtUsd(totalRevUsd) + ', orders ' + totalOrders.toLocaleString('en-US') + (haveSpend ? ', spend ' + fmtUsd(totalSpend) + ', blended ROAS ' + (totalSpend ? (totalRevUsd / totalSpend).toFixed(2) : '0') + '×' : ', spend not entered'));
        L.push('');
        L.push('Note: avg CPC across campaigns is under $0.10 (low-price niche).');
        document.getElementById('apOut').value = L.join('\n');
      }

      loadSpend();
      document.querySelectorAll('.ap-spend').forEach(function (inp) {
        var m = inp.getAttribute('data-market');
        if (spend[m] != null) inp.value = spend[m];
        inp.addEventListener('input', function () {
          var v = parseFloat(inp.value);
          if (v > 0) spend[m] = v; else delete spend[m];
          saveSpend();
          recalc();
        });
      });

      document.getElementById('apCopy').addEventListener('click', function () {
        var out = document.getElementById('apOut');
        out.select();
        var done = function () {
          var c = document.getElementById('apCopied');
          c.classList.add('show'); setTimeout(function () { c.classList.remove('show'); }, 1600);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(out.value).then(done, function () { try { document.execCommand('copy'); done(); } catch (e) {} });
        } else { try { document.execCommand('copy'); done(); } catch (e) {} }
      });

      recalc();
    })();
  </script>
</body>
</html>
