<%
  /* This page previously read order.orderId, order.createdAt and
     order.totalPrice, but its route renders it with only { pageTitle } —
     so `order` was undefined and every customer who reached it after
     paying got a 500.

     It is NOT fixed by looking the order up from a query param: an
     unsigned ?orderId= would let anyone enumerate IDs and read another
     customer's name, email and total. The order-details block is removed
     instead. Customers get their real confirmation by email, and the
     signed-token flow at /thank-you is the place that legitimately
     renders order data (it verifies an HMAC before showing anything).

     Also removed: this file included partials/header and partials/footer
     while ALSO rendering through views/layout.ejs, which includes both —
     producing two <header> and two <footer> landmarks per page, one pair
     nested inside <main>. And it was styled light-on-light (#111827 text
     with no background) against a dark site, with copy about "your
     commission" and "your voucher" carried over from a different
     template. */
%>
<section class="cs-wrap">
  <div class="container">
    <div class="cs-card zy-slab">
      <div class="cs-icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </div>

      <span class="zy-meta cs-kicker">Receipt &middot; payment received</span>
      <h1 class="cs-title">Order confirmed</h1>

      <p class="cs-lead">
        Thanks for your order. Payment went through and your confirmation is on its way to the email address you used at checkout.
      </p>

      <div class="cs-next">
        <p class="zy-meta">What happens next</p>
        <ul class="cs-list">
          <li>A confirmation email with your order details arrives within a few minutes.</li>
          <li>Preorders ship on the product's stated release date. In-stock orders placed before 2PM ship the same business day.</li>
          <li>You'll get a tracking number by email as soon as your parcel is dispatched.</li>
        </ul>
      </div>

      <div class="cs-actions">
        <a href="<%= marketPath('/collection/all') %>" class="btn btn-primary btn-lg">Continue shopping</a>
        <a href="<%= marketPath('/contact') %>" class="btn btn-outline btn-lg">Contact support</a>
      </div>

      <p class="cs-foot">
        Nothing in your inbox after 15 minutes? Check your spam folder, then <a href="<%= marketPath('/contact') %>">get in touch</a> and we'll resend it.
      </p>
    </div>
  </div>
</section>

<style>
  /* A receipt slip: one leaf, an ink rule on top, a serif heading, the
     next steps as numbered ruled rows, and one ink action. */
  .cs-wrap { padding: var(--space-3xl) 0 var(--space-4xl); min-height: 60vh; display: flex; align-items: center; }
  .cs-card { position: relative; max-width: 640px; margin: 0 auto; background: var(--color-bg-card); border: 1px solid var(--color-border-light); border-radius: 0; padding: 2.75rem 2.75rem 2.25rem; text-align: center; }
  .cs-icon { width: 48px; height: 48px; border-radius: 0; margin: 0 auto 1.25rem; display: flex; align-items: center; justify-content: center; background: var(--color-plate); border: 1px solid var(--color-accent); color: var(--color-accent); }
  .cs-kicker { display: block; margin: 0 0 0.75rem; }
  .cs-title { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 2.6rem); font-weight: 400; color: var(--color-ink); letter-spacing: -0.02em; line-height: 1.05; margin-bottom: 0.9rem; font-variation-settings: 'opsz' 120; }
  .cs-lead { font-size: 0.98rem; color: var(--color-text-muted); line-height: 1.7; max-width: 460px; margin: 0 auto; }
  .cs-next { text-align: left; margin: 2.25rem 0 2rem; padding: 0; background: none; border: 0; border-radius: 0; }
  .cs-next .zy-meta { color: var(--color-ink); padding-bottom: 0.5rem; border-bottom: 1.5px solid var(--color-ink); }
  .cs-list { list-style: none; margin: 0; padding: 0; counter-reset: cs; display: block; }
  .cs-list li { position: relative; display: grid; grid-template-columns: 2rem 1fr; gap: 0 0.5rem; padding: 0.8rem 0; border-bottom: 1px solid var(--color-border-light); font-size: 0.9rem; color: var(--color-text); line-height: 1.6; }
  .cs-list li::before { content: counter(cs, decimal-leading-zero); counter-increment: cs; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.06em; color: var(--color-primary); padding-top: 0.2rem; }
  .cs-actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; margin-bottom: 1.75rem; }
  .cs-foot { font-size: 0.8rem; color: var(--color-text-faint); line-height: 1.7; }
  .cs-foot a { color: var(--color-text-muted); text-decoration: underline; text-underline-offset: 3px; }
  .cs-foot a:hover { color: var(--color-primary); }
  @media (max-width: 640px) {
    .cs-wrap { padding: var(--space-xl) 0 var(--space-3xl); }
    .cs-card { padding: 2rem 1.25rem 1.75rem; }
    .cs-actions { flex-direction: column; }
  }
</style>
