<%
  /* This page previously read order.orderId, order.createdAt and
     order.totalPrice, but its route renders it with only { pageTitle } —
     so `order` was undefined and every customer who reached it after
     paying got a 500.

     It is NOT fixed by looking the order up from a query param: an
     unsigned ?orderId= would let anyone enumerate IDs and read another
     customer's name, email and total. The order-details block is removed
     instead. Customers get their real confirmation by email, and the
     signed-token flow at /thank-you is the place that legitimately
     renders order data (it verifies an HMAC before showing anything).

     Also removed: this file included partials/header and partials/footer
     while ALSO rendering through views/layout.ejs, which includes both —
     producing two <header> and two <footer> landmarks per page, one pair
     nested inside <main>. And it was styled light-on-light (#111827 text
     with no background) against a dark site, with copy about "your
     commission" and "your voucher" carried over from a different
     template. */
%>
<section class="cs-wrap">
  <div class="container">
    <div class="cs-card zy-slab">
      <div class="cs-icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </div>

      <h1 class="cs-title">Order confirmed</h1>

      <p class="cs-lead">
        Thanks for your order. Payment went through and your confirmation is on its way to the email address you used at checkout.
      </p>

      <div class="cs-next">
        <p class="zy-meta">What happens next</p>
        <ul class="cs-list">
          <li>A confirmation email with your order details arrives within a few minutes.</li>
          <li>Preorders ship on the product's stated release date. In-stock orders placed before 2PM ship the same business day.</li>
          <li>You'll get a tracking number by email as soon as your parcel is dispatched.</li>
        </ul>
      </div>

      <div class="cs-actions">
        <a href="<%= marketPath('/collection/all') %>" class="btn btn-primary btn-lg">Continue shopping</a>
        <a href="<%= marketPath('/contact') %>" class="btn btn-outline btn-lg">Contact support</a>
      </div>

      <p class="cs-foot">
        Nothing in your inbox after 15 minutes? Check your spam folder, then <a href="<%= marketPath('/contact') %>">get in touch</a> and we'll resend it.
      </p>
    </div>
  </div>
</section>

<style>
  .cs-wrap { padding: var(--space-4xl) 0; min-height: 60vh; display: flex; align-items: center; }
  .cs-card { position: relative; max-width: 620px; margin: 0 auto; background: var(--color-bg-card); border: 1px solid var(--color-border-light); border-radius: var(--radius-lg); padding: 3rem 2.75rem; text-align: center; overflow: hidden; }
  .cs-icon { width: 54px; height: 54px; border-radius: 50%; margin: 0 auto 1.5rem; display: flex; align-items: center; justify-content: center; background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.28); color: var(--color-accent); }
  .cs-title { font-family: var(--font-serif); font-size: 2rem; font-weight: 500; color: var(--color-white); letter-spacing: -0.01em; margin-bottom: 0.9rem; }
  .cs-lead { font-size: 0.98rem; font-weight: 300; color: var(--color-text-muted); line-height: 1.8; max-width: 460px; margin: 0 auto; }
  .cs-next { text-align: left; margin: 2.25rem 0; padding: 1.5rem 1.6rem; background: var(--color-bg-elevated); border: 1px solid var(--color-border-light); border-radius: var(--radius-md); }
  .cs-list { list-style: none; margin: 1rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.85rem; }
  .cs-list li { position: relative; padding-left: 1.15rem; font-size: 0.86rem; font-weight: 300; color: var(--color-text-muted); line-height: 1.7; }
  .cs-list li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 5px; height: 5px; border-radius: 50%; background: var(--color-primary); opacity: 0.6; }
  .cs-actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; margin-bottom: 1.75rem; }
  .cs-foot { font-size: 0.78rem; color: var(--color-text-faint); line-height: 1.7; }
  .cs-foot a { color: var(--color-text-muted); text-decoration: underline; }
  @media (max-width: 640px) {
    .cs-card { padding: 2.25rem 1.5rem; }
    .cs-actions { flex-direction: column; }
  }
</style>
