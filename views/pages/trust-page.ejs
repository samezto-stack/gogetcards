<%
  /* One template for every trust and policy page. Content comes from
     config/trustPages.js; nothing here is page-specific, so a new page is
     a config entry rather than a new file that can drift out of step with
     the others. */
  var groups = trustNav;
%>

<nav class="col-page__breadcrumb container" style="padding-top:1.25rem;margin-bottom:0" aria-label="Breadcrumb">
  <a href="<%= marketPath('/') %>">Home</a>
  <span aria-hidden="true">/</span>
  <span aria-current="page"><%= page.title %></span>
</nav>

<div class="container tp">
  <article class="tp__main">
    <header class="tp__head">
      <p class="label-overline tp__over">Policies &amp; guarantees</p>
      <h1 class="tp__title"><%= page.title %></h1>
      <p class="tp__intro"><%= page.intro %></p>
      <p class="tp__meta">Last reviewed <%= lastReviewed %></p>
    </header>

    <% page.sections.forEach(function (section, i) { %>
      <section class="tp__section" aria-labelledby="tp-s<%= i %>">
        <h2 id="tp-s<%= i %>"><%= section.heading %></h2>
        <% section.blocks.forEach(function (block) { %>

          <% if (block.type === 'p') { %>
            <p><%= block.text %></p>

          <% } else if (block.type === 'ul') { %>
            <ul>
              <% block.items.forEach(function (item) { %><li><%= item %></li><% }); %>
            </ul>

          <% } else if (block.type === 'dl') { %>
            <dl class="tp__dl">
              <% block.pairs.forEach(function (pair) { %>
                <dt><%= pair[0] %></dt>
                <dd><%= pair[1] %></dd>
              <% }); %>
            </dl>

          <% } else if (block.type === 'note') { %>
            <%/* The one thing on the page a reader must not miss. Marked up
                 as a real callout rather than bolded body text so it reads
                 as a distinct statement in a screen reader too. */%>
            <p class="tp__note"><%= block.text %></p>

          <% } else if (block.type === 'regions') { %>
            <%/* The delivery table, rendered from config/shipping.js — the
                 same source as the Shipping page and the Offer schema, so
                 a transit estimate cannot say one thing here and another
                 there. */%>
            <div class="tp__table-wrap">
              <table class="tp__table">
                <caption class="sr-only">Estimated delivery time and carrier by destination. Shipping is free to every destination listed.</caption>
                <thead>
                  <tr><th scope="col">Destination</th><th scope="col">Carrier</th><th scope="col">Estimated delivery</th><th scope="col">Cost</th></tr>
                </thead>
                <tbody>
                  <% shippingCfg.REGIONS.forEach(function (r) { %>
                    <tr>
                      <th scope="row"><%= r.name %></th>
                      <td><%= r.carrier %></td>
                      <td><%= r.transitDays[0] %>&ndash;<%= r.transitDays[1] %> business days</td>
                      <td class="tp__free">Free</td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>

        <% }); %>
      </section>
    <% }); %>

    <footer class="tp__foot">
      <%/* Email only. The sidebar already carries a Contact us button, and
           two links to /contact under different labels in the same view
           reads as two destinations. */%>
      <p>
        Something here not clear, or not matching what happened to your order?
        Email <a href="mailto:<%= company.business.supportEmail %>"><%= company.business.supportEmail %></a>
        and we will fix the page or the order, whichever is wrong.
      </p>
    </footer>
  </article>

  <%/* Every other trust page, from every page. These were the orphans
       before: a policy page with no outbound links is a dead end for a
       reader and a crawl dead end for Google, and a reviewer checking
       whether the store documents its terms should never have to go back
       to the footer to find the next one. */%>
  <aside class="tp__aside" aria-labelledby="tp-more">
    <h2 id="tp-more" class="tp__aside-title">More information</h2>
    <% Object.values(groups).forEach(function (group) { %>
      <% if (group.items.length) { %>
        <nav class="tp__aside-group" aria-label="<%= group.label %>">
          <p class="tp__aside-group-title"><%= group.label %></p>
          <ul>
            <% group.items.forEach(function (item) { %>
              <li>
                <a href="<%= marketPath('/' + (item.slug)) %>"<%= currentPath === '/' + item.slug ? ' aria-current="page"' : '' %>><%= item.label %></a>
              </li>
            <% }); %>
          </ul>
        </nav>
      <% } %>
    <% }); %>
    <%/* Only /shipping is listed by hand: it is the one policy page that
         is not a trustPages entry (it renders a live table from
         config/shipping.js instead). Everything else comes from the group
         loop above — this block used to repeat the five legal pages, so
         each one appeared twice in the same sidebar. */%>
    <nav class="tp__aside-group" aria-label="Delivery">
      <p class="tp__aside-group-title">Delivery</p>
      <ul>
        <li><a href="<%= marketPath('/shipping') %>">Shipping &amp; Delivery</a></li>
      </ul>
    </nav>
    <div class="tp__aside-cta">
      <p class="tp__aside-cta-title">Still stuck?</p>
      <p class="tp__aside-cta-body">
        We answer within <%= company.business.responseTimeHours %> hours, and a person reads every message.
      </p>
      <a href="<%= marketPath('/contact') %>" class="btn btn-outline btn-sm">Contact Us</a>
    </div>
  </aside>
</div>

<style>
  /* The main column sets the measure directly rather than being capped
     inside a wider 1fr track, which left a band of dead space between the
     text and the sidebar. Set like a printed document: a mono overline, a
     serif title over an ink rule, numbered sections at a ~65ch measure. */
  .tp { display: grid; grid-template-columns: minmax(0, 46rem) 16.5rem; gap: 4.5rem; padding-top: 1.75rem; padding-bottom: 4.5rem; align-items: start; justify-content: space-between; }
  .tp__main { min-width: 0; counter-reset: tpsec; }
  .tp__head { padding-bottom: 1.6rem; border-bottom: 1px solid var(--color-border-light); margin-bottom: 2.25rem; }
  .tp__over { margin-bottom: 0.9rem; }
  .tp__title { font-family: var(--font-display); font-size: clamp(2.1rem, 4.6vw, 3.3rem); font-weight: 400; letter-spacing: -0.02em; line-height: 1.03; color: var(--color-ink); font-variation-settings: 'opsz' 144; padding-bottom: 1.1rem; border-bottom: 1.5px solid var(--color-ink); }
  .tp__intro { font-family: var(--font-display); font-weight: 300; font-size: 1.2rem; line-height: 1.6; color: var(--color-text); margin-top: 1.25rem; max-width: 60ch; font-variation-settings: 'opsz' 36; }
  .tp__meta { font-family: var(--font-mono); font-size: 0.68rem; color: var(--color-text-faint); margin-top: 1.1rem; text-transform: uppercase; letter-spacing: 0.12em; }
  .tp__head a, .tp__foot a, .tp__section a { color: var(--color-primary); text-decoration: underline; text-underline-offset: 2px; }

  .tp__foot { margin-top: 2.75rem; padding-top: 1.25rem; border-top: 1.5px solid var(--color-ink); }
  .tp__foot p { font-size: 0.9rem; line-height: 1.8; color: var(--color-text-muted); max-width: 65ch; }

  .tp__aside { position: sticky; top: calc(var(--header-h) + 1.5rem); display: flex; flex-direction: column; gap: 1.6rem; border-top: 1.5px solid var(--color-ink); padding-top: 0.85rem; }
  .tp__aside-title { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-text-muted); }
  .tp__aside-group-title { font-family: var(--font-display); font-size: 1.05rem; font-weight: 400; color: var(--color-ink); padding-bottom: 0.4rem; border-bottom: 1px solid var(--color-border-light); }
  .tp__aside-group ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .tp__aside-group li { border-bottom: 1px solid var(--color-rule-soft); }
  .tp__aside-group a { display: block; padding: 0.42rem 0; font-size: 0.85rem; color: var(--color-text); text-decoration: none; }
  .tp__aside-group a:hover { color: var(--color-primary); }
  .tp__aside-group a[aria-current="page"] { color: var(--color-primary); font-weight: 600; }
  .tp__aside-group a[aria-current="page"]::before { content: '\25B8\00A0'; font-size: 0.75em; }
  .tp__aside-cta { background: var(--color-bg-card); border: 1px solid var(--color-border-light); border-top: 1.5px solid var(--color-ink); border-radius: 0; padding: 1.1rem; }
  .tp__aside-cta-title { font-family: var(--font-display); font-size: 1.15rem; font-weight: 400; color: var(--color-ink); }
  .tp__aside-cta-body { font-size: 0.8rem; line-height: 1.7; color: var(--color-text-muted); margin: 0.35rem 0 0.9rem; }

  .tp__section { margin-bottom: 2.75rem; counter-increment: tpsec; }
  .tp__section h2 { display: flex; align-items: baseline; gap: 0.9rem; font-family: var(--font-display); font-size: 1.55rem; font-weight: 400; line-height: 1.2; color: var(--color-ink); margin-bottom: 1rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--color-border-light); }
  .tp__section h2::before { content: '\00A7\00A0' counter(tpsec, decimal-leading-zero); flex-shrink: 0; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em; color: var(--color-text-faint); }
  .tp__section p { font-size: 0.96rem; line-height: 1.85; color: var(--color-text); margin-bottom: 0.95rem; max-width: 65ch; }
  .tp__section ul { margin: 0 0 1.1rem; padding: 0; list-style: none; max-width: 65ch; }
  .tp__section li { position: relative; padding-left: 1.4rem; font-size: 0.95rem; line-height: 1.8; color: var(--color-text); margin-bottom: 0.55rem; }
  .tp__section li::before { content: '\2014'; position: absolute; left: 0; color: var(--color-text-faint); }

  .tp__dl { margin: 0 0 1.1rem; border-top: 1px solid var(--color-ink); max-width: 65ch; }
  .tp__dl dt { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-ink); padding-top: 0.85rem; }
  .tp__dl dd { margin: 0.3rem 0 0; padding-bottom: 0.85rem; border-bottom: 1px solid var(--color-border-light); font-size: 0.93rem; line-height: 1.8; color: var(--color-text); }

  .tp__note { background: var(--color-bg-card); border: 1px solid var(--color-border-light); border-left: 3px solid var(--color-ink); border-radius: 0; padding: 0.95rem 1.15rem; color: var(--color-ink) !important; font-family: var(--font-display); font-size: 1.08rem !important; font-weight: 400; line-height: 1.6 !important; }

  .tp__table-wrap { overflow-x: auto; margin: 0.25rem 0 1.4rem; }
  .tp__table { width: 100%; border-collapse: collapse; font-size: 0.88rem; min-width: 32rem; }
  .tp__table th, .tp__table td { text-align: left; padding: 0.7rem 0.85rem 0.7rem 0; border-bottom: 1px solid var(--color-border-light); }
  .tp__table thead th { font-family: var(--font-mono); font-weight: 500; font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-text-muted); border-bottom: 1.5px solid var(--color-ink); }
  .tp__table tbody th { font-weight: 500; color: var(--color-ink); }
  .tp__table td { color: var(--color-text); }
  .tp__table td:nth-child(3) { font-family: var(--font-mono); font-size: 0.8rem; }
  .tp__free { font-family: var(--font-mono); font-size: 0.7rem !important; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-accent) !important; }

  @media (max-width: 980px) {
    .tp { grid-template-columns: 1fr; gap: 2.75rem; }
    .tp__aside { position: static; }
  }
  @media (max-width: 640px) {
    .tp__intro { font-size: 1.06rem; }
    .tp__table { min-width: 0; font-size: 0.8rem; }
    .tp__table th, .tp__table td { padding: 0.6rem 0.5rem 0.6rem 0; }
    .tp__table thead th { font-size: 0.58rem; letter-spacing: 0.08em; }
    .tp__table td:nth-child(3) { font-size: 0.72rem; }
    .tp__table th:last-child, .tp__table td:last-child { padding-right: 0; text-align: right; }
  }
</style>
