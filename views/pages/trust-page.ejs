<%
  /* One template for every trust and policy page. Content comes from
     config/trustPages.js; nothing here is page-specific, so a new page is
     a config entry rather than a new file that can drift out of step with
     the others. */
  var groups = trustNav;
%>

<nav class="col-page__breadcrumb container" style="padding-top:1rem" aria-label="Breadcrumb">
  <a href="<%= marketPath('/') %>">Home</a>
  <span aria-hidden="true">/</span>
  <span aria-current="page"><%= page.title %></span>
</nav>

<div class="container tp">
  <article class="tp__main">
    <header class="tp__head">
      <h1 class="heading-section"><%= page.title %></h1>
      <p class="tp__intro"><%= page.intro %></p>
      <p class="tp__meta">Last reviewed <%= lastReviewed %></p>
    </header>

    <% page.sections.forEach(function (section, i) { %>
      <section class="tp__section" aria-labelledby="tp-s<%= i %>">
        <h2 id="tp-s<%= i %>"><%= section.heading %></h2>
        <% section.blocks.forEach(function (block) { %>

          <% if (block.type === 'p') { %>
            <p><%= block.text %></p>

          <% } else if (block.type === 'ul') { %>
            <ul>
              <% block.items.forEach(function (item) { %><li><%= item %></li><% }); %>
            </ul>

          <% } else if (block.type === 'dl') { %>
            <dl class="tp__dl">
              <% block.pairs.forEach(function (pair) { %>
                <dt><%= pair[0] %></dt>
                <dd><%= pair[1] %></dd>
              <% }); %>
            </dl>

          <% } else if (block.type === 'note') { %>
            <%/* The one thing on the page a reader must not miss. Marked up
                 as a real callout rather than bolded body text so it reads
                 as a distinct statement in a screen reader too. */%>
            <p class="tp__note"><%= block.text %></p>

          <% } else if (block.type === 'regions') { %>
            <%/* The delivery table, rendered from config/shipping.js — the
                 same source as the Shipping page and the Offer schema, so
                 a transit estimate cannot say one thing here and another
                 there. */%>
            <div class="tp__table-wrap">
              <table class="tp__table">
                <caption class="sr-only">Estimated delivery time and carrier by destination. Shipping is free to every destination listed.</caption>
                <thead>
                  <tr><th scope="col">Destination</th><th scope="col">Carrier</th><th scope="col">Estimated delivery</th><th scope="col">Cost</th></tr>
                </thead>
                <tbody>
                  <% shippingCfg.REGIONS.forEach(function (r) { %>
                    <tr>
                      <th scope="row"><%= r.name %></th>
                      <td><%= r.carrier %></td>
                      <td><%= r.transitDays[0] %>&ndash;<%= r.transitDays[1] %> business days</td>
                      <td class="tp__free">Free</td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>

        <% }); %>
      </section>
    <% }); %>

    <footer class="tp__foot">
      <%/* Email only. The sidebar already carries a Contact us button, and
           two links to /contact under different labels in the same view
           reads as two destinations. */%>
      <p>
        Something here not clear, or not matching what happened to your order?
        Email <a href="mailto:<%= company.business.supportEmail %>"><%= company.business.supportEmail %></a>
        and we will fix the page or the order, whichever is wrong.
      </p>
    </footer>
  </article>

  <%/* Every other trust page, from every page. These were the orphans
       before: a policy page with no outbound links is a dead end for a
       reader and a crawl dead end for Google, and a reviewer checking
       whether the store documents its terms should never have to go back
       to the footer to find the next one. */%>
  <aside class="tp__aside" aria-labelledby="tp-more">
    <h2 id="tp-more" class="tp__aside-title">More information</h2>
    <% Object.values(groups).forEach(function (group) { %>
      <% if (group.items.length) { %>
        <nav class="tp__aside-group" aria-label="<%= group.label %>">
          <p class="tp__aside-group-title"><%= group.label %></p>
          <ul>
            <% group.items.forEach(function (item) { %>
              <li>
                <a href="<%= marketPath('/' + (item.slug)) %>"<%= currentPath === '/' + item.slug ? ' aria-current="page"' : '' %>><%= item.label %></a>
              </li>
            <% }); %>
          </ul>
        </nav>
      <% } %>
    <% }); %>
    <%/* Only /shipping is listed by hand: it is the one policy page that
         is not a trustPages entry (it renders a live table from
         config/shipping.js instead). Everything else comes from the group
         loop above — this block used to repeat the five legal pages, so
         each one appeared twice in the same sidebar. */%>
    <nav class="tp__aside-group" aria-label="Delivery">
      <p class="tp__aside-group-title">Delivery</p>
      <ul>
        <li><a href="<%= marketPath('/shipping') %>">Shipping &amp; Delivery</a></li>
      </ul>
    </nav>
    <div class="tp__aside-cta">
      <p class="tp__aside-cta-title">Still stuck?</p>
      <p class="tp__aside-cta-body">
        We answer within <%= company.business.responseTimeHours %> hours, and a person reads every message.
      </p>
      <a href="<%= marketPath('/contact') %>" class="btn btn-outline btn-sm">Contact Us</a>
    </div>
  </aside>
</div>

<style>
  /* The main column sets the measure directly rather than being capped
     inside a wider 1fr track, which left a band of dead space between the
     text and the sidebar. */
  .tp { display: grid; grid-template-columns: minmax(0, 46rem) 17rem; gap: 4rem; padding-top: 2rem; padding-bottom: 4.5rem; align-items: start; justify-content: start; }
  .tp__main { min-width: 0; }
  .tp__head { padding-bottom: 1.75rem; border-bottom: 1px solid var(--color-border-light); margin-bottom: 2rem; }
  .tp__intro { font-size: 1.02rem; line-height: 1.8; color: var(--color-text-muted); margin-top: 0.9rem; max-width: 60ch; }
  .tp__meta { font-size: 0.74rem; color: var(--color-text-faint); margin-top: 1rem; text-transform: uppercase; letter-spacing: 0.06em; }

  .tp__section { margin-bottom: 2.5rem; }
  .tp__section h2 { font-family: var(--font-heading); font-size: 1.12rem; font-weight: 800; color: var(--color-heading); margin-bottom: 0.9rem; }
  .tp__section p { font-size: 0.92rem; line-height: 1.85; color: var(--color-text-muted); margin-bottom: 0.9rem; max-width: 66ch; }
  .tp__section ul { margin: 0 0 1rem 1.1rem; padding: 0; }
  .tp__section li { font-size: 0.92rem; line-height: 1.8; color: var(--color-text-muted); margin-bottom: 0.5rem; max-width: 64ch; }

  .tp__dl { margin: 0 0 1rem; display: flex; flex-direction: column; gap: 0.8rem; }
  .tp__dl dt { font-family: var(--font-heading); font-size: 0.88rem; font-weight: 700; color: var(--color-heading); }
  .tp__dl dd { margin: 0.25rem 0 0; font-size: 0.9rem; line-height: 1.8; color: var(--color-text-muted); max-width: 64ch; }

  .tp__note { background: rgba(15,42,74,0.12); border-left: 3px solid var(--color-primary); border-radius: 0 var(--radius-md) var(--radius-md) 0; padding: 0.9rem 1.1rem; color: var(--color-text) !important; font-weight: 600; }

  .tp__table-wrap { overflow-x: auto; margin: 0 0 1.25rem; }
  .tp__table { width: 100%; border-collapse: collapse; font-size: 0.85rem; min-width: 32rem; }
  .tp__table th, .tp__table td { text-align: left; padding: 0.65rem 0.85rem; border-bottom: 1px solid var(--color-border-light); }
  .tp__table thead th { font-family: var(--font-heading); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-faint); }
  .tp__table tbody th { font-weight: 600; color: var(--color-text); }
  .tp__table td { color: var(--color-text-muted); }
  .tp__free { color: var(--color-accent, #10B981) !important; font-weight: 700; }

  .tp__foot { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border-light); }
  .tp__foot p { font-size: 0.86rem; line-height: 1.8; color: var(--color-text-muted); }
  .tp__foot a { color: var(--color-primary); }

  .tp__aside { position: sticky; top: 6rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .tp__aside-title { font-family: var(--font-heading); font-size: 0.74rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-faint); }
  .tp__aside-group-title { font-family: var(--font-heading); font-size: 0.78rem; font-weight: 700; color: var(--color-heading); margin-bottom: 0.5rem; }
  .tp__aside-group ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .tp__aside-group a { font-size: 0.84rem; color: var(--color-text-muted); text-decoration: none; }
  .tp__aside-group a:hover { color: var(--color-primary); }
  .tp__aside-group a[aria-current="page"] { color: var(--color-primary); font-weight: 700; }
  .tp__aside-cta { background: var(--color-bg-card); border: 1px solid var(--color-border-light); border-radius: var(--radius-md); padding: 1.1rem; }
  .tp__aside-cta-title { font-family: var(--font-heading); font-size: 0.88rem; font-weight: 700; color: var(--color-heading); }
  .tp__aside-cta-body { font-size: 0.78rem; line-height: 1.7; color: var(--color-text-muted); margin: 0.35rem 0 0.8rem; }

  @media (max-width: 980px) {
    .tp { grid-template-columns: 1fr; gap: 2.5rem; }
    .tp__aside { position: static; }
  }
</style>
