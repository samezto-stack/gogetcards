<div class="container doc-page">
  <header class="doc-head">
    <nav class="col-page__breadcrumb" aria-label="Breadcrumb">
      <a href="<%= marketPath('/') %>">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page"><%= page.title %></span>
    </nav>
    <div class="legal-badge label-overline">
      <% if (page.category === 'legal') { %>
        <%- include('../partials/icon', { name: 'shield', size: 12, color: 'currentColor' }) %> Documentation
      <% } else { %>
        <%- include('../partials/icon', { name: 'info', size: 12, color: 'currentColor' }) %> Information
      <% } %>
    </div>
    <h1 class="legal-title"><%= page.title %></h1>
  </header>

  <div class="legal-body-container">
    <!-- The DB content includes an h2 duplicating the title. We hide it via CSS. -->
    <%- page.content %>
  </div>
</div>

<style>
  /* A printed document: mono overline, a serif title over an ink rule,
     then the body at a ~65ch measure with numbered section heads. The
     content comes from the database as HTML, so everything below styles
     whatever elements it happens to use. */
  .doc-page { max-width: 56rem; margin-left: auto; margin-right: auto; padding-top: 1.25rem; padding-bottom: 4.5rem; }
  .doc-head .col-page__breadcrumb { margin-bottom: 1.75rem; }
  .legal-badge { display: inline-flex; align-items: center; gap: 0.5rem; margin-bottom: 0.9rem; }
  .legal-title { font-family: var(--font-display); font-size: clamp(2.1rem, 4.6vw, 3.3rem); font-weight: 400; letter-spacing: -0.02em; line-height: 1.03; color: var(--color-ink); font-variation-settings: 'opsz' 144; padding-bottom: 1.1rem; border-bottom: 1.5px solid var(--color-ink); margin-bottom: 0; }

  .legal-body-container { padding-top: 1.5rem; counter-reset: docsec; color: var(--color-text); font-size: 0.96rem; line-height: 1.85; }
  .legal-body-container .legal-page { max-width: none; display: block; }
  .legal-body-container > *, .legal-body-container .legal-page > * { max-width: 65ch; }

  /* Hide duplicate H2 from raw DB content */
  .legal-body-container .legal-page > h2:first-child { display: none; }

  .legal-body-container .legal-updated { font-family: var(--font-mono); font-size: 0.68rem !important; font-weight: 400; color: var(--color-text-faint) !important; text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 2rem !important; padding-bottom: 1.1rem; border-bottom: 1px solid var(--color-border-light); max-width: none; }

  .legal-body-container h2 { font-family: var(--font-display); font-size: 1.8rem; font-weight: 400; color: var(--color-ink); margin: 2.5rem 0 1rem; }
  .legal-body-container h3 { counter-increment: docsec; display: flex; align-items: baseline; gap: 0.9rem; font-family: var(--font-display); font-size: 1.5rem; font-weight: 400; line-height: 1.2; color: var(--color-ink); margin: 2.75rem 0 1rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--color-border-light); max-width: none; }
  .legal-body-container h3::before { content: '\00A7\00A0' counter(docsec, decimal-leading-zero); flex-shrink: 0; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em; color: var(--color-text-faint); }
  .legal-body-container h4 { font-family: var(--font-heading); font-size: 0.98rem; font-weight: 600; color: var(--color-ink); margin: 1.75rem 0 0.5rem; }

  .legal-body-container p { margin: 0 0 1rem; }

  .legal-body-container ul, .legal-body-container ol { margin: 0.5rem 0 1.25rem; padding: 0 0 0 1.4rem; }
  .legal-body-container ul { list-style: none; padding-left: 0; }
  .legal-body-container ul > li { position: relative; padding-left: 1.4rem; }
  .legal-body-container ul > li::before { content: '\2014'; position: absolute; left: 0; color: var(--color-text-faint); }
  .legal-body-container ol { list-style: decimal; }
  .legal-body-container ol > li::marker { font-family: var(--font-mono); font-size: 0.8em; color: var(--color-text-faint); }
  .legal-body-container li { line-height: 1.8; margin-bottom: 0.5rem; }

  .legal-body-container a { color: var(--color-primary); text-decoration: underline; text-underline-offset: 2px; }
  .legal-body-container a:hover { color: var(--color-ink); }
  .legal-body-container strong { color: var(--color-ink); font-weight: 600; }

  /* Tables as ruled ledgers */
  .legal-body-container table, .legal-body-container .legal-table { width: 100%; max-width: none; border-collapse: collapse; margin: 1rem 0 2rem; font-size: 0.88rem; background: transparent; border: 0; }
  .legal-body-container th, .legal-body-container td { padding: 0.7rem 0.9rem 0.7rem 0; text-align: left; border-bottom: 1px solid var(--color-border-light); vertical-align: top; }
  .legal-body-container thead th, .legal-body-container tr:first-child th { background: transparent; font-family: var(--font-mono); font-weight: 500; font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-text-muted); border-bottom: 1.5px solid var(--color-ink); }
  .legal-body-container tbody tr:hover td { background: var(--color-bg-card); }

  @media (max-width: 768px) {
    .legal-body-container table { display: block; overflow-x: auto; }
    .legal-body-container h3 { font-size: 1.3rem; }
  }
</style>
