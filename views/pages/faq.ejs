<nav class="col-page__breadcrumb container" style="padding-top:1rem" aria-label="Breadcrumb">
  <a href="<%= marketPath('/') %>">Home</a>
  <span aria-hidden="true">/</span>
  <span aria-current="page">FAQ</span>
</nav>

<div class="container tp">
  <article class="tp__main">
    <header class="tp__head">
      <h1 class="heading-section">Frequently Asked Questions</h1>
      <%/* No /contact link here: the sidebar CTA below is the one route,
           and a second link under a different label in the same view reads
           as a different destination. */%>
      <p class="tp__intro">
        The questions we are asked most, answered properly. If yours is not here,
        ask us and we will answer within <%= company.business.responseTimeHours %> hours.
      </p>
      <p class="tp__meta">Last reviewed <%= lastReviewed %></p>
    </header>

    <%/* Rendered from config/faq.js, which also builds the FAQPage JSON-LD
         on this route. Same array, so the marked-up answer and the visible
         one are the same string by construction — Google issues manual
         actions when marked-up FAQ content is not on the page.

         Open by default rather than collapsed. A policy answer hidden
         behind a click is one a reviewer may not open, and there is no
         reason to hide the thing the page exists to say. */%>
    <div class="faq-page-list">
      <% faqs.forEach(function (faq, i) { %>
        <section class="faq-page-item" aria-labelledby="faq-q<%= i %>">
          <h2 class="faq-page-item__q" id="faq-q<%= i %>"><%= faq.q %></h2>
          <p class="faq-page-item__a"><%= faq.a %></p>
        </section>
      <% }); %>
    </div>

    <footer class="tp__foot">
      <p>
        Still stuck? Email
        <a href="mailto:<%= company.business.supportEmail %>"><%= company.business.supportEmail %></a>.
        A person reads every one.
      </p>
    </footer>
  </article>

  <aside class="tp__aside" aria-labelledby="faq-more">
    <h2 id="faq-more" class="tp__aside-title">More information</h2>
    <% Object.values(trustNav).forEach(function (group) { %>
      <% if (group.items.length) { %>
        <nav class="tp__aside-group" aria-label="<%= group.label %>">
          <p class="tp__aside-group-title"><%= group.label %></p>
          <ul>
            <% group.items.forEach(function (item) { %>
              <li><a href="<%= marketPath('/' + (item.slug)) %>"><%= item.label %></a></li>
            <% }); %>
          </ul>
        </nav>
      <% } %>
    <% }); %>
    <nav class="tp__aside-group" aria-label="Shipping">
      <p class="tp__aside-group-title">Delivery</p>
      <ul><li><a href="<%= marketPath('/shipping') %>">Shipping &amp; Delivery</a></li></ul>
    </nav>
    <div class="tp__aside-cta">
      <p class="tp__aside-cta-title">Still stuck?</p>
      <p class="tp__aside-cta-body">
        We answer within <%= company.business.responseTimeHours %> hours, and a person reads every message.
      </p>
      <a href="<%= marketPath('/contact') %>" class="btn btn-outline btn-sm">Contact Us</a>
    </div>
  </aside>
</div>

<style>
  .faq-page-list { display: flex; flex-direction: column; gap: 1.75rem; }
  .faq-page-item__q { font-family: var(--font-heading); font-size: 1.02rem; font-weight: 800; color: var(--color-white); margin-bottom: 0.6rem; }
  .faq-page-item__a { font-size: 0.92rem; line-height: 1.85; color: var(--color-text-muted); max-width: 66ch; }
  .tp__head a, .tp__foot a { color: var(--color-primary); }
  /* .tp's grid comes from trust-page.ejs, which is only loaded on those
     routes, so the measure is restated here rather than inherited. */
  .tp { display: grid; grid-template-columns: minmax(0, 46rem) 17rem; gap: 4rem; padding-top: 2rem; padding-bottom: 4.5rem; align-items: start; justify-content: start; }
  .tp__main { min-width: 0; }
  .tp__head { padding-bottom: 1.75rem; border-bottom: 1px solid var(--color-border-light); margin-bottom: 2rem; }
  .tp__intro { font-size: 1.02rem; line-height: 1.8; color: var(--color-text-muted); margin-top: 0.9rem; max-width: 60ch; }
  .tp__meta { font-size: 0.74rem; color: var(--color-text-faint); margin-top: 1rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .tp__foot { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border-light); }
  .tp__foot p { font-size: 0.86rem; line-height: 1.8; color: var(--color-text-muted); }
  .tp__aside { position: sticky; top: 6rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .tp__aside-title { font-family: var(--font-heading); font-size: 0.74rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-faint); }
  .tp__aside-group-title { font-family: var(--font-heading); font-size: 0.78rem; font-weight: 700; color: var(--color-white); margin-bottom: 0.5rem; }
  .tp__aside-group ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .tp__aside-group a { font-size: 0.84rem; color: var(--color-text-muted); text-decoration: none; }
  .tp__aside-group a:hover { color: var(--color-primary); }
  .tp__aside-cta { background: var(--color-bg-card); border: 1px solid var(--color-border-light); border-radius: var(--radius-md); padding: 1.1rem; }
  .tp__aside-cta-title { font-family: var(--font-heading); font-size: 0.88rem; font-weight: 700; color: var(--color-white); }
  .tp__aside-cta-body { font-size: 0.78rem; line-height: 1.7; color: var(--color-text-muted); margin: 0.35rem 0 0.8rem; }
  @media (max-width: 980px) { .tp { grid-template-columns: 1fr; gap: 2.5rem; } .tp__aside { position: static; } }
</style>
