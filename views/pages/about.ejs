<nav class="col-page__breadcrumb container" style="padding-top:1.25rem" aria-label="Breadcrumb">
  <a href="<%= marketPath('/') %>">Home</a>
  <span aria-hidden="true">/</span>
  <span aria-current="page">About</span>
</nav>

<div class="about-page">
  <!-- Title page -->
  <div class="about-hero">
    <div class="container">
      <div class="about-hero__eyebrow">
        <span class="label-overline">About Zyphera TCG</span>
        <span class="about-hero__eyebrow-rule" aria-hidden="true"></span>
        <span class="zy-meta">Sealed product only</span>
      </div>
      <h1 class="heading-hero about-hero__title">
        We sell sealed product<br /><span class="gradient-text">we can account for</span>
      </h1>
      <%/* The previous opening was "Zyphera TCG was born out of
           frustration... we decided to build the store we always wished
           existed", which is the origin story every store in this category
           tells and which says nothing checkable. This one leads with the
           single fact that distinguishes the business and that a customer
           can hold us to. */%>
      <p class="about-hero__sub">
        Every box, case and elite trainer box we list is bought through authorized
        distribution and reaches you exactly as it left the manufacturer. That
        constraint is the whole business. It costs us margin, it occasionally costs
        us a set we would like to have listed, and it is the reason we can make the
        guarantees on this site without hedging them.
      </p>
    </div>
  </div>

  <!-- What we do -->
  <section class="about-sec">
    <div class="container">
      <div class="reg-head">
        <span class="reg-head__num">§ 01 — What we do</span>
        <h2 class="reg-head__title heading-section">Sealed product, sourced one way</h2>
        <span></span>
      </div>
      <div class="about-story">
        <div class="about-story__text">
          <p>
            Zyphera TCG is an independent retailer of sealed trading card product:
            Pokémon, Yu-Gi-Oh!, Magic: The Gathering and One Piece booster boxes,
            cases and elite trainer boxes, plus preorders on sets before they release.
          </p>
          <p>
            We buy through authorized distribution and nowhere else. Not the secondary
            market, not liquidation lots, not private sellers, not marketplaces where
            a product's history cannot be established. Where a set is allocated and we
            cannot get enough of it, we list what we were allocated and stop, rather
            than filling the gap from somewhere we would not want to name.
          </p>
          <p>
            Nothing we ship has been opened, weighed, searched or resealed. Weighing
            is worth naming specifically: it is the technique that identifies searched
            product, and it is also the technique that creates it. We do not do it and
            we do not buy from anyone we believe does.
          </p>
          <div class="about-story__ctas">
            <a href="<%= marketPath('/collection/all') %>" class="btn btn-primary" id="about-shop-btn">Browse Products →</a>
            <a href="<%= marketPath('/authenticity-guarantee') %>" class="btn btn-outline" id="about-guarantee-btn">Read the authenticity guarantee</a>
          </div>
        </div>
        <%
          /* Stats render ONLY when config/company.js has a real value.
             This block previously asserted "10,000+ Orders Delivered",
             "4.9 Average Rating", "6+ Years Operating" and "£10M+ Product
             Shipped" (GBP, on a USD store) with nothing behind any of it.
             The rating in particular is an FTC problem: a stated average
             with no review system is exactly what 16 CFR Part 465 covers.
             Fill values in config/company.js as you can evidence them. */
          var st = company.stats, ct = company.constants;
          var statCards = [];
          if (st.ordersDelivered)     statCards.push({ icon:'package',  num: st.ordersDelivered,      label:'Orders Delivered' });
          if (ct.factorySealedPct)    statCards.push({ icon:'lock',     num: ct.factorySealedPct,     label:'Factory Sealed' });
          if (st.averageRating)       statCards.push({ icon:'sparkles', num: st.averageRating,        label:'Average Rating' });
          if (st.yearsOperating)      statCards.push({ icon:'trophy',   num: st.yearsOperating + '+', label:'Years Operating' });
          if (ct.tcgBrandsStocked)    statCards.push({ icon:'diamond',  num: ct.tcgBrandsStocked,     label:'TCG Brands Stocked' });
          if (st.productShippedValue) statCards.push({ icon:'globe',    num: st.productShippedValue,  label:'Product Shipped' });
        %>
        <aside class="about-story__aside">
          <%/* A pull quote set from the paragraph beside it. Hidden from
               assistive tech because it repeats text already read out. */%>
          <blockquote class="about-pull" aria-hidden="true">
            Nothing we ship has been opened, weighed, searched or resealed.
          </blockquote>
          <% if (statCards.length) { %>
          <dl class="about-facts">
            <% statCards.forEach(function (c) { %>
              <div class="about-stat">
                <dt class="about-stat__label"><%= c.label %></dt>
                <dd class="about-stat__num"><%= c.num %></dd>
              </div>
            <% }); %>
          </dl>
          <% } %>
        </aside>
      </div>
    </div>
  </section>

  <!-- What we commit to -->
  <%/* Four commitments, each one linking to the page that states it in
       full. This replaces a "Values" grid of Integrity / Quality /
       Community / Transparency, which are the four words every company
       picks and none of which a customer can check. Each of these is a
       promise with a page behind it. */%>
  <section class="about-sec about-sec--band">
    <div class="container">
      <div class="reg-head">
        <span class="reg-head__num">§ 02 — What we commit to</span>
        <h2 class="reg-head__title heading-section">Four promises, each written down</h2>
        <span></span>
      </div>
      <div class="value-grid">
        <a class="value-card value-card--link" href="<%= marketPath('/authenticity-guarantee') %>">
          <span class="value-card__n" aria-hidden="true">i.</span>
          <h3 class="value-card__title">Authenticity</h3>
          <p class="value-card__desc">
            Genuine, manufacturer-produced stock, in the language and edition the listing
            states. If we ever get that wrong, you are refunded in full with no time limit.
          </p>
          <span class="value-card__more">Read the guarantee →</span>
        </a>
        <a class="value-card value-card--link" href="<%= marketPath('/factory-sealed-guarantee') %>">
          <span class="value-card__n" aria-hidden="true">ii.</span>
          <h3 class="value-card__title">Sealed means sealed</h3>
          <p class="value-card__desc">
            Never opened, weighed, searched or resealed. If a seal arrives damaged we
            replace or refund it and pay the postage.
          </p>
          <span class="value-card__more">Read the guarantee →</span>
        </a>
        <a class="value-card value-card--link" href="<%= marketPath('/preorder-policy') %>">
          <span class="value-card__n" aria-hidden="true">iii.</span>
          <h3 class="value-card__title">Preorders without surprises</h3>
          <p class="value-card__desc">
            You are charged at checkout, not on release day, and we say so in the first
            line rather than burying it. Cancel any time before dispatch for a full refund.
          </p>
          <span class="value-card__more">Read the policy →</span>
        </a>
        <a class="value-card value-card--link" href="<%= marketPath('/shipping') %>">
          <span class="value-card__n" aria-hidden="true">iv.</span>
          <h3 class="value-card__title"><%= shippingCopy.short %></h3>
          <p class="value-card__desc">
            Tracked, worldwide, at our cost, with no minimum spend. Every order covered
            against loss or damage in transit.
          </p>
          <span class="value-card__more">See delivery times →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- What we will not do -->
  <%/* The section that makes the rest credible. A page that only lists
       what a company is good at reads as marketing; naming the things we
       decline to do, including the ones that cost us sales, is the part a
       reader weighs. Every line here is a real operating constraint. */%>
  <section class="about-sec">
    <div class="container">
      <div class="about-nots">
        <div class="about-nots__head">
          <div class="label-overline" style="margin-bottom:0.75rem">§ 03 — Where we are not competing</div>
          <h2 class="heading-section">Things we will not do</h2>
          <p class="about-nots__aside" aria-hidden="true">Buy what you want to own.</p>
        </div>
        <ol class="about-nots__list">
          <li>
            <strong>We will not tell you what is inside a sealed product.</strong>
            Pull rates are set by the manufacturer and are a matter of chance. Nobody
            can promise you a hit, and anyone who does is telling you something they
            cannot know.
          </li>
          <li>
            <strong>We will not present this as an investment.</strong>
            Prices in this category move sharply in both directions and past movement
            predicts nothing. Buy what you want to own.
          </li>
          <li>
            <strong>We will not undervalue a customs declaration.</strong>
            We are asked regularly. It is fraud, and the consequence lands on the buyer
            rather than on us, which is the other reason we say no.
          </li>
          <li>
            <strong>We will not invent numbers.</strong>
            No review scores without a review system behind them, no customer counts we
            cannot evidence, no countdown timers on products that are not scarce. If a
            figure appears on this site, we can show you what it is based on.
          </li>
          <li>
            <strong>We will not always be the cheapest.</strong>
            Buying exclusively through distribution costs more than buying wherever
            stock appears, and on a hot set a marketplace listing will sometimes beat us.
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- Team, only if real -->
  <% if ((company.team || []).length) { %>
  <section class="about-sec about-sec--band">
    <div class="container">
      <div class="reg-head">
        <span class="reg-head__num">The People</span>
        <h2 class="reg-head__title heading-section">Who you are dealing with</h2>
        <span></span>
      </div>
      <div class="team-grid">
        <%/* Three named staff with biographies used to be hardcoded here.
             Real people only: add them to config/company.js team[]. With
             none configured the whole section is omitted rather than
             filled with invented colleagues. */%>
        <% (company.team || []).forEach(function (m) { %>
          <div class="team-card">
            <div class="team-card__avatar"><%- include('../partials/icon', { name: m.icon || 'zap', size: 22, color: 'currentColor' }) %></div>
            <h3 class="team-card__name"><%= m.name %></h3>
            <p class="team-card__role"><%= m.role %></p>
            <% if (m.bio) { %><p class="team-card__bio"><%= m.bio %></p><% } %>
          </div>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>

  <% if ((company.timeline || []).length) { %>
  <section class="about-sec">
    <div class="container">
      <div class="reg-head">
        <span class="reg-head__num">Our Journey</span>
        <h2 class="reg-head__title heading-section">The Zyphera Timeline</h2>
        <span></span>
      </div>
      <div class="about-timeline">
        <% (company.timeline || []).forEach(function(m) { %>
          <div class="about-milestone">
            <div class="about-milestone__year"><%= m.year %></div>
            <div class="about-milestone__text"><%= m.description || m.text %></div>
          </div>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Reaching us -->
  <section class="about-sec about-sec--band">
    <div class="container">
      <div class="about-contact">
        <div>
          <div class="label-overline" style="margin-bottom:0.75rem">§ 04 — Correspondence</div>
          <h2 class="heading-section about-contact__title">How to reach us</h2>
          <p>
            Every message is read and answered by a person, within
            <%= company.business.responseTimeHours %> hours,
            <%= company.business.supportHours ? company.business.supportHours.charAt(0).toLowerCase() + company.business.supportHours.slice(1) : 'on business days' %>.
            There is no automated first line to argue past.
          </p>
          <p>
            Email <a href="mailto:<%= company.business.supportEmail %>"><%= company.business.supportEmail %></a>
            or use the contact form. Full business details, including where we trade from,
            are on the contact page.
          </p>
          <div class="about-story__ctas">
            <a href="<%= marketPath('/contact') %>" class="btn btn-primary">Contact Us</a>
            <a href="<%= marketPath('/customer-support') %>" class="btn btn-outline">How support works</a>
          </div>
        </div>
        <div class="about-contact__links">
          <p class="about-contact__links-title">Everything we commit to, in full</p>
          <ul>
            <li><a href="<%= marketPath('/authenticity-guarantee') %>">Authenticity Guarantee</a></li>
            <li><a href="<%= marketPath('/factory-sealed-guarantee') %>">Factory-Sealed Guarantee</a></li>
            <li><a href="<%= marketPath('/preorder-policy') %>">Preorder Policy</a></li>
            <li><a href="<%= marketPath('/allocation-policy') %>">Allocation Policy</a></li>
            <li><a href="<%= marketPath('/shipping') %>">Shipping &amp; Delivery</a></li>
            <li><a href="<%= marketPath('/refund-policy') %>">Refund &amp; Returns</a></li>
            <li><a href="<%= marketPath('/payment-information') %>">Payment Information</a></li>
            <li><a href="<%= marketPath('/faq') %>">FAQ</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .about-page { padding-bottom: 0; }

  /* Title page */
  .about-hero { padding: 2.5rem 0 3.5rem; border-bottom: 1.5px solid var(--color-ink); }
  .about-hero__eyebrow { display: flex; align-items: center; gap: 0.9rem; margin-bottom: 2rem; }
  .about-hero__eyebrow-rule { flex: 1; height: 1px; background: var(--color-border-light); }
  .about-hero__title { max-width: 15ch; }
  .about-hero__sub { font-family: var(--font-display); font-size: 1.32rem; font-weight: 300; line-height: 1.55; color: var(--color-ink); max-width: 46ch; margin-top: 2.25rem; padding-top: 1.25rem; border-top: 1px solid var(--color-border-light); font-variation-settings: 'opsz' 36; }
  .about-hero__sub::first-letter { font-size: 3.3em; float: left; line-height: 0.85; padding: 0.06em 0.1em 0 0; color: var(--color-primary); font-weight: 400; }

  /* Sections */
  .about-sec { padding: 4.5rem 0; }
  .about-sec--band { background: var(--color-bg-elevated); border-top: 1.5px solid var(--color-ink); border-bottom: 1px solid var(--color-border-light); }
  .about-sec + .about-sec--band, .about-sec--band + .about-sec { margin-top: 0; }

  .about-story { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 4rem; align-items: start; padding-top: 2.25rem; }
  .about-story__text p { color: var(--color-text); line-height: 1.85; font-size: 0.98rem; max-width: 65ch; margin-bottom: 1.1rem; }
  .about-story__ctas { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 2rem; }
  .about-story__aside { display: flex; flex-direction: column; gap: 2rem; }
  .about-pull { margin: 0; padding: 1.4rem 0 1.5rem; border-top: 1.5px solid var(--color-ink); border-bottom: 1px solid var(--color-border-light); font-family: var(--font-display); font-style: italic; font-weight: 300; font-size: clamp(1.5rem, 2.6vw, 2rem); line-height: 1.25; color: var(--color-ink); letter-spacing: -0.01em; font-variation-settings: 'opsz' 96; }
  .about-pull::before { content: '\201C'; display: block; font-size: 2.6em; line-height: 0.6; height: 0.4em; color: var(--color-primary); font-style: normal; }

  /* Ruled facts: a ledger, not tiles */
  .about-facts { margin: 0; border-top: 1px solid var(--color-ink); }
  .about-stat { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 0.7rem 0; border-bottom: 1px solid var(--color-border-light); }
  .about-stat__label { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted); }
  .about-stat__num { margin: 0; font-family: var(--font-mono); font-size: 1.15rem; font-weight: 500; font-variant-numeric: tabular-nums; color: var(--color-ink); }

  /* Commitments: four ruled columns that share their borders */
  .value-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 0; }
  .value-card { display: flex; flex-direction: column; gap: 0.7rem; padding: 1.75rem 1.5rem 1.6rem; color: inherit; text-decoration: none; border-bottom: 1px solid var(--color-border-light); transition: background var(--transition-fast); }
  .value-card + .value-card { border-left: 1px solid var(--color-border-light); }
  .value-card:first-child { padding-left: 0; }
  .value-card:hover { background: var(--color-bg-card); }
  .value-card__n { font-family: var(--font-display); font-style: italic; font-size: 1.5rem; line-height: 1; color: var(--color-primary); }
  .value-card__title { font-family: var(--font-display); font-size: 1.3rem; font-weight: 400; line-height: 1.2; color: var(--color-ink); }
  .value-card__desc { font-size: 0.87rem; color: var(--color-text-muted); line-height: 1.7; }
  .value-card__more { margin-top: auto; padding-top: 0.5rem; font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink); text-decoration: underline; text-underline-offset: 4px; }
  .value-card:hover .value-card__more { color: var(--color-primary); }

  /* What we will not do: numbered clauses */
  .about-nots { display: grid; grid-template-columns: minmax(0, 20rem) minmax(0, 1fr); gap: 4rem; align-items: start; }
  .about-nots__head { position: sticky; top: calc(var(--header-h) + 2rem); padding-bottom: 1.25rem; border-bottom: 1.5px solid var(--color-ink); }
  .about-nots__aside { margin-top: 1.5rem; font-family: var(--font-display); font-style: italic; font-weight: 300; font-size: 1.25rem; color: var(--color-text-muted); }
  .about-nots__list { list-style: none; margin: 0; padding: 0; counter-reset: nots; border-top: 1.5px solid var(--color-ink); }
  .about-nots__list li { counter-increment: nots; position: relative; padding: 1.35rem 0 1.35rem 3.25rem; border-bottom: 1px solid var(--color-border-light); font-size: 0.93rem; line-height: 1.8; color: var(--color-text-muted); max-width: 72ch; }
  .about-nots__list li::before { content: counter(nots, decimal-leading-zero); position: absolute; left: 0; top: 1.55rem; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; color: var(--color-text-faint); }
  .about-nots__list strong { display: block; margin-bottom: 0.25rem; font-family: var(--font-display); font-size: 1.22rem; font-weight: 400; line-height: 1.3; color: var(--color-ink); }

  /* Team and timeline (only when configured) */
  .team-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .team-card { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.75rem 1.5rem; border-bottom: 1px solid var(--color-border-light); }
  .team-card + .team-card { border-left: 1px solid var(--color-border-light); }
  .team-card:first-child { padding-left: 0; }
  .team-card__avatar { width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--color-ink); display: flex; align-items: center; justify-content: center; color: var(--color-ink); margin-bottom: 0.4rem; }
  .team-card__name { font-family: var(--font-display); font-size: 1.25rem; font-weight: 400; color: var(--color-ink); }
  .team-card__role { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted); }
  .team-card__bio { font-size: 0.86rem; color: var(--color-text-muted); line-height: 1.7; }
  .about-timeline { max-width: 52rem; }
  .about-milestone { display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: 1.5rem; padding: 1rem 0; border-bottom: 1px solid var(--color-border-light); }
  .about-milestone__year { font-family: var(--font-mono); font-size: 0.85rem; font-weight: 500; color: var(--color-ink); }
  .about-milestone__text { font-size: 0.92rem; color: var(--color-text-muted); line-height: 1.65; }

  /* Reaching us */
  .about-contact { display: grid; grid-template-columns: minmax(0, 1fr) 20rem; gap: 4rem; align-items: start; }
  .about-contact__title { padding-bottom: 1rem; margin-bottom: 1.25rem; border-bottom: 1.5px solid var(--color-ink); }
  .about-contact p { color: var(--color-text); line-height: 1.85; font-size: 0.96rem; max-width: 62ch; margin-bottom: 0.9rem; }
  .about-contact p a { color: var(--color-primary); text-decoration: underline; text-underline-offset: 3px; }
  .about-contact__links { border-top: 1.5px solid var(--color-ink); padding-top: 0.9rem; }
  .about-contact__links-title { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: 0.5rem; }
  .about-contact__links ul { list-style: none; margin: 0; padding: 0; counter-reset: idx; }
  .about-contact__links li { counter-increment: idx; border-bottom: 1px solid var(--color-border-light); }
  .about-contact__links a { display: flex; gap: 0.85rem; align-items: baseline; padding: 0.55rem 0; font-size: 0.9rem; color: var(--color-ink); text-decoration: none; }
  .about-contact__links a::before { content: counter(idx, decimal-leading-zero); font-family: var(--font-mono); font-size: 0.66rem; color: var(--color-text-faint); }
  .about-contact__links a:hover { color: var(--color-primary); }

  @media (max-width: 1024px) {
    .about-story { grid-template-columns: 1fr; gap: 2.5rem; }
    .value-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .value-card:nth-child(3) { border-left: 0; padding-left: 0; }
    .about-nots, .about-contact { grid-template-columns: 1fr; gap: 2rem; }
    .about-nots__head { position: static; }
  }
  @media (max-width: 640px) {
    .about-hero { padding: 1.5rem 0 2.25rem; }
    .about-hero__eyebrow { margin-bottom: 1.25rem; }
    .about-hero__eyebrow .zy-meta { display: none; }
    .about-hero__sub { font-size: 1.1rem; margin-top: 1.5rem; }
    .about-sec { padding: 3rem 0; }
    .value-grid, .team-grid { grid-template-columns: 1fr; }
    .value-card, .team-card { padding: 1.35rem 0; }
    .value-card + .value-card, .team-card + .team-card { border-left: 0; }
    .about-nots__list li { padding-left: 2.4rem; }
    .about-nots__list strong { font-size: 1.1rem; }
  }
</style>
