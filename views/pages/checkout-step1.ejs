<meta name="referrer" content="no-referrer">
<style>
  /* Checkout, information step: the order slip at the back of the
     register. Paper and ink, ruled rows, square corners, an ink action.
     Tokens come from zyphera.css via the layout. */
  .form-input {
    width: 100%;
    padding: 14px 16px;
    background: var(--color-bg-input);
    border: 1px solid var(--color-border-light);
    border-bottom-color: #B9B0A0;
    border-radius: 0;
    color: var(--color-ink);
    font-size: 1rem;
    font-family: var(--font-body);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    box-sizing: border-box;
  }
  .form-input:hover { border-color: #B9B0A0; }
  .form-input:focus {
    outline: none;
    border-color: var(--color-ink);
    box-shadow: 0 0 0 3px var(--color-primary-glow);
  }
  .form-input::placeholder { color: #8C8576; opacity: 1; }
  select.form-input {
    appearance: none; -webkit-appearance: none; padding-right: 2.25rem;
    background-image: linear-gradient(45deg, transparent 50%, var(--color-ink) 50%), linear-gradient(135deg, var(--color-ink) 50%, transparent 50%);
    background-position: calc(100% - 18px) 50%, calc(100% - 13px) 50%;
    background-size: 5px 5px; background-repeat: no-repeat;
  }
  .checkout-container {
    max-width: 1080px;
    margin: 40px auto 56px;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 0;
    min-height: calc(100vh - 280px);
    align-items: start;
  }
  .checkout-left {
    padding: 36px 40px 40px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-light);
    border-top: 1.5px solid var(--color-ink);
  }
  .checkout-right {
    background: var(--color-bg-elevated);
    padding: 36px 30px 32px;
    border: 1px solid var(--color-border-light);
    border-left: 0;
    border-top: 1.5px solid var(--color-ink);
    height: fit-content;
    position: sticky;
    top: calc(var(--header-h, 120px) + 16px);
    align-self: start;
  }
  .checkout-title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.4vw, 2.4rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--color-ink);
    margin: 0 0 0.4rem;
    font-variation-settings: 'opsz' 120;
  }
  .checkout-title-sub { margin: 0 0 1.75rem; font-size: 0.9rem; color: var(--color-text-muted); }
  /* Section heading in register form: a mono label on an ink rule. */
  .checkout-header {
    display: flex; align-items: baseline; gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink);
    margin: 0 0 18px;
    padding-bottom: 8px;
    border-bottom: 1.5px solid var(--color-ink);
    line-height: 1.4;
  }
  .checkout-header__num { color: var(--color-text-faint); }
  .checkout-header--spaced { margin-top: 36px; }
  .form-group {
    margin-bottom: 14px;
    gap: 0;
  }
  .form-row {
    display: flex;
    gap: 14px;
  }
  .form-row .form-group {
    flex: 1;
    margin-bottom: 14px;
  }

  /* ── The ledger ── */
  .order-items { border-top: 0; }
  .order-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-border-light);
  }
  .order-item-img-wrapper {
    position: relative;
    width: 72px;
    height: 72px;
    flex: none;
    border-radius: 0;
    background: var(--color-plate);
    border: 1px solid var(--color-border-light);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .order-item-img {
    max-width: 86%;
    max-height: 86%;
    object-fit: contain;
    border-radius: 0;
  }
  /* Quantity: a square ink stamp on the plate's corner. */
  .order-item-badge {
    position: absolute;
    top: -8px;
    right: -8px;
    background: var(--color-ink);
    color: var(--color-on-ink);
    border-radius: 0;
    min-width: 22px;
    height: 22px;
    padding: 0 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    z-index: 2;
  }
  .order-item-title {
    font-size: 1.02rem;
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1.3;
    font-variation-settings: 'opsz' 36;
  }
  .order-item-price {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--color-ink);
    text-align: right;
    font-size: 0.95rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .order-summary { margin-top: 6px; }
  .order-summary-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 9px 0;
    border-bottom: 1px solid var(--color-border-light);
    color: var(--color-text-muted);
    font-size: 0.88rem;
    font-weight: 400;
  }
  .order-summary-row:last-child { border-bottom: 0; }
  .order-summary-row span:last-child {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .order-summary-row .is-free { color: var(--color-accent); letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.75rem; }
  .order-summary-row .is-quiet { color: var(--color-text-muted); letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.75rem; }
  .order-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 0;
    padding-top: 16px;
    border-top: 1.5px solid var(--color-ink);
    color: var(--color-ink);
  }
  .order-total span:first-child {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .order-total__amount {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .order-total__cur {
    font-size: 0.7rem; letter-spacing: 0.1em; color: var(--color-text-faint);
    font-weight: 500; margin-right: 8px; vertical-align: 0.35em;
  }

  /* ── Promises: ruled cells sharing one border ── */
  .trust-features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 28px 0 14px;
    border-top: 1.5px solid var(--color-ink);
    border-bottom: 1px solid var(--color-border-light);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    line-height: 1.5;
  }
  .trust-features span {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    padding: 10px 12px;
  }
  .trust-features span:first-child { padding-left: 0; }
  .trust-features span + span { border-left: 1px solid var(--color-border-light); }
  .trust-features svg {
    width: 13px;
    height: 13px;
    flex: none;
    margin-top: 1px;
    color: var(--color-accent);
  }
  .checkout-charge-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0.5rem 0 0.9rem;
    line-height: 1.6;
  }
  .checkout-charge-note strong { font-family: var(--font-mono); font-weight: 500; color: var(--color-ink); }
  .checkout-charge-note a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .checkout-charge-note a:hover { color: var(--color-primary); }

  /* The pay button: an ink rectangle, the amount in mono. */
  .btn-pay {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    padding: 20px;
    font-size: 0.85rem;
  }
  .btn-pay__amount { font-family: var(--font-mono); font-weight: 500; letter-spacing: 0.02em; text-transform: none; font-size: 1rem; }

  /* Footer override for checkout page to keep focus on form */
  footer {
    padding: 24px 0 !important;
  }
  .footer-inner {
    margin-top: 0 !important;
  }

  @media(max-width: 900px) {
    .checkout-container {
      grid-template-columns: 1fr;
      gap: 20px;
      margin: 20px auto 40px;
      padding: 0 16px;
    }
    .checkout-left {
      order: 2;
      padding: 26px 20px 30px;
    }
    .checkout-right {
      order: 1;
      padding: 22px 20px 24px;
      position: relative;
      top: auto;
      border-left: 1px solid var(--color-border-light);
    }
    .form-row {
      flex-direction: column;
      gap: 0;
    }
    .trust-features {
      grid-template-columns: 1fr;
    }
    .trust-features span { padding: 9px 0; }
    .trust-features span + span { border-left: 0; border-top: 1px solid var(--color-border-light); }
  }
</style>

<div class="checkout-container">
  <div class="checkout-left">
    <h1 class="checkout-title">Checkout</h1>
    <p class="checkout-title-sub">Your details, then payment on the next step.</p>
    <h2 class="checkout-header"><span class="checkout-header__num">01</span> Contact</h2>
    
    <%/* Every field gained a real <label for> and an autocomplete token.
         Nine inputs carried a placeholder and nothing else, which fails
         WCAG 3.3.2 two ways: a placeholder is not an accessible name, so a
         screen reader announced nine unlabelled text boxes, and it
         vanishes the moment you type, so anyone checking their own work
         has no idea which box is which. The autocomplete tokens are the
         standard ones, which is what lets a browser or phone fill an
         address in one tap — on a checkout, that is conversion as much as
         accessibility.

         Labels are visually hidden rather than shown, so the design is
         unchanged: the placeholders stay exactly as they were. No id,
         name, value or event handler is touched, so the JavaScript that
         reads these fields behaves identically. */%>
    <form id="checkoutForm" onsubmit="event.preventDefault();">
      <%/* Admin-only. `testMode` is null for every customer, so this block
           does not exist on a real checkout — not hidden by CSS, not
           rendered and collapsed, absent from the HTML entirely. */%>
      <% if (typeof testMode !== 'undefined' && testMode) { %>
        <div class="checkout-testmode">
          <strong>Test purchase available.</strong>
          Put <code><%= testMode.tag %></code> before the @ in your own address
          (e.g. <code>you<%= testMode.tag %>@gmail.com</code>) and this checkout skips
          payment and goes straight to the real confirmation — same email, same
          account, same receipt. Use <code><%= testMode.email %></code> if you don't
          want the mail. Only you see this, and only while signed into admin.
        </div>
      <% } %>
      <div class="form-group">
        <label class="sr-only" for="email">Email address</label>
        <input type="email" id="email" class="form-input" required placeholder="Email" autocomplete="email" inputmode="email">
      </div>

      <h2 class="checkout-header checkout-header--spaced"><span class="checkout-header__num">02</span> Shipping address</h2>

      <div class="form-group">
        <label class="sr-only" for="country">Country or region</label>
        <select id="country" class="form-input" required style="cursor:pointer;" autocomplete="country">
          <option value="US">United States</option>
          <option value="CA">Canada</option>
          <option value="GB">United Kingdom</option>
          <option value="AU">Australia</option>
        </select>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="sr-only" for="firstName">First name</label>
          <input type="text" id="firstName" class="form-input" required placeholder="First name" autocomplete="given-name">
        </div>
        <div class="form-group">
          <label class="sr-only" for="lastName">Last name</label>
          <input type="text" id="lastName" class="form-input" required placeholder="Last name" autocomplete="family-name">
        </div>
      </div>

      <div class="form-group">
        <label class="sr-only" for="address">Street address</label>
        <input type="text" id="address" class="form-input" required placeholder="Address" autocomplete="address-line1">
      </div>

      <div class="form-group">
        <label class="sr-only" for="apartment">Apartment, suite or unit (optional)</label>
        <input type="text" id="apartment" class="form-input" placeholder="Apartment, suite, etc. (optional)" autocomplete="address-line2">
      </div>

      <div class="form-row">
        <div class="form-group" style="flex: 1.5;">
          <label class="sr-only" for="city">City</label>
          <input type="text" id="city" class="form-input" required placeholder="City" autocomplete="address-level2">
        </div>
        <div class="form-group" style="flex: 1;">
          <label class="sr-only" for="state">State or province</label>
          <input type="text" id="state" class="form-input" required placeholder="State" autocomplete="address-level1">
        </div>
        <div class="form-group" style="flex: 1;">
          <label class="sr-only" for="zip">ZIP or postal code</label>
          <input type="text" id="zip" class="form-input" required placeholder="ZIP code" autocomplete="postal-code">
        </div>
      </div>

      <div class="form-group">
        <label class="sr-only" for="phone">Phone number</label>
        <input type="tel" id="phone" class="form-input" required placeholder="Phone" autocomplete="tel" inputmode="tel">
      </div>

      <%
        /* These three chips were hardcoded "Free Shipping", "Taxes
           Included" and "Factory Sealed Guarantee", and two of them were
           not true.
 
           "Free Shipping" was true only above a threshold at the time; the
           store now ships everything free, so the claim is finally
           accurate and comes from config rather than being retyped here.
           "Taxes Included" was contradicted outright by the
           store's own shipping policy, which states that import duty, VAT
           and customs handling are set by the destination country, are
           charged to the buyer, and are not included in our price.
 
           A price claim that the customer's own invoice later disproves is
           a Merchant Center pricing violation, and stating it on the
           payment step is the worst possible place for it: it is the last
           thing read before paying and the first thing quoted in a
           chargeback. */
        var trustChips = [
          shippingCfg.copy.medium,
          'Duties and import taxes not included',
          'Factory sealed, sourced through authorized distribution',
        ];
      %>
      <div class="trust-features">
        <% trustChips.forEach(function (chip) { %>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> <%= chip %></span>
        <% }); %>
      </div>
      <%/* The order total, stated in the currency it is charged in, right
           above the pay button. The button said "Pay $X" with no currency
           named at all, on a store that ships worldwide — a Canadian or
           Australian shopper had no way to tell which dollar. */%>
      <p class="checkout-charge-note">
        Total charged: <strong>$<%= (cartTotal / 100).toFixed(2) %> <%= company.business.currency %></strong>.
        Shipping is free and already included, so this is the full amount.
        <a href="<%= marketPath('/shipping') %>">Shipping rates</a> ·
        <a href="<%= marketPath('/refund-policy') %>"><%= returnWindowDays %>-day returns</a>
      </p>

      <button type="submit" class="btn btn-primary btn-full btn-lg btn-pay" id="submitBtn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        Pay <span class="btn-pay__amount">$<%= (cartTotal / 100).toFixed(2) %></span>
      </button>
    </form>
  </div>

  <div class="checkout-right">
    <h2 class="checkout-header">Your order</h2>
    <div class="order-items">
      <% cartItems.forEach(item => { 
          let imgUrl = item.product.imageUrl || (item.product.images && item.product.images.length > 0 ? item.product.images[0] : '/images/placeholder.jpg');
          
          if (imgUrl.includes('cdn/shop')) {
            if (imgUrl.includes('width=')) {
              imgUrl = imgUrl.replace(/width=\d+/, 'width=80');
            } else {
              imgUrl += imgUrl.includes('?') ? '&width=80' : '?width=80';
            }
          }
      %>
        <div class="order-item">
          <div class="order-item-img-wrapper">
            <span class="order-item-badge"><%= item.quantity %></span>
            <img <%- productImage.attrs(imgUrl, 64) %> alt="<%= item.title || 'Product' %>" width="64" height="64" loading="lazy" decoding="async" onerror="this.onerror=null;this.srcset='';this.src='/images/placeholder.jpg';" class="order-item-img">
          </div>
          <div style="flex: 1;">
            <div class="order-item-title"><%= item.product.title %></div>
          </div>
          <div class="order-item-price">$<%= ((item.product.price * item.quantity) / 100).toFixed(2) %></div>
        </div>
      <% }) %>
    </div>

    <div class="order-summary">
      <div class="order-summary-row">
        <span>Subtotal</span>
        <span>$<%= (cartTotal / 100).toFixed(2) %></span>
      </div>
      <div class="order-summary-row">
        <span>Shipping</span>
        <span class="is-free">Free</span>
      </div>
      <div class="order-summary-row">
        <span>Taxes</span>
        <span class="is-quiet">Included in price</span>
      </div>
    </div>

    <div class="order-total">
      <span>Total</span>
      <span class="order-total__amount">
        <span class="order-total__cur">USD</span>$<%= (cartTotal / 100).toFixed(2) %>
      </span>
    </div>
  </div>
</div>

<style>
/* Admin-only test-purchase note. Deliberately looks like a developer
   affordance rather than part of the checkout, so a screenshot of this
   page can never be mistaken for something a customer was shown. */
.checkout-testmode {
  margin: 0 0 18px; padding: 12px 14px; border-radius: 0; line-height: 1.6;
  font-size: 0.8rem; color: var(--color-text-muted);
  background: var(--color-bg-card); border: 1px dashed var(--color-gold);
}
.checkout-testmode strong { color: var(--color-gold); font-weight: 600; }
.checkout-testmode code {
  font-family: var(--font-mono); font-size: 0.76rem; color: var(--color-ink);
  background: var(--color-bg-elevated); padding: 1px 5px; border-radius: 0;
}
</style>
<div id="cartItemsData" style="display:none;" data-items="<%= encodeURIComponent(JSON.stringify(cartItems)) %>" data-total="<%= cartTotal %>"></div>
<script>
  (function() {
    var form = document.getElementById('checkoutForm');
    if (!form) return;

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      e.stopPropagation();

      var btn = document.getElementById('submitBtn');
      btn.textContent = 'Processing...';
      btn.disabled = true;

      var itemsDataEl = document.getElementById('cartItemsData');
      var itemsStr = decodeURIComponent(itemsDataEl.getAttribute('data-items') || '');
      var totalVal = parseFloat(itemsDataEl.getAttribute('data-total')) || 0;
      var parsedItems;
      try { parsedItems = JSON.parse(itemsStr); } catch(ex) { parsedItems = []; }

      var cartData = { total: totalVal, items: parsedItems };

      var email = document.getElementById('email').value.trim();
      var firstName = document.getElementById('firstName').value.trim();
      var lastName = document.getElementById('lastName').value.trim();
      var addressLine1 = document.getElementById('address').value.trim();
      var apartment = document.getElementById('apartment').value.trim();
      var city = document.getElementById('city').value.trim();
      var state = document.getElementById('state').value.trim();
      var zip = document.getElementById('zip').value.trim();
      var country = document.getElementById('country').value.trim();
      var phone = document.getElementById('phone').value.trim();
      
      var fullAddress = addressLine1;
      if (apartment) fullAddress += ' ' + apartment;
      fullAddress += ', ' + city + ', ' + state + ' ' + zip + ', ' + country;
      
      var addressDetails = { 
        addressLine1: addressLine1, 
        apartment: apartment,
        city: city, 
        state: state, 
        zip: zip, 
        country: country,
        phone: phone
      };

      fetch('/checkout/capture-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
          email: email, 
          firstName: firstName, 
          lastName: lastName, 
          address: fullAddress, 
          addressDetails: addressDetails, 
          cartData: cartData 
        })
      })
      .then(function(res) { return res.text(); })
      .then(function(text) {
        var data;
        try { data = JSON.parse(text); } catch(ex) {
          alert('Server error: ' + text.substring(0, 200));
          btn.textContent = 'Continue to Payment';
          btn.disabled = false;
          return;
        }
        if (data.success && data.redirect) {
          window.location.href = data.redirect;
        } else if (data.success) {
          alert('Error: No redirect URL from server.');
          btn.textContent = 'Continue to Payment';
          btn.disabled = false;
        } else {
          alert('Error: ' + (data.error || 'Unknown error.'));
          btn.textContent = 'Continue to Payment';
          btn.disabled = false;
        }
      })
      .catch(function(err) {
        alert('Network error: ' + err.message);
        btn.textContent = 'Continue to Payment';
        btn.disabled = false;
      });
    });
  })();
</script>
