<%
  /* header/footer includes removed: this view also renders through
     views/layout.ejs, which already includes both, so every page here
     shipped two <header> and two <footer> landmarks, one pair nested
     inside <main>. The Whop embed below and its loader script are
     deliberately untouched. */
%>
<style>
  /* The partner's embed sits on a white plate under an ink rule, the
     same way a product photo sits in the register. */
  .checkout-container {
    max-width: 800px;
    margin: 48px auto 60px;
    padding: 0 20px;
    min-height: 60vh;
    font-family: var(--font-body);
  }
  .whop-checkout-wrapper {
    background: var(--color-plate);
    border: 1px solid var(--color-border-light);
    border-top: 1.5px solid var(--color-ink);
    border-radius: 0;
    overflow: hidden;
    min-height: 500px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
</style>

<div class="checkout-container">
  <div class="whop-checkout-wrapper">
    <div data-whop-checkout-plan-id="<%= whopPlanId %>"></div>
  </div>
</div>

<script async defer src="https://js.whop.com/static/checkout/loader.js"></script>

