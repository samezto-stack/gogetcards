<!-- Collection Header -->
<div class="col-page__header">
    <div class="container" style="position:relative;z-index:2">
    <nav class="col-page__breadcrumb" aria-label="Breadcrumb">
      <a href="<%= marketPath('/') %>">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page"><%= collectionTitle %></span>
    </nav>
    <div style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:1rem">
      <div>
        <% if (collectionHandle === 'preorders') { %>
          <div class="label-overline" style="margin-bottom:0.5rem">🔔 Lock In Now</div>
        <% } %>
        <h1 class="heading-section"><%= collectionTitle %></h1>
        <% if (typeof collectionDescription !== 'undefined' && collectionDescription) { %>
          <p style="color:var(--color-text-muted);margin-top:0.625rem;max-width:540px;font-size:0.9rem;line-height:1.7">
            <%= collectionDescription %>
          </p>
        <% } %>
      </div>
      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:2px">
        <span style="font-family:var(--font-heading);font-size:2rem;font-weight:900;color:var(--color-heading);line-height:1"><%= typeof totalProducts !== 'undefined' ? totalProducts : products.length %></span>
        <span style="font-size:0.72rem;color:var(--color-text-faint);text-transform:uppercase;letter-spacing:0.06em;font-weight:600">products</span>
      </div>
    </div>
  </div>
</div>

<div class="container">
  <div class="col-page__layout">

    <!-- Sidebar -->
    <aside class="col-page__sidebar" aria-label="Filters">
      <div class="col-page__filter-group">
        <h2 class="col-page__filter-title">Sort</h2>
        <form method="get">
          <select
            class="form-select"
            id="sort-select"
            name="sort"
            onchange="this.form.submit()"
            aria-label="Sort products"
          >
            <option value="featured" <%= typeof sort !== 'undefined' && sort === 'featured' ? 'selected' : '' %>>Featured</option>
            <option value="price-asc" <%= typeof sort !== 'undefined' && sort === 'price-asc' ? 'selected' : '' %>>Price: Low → High</option>
            <option value="price-desc" <%= typeof sort !== 'undefined' && sort === 'price-desc' ? 'selected' : '' %>>Price: High → Low</option>
            <option value="title-asc" <%= typeof sort !== 'undefined' && sort === 'title-asc' ? 'selected' : '' %>>Name: A → Z</option>
            <option value="newest" <%= typeof sort !== 'undefined' && sort === 'newest' ? 'selected' : '' %>>Newest First</option>
          </select>
        </form>
      </div>

      <%
        /* Filters. Facets and the URL builders come from the route, so a
           page rendered without them (a harness, an older caller) simply
           shows the sort. Every option is a real link: it works without
           JavaScript and a crawler can follow it, and the canonical in
           server.js keeps filtered views from competing with the page. */
        var fc = (typeof facets !== 'undefined' && facets) ? facets : null;
        var fl = (typeof filters !== 'undefined' && filters) ? filters : { avail: [], line: [], type: [], lang: [], price: [] };
        var fcount = (typeof activeFilterCount !== 'undefined') ? activeFilterCount : 0;
        var groups = fc ? [
          ['avail', 'Availability', fc.avail],
          ['line', 'Game or sport', fc.line],
          ['type', 'Product type', fc.type],
          ['lang', 'Language', fc.lang],
          ['price', 'Price', fc.price],
        ].filter(function (g) { return g[2] && g[2].length; }) : [];
      %>
      <% if (groups.length) { %>
        <details class="col-filters" id="col-filters" open>
          <summary class="col-filters__summary">
            <span>Filters<% if (fcount) { %> <span class="col-filters__count"><%= fcount %></span><% } %></span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="col-filters__body">
            <% if (fcount) { %>
              <a href="<%= marketPath(filterHref({ avail: [], line: [], type: [], lang: [], price: [] })) %>" class="col-filters__clear">Clear all filters</a>
            <% } %>
            <% groups.forEach(function (g) { var key = g[0]; %>
              <div class="col-page__filter-group">
                <h2 class="col-page__filter-title"><%= g[1] %></h2>
                <ul class="col-filters__list">
                  <% g[2].forEach(function (opt) { var on = fl[key].indexOf(opt.id) !== -1; %>
                    <li>
                      <a href="<%= marketPath(toggleHref(key, opt.id)) %>" class="col-filters__opt<%= on ? ' is-on' : '' %>" rel="nofollow"<%= on ? ' aria-current="true"' : '' %>>
                        <span class="col-filters__box" aria-hidden="true"></span>
                        <span class="col-filters__label"><%= opt.label %></span>
                        <span class="col-filters__n"><%= opt.n %></span>
                      </a>
                    </li>
                  <% }); %>
                </ul>
              </div>
            <% }); %>
          </div>
        </details>
        <script>
          /* Open on a desktop, folded on a phone, where the sidebar sits
             above the grid and would push every product off the first
             screen. Static behaviour, no data. */
          (function () { var d = document.getElementById('col-filters'); if (d && window.innerWidth <= 1024) d.removeAttribute('open'); })();
        </script>
      <% } else { %>
        <div class="col-page__filter-group">
          <h2 class="col-page__filter-title">Quick Links</h2>
          <a href="<%= marketPath('/collection/preorders') %>" class="col-filters__quick" id="filter-preorders-link">Preorders only</a>
          <a href="<%= marketPath('/collection/all') %>" class="col-filters__quick" id="filter-all-link">All products</a>
        </div>
      <% } %>
    </aside>

    <!-- Main grid -->
    <div class="col-page__main">

      <!-- Collection intro -->
      <%
        /* Unique, per-collection copy from config/collectionContent.js.
           Collections with no entry render nothing here rather than a
           generic paragraph repeated across every page. */
        var cc = (typeof content !== 'undefined') ? content : null;
        var isFirstPage = (typeof page === 'undefined') || page === 1;
      %>
      <% if (cc && cc.intro && isFirstPage) { %>
        <p class="col-page__intro"><%= cc.intro %></p>
      <% } %>

      <!-- Preorders notice -->
      <% if (collectionHandle === 'preorders') { %>
        <div class="col-page__notice" role="note">
          <span aria-hidden="true">🔔</span>
          <div>
            <strong style="color:var(--color-cyan)">Preorder Guarantee:</strong>
            Price is locked at today's rate. Ships release day. Cancel anytime before dispatch.
          </div>
        </div>
      <% } %>

      <!-- Sort bar -->
      <div class="col-page__sort-bar">
        <p class="col-page__results">
          <%
            /* The old line printed products.length, which was the whole
               catalogue. Now that the query is paginated it would read
               "24 products" on a 90-product collection, so it states the
               range being shown out of the real total. */
            var total = (typeof totalProducts !== 'undefined') ? totalProducts : products.length;
            var pg = (typeof page !== 'undefined') ? page : 1;
            var per = (typeof perPage !== 'undefined') ? perPage : products.length;
            var from = total === 0 ? 0 : (pg - 1) * per + 1;
            var to = Math.min(pg * per, total);
          %>
          <% if (total > per) { %>
            Showing <%= from %>&ndash;<%= to %> of <%= total %> products
          <% } else { %>
            <%= total %> product<%= total !== 1 ? 's' : '' %>
          <% } %>
        </p>
        <% if (fc && fcount) { %>
          <ul class="col-chips" aria-label="Active filters">
            <% ['avail', 'line', 'type', 'lang', 'price'].forEach(function (key) { fl[key].forEach(function (id) {
                 var opt = (fc[key] || []).find(function (o) { return o.id === id; }); %>
              <li><a href="<%= marketPath(toggleHref(key, id)) %>" class="col-chip" rel="nofollow"><%= opt ? opt.label : id %> <span aria-hidden="true">&times;</span><span class="sr-only">remove</span></a></li>
            <% }); }); %>
          </ul>
        <% } %>
      </div>

      <!-- Products -->
      <% if (products.length === 0) { %>
        <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:5rem 2rem;text-align:center;gap:1rem">
          <div style="font-size:3rem" aria-hidden="true">🔍</div>
          <h3 style="font-family:var(--font-heading);font-size:1.25rem;color:var(--color-heading)">No products found</h3>
          <a href="<%= marketPath('/collection/all') %>" class="btn btn-outline">Browse All →</a>
        </div>
      <% } else { %>
        <div class="grid-4">
          <% products.forEach(function(product) { %>
            <%- include('../partials/product-card', { product: product }) %>
          <% }); %>
        </div>

        <%
          /* Real anchor links, not a JS-driven control: a crawler has to
             be able to reach page 2 by following an href, and a visitor
             with JS off has to be able to as well. The sort parameter is
             carried through so paging does not silently reset the order. */
          var tp = (typeof totalPages !== 'undefined') ? totalPages : 1;
          var cp = (typeof page !== 'undefined') ? page : 1;
          function pageHref(n) {
            /* Through the route's builder when there is one, so the page
               link carries the filters and the sort together. */
            if (typeof filterHref === 'function') return filterHref({ page: n });
            var qs = [];
            if (typeof sort !== 'undefined' && sort && sort !== 'featured') qs.push('sort=' + encodeURIComponent(sort));
            if (n > 1) qs.push('page=' + n);
            return '/collection/' + collectionHandle + (qs.length ? '?' + qs.join('&') : '');
          }
          // Window of page numbers around the current page, so a 40-page
          // collection does not render 40 links.
          var windowStart = Math.max(1, Math.min(cp - 2, tp - 4));
          var windowEnd = Math.min(tp, Math.max(cp + 2, 5));
        %>
        <% if (tp > 1) { %>
          <nav class="col-pagination" aria-label="Collection pages">
            <% if (cp > 1) { %>
              <a class="col-pagination__step" href="<%= marketPath((pageHref(cp - 1))) %>" rel="prev">Previous</a>
            <% } else { %>
              <span class="col-pagination__step is-disabled" aria-hidden="true">Previous</span>
            <% } %>

            <ol class="col-pagination__list">
              <% for (var n = windowStart; n <= windowEnd; n++) { %>
                <li>
                  <% if (n === cp) { %>
                    <span class="col-pagination__page is-current" aria-current="page"><%= n %></span>
                  <% } else { %>
                    <a class="col-pagination__page" href="<%= marketPath((pageHref(n))) %>" aria-label="Page <%= n %>"><%= n %></a>
                  <% } %>
                </li>
              <% } %>
            </ol>

            <% if (cp < tp) { %>
              <a class="col-pagination__step" href="<%= marketPath((pageHref(cp + 1))) %>" rel="next">Next</a>
            <% } else { %>
              <span class="col-pagination__step is-disabled" aria-hidden="true">Next</span>
            <% } %>
          </nav>
        <% } %>
      <% } %>

      <% if (cc && isFirstPage) { %>
        <div class="col-page__editorial">
          <% if (cc.guide) { %>
            <section class="col-guide" aria-labelledby="col-guide-heading">
              <h2 class="col-guide__title" id="col-guide-heading"><%= cc.guide.title %></h2>
              <% cc.guide.body.forEach(function (para) { %>
                <p class="col-guide__p"><%= para %></p>
              <% }); %>
            </section>
          <% } %>

          <% if (cc.faqs && cc.faqs.length) { %>
            <section class="col-faq" aria-labelledby="col-faq-heading">
              <h2 class="col-guide__title" id="col-faq-heading">Common questions</h2>
              <%
                /* <details>/<summary> rather than a JS accordion: it is
                   keyboard operable, exposes the right role to a screen
                   reader, and the answers are present in the HTML for a
                   crawler whether or not they are expanded. */
              %>
              <% cc.faqs.forEach(function (f, i) { %>
                <details class="col-faq__item"<%= i === 0 ? ' open' : '' %>>
                  <summary class="col-faq__q"><%= f.q %></summary>
                  <p class="col-faq__a"><%= f.a %></p>
                </details>
              <% }); %>
            </section>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>
