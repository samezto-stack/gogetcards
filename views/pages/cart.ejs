<%
  /* Money in the storefront's own currency. `cartMarket` is set by the
     market middleware when the cart has been re-priced for a localised
     storefront; without it this is the default market and the stored
     figures are already correct. Reading the line, the subtotal and the
     total through one pair of helpers is what stops them disagreeing.

     ctLine keys off cartMarket rather than off anything stored on the
     item, so there is no state that can survive into a market where it
     would be wrong. */
  var ctM = (typeof cartMarket !== 'undefined' && cartMarket && cartMarket.lines) ? cartMarket : null;
  var ctMoney = function (cents) {
    return (ctM && typeof marketMoney === 'function')
      ? marketMoney(cents, ctM.currency)
      : 'US$' + formatPrice(cents);
  };
  var ctLine = function (item) {
    return ctM ? (ctM.lines[item.slug] || 0) : item.price;
  };
  var ctTotal = ctM ? ctM.totalPrice : cart.totalPrice;
%>
<div style="background:var(--color-bg-elevated);border-bottom:1px solid var(--color-border-light);padding:2rem 0">
  <div class="container">
    <h1 class="heading-section">Shopping Cart</h1>
    <p style="color:var(--color-text-muted);margin-top:0.5rem">
      <%= cart ? cart.totalItems : 0 %> item<%= (cart && cart.totalItems !== 1) ? 's' : '' %> in your cart
    </p>
  </div>
</div>

<% if (!cart || cart.items.length === 0) { %>
  <div class="container" style="min-height:60vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.5rem;padding:4rem var(--space-xl)">
    <div style="font-size:5rem" aria-hidden="true">🛒</div>
    <h2 class="heading-section">Your cart is empty</h2>
    <p style="color:var(--color-text-muted);max-width:400px;text-align:center">
      You haven't added any products yet. Browse our sealed TCG collection and find your next chase.
    </p>
    <a href="<%= marketPath('/collection/all') %>" class="btn btn-primary btn-lg" id="cart-browse-btn">Browse Products →</a>
  </div>
<% } else { %>
  <div class="container" style="padding:2.5rem var(--space-xl)">
    <div class="cart-page__layout">

      <!-- Items -->
      <div>
        <div class="cart-page__table-head">
          <span>Product</span><span>Price</span><span>Quantity</span><span>Total</span>
        </div>

        <% cart.items.forEach(function(item) { %>
          <div class="cart-page__row" id="cart-row-<%= item.slug %>">
            <!-- Product info -->
            <div style="display:flex;align-items:center;gap:1rem">
              <a href="<%= marketPath('/products/' + (item.slug)) %>" class="cart-page__img" aria-label="<%= item.title %>">
                <% if (item.imageUrl) { %>
                  <img <%- productImage.attrs(item.imageUrl, 80) %> alt="<%= item.title %>" width="80" height="80" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:contain;padding:6px">
                <% } else { %>
                  <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:2rem">🃏</div>
                <% } %>
              </a>
              <div>
                <p style="font-size:0.65rem;color:var(--color-primary);font-weight:700;font-family:var(--font-heading);text-transform:uppercase;letter-spacing:0.06em"><%= item.vendor %></p>
                <a href="<%= marketPath('/products/' + (item.slug)) %>" style="font-family:var(--font-heading);font-size:0.9rem;font-weight:700;color:var(--color-heading);text-decoration:none;display:block;margin-top:2px"><%= item.title %></a>
                <p style="font-size:0.72rem;color:var(--color-text-faint)"><%= item.productType %></p>
                <% if (item.preorder) { %>
                  <span class="badge badge--preorder" style="font-size:0.65rem;margin-top:4px">🔔 Preorder</span>
                <% } %>
              </div>
            </div>

            <!-- Price -->
            <div style="text-align:center">
              <span style="font-family:var(--font-heading);font-size:0.95rem;font-weight:700;color:var(--color-heading)"><%= ctMoney(ctLine(item)) %></span>
            </div>

            <!-- Quantity -->
            <div style="display:flex;align-items:center;justify-content:center">
              <div style="display:flex;align-items:center;background:var(--color-bg-input);border:1.5px solid var(--color-border-light);border-radius:var(--radius-md)">
                <input
                  type="number"
                  value="<%= item.quantity %>"
                  min="0"
                  class="cart-qty-input"
                  data-cart-qty="<%= item.slug %>"
                  aria-label="Quantity for <%= item.title %>"
                  style="width:60px;text-align:center;background:transparent;border:none;color:var(--color-heading);font-family:var(--font-heading);font-weight:700;padding:0.4rem"
                >
              </div>
            </div>

            <!-- Line total + remove -->
            <div style="text-align:right">
              <span style="font-family:var(--font-heading);font-size:1rem;font-weight:800;color:var(--color-heading);display:block"><%= ctMoney(ctLine(item) * item.quantity) %></span>
              <button
                type="button"
                class="cart-remove-btn"
                data-remove-key="<%= item.slug %>"
                aria-label="Remove <%= item.title %>"
                style="font-size:0.72rem;color:var(--color-text-faint);background:none;border:none;cursor:pointer;margin-top:4px;display:inline-flex;align-items:center;gap:4px;transition:color var(--transition-fast)"
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/></svg>
                Remove
              </button>
            </div>
          </div>
        <% }); %>

        <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:1.5rem">
          <a href="<%= marketPath('/collection/all') %>" class="btn btn-ghost btn-sm" id="cart-continue-btn">
            ← Continue Shopping
          </a>
          <%/* States the rule before it bites. Adding a second product
               replaces this one, which is correct — the checkout takes one
               product per order — but a customer who learns that by
               watching their cart empty reasonably reads it as a bug. */%>
          <p style="font-size:0.75rem;color:var(--color-text-faint);margin:0">
            One product per order. Adding a different product replaces what is here.
          </p>
        </div>
      </div>

      <!-- Summary -->
      <div>
        <div class="cart-page__summary-box">
          <h2 style="font-family:var(--font-heading);font-size:1.05rem;font-weight:800;color:var(--color-heading);margin-bottom:1.25rem">Order Summary</h2>

          <div style="display:flex;flex-direction:column;gap:0.875rem">
            <div style="display:flex;justify-content:space-between;font-size:0.875rem;color:var(--color-text-muted)">
              <span>Subtotal (<%= cart.totalItems %> items)</span>
              <span><%= ctMoney(ctTotal) %></span>
            </div>
            <%/* "Calculated at checkout" was true when a threshold
                 existed; shipping is free on everything now, so the cart
                 states the real figure instead of deferring it. A total
                 that changes between the cart and the payment step is the
                 most common reason a cart is abandoned, and Merchant
                 Center reads it as a pricing inconsistency. */%>
            <div style="display:flex;justify-content:space-between;font-size:0.875rem;color:var(--color-text-muted)">
              <span>Shipping</span>
              <span style="color:var(--color-accent);font-weight:600">Free</span>
            </div>

            <div class="divider" style="margin:0"></div>
            <%/* The cart drawer already carried the estimate and this page
                 did not, so a Canadian who opened the full cart lost the
                 figure the drawer had just shown them. The hook goes on the
                 amount; fx-approx appends to its parent, which is this row,
                 so the chip lands under the total on its own line. */%>
            <div style="display:flex;justify-content:space-between;font-family:var(--font-heading);font-size:1.2rem;font-weight:900;color:var(--color-heading)">
              <span>Total</span>
              <span class="cart-total-value"><span data-usd-cents="<%= ctTotal %>" data-usd-label="<%= ctMoney(ctTotal) %>"><%= ctMoney(ctTotal) %></span></span>
            </div>
          </div>

          <% if (cart.items.length > 0) { %>
            <a href="<%= marketPath('/checkout-redirect') %>" class="btn btn-primary btn-full btn-lg" id="cart-checkout-btn" style="margin-top:1.5rem">
              🔒 Secure Checkout →
            </a>
          <% } else { %>
            <a href="<%= marketPath('/collection/all') %>" class="btn btn-primary btn-full btn-lg" id="cart-checkout-btn" style="margin-top:1.5rem">
              🔒 Continue Shopping
            </a>
          <% } %>

          <div style="display:flex;flex-direction:column;gap:0.625rem;margin-top:1.25rem;padding-top:1.25rem;border-top:1px solid var(--color-border-light)">
            <div style="display:flex;align-items:center;gap:0.625rem;font-size:0.78rem;color:var(--color-text-muted)">Secure checkout</div>
            <div style="display:flex;align-items:center;gap:0.625rem;font-size:0.78rem;color:var(--color-text-muted)">Factory-sealed guarantee</div>
            <div style="display:flex;align-items:center;gap:0.625rem;font-size:0.78rem;color:var(--color-text-muted)">📦 <%= shippingCopy.medium %></div>
            <div style="display:flex;align-items:center;gap:0.625rem;font-size:0.78rem;color:var(--color-text-muted)">↩️ <%= returnWindowDays %>-Day Return Policy</div>
          </div>

          <%/* Same badge row as the footer, from config/payments.js.
               These two lists were separate hardcoded sets and had already
               drifted — the footer advertised six methods, this four — and
               the PayPal and Apple Pay marks here were unlabelled "Pay"
               rectangles standing in for methods no buyer could use. */%>
          <div style="margin-top:1rem;padding-top:1rem;border-top:1px solid var(--color-border-light)">
            <%- include('../partials/payment-methods') %>
          </div>
        </div>
      </div>

    </div>
  </div>
<% } %>


<style>
  .cart-remove-btn:hover { color:#FC8181 !important; }
</style>
