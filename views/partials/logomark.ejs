<%/* The brand mark, as one partial.

     The header and the footer draw the same mark that the favicon, the
     apple-touch icon, the 512px PWA icon, the Open Graph share card and
     the order push notification render from brand/mark.js. One business,
     one mark, everywhere a visitor (or a Merchant Center reviewer
     comparing the tab icon, the page logo and the share preview) looks.

     Geometry is copied from brand/mark.js rather than imported because
     `require` is not available in EJS template scope. The viewBox and the
     two shapes must stay identical to that file; it is the source of
     truth and everything generated comes from it.

     Locals: `size` (px, default 28), `id` (unique when more than one
     instance appears on a page). */%>
<%
  var _size = typeof size !== 'undefined' ? size : 28;
%>
<svg width="<%= _size %>" height="<%= _size %>" viewBox="0 0 512 512" fill="none" aria-hidden="true" focusable="false">
  <rect x="190" y="104" width="196" height="272" rx="22" fill="none" stroke="currentColor" stroke-width="30" transform="rotate(14 288 240)"/>
  <rect x="126" y="136" width="196" height="272" rx="22" fill="currentColor"/>
</svg>
