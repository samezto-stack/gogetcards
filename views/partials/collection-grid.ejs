<%/* Home-page "shop by line" grid. One card per entry in config/catalog.js,
     split into the two kinds the store sells so a visitor sees at a glance
     that both trading card games and sports cards are here. The copy on
     each card is the line's description from the catalog. */%>
<section class="section-padding--sm" style="background:var(--color-bg-elevated);border-top:1px solid var(--color-border-light)">
  <div class="container">
    <div class="section-header text-center" style="margin-bottom:var(--space-2xl)">
      <div class="label-overline" style="margin-bottom:0.5rem">Browse by game and sport</div>
      <h2 class="heading-section">Shop by Collection</h2>
      <div class="divider-accent"></div>
    </div>

    <div class="cat__grid">
      <% catalog.all().forEach(function (line) { %>
      <a href="<%= marketPath('/collection/' + line.handle) %>" class="cat__card" style="--cat-accent:<%= line.accent %>" id="cat-<%= line.handle %>">
        <div class="cat__emoji" aria-hidden="true">
          <img src="/images/<%= line.icon %>" alt="" width="120" height="40" loading="lazy" decoding="async" style="height:40px;width:120px;object-fit:contain">
        </div>
        <div class="cat__info">
          <div class="label-overline" style="font-size:0.65rem;margin-bottom:0.25rem"><%= line.kind === 'sport' ? (line.league + ' · ' + line.publisher) : line.publisher %></div>
          <h3 class="cat__title"><%= line.name %></h3>
          <p class="cat__desc"><%= line.description %></p>
          <span class="cat__link" style="color:var(--cat-accent)">Shop <%= line.shortName %> →</span>
        </div>
        <div class="cat__glow" aria-hidden="true" style="background:var(--cat-accent)"></div>
      </a>
      <% }); %>
    </div>
  </div>
</section>

<style>
  .cat__glow { position:absolute; top:0; right:0; width:80px; height:80px; border-radius:50%; opacity:0.06; filter:blur(30px); pointer-events:none; transition:opacity var(--transition-normal); }
  .cat__card:hover .cat__glow { opacity:0.15; }
  .cat__card:hover { border-color:var(--cat-accent); box-shadow:0 12px 40px rgba(0,0,0,0.4),0 0 30px color-mix(in srgb,var(--cat-accent) 20%,transparent); }
  .cat__link { font-size:0.8rem;font-weight:700;font-family:var(--font-heading);margin-top:0.5rem;display:block; }
</style>
