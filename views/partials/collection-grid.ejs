<%/* THE INDEX OF LINES. A ruled index, the way a register lists its
     departments: number, mark, name, what is in it. One row per entry in
     config/catalog.js, trading card games and sports alike. The publisher
     marks are printed in grey and take their colour on hover, so seven
     brand palettes do not fight the page. */%>
<%
  var catRows = catalog.all().map(function (line) {
    return {
      id: 'cat-' + line.handle,
      href: '/collection/' + line.handle,
      img: '/images/' + line.icon,
      name: line.name,
      desc: line.description,
      cta: 'Shop ' + line.shortName,
    };
  });
%>
<section class="section-padding--sm">
  <div class="container">
    <div class="reg-head">
      <span class="reg-head__num">&sect; 02</span>
      <h2 class="heading-section reg-head__title">Shop by collection</h2>
      <a href="<%= marketPath('/collection/all') %>" class="reg-head__aside">All games and sports &rarr;</a>
    </div>
    <div class="cat__grid">
      <% catRows.forEach(function (c, i) { %>
        <a href="<%= marketPath(c.href) %>" class="cat__card" id="<%= c.id %>">
          <span class="cat__num"><%= String(i + 1).padStart(2, '0') %></span>
          <span class="cat__emoji" aria-hidden="true">
            <img src="<%= c.img %>" alt="" width="120" height="40" loading="lazy" decoding="async">
          </span>
          <div class="cat__info">
            <h3 class="cat__title"><%= c.name %></h3>
            <p class="cat__desc"><%= c.desc %></p>
          </div>
          <span class="cat__link"><%= c.cta %> &rarr;</span>
        </a>
      <% }); %>
    </div>
  </div>
</section>
