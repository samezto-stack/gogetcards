<%/* THE INDEX OF GAMES. A ruled index, the way a register lists its
     departments: number, mark, name, what is in it. The publisher marks
     are printed in grey and take their colour on hover, so four brand
     palettes do not fight the page. */%>
<%
  var catRows = [
    { id: 'cat-pokemon', href: '/collection/pokemon', img: '/images/pokemon.svg', name: 'Pokémon', desc: 'Booster boxes, ETBs, Master Cases & vintage lots', cta: 'Shop Pokémon' },
    { id: 'cat-yugioh', href: '/collection/yugioh', img: '/images/yugioh.svg', name: 'Yu-Gi-Oh!', desc: 'Booster boxes, tins, collector sets & tournament staples', cta: 'Shop Yu-Gi-Oh!' },
    { id: 'cat-mtg', href: '/collection/mtg', img: '/images/mtg.svg', name: 'MTG', desc: 'Draft boosters, collector boxes & sealed Commander sets', cta: 'Shop MTG' },
    { id: 'cat-one-piece', href: '/collection/one-piece', img: '/images/onepiece.svg', name: 'One Piece', desc: 'Japanese & English booster boxes, starter decks & cases', cta: 'Shop One Piece' },
  ];
%>
<section class="section-padding--sm">
  <div class="container">
    <div class="reg-head">
      <span class="reg-head__num">&sect; 02</span>
      <h2 class="heading-section reg-head__title">Shop by collection</h2>
      <a href="<%= marketPath('/collection/all') %>" class="reg-head__aside">All games &rarr;</a>
    </div>
    <div class="cat__grid">
      <% catRows.forEach(function (c, i) { %>
        <a href="<%= marketPath(c.href) %>" class="cat__card" id="<%= c.id %>">
          <span class="cat__num"><%= String(i + 1).padStart(2, '0') %></span>
          <span class="cat__emoji" aria-hidden="true">
            <img src="<%= c.img %>" alt="" width="120" height="40" loading="lazy" decoding="async">
          </span>
          <div class="cat__info">
            <h3 class="cat__title"><%= c.name %></h3>
            <p class="cat__desc"><%= c.desc %></p>
          </div>
          <span class="cat__link"><%= c.cta %> &rarr;</span>
        </a>
      <% }); %>
    </div>
  </div>
</section>
