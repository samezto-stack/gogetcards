<section class="po-section">
  <div class="po-section__orb" aria-hidden="true"></div>
  <div class="container">
    <div class="po-section__inner">

      <!-- Left: Copy -->
      <div class="po-section__left">
        <span class="badge badge--preorder" style="font-size:0.78rem;padding:5px 14px">
          Preorder Now Open
        </span>
        <h2 class="heading-section" style="margin-top:1rem">
          Wave 1 allocation,<br>
          <span style="color:var(--color-text-muted);font-weight:300">priced at release rate</span>
        </h2>
        <p style="color:var(--color-text-muted);font-weight:300;line-height:1.8;max-width:420px;margin-top:0.875rem">
          Preorder allocation is finite and set by the distributor, not by us. Lock your price today and we ship direct on release day. No markup, no delay.
        </p>

        <div class="po-section__urgency">
          <div class="po-section__urgency-item">
            <span class="po-section__urgency-dot"></span>
            <span>Price guaranteed at preorder rate</span>
          </div>
          <div class="po-section__urgency-item">
            <span class="po-section__urgency-dot"></span>
            <span>Ships release day from distributor</span>
          </div>
          <div class="po-section__urgency-item">
            <span class="po-section__urgency-dot"></span>
            <span>Cancel anytime before dispatch for a full refund</span>
          </div>
          <%/* The disclosure that was missing here. This block sold
               preorders from the homepage while saying only what the buyer
               gains; that payment is taken today for an unreleased item is
               the fact Merchant Center expects a preorder listing to
               state, and the fact a buyer is most likely to be surprised
               by. Every product page says it, so the homepage does too. */%>
          <div class="po-section__urgency-item">
            <span class="po-section__urgency-dot"></span>
            <span>Charged today, not on release day</span>
          </div>
        </div>

        <a href="<%= marketPath('/collection/preorders') %>" class="btn btn-primary btn-lg" id="preorder-section-cta" style="margin-top:1.75rem;display:inline-flex">
          View All Preorders →
        </a>
      </div>

      <!-- Right: Product Cards -->
      <div class="po-section__right">
        <% if (typeof preorderProducts !== 'undefined' && preorderProducts.length > 0) { %>
          <% preorderProducts.slice(0, 2).forEach(function(product) { %>
            <%
              /* Allocation readout, driven ONLY by this product's real
                 stock field. There is no invented percentage and no
                 fabricated "X units left" here: if a product has no
                 stock figure recorded, the bar is omitted entirely
                 rather than filled with a plausible-looking number.
                 allocationStart is the high-water mark we measure
                 against — the greater of the configured per-customer
                 allocation limit and current stock, so the bar can only
                 ever under-state urgency, never over-state it. */
              var stock = typeof product.stock === 'number' ? product.stock : null;
              var showAllocation = stock !== null && stock > 0;
              var allocationStart = showAllocation
                ? Math.max(stock, (product.allocationLimit || 0), 1)
                : 0;
              var remainingPct = showAllocation
                ? Math.max(4, Math.min(100, Math.round((stock / allocationStart) * 100)))
                : 0;
            %>
            <a href="<%= marketPath('/products/' + (product.slug)) %>" class="po-card zy-slab" id="po-card-<%= product.slug %>">
              <div class="po-card__header">
                <span class="badge badge--preorder">Preorder</span>
                <% if (product.preorderShips) { %>
                  <span class="po-card__ships">Ships <%= product.preorderShips %></span>
                <% } %>
              </div>
              <div class="po-card__title"><%= product.title %></div>
              <% if (showAllocation) { %>
                <div class="po-alloc">
                  <div class="po-alloc__head">
                    <span class="zy-meta">Allocation remaining</span>
                    <span class="po-alloc__count"><%= stock %> <%= stock === 1 ? 'unit' : 'units' %></span>
                  </div>
                  <div class="progress-bar" role="img" aria-label="<%= stock %> units remaining in this allocation">
                    <div class="progress-bar__fill" style="width:<%= remainingPct %>%"></div>
                  </div>
                </div>
              <% } %>
              <div class="po-card__footer">
                <%/* Priced in this storefront, like every other card on the site. */%>
                <% var poP = (typeof marketPrice === 'function') ? marketPrice(product) : null; %>
                <% if (poP) { %>
                  <span class="po-card__price" data-usd-cents="<%= poP.amount %>" data-usd-label="<%= marketMoney(poP.amount, poP.currency) %>"><%= marketMoney(poP.amount, poP.currency) %></span>
                <% } %>
                <span class="btn btn-primary btn-sm">Secure Spot →</span>
              </div>
            </a>
          <% }); %>
        <% } else { %>
          <%
            /* Honest empty state. This branch previously rendered two
               invented products ("Pokémon Twilight Masquerade", "One Piece
               Awakening Heroes") with fabricated 35%/55% allocation bars
               and fabricated prices — products that were never listed and
               could not be bought. A real store with nothing on preorder
               should say so. */
          %>
          <div class="po-empty">
            <p class="zy-meta">No open allocation</p>
            <p class="po-empty__text">There are no preorders open right now. Join the Collector's List below and you'll hear the day the next allocation opens.</p>
          </div>
        <% } %>
      </div>

    </div>
  </div>
</section>

<style>
  .po-section__right { display:flex; flex-direction:column; gap:1rem; }
  .po-alloc { margin: 0.9rem 0 0.25rem; }
  .po-alloc__head { display:flex; align-items:baseline; justify-content:space-between; gap:1rem; margin-bottom:0.45rem; }
  .po-alloc__count { font-family:var(--font-mono); font-size:0.74rem; color:var(--color-text); font-variant-numeric:tabular-nums; }
  .po-empty { background:var(--color-bg-card); border:1px dashed var(--color-border-light); border-radius:var(--radius-lg); padding:2rem 1.75rem; }
  .po-empty__text { font-size:0.88rem; font-weight:300; color:var(--color-text-muted); line-height:1.8; margin-top:0.6rem; }
</style>
