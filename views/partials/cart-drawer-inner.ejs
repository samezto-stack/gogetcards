<%/* The drawer's contents. Rendered inside #cart-drawer-inner both with
     the page (partials/cart-drawer) and by GET /api/cart/drawer after every
     cart change, so the two can never look different. */%>
<%
  /* Money in the storefront's own currency. `cartMarket` is set by the
     market middleware when the cart has been re-priced for a localised
     storefront; without it this is the default market and the stored
     figures are already correct. Reading the line, the subtotal and the
     total through one pair of helpers is what stops them disagreeing.

     ctLine keys off cartMarket rather than off anything stored on the
     item, so there is no state that can survive into a market where it
     would be wrong. */
  var ctM = (typeof cartMarket !== 'undefined' && cartMarket && cartMarket.lines) ? cartMarket : null;
  var ctMoney = function (cents) {
    return (ctM && typeof marketMoney === 'function')
      ? marketMoney(cents, ctM.currency)
      : 'US$' + formatPrice(cents);
  };
  var ctLine = function (item) {
    return ctM ? (ctM.lines[item.slug] || 0) : item.price;
  };
  var ctTotal = ctM ? ctM.totalPrice : cart.totalPrice;
%>
<div class="cd__header">
  <h2 class="cd__title">
    Your Cart
    <% if (cart && cart.totalItems > 0) { %>
      <span class="badge badge--new" style="margin-left:0.625rem"><%= cart.totalItems %></span>
    <% } %>
  </h2>
  <button class="cd__close" id="cart-drawer-close" aria-label="Close cart">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
</div>

<div class="cd__body">
  <% if (!cart || cart.items.length === 0) { %>
    <div class="cd__empty">
      <div class="cd__empty-icon" aria-hidden="true"><%- include('icon', { name: 'shopping-cart', size: 48, color: 'var(--color-text-faint)' }) %></div>
      <p class="cd__empty-title">Your cart is empty</p>
      <p style="font-size:0.875rem;color:var(--color-text-muted);text-align:center">
        Add some premium sealed product and come back here.
      </p>
      <a href="<%= marketPath('/collection/all') %>" class="btn btn-primary" id="cd-browse-btn" style="margin-top:1rem">
        Browse Products →
      </a>
    </div>
  <% } else { %>
    <div class="cd__items">
      <% cart.items.forEach(function(item) { %>
        <div class="cd__item" id="cd-item-<%= item.slug %>">
          <a href="<%= marketPath('/products/' + (item.slug)) %>" class="cd__item-img">
            <% if (item.imageUrl) { %>
              <img <%- productImage.attrs(item.imageUrl, 70) %> alt="<%= item.title %>" width="70" height="70" loading="lazy" decoding="async">
            <% } else { %>
              <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center"><%- include('icon', { name: 'package', size: 28, color: 'var(--color-text-faint)' }) %></div>
            <% } %>
          </a>
          <div class="cd__item-info">
            <a href="<%= marketPath('/products/' + (item.slug)) %>" class="cd__item-title"><%= item.title %></a>
            <% if (item.preorder) { %>
              <span class="badge badge--preorder" style="font-size:0.6rem;margin-top:4px">Preorder</span>
            <% } %>
            <div style="display:flex;align-items:center;justify-content:space-between;margin-top:0.625rem">
              <span class="cd__item-price"><%= ctMoney(ctLine(item) * item.quantity) %></span>
              <span style="font-size:0.72rem;color:var(--color-text-faint)">×<%= item.quantity %></span>
              <button class="cd__remove-btn" data-cart-remove="<%= item.slug %>" aria-label="Remove <%= item.title %>">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/></svg>
              </button>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<% if (cart && cart.items.length > 0) { %>
  <div class="cd__footer">
    <div class="cd__subtotal">
      <span>Subtotal</span>
      <span class="cd__subtotal-amount" data-usd-cents="<%= ctTotal %>" data-usd-label="<%= ctMoney(ctTotal) %>"><%= ctMoney(ctTotal) %></span>
    </div>
    <%/* The one rule, stated before it bites: the whole order is charged
         as a single plan, and the plans stop at $1,199.76. */%>
    <p style="font-size:0.68rem;color:var(--color-text-faint);text-align:center;margin-bottom:0.5rem">
      Mix any products in one order, up to $1,199.76 per order.
    </p>
    <%/* Was "Taxes and shipping calculated at checkout", which told a
         shopper the number in front of them was not the number they
         would pay. Shipping is free on every order, so the only thing
         that can still be added is destination-country import duty,
         which the carrier collects and we never see. */%>
    <p style="font-size:0.72rem;color:var(--color-accent);text-align:center;font-weight:600">
      <%= shippingCopy.short %>
    </p>
    <p style="font-size:0.68rem;color:var(--color-text-faint);text-align:center;margin-top:2px">
      Import duty, where it applies, is collected by the carrier
    </p>
    <a href="<%= marketPath('/cart') %>" class="btn btn-ghost btn-full" id="cd-view-cart">
      View Cart
    </a>
    <a href="<%= marketPath('/checkout-redirect') %>" class="btn btn-primary btn-full btn-lg" id="cd-checkout-btn">
      <%- include('icon', { name: 'lock', size: 16, color: '#fff' }) %><span style="margin-left:0.5rem">Secure Checkout · <%= ctMoney(ctTotal) %></span>
    </a>
    <div class="cd__trust-row">
      <span style="display:inline-flex;align-items:center;gap:4px"><%- include('icon', { name: 'lock', size: 12, color: 'var(--color-text-faint)' }) %> Secure</span>
      <span style="display:inline-flex;align-items:center;gap:4px"><%- include('icon', { name: 'check-circle', size: 12, color: 'var(--color-text-faint)' }) %> Sealed</span>
      <span style="display:inline-flex;align-items:center;gap:4px"><%- include('icon', { name: 'package', size: 12, color: 'var(--color-text-faint)' }) %> Tracked</span>
    </div>
  </div>
<% } %>
