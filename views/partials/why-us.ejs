<%
  /* Six identical cards in a 3x2 grid is one of the most recognizable
     generated-layout patterns there is — the uniformity itself is the
     tell, regardless of how good the copy inside each card is. This is
     now an asymmetric editorial layout: two feature panels carrying the
     claims that actually differentiate this store, and four compact
     supporting lines. Different sizes, different treatments, one system.

     Every claim below is a policy the store operates. The previous
     version's sixth card ("With over 10,000 satisfied buyers") was an
     unverifiable figure and has been removed rather than restated. */
%>
<section class="why-us">
  <div class="container">
    <div class="why-head">
      <div>
        <div class="label-overline">The GoGetCards Standard</div>
        <h2 class="heading-section" style="margin-top:0.65rem">What sealed actually means here</h2>
      </div>
      <p class="why-head__note">
        Every product we list is bought through authorized distribution and stays sealed in our hands until it ships to you. No secondary market, no exceptions.
      </p>
    </div>

    <div class="why-layout">
      <article class="why-feature zy-slab zy-foil">
        <div class="why-feature__body">
          <span class="zy-meta">01 / Sourcing</span>
          <h3 class="why-feature__title">Distributor direct, never secondary</h3>
          <p class="why-feature__desc">
            We buy from official TCG distributors only. We do not purchase from individuals, collectors, or resale marketplaces, which is what makes an unbroken chain of custody possible in the first place.
          </p>
        </div>
      </article>

      <article class="why-feature zy-slab zy-foil">
        <div class="why-feature__body">
          <span class="zy-meta">02 / Condition</span>
          <h3 class="why-feature__title">Packed to survive the courier</h3>
          <p class="why-feature__desc">
            Boxes ship inside a rigid corrugated outer carton, wrapped to protect corners and shrink-wrap integrity. The seal you receive is the seal it left the distributor with.
          </p>
        </div>
      </article>

      <ul class="why-points">
        <li>
          <span class="why-points__icon"><%- include('icon', { name: 'zap', size: 16, color: 'var(--color-primary)' }) %></span>
          <div>
            <p class="why-points__title">Same-day dispatch</p>
            <p class="why-points__desc">Orders placed before 2PM ship the same business day.</p>
          </div>
        </li>
        <li>
          <span class="why-points__icon"><%- include('icon', { name: 'globe', size: 16, color: 'var(--color-primary)' }) %></span>
          <div>
            <p class="why-points__title">Tracked worldwide</p>
            <p class="why-points__desc">Fully tracked and insured to every market we serve.</p>
          </div>
        </li>
        <li>
          <span class="why-points__icon"><%- include('icon', { name: 'credit-card', size: 16, color: 'var(--color-primary)' }) %></span>
          <div>
            <p class="why-points__title">Secure checkout</p>
            <p class="why-points__desc">Payments handled entirely by established processors.</p>
          </div>
        </li>
        <li>
          <span class="why-points__icon"><%- include('icon', { name: 'undo', size: 16, color: 'var(--color-primary)' }) %></span>
          <div>
            <p class="why-points__title">Cancel before dispatch</p>
            <p class="why-points__desc">Any preorder, full refund, right up until it ships.</p>
          </div>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .why-us { background: var(--color-bg); padding: var(--space-4xl) 0; }
  .why-head { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: end; margin-bottom: 2.75rem; padding-bottom: 2rem; border-bottom: 1px solid var(--color-border-light); }
  .why-head__note { font-size: 0.92rem; font-weight: 300; color: var(--color-text-muted); line-height: 1.8; }

  /* Deliberately uneven: two tall feature panels beside a stacked list of
     four short ones. Nothing here is a 3-across grid of equal boxes. */
  .why-layout { display: grid; grid-template-columns: 1fr 1fr 0.9fr; gap: 1.25rem; align-items: stretch; }

  .why-feature { position: relative; background: var(--color-bg-card); border: 1px solid var(--color-border-light); border-radius: var(--radius-lg); overflow: hidden; transition: border-color var(--transition-normal), transform var(--transition-normal); }
  .why-feature:hover { border-color: rgba(15,42,74,0.28); transform: translateY(-3px); }
  .why-feature__body { position: relative; z-index: 1; padding: 2rem 1.9rem; display: flex; flex-direction: column; height: 100%; }
  .why-feature__title { font-family: var(--font-serif); font-size: 1.35rem; font-weight: 500; color: var(--color-heading); line-height: 1.3; margin: 1rem 0 0.9rem; }
  .why-feature__desc { font-size: 0.88rem; font-weight: 300; color: var(--color-text-muted); line-height: 1.85; }

  .why-points { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .why-points li { display: flex; gap: 0.85rem; padding: 1.05rem 0; border-bottom: 1px solid var(--color-border-light); }
  .why-points li:first-child { padding-top: 0; }
  .why-points li:last-child { border-bottom: none; padding-bottom: 0; }
  .why-points__icon { flex-shrink: 0; display: inline-flex; margin-top: 2px; opacity: 0.8; }
  .why-points__title { font-family: var(--font-heading); font-size: 0.88rem; font-weight: 600; color: var(--color-heading); margin-bottom: 0.2rem; }
  .why-points__desc { font-size: 0.8rem; font-weight: 300; color: var(--color-text-muted); line-height: 1.6; }

  @media (max-width: 1024px) {
    .why-layout { grid-template-columns: 1fr 1fr; }
    .why-points { grid-column: 1 / -1; }
  }
  @media (max-width: 720px) {
    .why-head { grid-template-columns: 1fr; gap: 1.25rem; }
    .why-layout { grid-template-columns: 1fr; }
  }
</style>
