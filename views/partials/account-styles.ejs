<style>
/* ── Customer account: a page of the register ──────────────────────
   Built on the tokens in gogetcards.css. The account is the
   collector's own folio: an index of sections, then ruled ledgers of
   what they bought. Paper and ink, hairline rules between rows, an ink
   rule over each section, mono for anything a customer might read aloud
   to support (references, dates, amounts).

   No cards with shadows, no pills, no gradients, no tinted glass. Violet
   is only for links, focus and the active state; status is a square
   stamp in the ink of what it says. No stat tiles: this is a record of
   what somebody bought, not an analytics product. */

.ac { padding: clamp(1.5rem, 3vh, 2.5rem) var(--space-md) clamp(2.5rem, 6vh, 4.5rem); }
.ac__inner { max-width: 1040px; margin: 0 auto; }

/* ── Identity: the folio's title page ── */
.ac__head { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.75rem 1.5rem; padding-bottom: 1.1rem; }
.ac__id { margin-right: auto; min-width: 0; }
.ac__eyebrow {
  font-family: var(--font-mono); font-size: 0.68rem; font-weight: 500; letter-spacing: 0.14em;
  text-transform: uppercase; color: var(--color-text-muted); margin: 0 0 0.6rem;
}
.ac__name {
  font-family: var(--font-display); font-size: clamp(1.9rem, 4.2vw, 2.9rem); font-weight: 400;
  letter-spacing: -0.02em; line-height: 1.04; margin: 0 0 0.45rem; color: var(--color-ink);
  font-variation-settings: 'opsz' 144; overflow-wrap: anywhere;
}
.ac__sub { margin: 0; font-size: 0.88rem; color: var(--color-text-muted); overflow-wrap: anywhere; }
.ac__linkbtn {
  background: none; border: 0; padding: 0 0 0.3rem; cursor: pointer;
  font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--color-ink); text-decoration: underline; text-underline-offset: 4px;
}
.ac__linkbtn:hover { color: var(--color-primary); }
.ac__linkbtn:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }

/* ── Section index: a ruled, numbered list of the folio's parts ── */
.ac__nav {
  display: flex; margin-bottom: 2.25rem; counter-reset: acnav;
  border-top: 1.5px solid var(--color-ink); border-bottom: 1px solid var(--color-border-light);
}
.ac__tab {
  position: relative; display: inline-flex; align-items: baseline; gap: 0.55rem;
  padding: 0.8rem 1.15rem; font-family: var(--font-heading); font-size: 0.76rem; font-weight: 500;
  letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text);
  text-decoration: none; white-space: nowrap; transition: color var(--transition-fast);
}
.ac__tab:first-child { padding-left: 0; }
.ac__tab + .ac__tab::after {
  content: ''; position: absolute; left: 0; top: 0.8rem; bottom: 0.8rem; width: 1px;
  background: var(--color-border-light);
}
.ac__tab:not(.ac__tab--end) { counter-increment: acnav; }
.ac__tab:not(.ac__tab--end)::before {
  content: counter(acnav, decimal-leading-zero); font-family: var(--font-mono); font-size: 0.64rem;
  letter-spacing: 0.06em; color: var(--color-text-faint);
}
.ac__tab:hover { color: var(--color-primary); }
.ac__tab.is-on { color: var(--color-primary); box-shadow: inset 0 -2px 0 var(--color-primary); }
.ac__tab.is-on::before { color: var(--color-primary); }
.ac__tab--end { margin-left: auto; padding-right: 0; color: var(--color-text-muted); text-decoration: underline; text-underline-offset: 4px; }
.ac__tab--end::after { display: none; }
.ac__tab:focus-visible { outline: 2px solid var(--color-primary); outline-offset: -2px; }

/* ── Sheets: a section of the register, an ink rule over it ── */
.ac__sheet { position: relative; border-top: 1.5px solid var(--color-ink); margin-bottom: 2.5rem; }
/* The lead section on a page carries a double rule, as a printed
   register marks the start of an entry. */
.ac__sheet--accent { padding-top: 3px; }
.ac__sheet--accent::before {
  content: ''; position: absolute; left: 0; right: 0; top: 2px; height: 0;
  border-top: 1px solid var(--color-ink);
}
.ac__sheet-head {
  display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 1rem;
  padding: 0.95rem 0 0.8rem; border-bottom: 1px solid var(--color-border-light);
}
.ac__sheet-title {
  font-family: var(--font-display); font-size: 1.4rem; font-weight: 400; line-height: 1.15;
  margin: 0; color: var(--color-ink); letter-spacing: -0.01em; font-variation-settings: 'opsz' 72;
}
.ac__sheet-title .ac__mono { font-size: 0.72em; letter-spacing: 0.06em; color: var(--color-ink); white-space: nowrap; }
.ac__sheet-more {
  margin-left: auto; font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--color-ink); text-decoration: underline; text-underline-offset: 4px; white-space: nowrap;
}
.ac__sheet-more:hover { color: var(--color-primary); }
.ac__sheet-head .ac__muted {
  font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase;
}
.ac__sheet-head .ac__muted:last-child { margin-left: auto; }
.ac__body { padding: 1.2rem 0 0.4rem; }

.ac__label {
  display: block; font-family: var(--font-mono); font-size: 0.66rem; font-weight: 500; letter-spacing: 0.13em;
  text-transform: uppercase; color: var(--color-text-faint); margin-bottom: 0.45rem;
}
.ac__mono { font-family: var(--font-mono); font-size: 0.84rem; color: var(--color-ink); font-variant-numeric: tabular-nums; }
.ac__muted { color: var(--color-text-faint); font-size: 0.82rem; }

/* ── Ledger rows: plate | entry | figures ── */
.ac__order {
  display: flex; align-items: center; gap: 1.1rem; padding: 1rem 0; text-decoration: none; color: inherit;
  border-bottom: 1px solid var(--color-border-light); transition: background var(--transition-fast);
}
.ac__sheet > .ac__order:last-child { border-bottom: 0; }
a.ac__order:hover { background: var(--color-bg-card); }
.ac__thumb {
  width: 58px; height: 58px; flex: none; border-radius: 0; object-fit: contain;
  background: var(--color-plate); border: 1px solid var(--color-rule-soft); padding: 5px; mix-blend-mode: multiply;
}
.ac__thumb--blank { display: block; }
.ac__order-main { min-width: 0; flex: 1; }
.ac__order-title {
  display: block; font-family: var(--font-display); font-size: 1.05rem; font-weight: 400;
  color: var(--color-ink); margin: 0 0 0.35rem; line-height: 1.3; font-variation-settings: 'opsz' 36;
}
a.ac__order:hover .ac__order-title { color: var(--color-primary); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
.ac__order-meta {
  display: flex; flex-wrap: wrap; gap: 0.35rem 0.9rem; align-items: center; margin: 0;
  font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--color-text-muted); font-variant-numeric: tabular-nums;
}
.ac__order-meta .ac__mono { font-size: inherit; letter-spacing: 0.08em; color: var(--color-ink); }
.ac__order-meta .ac__inline { font-family: var(--font-mono); }
.ac__order-right { flex: none; min-width: 7rem; text-align: right; margin-left: auto; }
.ac__order-right form { margin-top: 0.55rem; }
.ac__order-right .ac__btn { margin-top: 0.55rem; }
.ac__order-right form .ac__btn { margin-top: 0; }
.ac__order-right .ac__muted {
  display: block; font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.1em; text-transform: uppercase;
}
a.ac__order:hover .ac__order-right .ac__muted { color: var(--color-primary); }
.ac__price {
  font-family: var(--font-mono); font-size: 0.98rem; font-weight: 500; color: var(--color-ink);
  margin: 0 0 0.2rem; font-variant-numeric: tabular-nums; letter-spacing: -0.01em; white-space: nowrap;
}

/* Status: a square stamp in the ink of what it says. The tone comes from
   services/customerOrders: good = paid / shipped / delivered, accent =
   preorder, warn = waiting on us or on a refund, neutral = cancelled or
   refunded (the order is closed). */
.ac__status {
  display: inline-block; font-family: var(--font-mono); font-size: 0.62rem; font-weight: 500;
  letter-spacing: 0.12em; text-transform: uppercase; line-height: 1.4;
  padding: 2px 7px; border-radius: 0; border: 1px solid currentColor; white-space: nowrap;
  background: var(--color-plate);
}
.ac__status--good { color: var(--color-accent); }
.ac__status--accent { color: var(--color-cyan); }
.ac__status--warn { color: var(--color-gold); }
.ac__status--neutral { color: var(--color-text-muted); }

/* ── Filters: ruled index tabs sharing one frame ── */
.ac__filters { display: flex; flex-wrap: wrap; margin: -0.75rem 0 1.5rem; padding-left: 1px; }
.ac__filter {
  position: relative; display: inline-flex; align-items: baseline; gap: 0.45rem;
  margin: 0 0 -1px -1px; padding: 0.5rem 0.85rem; text-decoration: none;
  font-family: var(--font-heading); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase;
  border: 1px solid var(--color-border-light); color: var(--color-text); background: transparent;
}
.ac__filter:hover { color: var(--color-primary); z-index: 1; border-color: var(--color-text-faint); }
.ac__filter.is-on { z-index: 2; color: var(--color-primary); border-color: var(--color-primary); background: var(--color-plate); }
.ac__filter-n { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.04em; color: var(--color-text-faint); font-variant-numeric: tabular-nums; }
.ac__filter.is-on .ac__filter-n { color: var(--color-primary); }
.ac__filter:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 1px; z-index: 3; }

/* ── Detail grids ── */
.ac__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem 0; }
.ac__cols > * + * { padding-left: 2.25rem; border-left: 1px solid var(--color-border-light); }
.ac__cols > :first-child { padding-right: 2.25rem; }
.ac__stack { display: flex; flex-direction: column; gap: 0.14rem; font-size: 0.9rem;
  color: var(--color-text); line-height: 1.55; font-style: normal; margin: 0; overflow-wrap: anywhere; }
.ac__stack strong { color: var(--color-ink); font-weight: 600; }
.ac__rows { display: flex; flex-direction: column; }
.ac__row {
  display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
  padding: 0.5rem 0; font-size: 0.88rem; color: var(--color-text); border-bottom: 1px dotted var(--color-border-light);
}
.ac__row:first-child { padding-top: 0; }
.ac__row > :last-child { flex: none; text-align: right; }
.ac__row strong { font-family: var(--font-mono); color: var(--color-ink); font-weight: 500; font-variant-numeric: tabular-nums; white-space: nowrap; }
.ac__row--total {
  padding-top: 0.7rem; margin-top: 0.15rem; border-bottom: 0; border-top: 1.5px solid var(--color-ink);
  font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink);
}
.ac__row--total .ac__mono { font-size: 1.1rem; font-weight: 500; letter-spacing: -0.01em; text-transform: none; }
.ac__free {
  font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--color-accent); font-weight: 500;
}

/* ── Timeline: a register of entries, dots are status marks ── */
.ac__timeline { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; }
.ac__tl { display: flex; gap: 0.9rem; padding: 0.45rem 0; position: relative; }
.ac__tl-dot {
  width: 9px; height: 9px; border-radius: 50%; flex: none; margin-top: 0.42rem;
  border: 1.5px solid var(--color-text-faint); background: var(--color-bg);
}
.ac__tl.is-done .ac__tl-dot { background: var(--color-accent); border-color: var(--color-accent); }
.ac__tl:not(:last-child)::before {
  content: ''; position: absolute; left: 4px; top: 1.2rem; bottom: -0.3rem;
  width: 1px; background: var(--color-border-light);
}
.ac__tl.is-done:not(:last-child)::before { background: var(--color-accent); }
.ac__tl-label { font-size: 0.9rem; color: var(--color-ink); }
.ac__tl:not(.is-done) .ac__tl-label { color: var(--color-text-muted); }
.ac__tl-when {
  display: block; font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.1em;
  text-transform: uppercase; color: var(--color-text-faint); margin-top: 1px;
}

/* ── Recommendations: lots in a ruled grid, neighbours share a line ── */
.ac__picks {
  display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0;
  border-left: 1px solid var(--color-border-light);
}
.ac__pick {
  text-decoration: none; display: block; color: inherit; padding: 0.75rem 0.75rem 0.9rem;
  border-right: 1px solid var(--color-border-light); border-bottom: 1px solid var(--color-border-light);
  transition: background var(--transition-fast);
}
.ac__pick:hover { background: var(--color-bg-card); }
.ac__pick-img {
  display: block; width: 100%; aspect-ratio: 1; object-fit: contain; border-radius: 0;
  background: var(--color-plate); border: 1px solid var(--color-rule-soft);
  padding: 0.8rem; mix-blend-mode: multiply;
}
.ac__pick-title {
  font-family: var(--font-display); font-size: 0.95rem; font-weight: 400; color: var(--color-ink);
  margin: 0.65rem 0 0.25rem; line-height: 1.3;
}
.ac__pick:hover .ac__pick-title { color: var(--color-primary); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
.ac__pick-price { font-family: var(--font-mono); font-size: 0.84rem; font-weight: 500; color: var(--color-ink); margin: 0; font-variant-numeric: tabular-nums; }

/* ── Empty states ── */
.ac__empty { padding: 2.75rem 1rem 2.5rem; text-align: center; }
.ac__empty h3 {
  font-family: var(--font-display); font-size: 1.5rem; font-weight: 400; letter-spacing: -0.01em;
  color: var(--color-ink); margin: 0 0 0.45rem; font-variation-settings: 'opsz' 72;
}
.ac__empty p { color: var(--color-text-muted); font-size: 0.9rem; margin: 0 0 1.4rem; }

/* ── Buttons: rectangular, uppercase, ink ── */
.ac__btn {
  display: inline-flex; align-items: center; justify-content: center; border-radius: 0;
  font-family: var(--font-heading); font-size: 0.74rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
  line-height: 1.2; padding: 0.78rem 1.35rem; text-decoration: none; white-space: nowrap;
  border: 1.5px solid transparent; cursor: pointer; background: transparent;
  transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
}
.ac__btn--primary { background: var(--color-ink); border-color: var(--color-ink); color: var(--color-on-ink); }
.ac__btn--primary:hover { background: var(--color-primary); border-color: var(--color-primary); color: var(--color-on-ink); }
.ac__btn--ghost { border-color: var(--color-border-light); color: var(--color-ink); }
.ac__btn--ghost:hover { border-color: var(--color-ink); }
.ac__btn--danger { border-color: var(--color-red); color: var(--color-red); }
.ac__btn--danger:hover { background: var(--color-red); color: var(--color-on-ink); }
.ac__btn:active { transform: translateY(1px); }
.ac__btn:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
.ac__actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }

/* ── Notices: a slip on a tinted leaf, ruled at the margin ── */
.ac__notice {
  padding: 0.9rem 1.1rem; border-radius: 0; font-size: 0.88rem; line-height: 1.6;
  border: 1px solid var(--color-border-light); border-left: 3px solid var(--color-ink);
  background: var(--color-bg-card); margin-bottom: 1.5rem; color: var(--color-text);
}
.ac__notice strong { color: var(--color-ink); font-weight: 600; }
.ac__notice a { color: var(--color-primary); text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
.ac__notice a:hover { color: var(--color-ink); }
.ac__notice--good { background: var(--color-accent-soft); border-color: var(--color-accent-soft); border-left-color: var(--color-accent); }
.ac__notice--warn,
.ac__notice--err { background: var(--color-red-soft); border-color: var(--color-red-soft); border-left-color: var(--color-red); }
.ac__notice--warn strong, .ac__notice--err strong { color: var(--color-red); }

/* ── Forms ── */
.ac__form { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem 1.5rem; }
.ac__field { display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; }
.ac__field--wide { grid-column: 1 / -1; }
.ac__field label {
  font-family: var(--font-mono); font-size: 0.68rem; font-weight: 500; letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--color-text-muted);
}
.ac__field label .ac__muted { font-size: inherit; text-transform: none; letter-spacing: 0.02em; }
.ac__field input, .ac__field select {
  background: var(--color-bg-input); border: 1px solid var(--color-border-light);
  border-bottom-color: var(--color-text-faint); border-radius: 0; color: var(--color-ink);
  font-family: var(--font-body); font-size: 0.95rem; padding: 0.7rem 0.85rem; width: 100%;
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}
.ac__field input:focus, .ac__field select:focus {
  outline: none; border-color: var(--color-ink); box-shadow: 0 0 0 3px var(--color-primary-glow);
}
.ac__field input::placeholder { color: var(--color-text-faint); }
.ac__field input[readonly] {
  background: var(--color-bg-elevated); border-color: var(--color-border-light);
  color: var(--color-text-muted); cursor: not-allowed;
}
.ac__check { display: flex; align-items: flex-start; gap: 0.65rem; font-size: 0.9rem; color: var(--color-text); cursor: pointer; }
.ac__check input { width: 16px; height: 16px; margin-top: 0.2rem; flex: none; accent-color: var(--color-ink); }

.ac__hint { font-size: 0.8rem; color: var(--color-text-muted); line-height: 1.6; margin: 0; }
.ac__hint a, .ac__inline, .ac__detail a { color: var(--color-primary); text-decoration: underline; text-underline-offset: 3px; }
.ac__hint a:hover, .ac__inline:hover, .ac__detail a:hover { color: var(--color-ink); }
.ac__detail { font-size: 0.95rem; color: var(--color-text); line-height: 1.65; margin: 0; max-width: 68ch; }
.ac__detail strong { color: var(--color-ink); font-weight: 600; }
.ac__body > .ac__detail + .ac__muted { margin: 0.55rem 0 0; font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; }
.ac__minor {
  font-family: var(--font-mono); font-size: 0.7rem; font-weight: 500; letter-spacing: 0.13em; text-transform: uppercase;
  color: var(--color-text-muted); margin: 0 0 0.8rem;
}
.ac__list { margin: 0 0 1.5rem; padding: 0; list-style: none; counter-reset: aclist; border-top: 1px solid var(--color-border-light); }
.ac__list li {
  counter-increment: aclist; position: relative;
  padding: 0.7rem 0 0.7rem 2.2rem; border-bottom: 1px solid var(--color-border-light);
  font-size: 0.9rem; color: var(--color-text); line-height: 1.6;
}
.ac__list li::before {
  content: counter(aclist, decimal-leading-zero); position: absolute; left: 0; top: 0.92rem;
  font-family: var(--font-mono); font-size: 0.66rem; line-height: 1; color: var(--color-text-faint);
}
.ac__list strong { color: var(--color-ink); font-weight: 600; }

/* A row that reads as a record rather than a link. Same geometry as
   .ac__order so a detail page and a list page line up. */
.ac__order--static { cursor: default; }
.ac__body > .ac__order--static { border-top: 1px solid var(--color-border-light); }
.ac__body > .ac__order--static ~ .ac__order--static,
.ac__body > .ac__list + .ac__order--static { border-top: 0; }
.ac__order-title .ac__status { margin-left: 0.5rem; vertical-align: 2px; }

.ac__actions--page { margin: 0 0 1.5rem; }
.ac__cancel-form { display: block; }
.ac__cancel-form .ac__field { max-width: 380px; margin-bottom: 1.2rem; }
.ac__btn--block { width: 100%; }

/* ── Sign in (no account chrome): a slip, framed in ink ── */
.ac--solo { display: flex; justify-content: center; padding-top: clamp(2rem, 7vh, 4.5rem); }
.ac__solo {
  width: 100%; max-width: 440px; background: var(--color-bg-card);
  border: 1px solid var(--color-border-light); border-top: 1.5px solid var(--color-ink); border-radius: 0;
  padding: clamp(1.4rem, 4vw, 2.2rem);
}
.ac__solo .ac__name { font-size: clamp(1.9rem, 5vw, 2.4rem); margin-bottom: 0.9rem; padding-bottom: 0.9rem; border-bottom: 1px solid var(--color-border-light); }
.ac__solo-lede { font-size: 0.93rem; color: var(--color-text); line-height: 1.65; margin: 0 0 1.4rem; }
.ac__solo-form { display: flex; flex-direction: column; gap: 1.1rem; }
.ac__solo-note { font-size: 0.8rem; color: var(--color-text-muted); line-height: 1.65; margin: 1.3rem 0 0; padding-top: 1rem; border-top: 1px dashed var(--color-border-light); }
.ac__solo-note a { color: var(--color-primary); text-decoration: underline; text-underline-offset: 3px; }
.ac__solo .ac__notice { margin-bottom: 1.1rem; }
.ac__solo .ac__notice + .ac__solo-note { margin-top: 0; }

@media (max-width: 860px) {
  .ac__picks { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 640px) {
  /* The section index becomes a two-column ruled list. */
  .ac__nav { display: grid; grid-template-columns: 1fr 1fr; margin-bottom: 1.75rem; }
  .ac__tab, .ac__tab:first-child { padding: 0.75rem 0.25rem; border-bottom: 1px solid var(--color-border-light); }
  .ac__tab:nth-child(even) { padding-left: 0.85rem; border-left: 1px solid var(--color-border-light); }
  .ac__tab + .ac__tab::after { display: none; }
