<style>
/* ── Customer account ───────────────────────────────────────────────
   Built on the tokens in gogetcards.css. Same vocabulary as the order
   confirmation: one sheet per idea, hairline rules instead of nested
   boxes, mono for anything a customer might read aloud to support.

   No stat tiles, no icon circles, no six-across feature grid. This is a
   record of what somebody bought, not an analytics product. */

.ac { padding: clamp(1.25rem, 2.5vh, 2rem) var(--space-md) clamp(2.5rem, 5vh, 4rem); }
.ac__inner { max-width: 1040px; margin: 0 auto; }

/* ── Identity ── */
.ac__head { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 1rem; margin-bottom: 1.1rem; }
.ac__id { margin-right: auto; }
.ac__eyebrow {
  font-size: 0.66rem; font-weight: 600; letter-spacing: 0.13em; text-transform: uppercase;
  color: var(--color-primary-text); margin: 0 0 0.3rem;
}
.ac__name {
  font-family: var(--font-heading); font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 600;
  letter-spacing: -0.02em; line-height: 1.1; margin: 0 0 0.25rem; color: var(--color-white);
}
.ac__sub { margin: 0; font-size: 0.86rem; color: var(--color-text-muted); }
.ac__linkbtn {
  background: none; border: 0; padding: 0; cursor: pointer;
  font-family: var(--font-body); font-size: 0.84rem; color: var(--color-text-muted);
  text-decoration: underline; text-underline-offset: 3px;
}
.ac__linkbtn:hover { color: var(--color-primary-text); }
.ac__linkbtn:focus-visible { outline: 2px solid var(--color-primary-text); outline-offset: 3px; }

/* ── Tabs ── */
.ac__nav {
  display: flex; gap: 0.25rem; overflow-x: auto; margin-bottom: 1.4rem;
  border-bottom: 1px solid var(--color-border-light); scrollbar-width: none;
}
.ac__nav::-webkit-scrollbar { display: none; }
.ac__tab {
  padding: 0.6rem 0.9rem; font-size: 0.88rem; color: var(--color-text-muted);
  text-decoration: none; white-space: nowrap; border-bottom: 2px solid transparent;
  margin-bottom: -1px; transition: color 0.15s, border-color 0.15s;
}
.ac__tab:hover { color: var(--color-text); }
.ac__tab.is-on { color: var(--color-white); border-bottom-color: var(--color-primary); }
.ac__tab--end { margin-left: auto; }
.ac__tab:focus-visible { outline: 2px solid var(--color-primary-text); outline-offset: -2px; border-radius: 4px; }

/* ── Sheets ── */
.ac__sheet {
  position: relative; background: var(--color-bg-elevated);
  border: 1px solid var(--color-border-light); border-radius: 14px;
  overflow: hidden; margin-bottom: 1.1rem;
}
.ac__sheet--accent::before {
  content: ''; position: absolute; inset: 0 0 auto 0; height: 2px;
  background: linear-gradient(90deg, var(--color-primary), var(--color-cyan));
}
.ac__sheet-head {
  display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.6rem 1rem;
  padding: 0.95rem 1.4rem; border-bottom: 1px solid var(--color-border-light);
}
.ac__sheet-title {
  font-family: var(--font-heading); font-size: 1rem; font-weight: 600;
  margin: 0; color: var(--color-white); letter-spacing: -0.01em;
}
.ac__sheet-more { margin-left: auto; font-size: 0.82rem; color: var(--color-text-muted); text-decoration: none; }
.ac__sheet-more:hover { color: var(--color-primary-text); }
.ac__body { padding: 1.1rem 1.4rem; }

.ac__label {
  display: block; font-size: 0.66rem; font-weight: 600; letter-spacing: 0.11em;
  text-transform: uppercase; color: var(--color-text-faint); margin-bottom: 0.25rem;
}
.ac__mono { font-family: var(--font-mono); font-size: 0.86rem; color: var(--color-text); }
.ac__muted { color: var(--color-text-faint); font-size: 0.82rem; }

/* ── Order rows ── */
.ac__order { display: flex; align-items: center; gap: 1rem; padding: 0.95rem 1.4rem; text-decoration: none; }
.ac__order + .ac__order { border-top: 1px solid var(--color-border-light); }
.ac__order:hover { background: rgba(255,255,255,0.015); }
.ac__thumb {
  width: 58px; height: 58px; flex: none; border-radius: 8px; object-fit: contain;
  background: var(--color-bg-card); border: 1px solid var(--color-border-light); padding: 5px;
}
.ac__thumb--blank { display: block; }
.ac__order-main { min-width: 0; flex: 1; }
.ac__order-title {
  display: block; font-size: 0.94rem; font-weight: 500; color: var(--color-text);
  margin: 0 0 0.22rem; line-height: 1.35;
}
a.ac__order:hover .ac__order-title { color: var(--color-primary-text); }
.ac__order-meta {
  display: flex; flex-wrap: wrap; gap: 0.35rem 0.7rem; align-items: center;
  font-size: 0.78rem; color: var(--color-text-faint); margin: 0;
}
.ac__order-right { text-align: right; flex: none; }
.ac__price { font-family: var(--font-mono); font-size: 0.94rem; color: var(--color-white); margin: 0 0 0.2rem; }

/* Status. Colour is semantic and separate from the brand accent. */
.ac__status {
  display: inline-block; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.03em;
  padding: 0.13rem 0.48rem; border-radius: 999px; border: 1px solid currentColor; white-space: nowrap;
}
.ac__status--good { color: var(--color-accent); background: rgba(34,197,94,0.09); }
.ac__status--accent { color: var(--color-cyan); background: rgba(6,182,212,0.09); }
.ac__status--warn { color: var(--color-gold); background: rgba(245,158,11,0.09); }
.ac__status--neutral { color: var(--color-text-faint); }

/* ── Filters ── */
.ac__filters { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.1rem; }
.ac__filter {
  font-size: 0.8rem; padding: 0.34rem 0.75rem; border-radius: 999px; text-decoration: none;
  border: 1px solid var(--color-border-light); color: var(--color-text-muted);
}
.ac__filter:hover { border-color: var(--color-primary); color: var(--color-text); }
.ac__filter.is-on { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
.ac__filter-n { opacity: 0.65; margin-left: 0.3rem; font-variant-numeric: tabular-nums; }

/* ── Detail grids ── */
.ac__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem 2.5rem; }
.ac__stack { display: flex; flex-direction: column; gap: 0.14rem; font-size: 0.87rem;
  color: var(--color-text-muted); line-height: 1.5; font-style: normal; }
.ac__stack strong { color: var(--color-text); font-weight: 500; }
.ac__rows { display: flex; flex-direction: column; gap: 0.5rem; }
.ac__row { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.87rem; color: var(--color-text-muted); }
.ac__row strong { color: var(--color-text); font-weight: 500; }
.ac__row--total { padding-top: 0.5rem; border-top: 1px solid var(--color-border-light);
  font-size: 1rem; color: var(--color-white); font-weight: 600; }
.ac__free { color: var(--color-accent); font-weight: 600; }

/* ── Timeline ── */
.ac__timeline { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0; }
.ac__tl { display: flex; gap: 0.8rem; padding: 0.4rem 0; position: relative; }
.ac__tl-dot {
  width: 9px; height: 9px; border-radius: 50%; flex: none; margin-top: 0.36rem;
  border: 1.5px solid var(--color-text-faint); background: var(--color-bg-elevated);
}
.ac__tl.is-done .ac__tl-dot { background: var(--color-accent); border-color: var(--color-accent); }
.ac__tl:not(:last-child)::before {
  content: ''; position: absolute; left: 4px; top: 1.05rem; bottom: -0.15rem;
  width: 1px; background: var(--color-border-light);
}
.ac__tl.is-done:not(:last-child)::before { background: rgba(34,197,94,0.4); }
.ac__tl-label { font-size: 0.86rem; color: var(--color-text); }
.ac__tl:not(.is-done) .ac__tl-label { color: var(--color-text-faint); }
.ac__tl-when { display: block; font-size: 0.74rem; color: var(--color-text-faint); }

/* ── Recommendations ── */
.ac__picks { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; padding: 1.1rem 1.4rem; }
.ac__pick { text-decoration: none; display: block; }
.ac__pick-img {
  width: 100%; aspect-ratio: 1; object-fit: contain; border-radius: 10px;
  background: var(--color-bg-card); border: 1px solid var(--color-border-light);
  padding: 0.7rem; transition: border-color 0.2s, transform 0.2s;
}
.ac__pick:hover .ac__pick-img { border-color: var(--color-primary); transform: translateY(-2px); }
.ac__pick-title { font-size: 0.82rem; color: var(--color-text); margin: 0.5rem 0 0.1rem; line-height: 1.35; }
.ac__pick-price { font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-text-muted); margin: 0; }

/* ── Empty states ── */
.ac__empty { padding: 2.25rem 1.4rem; text-align: center; }
.ac__empty h3 { font-family: var(--font-heading); font-size: 1.05rem; font-weight: 600;
  color: var(--color-text); margin: 0 0 0.3rem; }
.ac__empty p { color: var(--color-text-faint); font-size: 0.87rem; margin: 0 0 1rem; }

/* ── Buttons ── */
.ac__btn {
  display: inline-flex; align-items: center; justify-content: center; border-radius: 8px;
  font-size: 0.87rem; font-weight: 500; padding: 0.62rem 1.3rem; text-decoration: none;
  border: 1px solid transparent; cursor: pointer; font-family: var(--font-body);
  transition: all 0.18s ease;
}
.ac__btn--primary { background: var(--color-primary); color: #fff; }
.ac__btn--primary:hover { background: var(--color-primary-dark); }
.ac__btn--ghost { border-color: var(--color-border-light); color: var(--color-text-muted); background: transparent; }
.ac__btn--ghost:hover { border-color: var(--color-primary); color: var(--color-text); }
.ac__btn--danger { border-color: rgba(239,68,68,0.4); color: #F87171; background: transparent; }
.ac__btn--danger:hover { background: rgba(239,68,68,0.1); }
.ac__btn:focus-visible { outline: 2px solid var(--color-primary-text); outline-offset: 3px; }
.ac__actions { display: flex; flex-wrap: wrap; gap: 0.7rem; }

/* ── Notices ── */
.ac__notice {
  padding: 0.85rem 1.1rem; border-radius: 10px; font-size: 0.87rem; line-height: 1.55;
  border: 1px solid var(--color-border-light); border-left: 3px solid var(--color-primary);
  background: var(--color-bg-elevated); margin-bottom: 1.1rem; color: var(--color-text-muted);
}
.ac__notice strong { color: var(--color-text); }
.ac__notice--good { border-left-color: var(--color-accent); }
.ac__notice--warn { border-left-color: var(--color-gold); }
.ac__notice--err { border-left-color: var(--color-red); }

/* ── Forms ── */
.ac__form { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem 1.25rem; }
.ac__field { display: flex; flex-direction: column; gap: 0.3rem; }
.ac__field--wide { grid-column: 1 / -1; }
.ac__field label { font-size: 0.78rem; color: var(--color-text-muted); }
.ac__field input, .ac__field select {
  background: var(--color-bg-input); border: 1px solid var(--color-border-light);
  border-radius: 8px; color: var(--color-text); font-family: var(--font-body);
  font-size: 0.9rem; padding: 0.6rem 0.75rem; width: 100%;
}
.ac__field input:focus { outline: none; border-color: var(--color-primary); }
.ac__field input[readonly] { color: var(--color-text-faint); cursor: not-allowed; }
.ac__check { display: flex; align-items: center; gap: 0.55rem; font-size: 0.87rem; color: var(--color-text-muted); }

.ac__hint { font-size: 0.78rem; color: var(--color-text-faint); line-height: 1.5; margin: 0; }
.ac__hint a, .ac__inline { color: var(--color-primary-text); }
.ac__inline { text-decoration: underline; text-underline-offset: 3px; }
.ac__detail { font-size: 0.9rem; color: var(--color-text-muted); line-height: 1.6; margin: 0; }
.ac__detail strong { color: var(--color-text); font-weight: 500; }
.ac__minor {
  font-family: var(--font-heading); font-size: 0.86rem; font-weight: 600; letter-spacing: 0.02em;
  color: var(--color-text); margin: 0 0 0.55rem;
}
.ac__list { margin: 0 0 1.3rem; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.5rem; }
.ac__list li { font-size: 0.87rem; color: var(--color-text-muted); line-height: 1.6; }
.ac__list strong { color: var(--color-text); font-weight: 500; }

/* A row that reads as a record rather than a link. Same geometry as
   .ac__order so a detail page and a list page line up. */
.ac__order--static { cursor: default; }
.ac__order--static:hover { background: none; }
.ac__order--static + .ac__order--static { border-top: 1px solid var(--color-border-light); }
.ac__order-title .ac__status { margin-left: 0.5rem; vertical-align: 1px; }

.ac__actions--page { margin: 0 0 1.1rem; }
.ac__cancel-form { display: block; }
.ac__cancel-form .ac__field { max-width: 380px; margin-bottom: 1.1rem; }
.ac__btn--block { width: 100%; }

/* ── Sign in (no account chrome) ── */
.ac--solo { display: flex; justify-content: center; padding-top: clamp(2rem, 7vh, 4.5rem); }
.ac__solo {
  width: 100%; max-width: 430px; background: var(--color-bg-elevated);
  border: 1px solid var(--color-border-light); border-radius: 14px;
  padding: clamp(1.5rem, 4vw, 2.1rem);
}
.ac__solo .ac__name { margin-bottom: 0.6rem; }
.ac__solo-lede { font-size: 0.89rem; color: var(--color-text-muted); line-height: 1.6; margin: 0 0 1.3rem; }
.ac__solo-form { display: flex; flex-direction: column; gap: 1rem; }
.ac__solo-note { font-size: 0.78rem; color: var(--color-text-faint); line-height: 1.6; margin: 1.2rem 0 0; }
.ac__solo-note a { color: var(--color-primary-text); }

@media (max-width: 860px) {
  .ac__picks { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .ac__cols, .ac__form { grid-template-columns: 1fr; }
  .ac__order { padding: 0.85rem 1.05rem; gap: 0.8rem; }
  .ac__sheet-head, .ac__body, .ac__picks { padding-left: 1.05rem; padding-right: 1.05rem; }
  .ac__order-right { text-align: left; }
  .ac__order { flex-wrap: wrap; }
  .ac__order-main { flex: 1 1 60%; }
}
@media (prefers-reduced-motion: reduce) {
  .ac__pick-img, .ac__btn, .ac__tab { transition: none; }
  .ac__pick:hover .ac__pick-img { transform: none; }
}
</style>
