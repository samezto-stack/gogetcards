<%/* The terms of sale, set as four numbered clauses rather than four
     icons: the register states its terms, it does not decorate them. */%>
<section class="trust-bar" aria-label="Terms of sale">
  <div class="container">
    <div class="trust-bar__grid">
      <div class="trust-bar__item">
        <span class="trust-bar__num" aria-hidden="true">i.</span>
        <div>
          <p class="trust-bar__label">Authentic Sealed</p>
          <p class="trust-bar__sub">Direct from distributor</p>
        </div>
      </div>
      <div class="trust-bar__item">
        <span class="trust-bar__num" aria-hidden="true">ii.</span>
        <div>
          <%/* Was "PayPal protected payment". PayPal is not offered at
               this store's checkout, and a payment method advertised on
               every page but absent from the payment step is exactly what
               a Merchant Center reviewer clicks through to check. Copy
               now comes from config/payments.js. */%>
          <p class="trust-bar__label"><%= payments.copy.secureCheckout %></p>
          <p class="trust-bar__sub"><%= payments.copy.secureCheckoutSub %></p>
        </div>
      </div>
      <div class="trust-bar__item">
        <span class="trust-bar__num" aria-hidden="true">iii.</span>
        <div>
          <%/* The store's strongest single trust signal now leads this
               cell. "Global Shipping / Tracked & fully insured" buried the
               fact that it costs nothing, and "fully insured" implied a
               named policy the store does not hold — the shipping page
               commits to covering loss or damage, which it does. */%>
          <p class="trust-bar__label"><%= shippingCopy.short %></p>
          <p class="trust-bar__sub">Worldwide, tracked, covered in transit</p>
        </div>
      </div>
      <div class="trust-bar__item">
        <span class="trust-bar__num" aria-hidden="true">iv.</span>
        <div>
          <p class="trust-bar__label">Collector Packaging</p>
          <p class="trust-bar__sub">Rigid outer box, every order</p>
        </div>
      </div>
    </div>
  </div>
</section>
