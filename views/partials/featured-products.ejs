<section class="section-padding">
  <div class="container">
    <div class="section-header flex-between" style="flex-wrap:wrap;gap:1rem;margin-bottom:var(--space-2xl)">
      <div>
        <div class="label-overline" style="margin-bottom:0.5rem">Latest Releases</div>
        <h2 class="heading-section">Featured Drops</h2>
        <div class="divider-accent"></div>
      </div>
      <a href="<%= marketPath('/collection/all') %>" class="btn btn-outline" id="featured-view-all">
        View All →
      </a>
    </div>

    <div class="grid-4">
      <% if (typeof featuredProducts !== 'undefined' && featuredProducts.length > 0) { %>
        <% featuredProducts.forEach(function(product) { %>
          <%- include('product-card', { product: product }) %>
        <% }); %>
      <% } else { %>
        <% for (var i = 1; i <= 4; i++) { %>
          <div class="pc">
            <div class="pc__img-wrap">
              <div class="pc__placeholder" style="display:flex;align-items:center;justify-content:center;height:100%">
                <%- include('icon', { name: 'package', size: 48, color: 'var(--color-text-faint)' }) %>
              </div>
            </div>
            <div class="pc__body">
              <p class="pc__vendor">Sample Product</p>
              <p class="pc__title">Featured Product <%= i %></p>
              <p class="pc__type">Booster Box</p>
              <div class="pc__footer">
                <div class="pc__pricing">
                  <span class="pc__price">$149.99</span>
                </div>
                <span class="btn btn-outline btn-sm">View</span>
              </div>
            </div>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>
</section>
