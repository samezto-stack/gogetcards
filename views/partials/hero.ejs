<section class="hero zy-texture" id="hero">
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="container">
    <div class="hero__content animate-fade-in-up">
      <%/* Illustration, not a photograph: abstract sealed boxes in the brand
           colours, no publisher artwork or logos, so it can never be read as
           a picture of specific stock. Decorative, hence the empty alt. */%>
      <div class="hero__art" aria-hidden="true">
        <img src="/images/hero-sealed-stack.svg" alt="" width="530" height="515" decoding="async">
      </div>
      <div class="hero__eyebrow">
        <span class="zy-meta">Factory Sealed · Distributor Direct</span>
      </div>

      <h1 class="heading-hero hero__headline">
        Factory sealed.<br>
        Allocated early.<br>
        <span class="hero__headline-accent">Held to release day.</span>
      </h1>

      <p class="hero__sub">
        Booster boxes, elite trainer boxes and hobby boxes for Pokémon, Magic, One Piece, Lorcana, baseball, basketball and football, sourced through authorized distribution and never opened in between.
      </p>

      <div class="hero__ctas">
        <a href="<%= marketPath('/collection/preorders') %>" class="btn btn-primary btn-lg" id="hero-preorder-btn">
          View Preorders
        </a>
        <a href="<%= marketPath('/collection/all') %>" class="btn btn-outline btn-lg" id="hero-shop-btn">
          Shop All Products
        </a>
      </div>

      <!-- Category chips replace the floating card deco that used to sit
           at the right edge — same navigation value, but tactile and
           actually clickable instead of decorative. -->
      <nav class="hero__chips" aria-label="Shop by game">
        <% catalog.all().forEach(function (line) { %>
        <a href="<%= marketPath('/collection/' + line.handle) %>" class="hero__chip"><img src="/images/<%= line.icon %>" alt="" aria-hidden="true" width="15" height="15" loading="lazy" decoding="async"><span><%= line.shortName %></span></a>
        <% }); %>
      </nav>
    </div>
  </div>
</section>
