<%/* The line a product belongs to, as a small badge. Detection and labels
     come from config/catalog.js (exposed to views as `catalog`), so a new
     line is one entry there rather than another branch here. Renders
     nothing when the product matches no line. */%>
<% var bbLine = catalog.detect(product); %>
<% if (bbLine) { %>
  <span class="brand-badge <%= bbLine.badgeClass %>"><%= bbLine.name %></span>
<% } %>
