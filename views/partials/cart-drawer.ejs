<div id="cart-backdrop" class="cd-backdrop" aria-hidden="true"></div>

<aside id="cart-drawer" class="cd" role="dialog" aria-label="Shopping cart" aria-modal="true">
  <span id="cart-live" class="sr-only" aria-live="polite"></span>
  <div id="cart-drawer-inner">
    <%- include('cart-drawer-inner') %>
  </div>
</aside>

<style>
  .cd__remove-btn { background:none;border:none;color:var(--color-text-faint);cursor:pointer;padding:4px;border-radius:4px;transition:color var(--transition-fast); }
  .cd__remove-btn:hover { color:#FC8181; }
  .cd__trust-row { display:flex;gap:1rem;justify-content:center;padding-top:0.625rem;border-top:1px solid var(--color-border-light); }
  .cd__trust-row span { font-size:0.72rem;color:var(--color-text-faint); }
</style>
