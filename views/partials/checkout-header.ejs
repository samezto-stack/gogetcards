  <div class="ck-header-in">
    <span class="ck-logo">
      <span class="ck-logo-mark" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><rect x="104" y="104" width="304" height="74" rx="10"/><polygon points="284,192 408,192 228,320 104,320"/><rect x="104" y="334" width="304" height="74" rx="10"/></svg></span>
