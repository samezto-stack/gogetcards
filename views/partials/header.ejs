<%/* THE MASTHEAD. The storefront is designed as a printed collector's
     register (docs/storefront-design.md), so the header is set like the
     masthead of one: search on the left, the wordmark centred, utilities on
     the right, and the sections on a ruled row underneath. On a phone it
     collapses to wordmark, cart and menu. Every id and class the script in
     public/js/gogetcards.js looks up is unchanged. */%>
<header class="site-header" role="banner" id="site-header">
  <div class="container">
    <div class="header__inner">

      <div class="header__left">
          <%/* Search. The sitewide WebSite schema declares a SearchAction
               pointing at /collection/all?q=, and this is where a person
               types the term. */%>
          <form class="header__search hide-mobile" action="<%= marketPath('/collection/all') %>" method="GET" role="search">
            <label class="sr-only" for="site-search">Search products</label>
            <input
              type="search"
              id="site-search"
              name="q"
              placeholder="Search sealed boxes, sets, players"
              autocomplete="off"
              maxlength="80"
              value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
            >
            <button type="submit" aria-label="Search">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </button>
            <%/* Instant results, filled by gogetcards.js from /api/search with
                 textContent only. Empty and hidden until something is typed. */%>
            <div class="search-suggest" data-search-suggest hidden role="listbox" aria-label="Search suggestions"></div>
          </form>
      </div>

      <!-- Wordmark -->
      <a href="<%= marketPath('/') %>" class="header__logo" id="nav-logo" aria-label="GoGetCards">
        <%/* The three-card mark from brand/mark.js stays the mark: the favicon,
             the app icons and the share card all render it. */%>
        <span class="header__logo-row">
          <span class="header__logo-icon"><%- include('logomark', { size: 22 }) %></span>
          <span class="header__logo-text">GoGetCards</span>
        </span>
        <span class="header__logo-tcg">Sealed TCG &amp; sports cards</span>
      </a>

      <!-- Actions -->
      <div class="header__actions">
        <%- include('market-selector') %>

        <%/* Account. Rendered from res.locals.customer, which middleware/
             customer.js sets on every storefront request and which is null
             when nobody is signed in — so this is one link with two labels,
             not a signed-in variant of the header. Guarded on `typeof`
             because a page rendered outside that middleware (the error
             handler, for one) must not blow up over a missing local. */%>
        <% var acCust = (typeof customer !== 'undefined') ? customer : null; %>
        <a
          class="header__account"
          href="<%= marketPath('/account') %>"
          id="nav-account"
          aria-label="<%= acCust ? 'My account' : 'Sign in to your account' %>"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span class="header__account-text hide-mobile"><%= acCust ? (acCust.firstName || 'Account') : 'Sign in' %></span>
        </a>

        <!-- Cart Button -->
        <button
          class="header__cart-btn"
          id="cart-drawer-trigger"
          aria-label="Open cart"
          aria-expanded="false"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 01-8 0"/>
          </svg>
          <span class="header__cart-label">Cart</span>
          <span class="header__cart-count js-cart-count" <% if (!cart || cart.totalItems === 0) { %>style="display:none"<% } %>>
            <%= cart ? cart.totalItems : 0 %>
          </span>
        </button>

        <!-- Mobile hamburger -->
        <button
          class="header__hamburger hide-desktop"
          id="hamburger-btn"
          aria-label="Toggle mobile menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Sections -->
  <div class="header__nav-row">
    <div class="container">
          <nav class="header__nav" role="navigation" aria-label="Main navigation">
            <a href="<%= marketPath('/') %>" class="header__nav-link<%= currentPath === '/' ? ' active' : '' %>" id="nav-home">Home</a>
            <a href="<%= marketPath('/collection/all') %>" class="header__nav-link<%= currentPath === '/collection/all' ? ' active' : '' %>" id="nav-shop">Shop All</a>
            <%/* One link per line in config/catalog.js: the nav, the footer, the
                 hero ledger and the home index all read the same list. */%>
            <% catalog.all().forEach(function (line) { %>
            <a href="<%= marketPath('/collection/' + line.handle) %>" class="header__nav-link<%= currentPath === '/collection/' + line.handle ? ' active' : '' %>" id="nav-<%= line.handle %>"><%= line.shortName %></a>
            <% }); %>
            <a href="<%= marketPath('/collection/preorders') %>" class="header__nav-link header__nav-link--stamp<%= currentPath === '/collection/preorders' ? ' active' : '' %>" id="nav-preorders">Preorders</a>
            <a href="<%= marketPath('/releases') %>" class="header__nav-link<%= currentPath === '/releases' ? ' active' : '' %>" id="nav-releases">Release calendar</a>
            <a href="<%= marketPath('/about') %>" class="header__nav-link<%= currentPath === '/about' ? ' active' : '' %>" id="nav-about">About</a>
            <a href="<%= marketPath('/contact') %>" class="header__nav-link<%= currentPath === '/contact' ? ' active' : '' %>" id="nav-contact">Contact</a>
          </nav>
    </div>
  </div>

  <!-- Mobile Nav -->
  <nav class="mobile-nav" id="mobile-nav" role="navigation" aria-label="Mobile navigation" aria-hidden="true">
    <div class="mobile-nav__inner">
      <%/* Search on mobile too. The desktop box is hidden below the
           breakpoint, and a store whose schema advertises a search action
           should not lose it on the devices most of its traffic uses. */%>
      <form class="mobile-nav__search" action="<%= marketPath('/collection/all') %>" method="GET" role="search">
        <label class="sr-only" for="mobile-search">Search products</label>
        <input type="search" id="mobile-search" name="q" placeholder="Search sealed boxes, sets, players" maxlength="80" autocomplete="off">
        <button type="submit" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
        <div class="search-suggest search-suggest--mobile" data-search-suggest hidden role="listbox" aria-label="Search suggestions"></div>
      </form>
      <a href="<%= marketPath('/') %>" class="mobile-nav__link" id="mobile-nav-home">Home <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></a>
      <a href="<%= marketPath('/collection/all') %>" class="mobile-nav__link">Shop All <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></a>
      <% catalog.all().forEach(function (line) { %>
      <a href="<%= marketPath('/collection/' + line.handle) %>" class="mobile-nav__link"><%= line.name %> <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></a>
      <% }); %>
      <a href="<%= marketPath('/collection/preorders') %>" class="mobile-nav__link">Preorders <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></a>
      <a href="<%= marketPath('/releases') %>" class="mobile-nav__link">Release calendar <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></a>
      <%/* About and the policy pages are listed here too: a phone visitor
           navigating by the menu must be able to reach every page the
           desktop nav or the footer offers. */%>
      <a href="<%= marketPath('/about') %>" class="mobile-nav__link">About <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></a>
      <a href="<%= marketPath('/contact') %>" class="mobile-nav__link">Contact Us <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></a>
      <a href="<%= marketPath('/shipping') %>" class="mobile-nav__link">Shipping &amp; Delivery <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></a>
      <a href="<%= marketPath('/faq') %>" class="mobile-nav__link">FAQ <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></a>
      <a href="<%= marketPath('/account') %>" class="mobile-nav__link"><%= (typeof customer !== 'undefined' && customer) ? 'My account' : 'Sign in' %> <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></a>
    </div>
  </nav>

  <div class="header__backdrop" id="header-backdrop" aria-hidden="true"></div>
</header>
