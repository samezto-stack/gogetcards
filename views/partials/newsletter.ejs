<section class="nl-section">
    <div class="container">
    <div class="nl-inner">
      <div class="nl-copy">
        <span class="zy-meta">Subscription slip</span>
        <h2 class="heading-section">The Collector's List</h2>
        <p>
          Allocation alerts the day preorders open, price-lock windows before they close, and restock notices on sealed product. Sent before anything is posted publicly.
        </p>
      </div>
      <div>
      <form data-newsletter-form>
        <div data-nl-fields>
          <div class="nl-form">
            <label for="nl-email" class="visually-hidden">Email address</label>
            <input
              type="email"
              class="form-input nl-input"
              id="nl-email"
              name="email"
              placeholder="Your email address"
              required
              autocorrect="off"
              autocapitalize="off"
            >
            <button type="submit" class="btn btn-primary btn-lg" id="newsletter-submit">
              Get early access
            </button>
          </div>
        </div>

        <div data-nl-success style="display:none" role="status">
          <div class="nl-success">You're in! You'll get the next drop notification first.</div>
        </div>

        <div data-nl-error style="display:none" role="alert">
          <div class="nl-error">That didn't go through. Please try again in a moment.</div>
        </div>
      </form>

        <p class="nl-fine">No spam. Unsubscribe anytime. Drop alerts only.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .nl-input { flex:1; }
  .nl-success { background:var(--color-accent-soft);border:1px solid var(--color-accent);padding:1rem 1.25rem;color:var(--color-accent-dark);font-weight:600; }
  .nl-error { background:var(--color-red-soft);border:1px solid var(--color-red);padding:0.85rem 1.25rem;color:var(--color-red);font-weight:500;font-size:0.9rem;margin-top:0.75rem; }
  .visually-hidden { position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap; }
</style>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.querySelector('[data-newsletter-form]');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = form.querySelector('input[name="email"]').value;
        const btn = form.querySelector('#newsletter-submit');
        const fields = form.querySelector('[data-nl-fields]');
        const success = form.querySelector('[data-nl-success]');
        const error = form.querySelector('[data-nl-error]');

        error.style.display = 'none';
        btn.disabled = true;
        btn.innerText = 'Subscribing...';

        /* fetch() only rejects on a network failure. A 500 from /api/leads
           resolves normally, so the old `await fetch(...)` followed by an
           unconditional success swap told the visitor they were subscribed
           on every server error. res.ok is what actually distinguishes the
           two. */
        try {
          const res = await fetch('/api/leads', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, source: 'newsletter' })
          });
          if (!res.ok) throw new Error('Request failed with ' + res.status);
          fields.style.display = 'none';
          success.style.display = 'block';
        } catch (err) {
          error.style.display = 'block';
          btn.disabled = false;
          btn.innerText = 'Get early access';
        }
      });
    }
  });
</script>
