<section class="nl-section">
  <div class="nl-section__orb" aria-hidden="true"></div>
  <div class="container">
    <div class="nl-inner">
      <div class="label-overline" style="text-align:center;margin-bottom:0.75rem">Zyphera</div>
      <h2 class="heading-section" style="text-align:center">The Collector's List</h2>
      <p style="text-align:center;color:var(--color-text-muted);font-size:0.95rem;font-weight:300;line-height:1.8;max-width:490px">
        Allocation alerts the day preorders open, price-lock windows before they close, and restock notices on sealed product. Sent before anything is posted publicly.
      </p>

      <form data-newsletter-form>
        <div data-nl-fields>
          <div class="nl-form">
            <label for="nl-email" class="visually-hidden">Email address</label>
            <input
              type="email"
              class="form-input nl-input"
              id="nl-email"
              name="email"
              placeholder="Enter your email address..."
              required
              autocorrect="off"
              autocapitalize="off"
            >
            <button type="submit" class="btn btn-primary btn-lg" id="newsletter-submit">
              Get Early Access →
            </button>
          </div>
        </div>

        <div data-nl-success style="display:none" role="status">
          <div class="nl-success">You're in! You'll get the next drop notification first.</div>
        </div>

        <div data-nl-error style="display:none" role="alert">
          <div class="nl-error">That didn't go through. Please try again in a moment.</div>
        </div>
      </form>

      <p style="font-size:0.72rem;color:var(--color-text-faint);text-align:center">
        No spam. Unsubscribe anytime. Drop alerts only.
      </p>
    </div>
  </div>
</section>

<style>
  .nl-input { flex:1; }
  .nl-success { background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.3);border-radius:var(--radius-md);padding:1rem 1.75rem;color:var(--color-accent);font-weight:600;font-family:var(--font-heading);text-align:center; }
  .nl-error { background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.35);border-radius:var(--radius-md);padding:0.875rem 1.5rem;color:#FCA5A5;font-weight:500;font-family:var(--font-heading);text-align:center;font-size:0.9rem;margin-top:0.75rem; }
  .visually-hidden { position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap; }
</style>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.querySelector('[data-newsletter-form]');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = form.querySelector('input[name="email"]').value;
        const btn = form.querySelector('#newsletter-submit');
        const fields = form.querySelector('[data-nl-fields]');
        const success = form.querySelector('[data-nl-success]');
        const error = form.querySelector('[data-nl-error]');

        error.style.display = 'none';
        btn.disabled = true;
        btn.innerText = 'Subscribing...';

        /* fetch() only rejects on a network failure. A 500 from /api/leads
           resolves normally, so the old `await fetch(...)` followed by an
           unconditional success swap told the visitor they were subscribed
           on every server error. res.ok is what actually distinguishes the
           two. */
        try {
          const res = await fetch('/api/leads', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, source: 'newsletter' })
          });
          if (!res.ok) throw new Error('Request failed with ' + res.status);
          fields.style.display = 'none';
          success.style.display = 'block';
        } catch (err) {
          error.style.display = 'block';
          btn.disabled = false;
          btn.innerText = 'Get Early Access →';
        }
      });
    }
  });
</script>
